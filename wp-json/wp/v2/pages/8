{"id":8,"date":"2026-05-08T10:42:52","date_gmt":"2026-05-08T10:42:52","guid":{"rendered":"https:\/\/4050guide.co.kr\/contact\/"},"modified":"2026-05-18T22:34:31","modified_gmt":"2026-05-18T13:34:31","slug":"contact","status":"publish","type":"page","link":"https:\/\/4050guide.co.kr\/contact\/","title":{"rendered":"\ubb38\uc758"},"content":{"rendered":"<p>4050\uac00\uc774\ub4dc\uc5d0 \ub300\ud55c \ubb38\uc758, \uc815\ubcf4 \uc218\uc815 \uc694\uccad, \ucf58\ud150\uce20 \uc81c\uc548, \uad11\uace0 \ubc0f \uc81c\ud734 \ubb38\uc758\ub294 \uc544\ub798 \uc548\ub0b4\uc5d0 \ub530\ub77c \uc811\uc218\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\ubb38\uc758 \uac00\ub2a5\ud55c \ub0b4\uc6a9<\/h2>\n<ul>\n<li>\uac8c\uc2dc\ub41c \uc815\ubcf4\uc758 \uc624\ub958 \ub610\ub294 \ucd5c\uc2e0 \uc815\ubcf4 \ubc18\uc601 \uc694\uccad<\/li>\n<li>\uc790\uaca9\uc99d, \uad6d\ube44\uc9c0\uc6d0, \ubcf5\uc9c0\uc81c\ub3c4, \uc815\ubd80\uc9c0\uc6d0\uae08 \uad00\ub828 \ucf58\ud150\uce20 \uc8fc\uc81c \uc81c\uc548<\/li>\n<li>\uc0ac\uc774\ud2b8 \uc774\uc6a9 \uc911 \ubc1c\uc0dd\ud55c \uc624\ub958 \uc81c\ubcf4<\/li>\n<li>\uad11\uace0, \uc81c\ud734, \ucf58\ud150\uce20 \ud611\uc5c5 \ubb38\uc758<\/li>\n<li>\uac1c\uc778\uc815\ubcf4 \ucc98\ub9ac\uc640 \uad00\ub828\ub41c \ubb38\uc758<\/li>\n<\/ul>\n<h2>\ubb38\uc758 \ubc29\ubc95<\/h2>\n<p>\uc774\uba54\uc77c: <a href=\"mailto:solye1226@gmail.com\">solye1226@gmail.com<\/a><\/p>\n<p>\ubb38\uc758 \uc2dc \uc544\ub798 \ub0b4\uc6a9\uc744 \ud568\uaed8 \ubcf4\ub0b4\uc8fc\uc2dc\uba74 \ub354 \ube60\ub974\uac8c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<ul>\n<li>\ubb38\uc758 \uc720\ud615: \uc815\ubcf4 \uc218\uc815, \uad11\uace0 \uc81c\ud734, \uc0ac\uc774\ud2b8 \uc624\ub958, \uac1c\uc778\uc815\ubcf4 \ubb38\uc758 \ub4f1<\/li>\n<li>\uad00\ub828 \ud398\uc774\uc9c0 \uc8fc\uc18c \ub610\ub294 \uae00 \uc81c\ubaa9<\/li>\n<li>\uc218\uc815\uc774 \ud544\uc694\ud55c \ub0b4\uc6a9 \ub610\ub294 \ubb38\uc758 \ub0b4\uc6a9<\/li>\n<li>\ud655\uc778 \uac00\ub2a5\ud55c \uacf5\uc2dd \ucd9c\ucc98 URL\uc774 \uc788\ub294 \uacbd\uc6b0 \ud574\ub2f9 \uc8fc\uc18c<\/li>\n<\/ul>\n<h2>\ub2f5\ubcc0 \uc548\ub0b4<\/h2>\n<p>4050\uac00\uc774\ub4dc\ub294 \uc811\uc218\ub41c \ubb38\uc758\ub97c \ud655\uc778\ud55c \ub4a4 \uac00\ub2a5\ud55c \ubc94\uc704\uc5d0\uc11c \ub2f5\ubcc0\ud569\ub2c8\ub2e4. \ub2e4\ub9cc \uac1c\ubcc4 \uc9c0\uc6d0\uae08 \uc218\uae09 \uac00\ub2a5 \uc5ec\ubd80, \uc790\uaca9\uc99d \ud569\uaca9 \uac00\ub2a5\uc131, \uae08\uc735\uc0c1\ud488 \uc2b9\uc778 \uc5ec\ubd80 \ub4f1 \uac1c\uc778\ubcc4 \uc2ec\uc0ac \uacb0\uacfc\uac00 \ud544\uc694\ud55c \uc0ac\uc548\uc740 \uacf5\uc2dd \uae30\uad00 \ub610\ub294 \uc804\ubb38\uac00 \uc0c1\ub2f4\uc744 \uc774\uc6a9\ud574 \uc8fc\uc2dc\uae30 \ubc14\ub78d\ub2c8\ub2e4.<\/p>\n<h2>\uc815\ubcf4 \uc218\uc815 \uc694\uccad<\/h2>\n<p>\uc815\ucc45, \uc9c0\uc6d0\uae08, \uc790\uaca9\uc99d, \uad50\uc721 \uacfc\uc815 \uc815\ubcf4\ub294 \uae30\uad00 \uc0ac\uc815\uc5d0 \ub530\ub77c \ubcc0\uacbd\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 4050\uac00\uc774\ub4dc\ub294 \uac00\ub2a5\ud55c \uc815\ud655\ud55c \uc815\ubcf4\ub97c \uc720\uc9c0\ud558\uae30 \uc704\ud574 \ub178\ub825\ud558\uace0 \uc788\uc73c\uba70, \uc624\ub958 \uc81c\ubcf4\uac00 \uc811\uc218\ub418\uba74 \uacf5\uc2dd \ucd9c\ucc98\ub97c \ud655\uc778\ud55c \ub4a4 \ud544\uc694\ud55c \uacbd\uc6b0 \ub0b4\uc6a9\uc744 \uc218\uc815\ud569\ub2c8\ub2e4.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>4050\uac00\uc774\ub4dc\uc5d0 \ub300\ud55c \ubb38\uc758, \uc815\ubcf4 \uc218\uc815 \uc694\uccad, \ucf58\ud150\uce20 \uc81c\uc548, \uad11\uace0 \ubc0f \uc81c\ud734 \ubb38\uc758\ub294 \uc544\ub798 \uc548\ub0b4\uc5d0 \ub530\ub77c \uc811\uc218\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubb38\uc758 \uac00\ub2a5\ud55c \ub0b4\uc6a9 \uac8c\uc2dc\ub41c \uc815\ubcf4\uc758 \uc624\ub958 \ub610\ub294 \ucd5c\uc2e0 \uc815\ubcf4 \ubc18\uc601 \uc694\uccad \uc790\uaca9\uc99d, \uad6d\ube44\uc9c0\uc6d0, \ubcf5\uc9c0\uc81c\ub3c4, \uc815\ubd80\uc9c0\uc6d0\uae08 \uad00\ub828 \ucf58\ud150\uce20 \uc8fc\uc81c \uc81c\uc5