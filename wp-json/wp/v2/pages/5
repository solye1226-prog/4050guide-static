c744 \uc900\ube44\ud558\uac70\ub098 \uc0c8\ub85c\uc6b4 \uc0dd\ud65c \uc124\uacc4\ub97c \uc2dc\uc791\ud558\ub294 \ubd84\ub4e4\uc744 \uc704\ud574 \uad6d\uac00\uc790\uaca9\uc99d, \uc9c1\uc5c5\ud6c8\ub828, \uc9c0\uc6d0\uae08, \uc77c\uc790\ub9ac \uc815\ubcf4\ub97c \uc774\ud574\ud558\uae30 \uc27d\uac8c \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/p>\n    <div class=\"g4050-actions\">\n      <a class=\"g4050-btn primary\" href=\"\/category\/license\/\">\uc790\uaca9\uc99d \uc815\ubcf4 \ubcf4\uae30<\/a>\n      <a class=\"g4050-btn secondary\" href=\"\/category\/support\/\">\uad6d\ube44\uc9c0\uc6d0 \uc0b4\ud3b4\ubcf4\uae30<\/a>\n      <a class=\"g4050-btn secondary\" href=\"\/category\/grant\/\">\uc815\ubd80\uc9c0\uc6d0\uae08 \ud655\uc778\ud558\uae30<\/a>\n    <\/div>\n  <\/section>\n\n  <section class=\"g4050-section\">\n    <h2>\uc8fc\uc694 \uc815\ubcf4<\/h2>\n    <p>4050 \uc138\ub300\uac00 \uc2e4\uc81c\ub85c \uac80\uc0c9\ud558\ub294 \uc2e0\uccad\ubc29\ubc95, \uc870\uac74, \uc11c\ub958, \uac00\ub2a5 \uc5ec\ubd80 \uc911\uc2ec\uc73c\ub85c \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/p>\n    <div class=\"g4050-cats\">\n      <a class=\"g4050-cat\" href=\"\/category\/license\/\"><strong>\uc790\uaca9\uc99d<\/strong><span>\uc694\uc591\ubcf4\ud638\uc0ac, \uc804\uae30\uae30\ub2a5\uc0ac, \uc9c0\uac8c\ucc28, \uc0ac\ud68c\ubcf5\uc9c0\uc0ac \ub4f1 \uc7ac\ucde8\uc5c5 \uc790\uaca9\uc99d<\/span><\/a>\n      <a class=\"g4050-cat\" href=\"\/category\/support\/\"><strong>\uad6d\ube44\uc9c0\uc6d0<\/strong><span>\uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc, \uc9c1\uc5c5\ud6c8\ub828, \uc911\uc7a5\ub144 \uad50\uc721\uacfc\uc815 \uc2e0\uccad \uc815\ubcf4<\/span><\/a>\n      <a class=\"g4050-cat\" href=\"\/category\/grant\/\"><strong>\uc815\ubd80\uc9c0\uc6d0\uae08<\/strong><span>\uadfc\ub85c\uc7a5\ub824\uae08, \uace0\uc6a9\uc9c0\uc6d0\uae08, \uc0dd\ud65c\uc9c0\uc6d0 \uc81c\ub3c4\uc640 \uc2e0\uccad \uc870\uac74<\/span><\/a>\n      <a class=\"g4050-cat\" href=\"\/category\/rejob\/\"><strong>\uc7ac\ucde8\uc5c5<\/strong><span>\uc911\uc7a5\ub144 \uc77c\uc790\ub9ac, \uc774\uc9c1 \uc900\ube44, \uc7ac\ucde8\uc5c5\uc13c\ud130 \ud65c\uc6a9 \ubc29\ubc95<\/span><\/a>\n      <a class=\"g4050-cat\" href=\"\/category\/money\/\"><strong>\uc0dd\ud65c\uacbd\uc81c<\/strong><span>\ubcf4\ud5d8, \ub300\ucd9c, \uc138\uae08, \ucc3d\uc5c5 \uc804 \ud655\uc778\ud560 \uc0dd\ud65c\uacbd\uc81c \uc815\ubcf4<\/span><\/a>\n      <a class=\"g4050-cat\" href=\"\/category\/policy\/\"><strong>\uc815\ucc45\ub274\uc2a4<\/strong><span>\uc815\ubd80\uc640 \uc9c0\uc790\uccb4\uc758 4050 \uad00\ub828 \uc815\ucc45 \uc18c\uc2dd\uc744 \uc27d\uac8c \ud574\uc124<\/span><\/a>\n    <\/div>\n  <\/section>\n\n  <section class=\"g4050-section\">\n    <h2>\uba3c\uc800 \uc77d\uc73c\uba74 \uc88b\uc740 \uae00<\/h2>\n    <p>\ucd08\uae30\uc5d0\ub294 \uc544\ub798 \uc8fc\uc81c\ub4e4\uc744 \uc911\uc2ec\uc73c\ub85c \uc2e4\uc804\ud615 \uac00\uc774\ub4dc\ub97c \ucc44\uc6cc\uac08 \uc608\uc815\uc785\ub2c8\ub2e4.<\/p>\n    <div class=\"g4050-grid\">\n      <article class=\"g4050-card\">\n        <span class=\"g4050-tag\">\uc790\uaca9\uc99d<\/span>\n        <h3>50\ub300 \uc5ec\uc131 \uc7ac\ucde8\uc5c5 \uc790\uaca9\uc99d \ucd94\ucc9c<\/h3>\n        <p>\uc694\uc591\ubcf4\ud638\uc0ac, \uc0ac\ud68c\ubcf5\uc9c0\uc0ac, \ud55c\uc2dd\uc870\ub9ac\uae30\ub2a5\uc0ac\ucc98\ub7fc \uc2e4\uc81c \ucde8\uc5c5\uacfc \uc5f0\uacb0\ub418\ub294 \uc790\uaca9\uc99d\uc744 \ube44\uad50\ud569\ub2c8\ub2e4.<\/p>\n        <a href=\"\/category\/license\/\">\uad00\ub828 \uae00 \ubcf4\uae30<\/a>\n      <\/article>\n      <article class=\"g4050-card\">\n        <span class=\"g4050-tag\">\uad6d\ube44\uc9c0\uc6d0<\/span>\n        <h3>\uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc \uc2e0\uccad\ubc29\ubc95<\/h3>\n        <p>\uc2e0\uccad \uc870\uac74, \uc0ac\uc6a9\ucc98, \ud6c8\ub828 \uacfc\uc815 \uc120\ud0dd \uc804 \ud655\uc778\ud574\uc57c \ud560 \ud56d\ubaa9\uc744 \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/p>\n        <a href=\"\/category\/support\/\">\uad00\ub828 \uae00 \ubcf4\uae30<\/a>\n      <\/article>\n      <article class=\"g4050-card\">\n        <span class=\"g4050-tag\">\uc9c0\uc6d0\uae08<\/span>\n        <h3>\uadfc\ub85c\uc7a5\ub824\uae08 \uc2e0\uccad \uc548 \ub418\ub294 \uc774\uc720<\/h3>\n        <p>\uc18c\ub4dd, \uc7ac\uc0b0, \uac00\uad6c \uc720\ud615 \ub54c\ubb38\uc5d0 \ud0c8\ub77d\ud558\ub294 \uacbd\uc6b0\ub97c \uccb4\ud06c\ub9ac\uc2a4\ud2b8\ub85c \ud655\uc778\ud569\ub2c8\ub2e4.<\/p>\n        <a href=\"\/category\/grant\/\">\uad00\ub828 \uae00 \ubcf4\uae30<\/a>\n      <\/article>\n      <article class=\"g4050-card\">\n        <span class=\"g4050-tag\">\uc7ac\ucde8\uc5c5<\/span>\n        <h3>\uc911\uc7a5\ub144 \ub0b4\uc77c\uc13c\ud130 \uc774\uc6a9 \ubc29\ubc95<\/h3>\n        <p>40\ub300 \uc774\ud6c4 \uc7ac\ucde8\uc5c5 \uc0c1\ub2f4\uacfc \uad50\uc721 \ud504\ub85c\uadf8\ub7a8\uc744 \uc5b4\ub514\uc11c \uc2e0\uccad\ud558\ub294\uc9c0 \uc0b4\ud3b4\ubd05\ub2c8\ub2e4.<\/p>\n        <a href=\"\/category\/rejob\/\">\uad00\ub828 \uae00 \ubcf4\uae30<\/a>\n      <\/article>\n      <article class=\"g4050-card\">\n        <span class=\"g4050-tag\">\uc0dd\ud65c\uacbd\uc81c<\/span>\n        <h3>\ud1f4\uc9c1 \ud6c4 \ub300\ucd9c \uc804 \ud655\uc778\ud560 \uac83<\/h3>\n        <p>\uae08\ub9ac, \uc0c1\ud658 \uae30\uac04, \uc815\ubd80\uc9c0\uc6d0 \uc0c1\ud488 \uc5ec\ubd80 \ub4f1 \uc0c1\ub2f4 \uc804 \uc54c\uc544\ub458 \uae30\ubcf8 \ud56d\ubaa9\uc785\ub2c8\ub2e4.<\/p>\n        <a href=\"\/category\/money\/\">\uad00\ub828 \uae00 \ubcf4\uae30<\/a>\n      <\/article>\n      <article class=\"g4050-card\">\n        <span class=\"g4050-tag\">\uc815\ucc45<\/span>\n        <h3>4050 \uc9c0\uc6d0\uc815\ucc45 \ucc3e\ub294 \ubc95<\/h3>\n        <p>\uc815\ubd8024, \ubcf5\uc9c0\ub85c, \uc815\ucc45\ube0c\ub9ac\ud551, \uc9c0\uc790\uccb4 \uc0ac\uc774\ud2b8\uc5d0\uc11c \ub0b4\uac8c \ub9de\ub294 \uc81c\ub3c4\ub97c \ucc3e\ub294 \ubc29\ubc95\uc785\ub2c8\ub2e4.<\/p>\n        <a href=\"\/category\/policy\/\">\uad00\ub828 \uae00 \ubcf4\uae30<\/a>\n      <\/article>\n    <\/div>\n  <\/section>\n\n  <section class=\"g4050-section g4050-guide\">\n    <h2>4050 \uc7ac\ucde8\uc5c5 \uc815\ubcf4\ub294 \uc5b4\ub5bb\uac8c \ubd10\uc57c \ud560\uae4c\uc694?<\/h2>\n    <h3>\uc790\uaca9\uc99d\ub9cc \ubcf4\uba74 \ubd80\uc871\ud569\ub2c8\ub2e4<\/h3>\n    <p>\uc790\uaca9\uc99d\uc740 \uc7ac\ucde8\uc5c5 \uc900\ube44\uc758 \ucd9c\ubc1c\uc810\uc774 \ub420 \uc218 \uc788\uc9c0\ub9cc, \uc2e4\uc81c\ub85c\ub294 \uad6d\ube44\uc9c0\uc6d0 \uad50\uc721, \uc9c0\uc5ed \uc77c\uc790\ub9ac, \uc9c0\uc6d0\uae08, \uadfc\ubb34 \uc870\uac74\uc744 \ud568\uaed8 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. 4050\uac00\uc774\ub4dc\ub294 \uc790\uaca9\uc99d \uc774\ub984\ub9cc \ub098\uc5f4\ud558\uc9c0 \uc54a\uace0 \uc5b4\ub5a4 \uc0c1\ud669\uc5d0\uc11c \ub3c4\uc6c0\uc774 \ub418\ub294\uc9c0\uae4c\uc9c0 \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/p>\n    <h3>\uacf5\uc2dd \ucd9c\ucc98\ub97c \uae30\uc900\uc73c\ub85c \ud655\uc778\ud569\ub2c8\ub2e4<\/h3>\n    <p>\uc815\ubd80\uc9c0\uc6d0\uae08\uacfc \uc9c1\uc5c5\ud6c8\ub828 \uc815\ubcf4\ub294 \ud574\ub9c8\ub2e4 \uc870\uac74\uc774 \ubc14\ub014 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uae00\uc744 \uc791\uc131\ud560 \ub54c \uc815\ucc45\ube0c\ub9ac\ud551, \uc815\ubd8024, \ubcf5\uc9c0\ub85c, \uace0\uc6a9 \uad00\ub828 \uacf5\uc2dd \uc0ac\uc774\ud2b8\ub97c \ud568\uaed8 \ud655\uc778\ud558\uace0, \uc2e0\uccad \uc804 \ub2e4\uc2dc \ud655\uc778\ud574\uc57c \ud560 \ud56d\ubaa9\uc744 \ud45c\uc2dc\ud569\ub2c8\ub2e4.<\/p>\n    <h3>\ub871\ud14c\uc77c \uc9c8\ubb38\uc5d0 \ub2f5\ud569\ub2c8\ub2e4<\/h3>\n    <p>\u201c\uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc\u201d\ucc98\ub7fc \ud070 \ud0a4\uc6cc\ub4dc\ubcf4\ub2e4 \u201c50\ub300 \uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc \uc2e0\uccad\ubc29\ubc95\u201d, \u201c\uc2e4\uc5c5\uae09\uc5ec \ubc1b\ub294 \uc911 \uad6d\ube44\uc9c0\uc6d0 \uac00\ub2a5 \uc5ec\ubd80\u201d\ucc98\ub7fc \uc2e4\uc81c \uac80\uc0c9\uc790\uac00 \uad81\uae08\ud574\ud558\ub294 \uc9c8\ubb38\uc744 \uc911\uc2ec\uc73c\ub85c \uae00\uc744 \uc313\uc544\uac11\ub2c8\ub2e4.<\/p>\n  <\/section>\n\n  <section class=\"g4050-section\">\n    <h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n    <div class=\"g4050-faq\">\n      <details open><summary>50\ub300\ub3c4 \uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc\ub97c \uc2e0\uccad\ud560 \uc218 \uc788\ub098\uc694?<\/summary><p>\ub098\uc774\ub9cc\uc73c\ub85c \uc81c\ud55c\ub418\uc9c0\ub294 \uc54a\uc9c0\ub9cc, \uace0\uc6a9 \ud615\ud0dc\uc640 \uc18c\ub4dd, \uc9c1\uc5c5\ud6c8\ub828 \uc774\ub825\uc5d0 \ub530\ub77c \uc870\uac74\uc774 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2e0\uccad \uc804 \uace0\uc6a924 \ub610\ub294 \uad00\ud560 \uace0\uc6a9\uc13c\ud130 \uc548\ub0b4\ub97c \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p><\/details>\n      <details><summary>\uc911\uc7a5\ub144 \uc7ac\ucde8\uc5c5\uc5d0 \uc720\ub9ac\ud55c \uc790\uaca9\uc99d\uc740 \ubb34\uc5c7\uc778\uac00\uc694?<\/summary><p>\uac1c\uc778\uc758 \uacbd\ub825\uacfc \ud76c\ub9dd \uadfc\ubb34 \ud615\ud0dc\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \uc694\uc591\ubcf4\ud638\uc0ac, \uc0ac\ud68c\ubcf5\uc9c0\uc0ac, \uc9c0\uac8c\ucc28\uc6b4\uc804\uae30\ub2a5\uc0ac, \uc804\uae30\uae30\ub2a5\uc0ac, \ud55c\uc2dd\uc870\ub9ac\uae30\ub2a5\uc0ac\ucc98\ub7fc \uc218\uc694\uac00 \uafb8\uc900\ud55c \uc790\uaca9\uc99d\ubd80\ud130 \ube44\uad50\ud574\ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p><\/details>\n      <details><summary>\uc815\ubd80\uc9c0\uc6d0\uae08\uc740 \uc911\ubcf5 \uc2e0\uccad\ud560 \uc218 \uc788\ub098\uc694?<\/summary><p>\uc9c0\uc6d0\uae08\ub9c8\ub2e4 \uc911\ubcf5 \uc218\uae09 \uc81c\ud55c\uc774 \ub2e4\ub985\ub2c8\ub2e4. \uac19\uc740 \ubaa9\uc801\uc758 \uc9c0\uc6d0\uae08\uc740 \uc911\ubcf5\uc774 \uc5b4\ub824\uc6b4 \uacbd\uc6b0\uac00 \ub9ce\uc73c\ubbc0\ub85c \uc2e0\uccad \ud398\uc774\uc9c0\uc758 \uc81c\uc678 \ub300\uc0c1\uacfc \uc911\ubcf5 \uc81c\ud55c \ud56d\ubaa9\uc744 \ubc18\ub4dc\uc2dc \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p><\/details>\n      <details><summary>\ubcf4\ud5d8\uc774\ub098 \ub300\ucd9c \uc815\ubcf4\ub3c4 \ub2e4\ub8e8\ub098\uc694?<\/summary><p>\ub2e4\ub8f9\ub2c8\ub2e4. \ub2e4\ub9cc \ud2b9\uc815 \uc0c1\ud488\uc744 \ucd94\ucc9c\ud558\uae30\ubcf4\ub2e4 40\ub300\u00b750\ub300\uac00 \uc0c1\ub2f4 \uc804 \ud655\uc778\ud574\uc57c \ud560 \uc870\uac74, \ube44\uad50 \uae30\uc900, \uc8fc\uc758\uc0ac\ud56d \uc911\uc2ec\uc73c\ub85c \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/p><\/details>\n    <\/div>\n  <\/section>\n\n  <section class=\"g4050-section\">\n    <div class=\"g4050-note\">4050\uac00\uc774\ub4dc\ub294 \uc815\ubcf4 \ud655\uc778\uc744 \ub3d5\ub294 \ucf58\ud150\uce20 \uc0ac\uc774\ud2b8\uc785\ub2c8\ub2e4. \uc790\uaca9\uc99d, \uc9c0\uc6d0\uae08, \uae08\uc735 \uc815\ubcf4\ub294 \uc81c\ub3c4\uc640 \uac1c\uc778 \uc870\uac74\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2e0\uccad \uc804 \uacf5\uc2dd \uae30\uad00\uc758 \ucd5c\uc2e0 \uc548\ub0b4\ub97c \ud568\uaed8 \ud655\uc778\ud558\uc138\uc694.<\/div>\n  <\/section>\n<\/main>\n\n","protected":false},"excerpt":{"rendered":"<p>4050 \uc0dd\ud65c\uacbd\uc81c \uc815\ubcf4 \ud3ec\ud138 40\ub300\u00b750\ub300\ub97c \uc704\ud55c \uc790\uaca9\uc99d, \uad6d\ube44\uc9c0\uc6d0, \uc815\ubd80\uc9c0\uc6d0\uae08 \uc815\ubcf4 \uc7ac\ucde8\uc5c5\uc744 \uc900\ube44\ud558\uac70\ub098 \uc0c8\ub85c\uc6b4 \uc0dd\ud65c \uc124\uacc4\ub97c \uc2dc\uc791\ud558\ub294 \ubd84\ub4e4\uc744 \uc704\ud574 \uad6d\uac00\uc790\uaca9\uc99d, \uc9c1\uc5c5\ud6c8\ub828, \uc9c0\uc6d0\uae08, \uc77c\uc790\ub9ac \uc815\ubcf4\ub97c \uc774\ud574\ud558\uae30 \uc27d\uac8c \uc815\ub9ac\ud569\ub2c8\ub2e4. \uc790\uaca9\uc99d \uc815\ubcf4 \ubcf4\uae30 \uad6d\ube44\uc9c0\uc6d0 \uc0b4\ud3b4\ubcf4\uae30 \uc815\ubd80\uc9c0\uc6d0\uae08 \ud655\uc778\ud558\uae30 \uc8fc\uc694 \uc815\ubcf4 4050 \uc138\ub300\uac00 \uc2e4\uc81c\ub85c \uac80\uc0c9\ud558\ub294 \uc2e0\uccad\ubc29\ubc95, \uc870\uac74, \uc11c\ub958, \uac00\ub2a5 \uc5ec\ubd80 \uc911\uc2ec\uc73c\ub85c \uc815\ub9ac\ud569\ub2c8\ub2e4. \uc790\uaca9\uc99d\uc694\uc591\ubcf4\ud638\uc0ac, \uc804\uae30\uae30\ub2a5\uc0ac, \uc9c0\uac8c\ucc28, \uc0ac\ud68c\ubcf5\uc9c0\uc0ac \ub4f1 \uc7ac\ucde8\uc5c5 \uc790\uaca9\uc99d \uad6d\ube44\uc9c0\uc6d0\uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc, \uc9c1\uc5c5\ud6c8\ub828, [&hellip;]<\/p>\n","protected":false},"author":0,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"footnotes":""},"class_list":["post-5","page","type-page","status-publish","hentry"],"_links":{"self":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/pages\/5","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/types\/page"}],"replies":[{"embeddable":true,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/comments?post=5"}],"version-history":[{"count":0,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/pages\/5\/revisions"}],"wp:attachment":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/media?parent=5"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}