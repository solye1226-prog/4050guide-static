{"id":35,"date":"2026-05-16T18:00:00","date_gmt":"2026-05-16T09:00:00","guid":{"rendered":"https:\/\/4050guide.co.kr\/?p=35"},"modified":"2026-05-26T09:29:09","modified_gmt":"2026-05-26T00:29:09","slug":"emergency-welfare-living-support","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/emergency-welfare-living-support\/","title":{"rendered":"\uae34\uae09\ubcf5\uc9c0 \uc0dd\uacc4\uc9c0\uc6d0 \uc2e0\uccad\uc870\uac74: \uac11\uc791\uc2a4\ub7ec\uc6b4 \uc704\uae30 \ub54c \ud655\uc778\ud560 \uc81c\ub3c4"},"content":{"rendered":"<figure class=\"wp-block-image size-large\"><img decoding=\"async\" src=\"\/wp-content\/uploads\/2026\/05\/government-benefit-photo.png\" alt=\"\uae34\uae09\ubcf5\uc9c0 \uc0dd\uacc4\uc9c0\uc6d0 \uc2e0\uccad \uc870\uac74\uc744 \ud655\uc778\ud558\ub294 \ubaa8\uc2b5\"><\/figure>\n<p>\uae34\uae09\ubcf5\uc9c0 \uc0dd\uacc4\uc9c0\uc6d0\uc740 \uac11\uc791\uc2a4\ub7ec\uc6b4 \uc704\uae30 \uc0c1\ud669\uc73c\ub85c \uc0dd\uacc4 \uc720\uc9c0\uac00 \uc5b4\ub824\uc6cc\uc9c4 \uac00\uad6c\ub97c \ub3d5\uae30 \uc704\ud55c \uc81c\ub3c4\uc785\ub2c8\ub2e4. 4050 \uc138\ub300\ub294 \uc2e4\uc9c1, \ud734\uc5c5, \uc9c8\ubcd1, \uac00\uc871 \ub3cc\ubd04, \uc18c\ub4dd \uc911\ub2e8\uc774 \ub3d9\uc2dc\uc5d0 \ubc1c\uc0dd\ud558\ub294 \uacbd\uc6b0\uac00 \uc788\uc5b4 \ud3c9\uc18c\uc5d0 \uc2e0\uccad \ud750\ub984\uc744 \uc54c\uc544\ub450\uba74 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4.<\/p>\n<h2>\uae34\uae09\ubcf5\uc9c0 \uc0dd\uacc4\uc9c0\uc6d0 \ud575\uc2ec \uc694\uc57d<\/h2>\n<table>\n<thead>\n<tr>\n<th>\uad6c\ubd84<\/th>\n<th>\ub0b4\uc6a9<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\ubaa9\uc801<\/td>\n<td>\uac11\uc791\uc2a4\ub7ec\uc6b4 \uc704\uae30 \uc0c1\ud669\uc5d0\uc11c \uc0dd\uacc4\ube44 \ubd80\ub2f4 \uc644\ud654<\/td>\n<\/tr>\n<tr>\n<td>\ud655\uc778 \uae30\uad00<\/td>\n<td>\uc8fc\ubbfc\uc13c\ud130, \ubcf4\uac74\ubcf5\uc9c0\uc0c1\ub2f4\uc13c\ud130 129, \ubcf5\uc9c0\ub85c<\/td>\n<\/tr>\n<tr>\n<td>\uc8fc\uc694 \uc2ec\uc0ac<\/td>\n<td>\uc704\uae30 \uc0ac\uc720, \uc18c\ub4dd, \uc7ac\uc0b0, \uae08\uc735\uc7ac\uc0b0, \uac00\uad6c \uc0c1\ud669<\/td>\n<\/tr>\n<tr>\n<td>\uc8fc\uc758\uc810<\/td>\n<td>\uc778\ud130\ub137 \uc815\ubcf4\ub9cc\uc73c\ub85c \ud310\ub2e8\ud558\uc9c0 \ub9d0\uace0 \uad00\ud560 \uc8fc\ubbfc\uc13c\ud130\uc5d0 \uc989\uc2dc \ubb38\uc758<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\uc5b4\ub5a4 \uc0c1\ud669\uc5d0\uc11c \ud655\uc778\ud574\ubcfc\uae4c?<\/h2>\n<p>\uae34\uae09\ubcf5\uc9c0\ub294 \ub2e8\uc21c\ud788 \uc18c\ub4dd\uc774 \ub0ae\ub2e4\ub294 \uc774\uc720\ub9cc\uc73c\ub85c \uacb0\uc815\ub418\ub294 \uc81c\ub3c4\ub294 \uc544\ub2d9\ub2c8\ub2e4. \uac11\uc791\uc2a4\ub7ec\uc6b4 \uc704\uae30 \uc0ac\uc720\uac00 \ud568\uaed8 \ud655\uc778\ub418\uc5b4\uc57c \ud558\ubbc0\ub85c \ud604\uc7ac \uc0c1\ud669\uc744 \uad6c\uccb4\uc801\uc73c\ub85c \uc124\uba85\ud560 \uc218 \uc788\uc5b4\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<ul>\n<li>\uc8fc \uc18c\ub4dd\uc790\uc758 \uc2e4\uc9c1, \ud734\uc5c5, \ud3d0\uc5c5\uc73c\ub85c \uc0dd\uacc4\uac00 \uc5b4\ub824\uc6cc\uc9c4 \uacbd\uc6b0<\/li>\n<li>\uc911\ud55c \uc9c8\ubcd1\uc774\ub098 \ubd80\uc0c1\uc73c\ub85c \uc758\ub8cc\ube44\uc640 \uc0dd\ud65c\ube44 \ubd80\ub2f4\uc774 \ub3d9\uc2dc\uc5d0 \uc0dd\uae34 \uacbd\uc6b0<\/li>\n<li>\uac00\uc871 \ub3cc\ubd04, \uc0ac\ub9dd, \uac00\ucd9c, \ud654\uc7ac \ub4f1\uc73c\ub85c \uac11\uc790\uae30 \uc0dd\ud65c \uae30\ubc18\uc774 \ud754\ub4e4\ub9b0 \uacbd\uc6b0<\/li>\n<li>\uacf5\uacfc\uae08 \uccb4\ub0a9, \uc6d4\uc138 \ubd80\ub2f4, \uc2dd\ube44 \ubd80\uc871\ucc98\ub7fc \ub2e8\uae30 \uc704\uae30\uac00 \ubc1c\uc0dd\ud55c \uacbd\uc6b0<\/li>\n<\/ul>\n<h2>\uc2e0\uccad \uc804 \uc900\ube44\ud558\uba74 \uc88b\uc740 \uc790\ub8cc<\/h2>\n<table>\n<thead>\n<tr>\n<th>\uc790\ub8cc<\/th>\n<th>\ud655\uc778 \uc774\uc720<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\uc2e0\ubd84\uc99d<\/td>\n<td>\ubcf8\uc778 \ud655\uc778\uacfc \uc0c1\ub2f4 \uc811\uc218<\/td>\n<\/tr>\n<tr>\n<td>\uc2e4\uc9c1\u00b7\ud3d0\uc5c5\u00b7\uc9c8\ubcd1 \uad00\ub828 \uc790\ub8cc<\/td>\n<td>\uc704\uae30 \uc0ac\uc720 \ud655\uc778<\/td>\n<\/tr>\n<tr>\n<td>\uc18c\ub4dd \uad00\ub828 \uc790\ub8cc<\/td>\n<td>\uac00\uad6c\uc758 \ud604\uc7ac \uc0dd\ud65c \uc0c1\ud0dc \ud655\uc778<\/td>\n<\/tr>\n<tr>\n<td>\uc784\ub300\ucc28\uacc4\uc57d\uc11c, \uacf5\uacfc\uae08 \uace0\uc9c0\uc11c<\/td>\n<td>\uc8fc\uac70\ube44\ub098 \uccb4\ub0a9 \uc0c1\ud669 \ud655\uc778<\/td>\n<\/tr>\n<tr>\n<td>\ud1b5\uc7a5 \uac70\ub798 \ub0b4\uc5ed<\/td>\n<td>\uae08\uc735\uc7ac\uc0b0 \ub610\ub294 \uae34\uae09 \uc9c0\ucd9c \uc0c1\ud669 \ud655\uc778<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\uc2e0\uccad \uc21c\uc11c<\/h2>\n<ol>\n<li>\uba3c\uc800 \uac70\uc8fc\uc9c0 \uc8fc\ubbfc\uc13c\ud130 \ub610\ub294 \ubcf4\uac74\ubcf5\uc9c0\uc0c1\ub2f4\uc13c\ud130 129\uc5d0 \ubb38\uc758\ud569\ub2c8\ub2e4.<\/li>\n<li>\ud604\uc7ac \uc704\uae30 \uc0ac\uc720\uc640 \uc0dd\uacc4 \uace4\ub780 \uc0c1\ud669\uc744 \uad6c\uccb4\uc801\uc73c\ub85c \uc124\uba85\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc548\ub0b4\ubc1b\uc740 \uc790\ub8cc\ub97c \uc900\ube44\ud574 \uc2e0\uccad \ub610\ub294 \uc0c1\ub2f4\uc744 \uc9c4\ud589\ud569\ub2c8\ub2e4.<\/li>\n<li>\ud544\uc694\ud55c \uacbd\uc6b0 \uc0dd\uacc4\uc9c0\uc6d0 \uc678 \uc758\ub8cc, \uc8fc\uac70, \ubcf5\uc9c0\uc11c\ube44\uc2a4 \uc5f0\uacc4 \uac00\ub2a5\uc131\uc744 \ud568\uaed8 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<\/ol>\n<h2>4050 \uc138\ub300\uac00 \uc8fc\uc758\ud560 \uc810<\/h2>\n<p>\ud1f4\uc9c1\uae08, \ubcf4\ud5d8\uae08, \uc608\uae08, \uac00\uc871 \uc9c0\uc6d0 \uac00\ub2a5\uc131 \ub4f1\uc740 \uc2ec\uc0ac \uacfc\uc815\uc5d0\uc11c \ud655\uc778\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \uc704\uae30 \uc0c1\ud669\uc774 \uae09\ud574\ub3c4 \ud5c8\uc704 \uc790\ub8cc\ub97c \uc81c\ucd9c\ud558\uba74 \ubd88\uc774\uc775\uc774 \uc0dd\uae38 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2e4\uc81c \uc0c1\ud669\uc744 \uc815\ud655\ud788 \uc124\uba85\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<h3>\uc628\ub77c\uc778\uc73c\ub85c\ub9cc \uc2e0\uccad\ud574\ub3c4 \ub418\ub098\uc694?<\/h3>\n<p>\uc81c\ub3c4 \ud655\uc778\uc740 \uc628\ub77c\uc778\uc73c\ub85c \uac00\ub2a5\ud558\uc9c0\ub9cc, \uc2e4\uc81c \uc0c1\ub2f4\uc740 \uc8fc\ubbfc\uc13c\ud130\ub098 \uc0c1\ub2f4\uc13c\ud130\ub97c \ud1b5\ud574 \uc9c4\ud589\ud558\ub294 \uac83\uc774 \ube60\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uae34\uae09 \uc0c1\ud669\uc774\ub77c\uba74 \uc804\ud654 \uc0c1\ub2f4\uc744 \uba3c\uc800 \uad8c\ud569\ub2c8\ub2e4.<\/p>\n<h3>\ub2e4\ub978 \ubcf5\uc9c0\uc81c\ub3c4\uc640 \ud568\uaed8 \ubc1b\uc744 \uc218 \uc788\ub098\uc694?<\/h3>\n<p>\uac1c\ubcc4 \uc0c1\ud669\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \ub3d9\uc77c \ubaa9\uc801\uc758 \uc9c0\uc6d0\uc740 \uc81c\ud55c\ub420 \uc218 \uc788\uc73c\ubbc0\ub85c \uc0c1\ub2f4 \uacfc\uc815\uc5d0\uc11c \ud604\uc7ac \ubc1b\uace0 \uc788\ub294 \uc9c0\uc6d0\uc744 \ud568\uaed8 \uc54c\ub824\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h3>\uc5bc\ub9c8\ub098 \ube68\ub9ac \ud655\uc778\ud574\uc57c \ud558\ub098\uc694?<\/h3>\n<p>\uae34\uae09\ubcf5\uc9c0\ub294 \uc704\uae30 \uc0c1\ud669 \ub300\uc751\uc774 \ubaa9\uc801\uc774\ubbc0\ub85c \ub2a6\uac8c \ud655\uc778\ud560\uc218\ub85d \ub3c4\uc6c0\uc744 \ubc1b\uae30 \uc5b4\ub824\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc0dd\uacc4\uac00 \uae09\ud558\ub2e4\uba74 \ubc14\ub85c \uc8fc\ubbfc\uc13c\ud130 \ub610\ub294 129\uc5d0 \ubb38\uc758\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uacf5\uc2dd \ucd9c\ucc98<\/h2>\n<p>\uae34\uae09\ubcf5\uc9c0 \uae30\uc900\uacfc \uc808\ucc28\ub294 \ubcc0\uacbd\ub420 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2e4\uc81c \uc2e0\uccad \uc804\uc5d0\ub294 \ubcf5\uc9c0\ub85c, \ubcf4\uac74\ubcf5\uc9c0\uc0c1\ub2f4\uc13c\ud130, \uac70\uc8fc\uc9c0 \uc8fc\ubbfc\uc13c\ud130\uc758 \ucd5c\uc2e0 \uc548\ub0b4\ub97c \ud655\uc778\ud558\uc138\uc694.<\/p>\n<p><a href=\"https:\/\/www.bokjiro.go.kr\" target=\"_blank\" rel=\"noopener\">\ubcf5\uc9c0\ub85c \uacf5\uc2dd \ud648\ud398\uc774\uc9c0<\/a><\/p>\n<p><!-- guide4050-depth-expand --><\/p>\n<h2>4050 \uae30\uc900\uc73c\ub85c \uba3c\uc800 \ud310\ub2e8\ud560 \ubd80\ubd84<\/h2>\n<p>\uae34\uae09\ubcf5\uc9c0 \uc0dd\uacc4\uc9c0\uc6d0 \uc2e0\uccad\uc870\uac74: \uac11\uc791\uc2a4\ub7ec\uc6b4 \uc704\uae30 \ub54c \ud655\uc778\ud560 \uc81c\ub3c4\ub97c \ud655\uc778\ud560 \ub54c\ub294 \ub2e8\uc21c\ud788 \uc774\ub984\ub9cc \ubcf4\uace0 \uacb0\uc815\ud558\uae30\ubcf4\ub2e4 \ub0b4 \uc0c1\ud669\uc5d0 \uc2e4\uc81c\ub85c \ub9de\ub294\uc9c0\ubd80\ud130 \ubcf4\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. 40\ub300\uc640 50\ub300\ub294 \uc774\ubbf8 \uc9c1\uc7a5 \uacbd\ud5d8, \uac00\uc871 \ubd80\uc591, \uac74\uac15\ubcf4\ud5d8\ub8cc, \ud1f4\uc9c1 \uc77c\uc815, \ubd80\ubaa8\ub2d8 \ub3cc\ubd04 \uac19\uc740 \uc870\uac74\uc774 \ud568\uaed8 \uc6c0\uc9c1\uc774\ub294 \uacbd\uc6b0\uac00 \ub9ce\uae30 \ub54c\ubb38\uc5d0 \uac19\uc740 \uc81c\ub3c4\ub77c\ub3c4 \uccb4\uac10\ub418\ub294 \uc720\ub9ac\ud568\uc774 \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ud2b9\ud788 \uc2e0\uccad\ud615 \uc81c\ub3c4\ub098 \uc790\uaca9\uc99d \uc815\ubcf4\ub294 \uad11\uace0 \ubb38\uad6c\ubcf4\ub2e4 \uacf5\uc2dd \uc870\uac74\uacfc \uc2e4\uc81c \ud65c\uc6a9\ucc98\ub97c \ud568\uaed8 \ubd10\uc57c \ud569\ub2c8\ub2e4. \uc9c0\uc6d0 \ub300\uc0c1, \uc2e0\uccad \uae30\uac04, \uc900\ube44\uc11c\ub958, \ubcf8\uc778\ubd80\ub2f4 \uc5ec\ubd80, \uc0c1\ub2f4 \ucc3d\uad6c\ub97c \uba3c\uc800 \ud655\uc778\ud558\uba74 \uc2dc\uac04\uc744 \uc904\uc77c \uc218 \uc788\uace0, \uc2e0\uccad \ud6c4 \ud0c8\ub77d\ud558\uac70\ub098 \uacfc\uc815 \uc218\ub8cc \ud6c4 \ud65c\uc6a9\ud558\uc9c0 \ubabb\ud558\ub294 \uc0c1\ud669\uc744 \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc9c0\uc6d0\uae08 \uc2e0\uccad \uc804 \ud655\uc778 \uc21c\uc11c<\/h2>\n<table>\n<thead>\n<tr>\n<th>\ud655\uc778 \uc21c\uc11c<\/th>\n<th>\ub0b4\uc6a9<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\ub300\uc0c1<\/td>\n<td>\ub098\uc774, \uc18c\ub4dd, \uc7ac\uc0b0, \uac00\uad6c \ud615\ud0dc \uae30\uc900\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uae30\uac04<\/td>\n<td>\uc0c1\uc2dc \uc2e0\uccad\uc778\uc9c0, \uc815\uae30 \uc2e0\ucc