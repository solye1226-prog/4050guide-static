{"id":32,"date":"2026-05-14T18:30:00","date_gmt":"2026-05-14T09:30:00","guid":{"rendered":"https:\/\/4050guide.co.kr\/?p=32"},"modified":"2026-05-26T18:38:19","modified_gmt":"2026-05-26T09:38:19","slug":"earned-income-tax-credit-rejection-reasons","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/earned-income-tax-credit-rejection-reasons\/","title":{"rendered":"\uadfc\ub85c\uc7a5\ub824\uae08 \uc2e0\uccad \uc548 \ub418\ub294 \uc774\uc720: \uc18c\ub4dd, \uc7ac\uc0b0, \uac00\uad6c \uc870\uac74 \uccb4\ud06c"},"content":{"rendered":"<figure class=\"wp-block-image size-large\"><img decoding=\"async\" src=\"\/wp-content\/uploads\/2026\/05\/earned-income-tax-credit-card.png\" alt=\"\uadfc\ub85c\uc7a5\ub824\uae08 \uc2e0\uccad \uc548 \ub418\ub294 \uc774\uc720: \uc18c\ub4dd, \uc7ac\uc0b0, \uac00\uad6c \uc870\uac74 \uccb4\ud06c\"><\/figure>\n<p>\uadfc\ub85c\uc7a5\ub824\uae08\uc740 \uc77c\uc744 \ud558\uace0 \uc788\uc9c0\ub9cc \uc18c\ub4dd\uc774 \ub0ae\uc740 \uac00\uad6c\uc758 \uc0dd\ud65c \uc548\uc815\uc744 \ub3d5\uae30 \uc704\ud55c \uc81c\ub3c4\uc785\ub2c8\ub2e4. \ub2e4\ub9cc \uc2e0\uccad \ubc84\ud2bc\uc744 \ub204\ub978\ub2e4\uace0 \ubaa8\ub450 \uc9c0\uae09\ub418\ub294 \uac83\uc740 \uc544\ub2c8\uba70, \uac00\uad6c \uc720\ud615, \ucd1d\uc18c\ub4dd, \uc7ac\uc0b0 \uae30\uc900, \uc2e0\uccad \uc2dc\uc810\uc758 \uc815\ubcf4\uac00 \ub9de\uc544\uc57c \ud569\ub2c8\ub2e4. 4050 \uc138\ub300\ub294 \ub9de\ubc8c\uc774, \uc790\ub140 \ub3c5\ub9bd, \ubd80\ubaa8 \ubd80\uc591, \ud1f4\uc9c1 \ud6c4 \ub2e8\uae30\uadfc\ub85c\ucc98\ub7fc \uac00\uad6c \uc0c1\ud669\uc774 \ubcf5\uc7a1\ud55c \uacbd\uc6b0\uac00 \ub9ce\uc544 \uc2e0\uccad \uc804 \ud655\uc778\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.<\/p>\n<h2>\uadfc\ub85c\uc7a5\ub824\uae08 \ud0c8\ub77d\uc774 \ub9ce\uc740 \uc774\uc720<\/h2>\n<table>\n<thead>\n<tr>\n<th>\ud655\uc778 \ud56d\ubaa9<\/th>\n<th>\uccb4\ud06c\ud560 \ub0b4\uc6a9<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\uac00\uad6c \uc720\ud615<\/td>\n<td>\ub2e8\ub3c5, \ud651\ubc8c\uc774, \ub9de\ubc8c\uc774 \uc911 \uc5b4\ub514\uc5d0 \ud574\ub2f9\ud558\ub294\uc9c0<\/td>\n<\/tr>\n<tr>\n<td>\uc18c\ub4dd \uae30\uc900<\/td>\n<td>\uadfc\ub85c\uc18c\ub4dd, \uc0ac\uc5c5\uc18c\ub4dd, \uc885\uad50\uc778\uc18c\ub4dd \ub4f1 \ucd1d\uc18c\ub4dd \uae30\uc900<\/td>\n<\/tr>\n<tr>\n<td>\uc7ac\uc0b0 \uae30\uc900<\/td>\n<td>\uc8fc\ud0dd, \uc804\uc138\uae08, \uc608\uae08, \uc790\ub3d9\ucc28 \ub4f1 \uc7ac\uc0b0 \ud569\uc0b0<\/td>\n<\/tr>\n<tr>\n<td>\uc2e0\uccad \uc815\ubcf4<\/td>\n<td>\uac00\uc871\uad00\uacc4, \uc8fc\uc18c, \uc18c\ub4dd\uc790\ub8cc\uac00 \uc2e4\uc81c\uc640 \ub9de\ub294\uc9c0<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>4050\uc774 \ud2b9\ud788 \ud5f7\uac08\ub9ac\ub294 \ubd80\ubd84<\/h2>\n<ul>\n<li>\uc790\ub140\uc640 \ub530\ub85c \uc0b4\uc9c0\ub9cc \uc8fc\ubbfc\ub4f1\ub85d\uc0c1 \uac19\uc740 \uac00\uad6c\ub85c \ubb36\uc5ec \uc788\ub294 \uacbd\uc6b0<\/li>\n<li>\uc804\ub144\ub3c4\uc5d0\ub294 \uadfc\ub85c\ud588\uc9c0\ub9cc \uc62c\ud574\ub294 \ud1f4\uc9c1\ud55c \uacbd\uc6b0<\/li>\n<li>\ubc30\uc6b0\uc790\uc758 \uc18c\ub4dd\uc774\ub098 \uc0ac\uc5c5\uc18c\ub4dd\uc774 \ub204\ub77d\ub41c \uacbd\uc6b0<\/li>\n<li>\uc804\uc138\uae08\uc774\ub098 \uc608\uae08 \ub54c\ubb38\uc5d0 \uc7ac\uc0b0 \uae30\uc900\uc744 \ub118\ub294 \uacbd\uc6b0<\/li>\n<li>\uc548\ub0b4\ubb38\uc744 \ubc1b\uc558\uc9c0\ub9cc \uc2e4\uc81c \uc2ec\uc0ac\uc5d0\uc11c \uac10\uc561 \ub610\ub294 \uc81c\uc678\ub418\ub294 \uacbd\uc6b0<\/li>\n<\/ul>\n<h2>\uc2e0\uccad \uc804 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h2>\n<table>\n<thead>\n<tr>\n<th>\uc21c\uc11c<\/th>\n<th>\ud655\uc778\ud560 \uac83<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>1<\/td>\n<td>\ud648\ud0dd\uc2a4 \ub610\ub294 \uc190\ud0dd\uc2a4\uc5d0\uc11c \uc2e0\uccad \uc548\ub0b4 \ub300\uc0c1 \uc5ec\ubd80 \ud655\uc778<\/td>\n<\/tr>\n<tr>\n<td>2<\/td>\n<td>\uc804\ub144\ub3c4 \uc18c\ub4dd\uc790\ub8cc\uac00 \uc81c\ub300\ub85c \uc7a1\ud600 \uc788\ub294\uc9c0 \ud655\uc778<\/td>\n<\/tr>\n<tr>\n<td>3<\/td>\n<td>\ubc30\uc6b0\uc790\uc640 \uac00\uad6c\uc6d0\uc758 \uc18c\ub4dd\u00b7\uc7ac\uc0b0\uc744 \ud568\uaed8 \ud655\uc778<\/td>\n<\/tr>\n<tr>\n<td>4<\/td>\n<td>\uc815\uae30\uc2e0\uccad, \ubc18\uae30\uc2e0\uccad \uc911 \ubcf8\uc778\uc5d0\uac8c \ub9de\ub294 \uc808\ucc28 \ud655\uc778<\/td>\n<\/tr>\n<tr>\n<td>5<\/td>\n<td>\uc9c0\uae09 \uc608\uc815\uc561\uc740 \uc2ec\uc0ac \ud6c4 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc74c\uc744 \uc774\ud574<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\ud0c8\ub77d\ud588\ub2e4\uba74 \uba3c\uc800 \ubcfc \uac83<\/h2>\n<p>\ud0c8\ub77d \uc0ac\uc720\ub97c \ud655\uc778\ud558\uc9c0 \uc54a\uace0 \ub2e4\uc2dc \uc2e0\uccad\ud558\uba74 \uac19\uc740 \uc774\uc720\ub85c \ubc18\ubcf5\ud574\uc11c \uc81c\uc678\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud648\ud0dd\uc2a4\uc758 \uc2ec\uc0ac \uacb0\uacfc\uc640 \uc548\ub0b4 \ubb38\uad6c\ub97c \uba3c\uc800 \ubcf4\uace0, \uc18c\ub4dd\uc790\ub8cc \uc624\ub958\ub098 \uac00\uad6c \uc815\ubcf4\uac00 \uc2e4\uc81c\uc640 \ub2e4\ub978\uc9c0 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \ud544\uc694\ud55c \uacbd\uc6b0 \uc138\ubb34\uc11c \ub610\ub294 \uad6d\uc138\uc0c1\ub2f4\uc13c\ud130\uc5d0 \ubb38\uc758\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<h3>\uc548\ub0b4\ubb38\uc744 \ubc1b\uc73c\uba74 \ubb34\uc870\uac74 \ubc1b\uc744 \uc218 \uc788\ub098\uc694?<\/h3>\n<p>\uc544\ub2d9\ub2c8\ub2e4. \uc548\ub0b4\ubb38\uc740 \uc2e0\uccad \uac00\ub2a5\uc131\uc774 \uc788\ub2e4\ub294 \uc758\ubbf8\uc5d0 \uac00\uae5d\uace0, \uc2e4\uc81c \uc9c0\uae09 \uc5ec\ubd80\uc640 \uae08\uc561\uc740 \uc2ec\uc0ac \uacfc\uc815\uc5d0\uc11c \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h3>\ud1f4\uc9c1\ud588\ub294\ub370\ub3c4 \uc2e0\uccad\ud560 \uc218 \uc788\ub098\uc694?<\/h3>\n<p>\uadfc\ub85c\uc7a5\ub824\uae08\uc740 \uc8fc\ub85c \uc804\ub144\ub3c4 \uc18c\ub4dd\uc744 \uae30\uc900\uc73c\ub85c \ud310\ub2e8\ud569\ub2c8\ub2e4. \uc62c\ud574 \ud1f4\uc9c1 \uc5ec\ubd80\ub9cc\uc73c\ub85c \ud310\ub2e8\ud558\uc9c0 \ub9d0\uace0 \uae30\uc900 \uc5f0\ub3c4\uc758 \uc18c\ub4dd\uacfc \uac00\uad6c \uc694\uac74\uc744 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h3>\uc7ac\uc0b0 \uae30\uc900\uc740 \uc65c \uc911\uc694\ud55c\uac00\uc694?<\/h3>\n<p>\uc18c\ub4dd\uc774 \ub0ae\uc544\ub3c4 \uc8fc\ud0dd, \uc804\uc138\uae08, \uc608\uae08, \uc790\ub3d9\ucc28 \ub4f1\uc744 \ud569\uc0b0\ud55c \uc7ac\uc0b0 \uae30\uc900\uc744 \ub118\uc73c\uba74 \uc9c0\uae09\uc561\uc774 \uc904\uac70\ub098 \uc81c\uc678\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc9c0\uae09\uc561\ubcf4\ub2e4 \uba3c\uc800 \ubd10\uc57c \ud560 \uac83<\/h2>\n<p>\uadfc\ub85c\uc7a5\ub824\uae08\uc740 \uc608\uc0c1 \uc9c0\uae09\uc561\ub9cc \ubcf4\uace0 \ud310\ub2e8\ud558\uba74 \uc624\ud574\uac00 \uc0dd\uae30\uae30 \uc27d\uc2b5\ub2c8\ub2e4. \uc2e4\uc81c \uc9c0\uae09\uc561\uc740 \uc2ec\uc0ac \uacb0\uacfc\uc5d0 \ub530\ub77c \uac10\uc561\ub420 \uc218 \uc788\uace0, \uac00\uad6c\uc6d0 \uc815\ubcf4\ub098 \uc7ac\uc0b0 \uc815\ubcf4\uac00 \ub2ec\ub77c\uc9c0\uba74 \uc2e0\uccad \ub2f9\uc2dc \uc608\uc0c1\uacfc \ub2e4\ub974\uac8c \ub098\uc62c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 4050 \uc138\ub300\ub294 \uc790\ub140\uac00 \ub3c5\ub9bd\ud588\ub294\uc9c0, \ubc30\uc6b0\uc790 \uc18c\ub4dd\uc774 \uc788\ub294\uc9c0, \ubd80\ubaa8\uc640 \uc8fc\uc18c\uc9c0\uac00 \uac19\uc740\uc9c0\uc5d0 \ub530\ub77c \uac00\uad6c \uad6c\ubd84\uc774 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<ul>\n<li>\uc804\ub144\ub3c4\uc5d0 \uc77c\ud55c \uae30\uac04\uc774 \uc9e7\uc544\ub3c4 \uc18c\ub4dd \uc790\ub8cc\uac00 \uc788\ub2e4\uba74 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc0ac\uc5c5\uc18c\ub4dd\uc774 \uc788\ub294 \uacbd\uc6b0 \uc5c5\uc885\ubcc4 \uc870\uc815\ub960\uc774 \uc801\uc6a9\ub420 \uc218 \uc788\uc74c\uc744 \uc774\ud574\ud569\ub2c8\ub2e4.<\/li>\n<li>\ubd80\ub3d9\uc0b0\uacfc \uc804\uc138\uae08\uc740 \uc2e4\uc81c \ud604\uae08\uc774 \uc544\ub2c8\uc5b4\ub3c4 \uc7ac\uc0b0\uc73c\ub85c \ubc18\uc601\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/li>\n<li>\uc2e0\uccad \ud6c4 \uc774\uc0ac, \ud63c\uc778, \uc774\ud63c \ub4f1 \uac00\uc871\uad00\uacc4 \ubcc0\ub3d9\uc774 \uc788\uc73c\uba74 \uc548\ub0b4\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>\uc2e0\uccad \ud6c4 \ubcf4\uad00\ud558\uba74 \uc88b\uc740 \uc790\ub8cc<\/h2>\n<p>\uc2e0\uccad \uacb0\uacfc\uc5d0 \uc774\uc758\uac00 \uc788\uac70\ub098 \ucd94\uac00 \ud655\uc778\uc774 \ud544\uc694\ud560 \ub54c\ub97c \ub300\ube44\ud574 \uc2e0\uccad \ud654\uba74, \uc548\ub0b4\ubb38, \uc18c\ub4dd\uc790\ub8cc, \uac00\uc871\uad00\uacc4 \ubcc0\ub3d9 \uc790\ub8cc\ub97c \ubcf4\uad00\ud574\ub450\uba74 \uc88b\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \ub2e8\uae30\uadfc\ub85c, \uc77c\uc6a9\uadfc\ub85c, \uc0ac\uc5c5\uc18c\ub4dd\uc774 \uc11e\uc5ec \uc788\ub294 \uacbd\uc6b0\uc5d0\ub294 \ubcf8\uc778\uc774 \uae30\uc5b5\ud558\ub294 \uc18c\ub4dd\uacfc \uad6d\uc138\uccad\uc5d0 \uc7a1\ud78c \uc18c\ub4dd\uc774 \ub2e4\ub97c \uc218 \uc788\uc73c\ubbc0\ub85c \ud648\ud0dd\uc2a4\uc5d0\uc11c \uba3c\uc800 \ud655\uc778\ud558\ub294 \uc2b5\uad00\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.<\/p>\n<h2>\uacf5\uc2dd \ucd9c\ucc98<\/h2>\n<p>\uadfc\ub85c\uc7a5\ub824\uae08 \uae30\uc900\uacfc \uc2e0\uccad \uae30\uac04\uc740 \ub9e4\ub144 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2e4\uc81c \uc2e0\uccad \uc804 \uad6d\uc138\uccad \ud648\ud0dd\uc2a4\uc758 \ucd5c\uc2e0 \uc548\ub0b4\ub97c \ud655\uc778\ud558\uc138\uc694.<\/p>\n<p><a href=\"https:\/\/www.hometax.go.kr\" target=\"_blank\" rel=\"noopener\">\uad6d\uc138\uccad \ud648\ud0dd\uc2a4<\/a><\/p>\n<p><!-- guide4050-related-start --><\/p>\n<section class=\"guide-related-posts\">\n<h2>\ud568\uaed8 \ubcf4\uba74 \uc88b\uc740 \uae00<\/h2>\n<p>\uc774 \uae00\uacfc \uc774\uc5b4\uc11c \ud655\uc778\ud558\uba74 \uc88b\uc740 4050 \ub9de\ucda4 \uc815\ubcf4\uc785\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/4050guide.co.kr\/june-2026-4050-benefit-welfare-checklist\/\">2026\ub144 6\uc6d4 4050 \uc815\ubd80\uc9c0\uc6d0\uae08\u00b7\ubcf5\uc9c0 \uc2e0\uccad \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/earned-child-tax-credit-june-2026-check\/\">2026 \uadfc\ub85c\u00b7\uc790\ub140\uc7a5\ub824\uae08 6\uc6d4 1\uc77c \uc804\ud6c4 \ud655\uc778\ud560 \uac83: \uc2e0\uccad, \uae30\ud55c \ud6c4 \uc2e0\uccad, \uc9c0\uae09\uc77c<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/small-business-policy-fund-4050-checklist\/\">\uc18c\uc0c1\uacf5\uc778 \uc815\ucc45\uc790\uae08 4050 \uc790\uc601\uc5c5\uc790 \ud655\uc778\ubc29\ubc95: \uc2e0\uccad \uc804 \uc900\ube44\uc11c\ub958<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/national-employment-support-4050-checklist\/\">\uad6d\ubbfc\ucde8\uc5c5\uc9c0\uc6d0\uc81c\ub3c4 4050 \uc2e0\uccad \uc804 \ud655\uc778\ud560 \uac83: \uc18c\ub4dd, \ucde8\uc5c5\uacbd\ud5d8, \uad6c\uc9c1\ud65c\ub3d9<\/a><\/li>\n<\/ul>\n<\/section>\n<p><!-- guide4050-related-end --><\/p>\n<p><!-- 4050_SHORT_UPLIFT_START --><\/p>\n<section class=\"guide-short-uplift\">\n<h2>\uc9c0\uc6d0\uae08 \uc2e0\uccad \uc804 \ud655\uc778\ud560 \uac83<\/h2>\n<p>\uc9c0\uc6d0\uae08\uc740 \u201c\ubc1b\uc744 \uc218 \uc788\ub2e4\u201d\ub294 \ub9d0\ubcf4\ub2e4 \uc81c\uc678 \uc870\uac74\uc744 \uba3c\uc800 \ubcf4\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc18c\ub4dd, \uc7ac\uc0b0, \uc5c5\uc885, \uac70\uc8fc\uc9c0, \uc2e0\uccad \uae30\uac04 \uc911 \ud558\ub098\ub9cc \ub9de\uc9c0 \uc54a\uc544\ub3c4 \uacb0\uacfc\uac00 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<figure class=\"wp-block-table\">\n<table>\n<tr>\n<th>\ud655\uc778 \uc21c\uc11c<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<th>\ud310\ub2e8 \uae30\uc900<\/th>\n<\/tr>\n<tr>\n<td>1\ub2e8\uacc4<\/td>\n<td>\ub300\uc0c1 \uc870\uac74<\/td>\n<td>\uc5f0\ub839, \uc9c0\uc5ed, \uc18c\ub4dd, \uc5c5\uc885 \uae30\uc900\uc744 \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>2\ub2e8\uacc4<\/td>\n<td>\uc2e0\uccad \uae30\uac04<\/td>\n<td>\uc811\uc218 \uc2dc\uc791\uc77c\uacfc \ub9c8\uac10\uc77c\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>3\ub2e8\uacc4<\/td>\n<td>\uc99d\ube59 \uc11c\ub958<\/td>\n