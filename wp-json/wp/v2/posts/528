{"id":528,"date":"2026-05-28T18:04:01","date_gmt":"2026-05-28T09:04:01","guid":{"rendered":"https:\/\/4050guide.co.kr\/social-worker-level-2-study-plan-4050\/"},"modified":"2026-05-28T18:04:01","modified_gmt":"2026-05-28T09:04:01","slug":"social-worker-level-2-study-plan-4050","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/social-worker-level-2-study-plan-4050\/","title":{"rendered":"\uc0ac\ud68c\ubcf5\uc9c0\uc0ac 2\uae09 4050 \uacf5\ubd80\ubc95: \uacfc\ubaa9 \uc774\uc218\uc640 \ud604\uc7a5\uc2e4\uc2b5\uc744 \uba3c\uc800 \uacc4\uc0b0\ud558\uc138\uc694"},"content":{"rendered":"<p>\uc0ac\ud68c\ubcf5\uc9c0\uc0ac 2\uae09\uc740 \ud544\uae30\uc2dc\ud5d8\uc744 \ub2e8\uae30\uac04\uc5d0 \ubcf4\ub294 \uc790\uaca9\uc99d\uc774 \uc544\ub2c8\ub77c \uacfc\ubaa9 \uc774\uc218\uc640 \ud604\uc7a5\uc2e4\uc2b5\uc744 \ucc28\uadfc\ucc28\uadfc \ucc44\uc6cc\uc57c \ud558\ub294 \uc790\uaca9\uc785\ub2c8\ub2e4. 4050 \uc900\ube44\uc790\ub294 \uad11\uace0 \ubb38\uad6c\ubcf4\ub2e4 \ud559\uc810\uc740\ud589\uc81c \uacfc\ubaa9, \uc2e4\uc2b5 \uac00\ub2a5 \uc2dc\uae30, \ube44\uc6a9, \ucde8\uc5c5\ucc98\ub97c \uba3c\uc800 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<p>\uc790\uaca9\uc99d \uacf5\ubd80\ubc95\uc740 \ubaa8\ub4e0 \uc885\ubaa9\uc5d0 \uac19\uc740 \ubc29\uc2dd\uc73c\ub85c \uc801\uc6a9\ud558\uae30 \uc5b4\ub835\uc2b5\ub2c8\ub2e4. \ud544\uae30 \uc911\uc2ec\uc778\uc9c0, \uc2e4\uae30 \uc911\uc2ec\uc778\uc9c0, \uc2e4\uc2b5\uae30\uad00\uc774 \ud544\uc694\ud55c\uc9c0, \ucde8\ub4dd \ud6c4 \uc5b4\ub5a4 \uc77c\uc790\ub9ac\uc640 \uc5f0\uacb0\ub418\ub294\uc9c0\uc5d0 \ub530\ub77c \uc900\ube44 \uc21c\uc11c\uac00 \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \uc544\ub798 \ub0b4\uc6a9\uc740 4050 \uc900\ube44\uc790\uac00 \uc2e4\uc81c\ub85c \ud655\uc778\ud574\uc57c \ud560 \ud56d\ubaa9\uc744 \uc790\uaca9\uc99d\ubcc4\ub85c \ub098\ub208 \uac83\uc785\ub2c8\ub2e4.<\/p>\n<h2>\uc790\uaca9\uc99d\ubcc4 \uc900\ube44 \uad6c\uc870<\/h2>\n<table>\n<thead>\n<tr>\n<th>\uad6c\ubd84<\/th>\n<th>\ud655\uc778\ud560 \uac83<\/th>\n<th>4050 \uccb4\ud06c \ud3ec\uc778\ud2b8<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\uc900\ube44 \uad6c\uc870<\/td>\n<td>\uc774\ub860 \uacfc\ubaa9 + \ud604\uc7a5\uc2e4\uc2b5<\/td>\n<td>\uc2dc\ud5d8 \uacf5\ubd80\ubcf4\ub2e4 \ud559\uc2b5 \uc77c\uc815 \uad00\ub9ac\uac00 \uc911\uc694\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uac00\uc7a5 \uba3c\uc800 \ubcfc \uac83<\/td>\n<td>\ucd5c\uc885\ud559\ub825\uacfc \uc774\uc218 \uacfc\ubaa9<\/td>\n<td>\uc804\ubb38\ub300\uc878 \uc774\uc0c1\uc778\uc9c0, \ucd94\uac00 \uacfc\ubaa9\uc774 \ud544\uc694\ud55c\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc2e4\uc2b5 \ud3ec\uc778\ud2b8<\/td>\n<td>\uc2e4\uc2b5\uae30\uad00\uacfc \uc2e4\uc2b5 \uac00\ub2a5 \uc2dc\uac04<\/td>\n<td>\uc9c1\uc7a5\uc778\uc774\ub77c\uba74 \uc8fc\ub9d0 \uc2e4\uc2b5 \uac00\ub2a5 \uc5ec\ubd80\uac00 \uc911\uc694\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\ucde8\uc5c5 \uc5f0\uacb0<\/td>\n<td>\ubcf5\uc9c0\uad00, \uc694\uc591\uc2dc\uc124, \uc8fc\uac04\ubcf4\ud638\uc13c\ud130<\/td>\n<td>\uae30\uad00\ubcc4 \uc5c5\ubb34\uac00 \ub2ec\ub77c \uc6d0\ud558\ub294 \uadfc\ubb34 \ud615\ud0dc\ub97c \uba3c\uc800 \uc815\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\uc0ac\ud68c\ubcf5\uc9c0\uc0ac 2\uae09\uc740 \ubb38\uc81c\uc9d1\ubcf4\ub2e4 \uc77c\uc815\ud45c\uac00 \uba3c\uc800\uc785\ub2c8\ub2e4<\/h2>\n<p>\uc0ac\ud68c\ubcf5\uc9c0\uc0ac 2\uae09\uc740 \uad6d\uac00\uae30\uc220\uc790\uaca9\ucc98\ub7fc \ud544\uae30\uc2dc\ud5d8 \ud55c \ubc88\uc73c\ub85c \ub05d\ub098\ub294 \ubc29\uc2dd\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uacfc\ubaa9 \uc774\uc218, \uc2e4\uc2b5, \uc11c\ub958 \uc81c\ucd9c\uc774 \uc774\uc5b4\uc9c0\ubbc0\ub85c \ucc98\uc74c\ubd80\ud130 \ub2ec\ub825\uc5d0 \ud559\uae30, \uc2e4\uc2b5 \uac00\ub2a5 \uc2dc\uae30, \ube44\uc6a9 \ub0a9\ubd80 \uc2dc\uc810\uc744 \ud45c\uc2dc\ud574\ub450\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc2e4\uc2b5\uc740 \ub098\uc911\uc5d0 \uc0dd\uac01\ud558\uba74 \uac00\uc7a5 \ub9ce\uc774 \ub9c9\ud799\ub2c8\ub2e4<\/h2>\n<p>4050 \uc900\ube44\uc790\ub294 \uc9c1\uc7a5, \uac00\uc871 \ub3cc\ubd04, \uc774\ub3d9 \uac70\ub9ac \ub54c\ubb38\uc5d0 \uc2e4\uc2b5\uae30\uad00\uc744 \uad6c\ud558\ub294 \ub370 \uc2dc\uac04\uc774 \uac78\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uacfc\ubaa9 \uc218\uac15\uc744 \uc2dc\uc791\ud558\uae30 \uc804\ubd80\ud130 \uac70\uc8fc\uc9c0 \uadfc\ucc98 \uc2e4\uc2b5\uae30\uad00\uacfc \uc2e4\uc2b5 \uac00\ub2a5 \uc694\uc77c\uc744 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h2>\ubcf5\uc9c0 \ubd84\uc57c \ucde8\uc5c5\ucc98\ub97c \ubbf8\ub9ac \ub098\ub220 \ubcf4\uc138\uc694<\/h2>\n<p>\uc0ac\ud68c\ubcf5\uc9c0\uc0ac 2\uae09\uc740 \ubcf5\uc9c0\uad00, \uc694\uc591\uc2dc\uc124, \uc8fc\uac04\ubcf4\ud638\uc13c\ud130, \uc544\ub3d9\u00b7\uc7a5\uc560\uc778 \uad00\ub828 \uae30\uad00 \ub4f1 \ud65c\uc6a9\ucc98\uac00 \ub113\uc2b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uae30\uad00\ub9c8\ub2e4 \uc5c5\ubb34 \uac15\ub3c4\uc640 \ud589\uc815 \ube44\uc911\uc774 \ub2e4\ub974\ubbc0\ub85c \uc790\uaca9 \ucde8\ub4dd \ud6c4 \uc5b4\ub514\ub85c \uac08\uc9c0 \uba3c\uc800 \uc0dd\uac01\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h2>\ubb38\uc81c\uc9d1\u00b7\uac15\uc758\u00b7\ud559\uc6d0 \uc120\ud0dd \uae30\uc900<\/h2>\n<p>\ubb38\uc81c\uc9d1\uc740 \ucd5c\uc2e0 \ucd9c\uc81c\uae30\uc900 \ubc18\uc601 \uc5ec\ubd80\uc640 \ud574\uc124 \uc218\uc900\uc744 \uba3c\uc800 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \uc2e4\uae30\ud615 \uc790\uaca9\uc740 \uc0ac\uc9c4, \uc791\uc5c5 \uc21c\uc11c, \uac10\uc810 \uae30\uc900\uc774 \uc790\uc138\ud55c \uc790\ub8cc\uac00 \uc88b\uace0, \uad50\uc721 \uacfc\uc815\uc774 \ud544\uc694\ud55c \uc790\uaca9\uc740 \uc2e4\uc2b5 \uac00\ub2a5 \uc2dc\uac04\uacfc \uae30\uad00 \uc704\uce58\ub97c \ud568\uaed8 \ubd10\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<p>\ud559\uc6d0\uc744 \uc120\ud0dd\ud560 \ub54c\ub294 \uc218\uac15\ub8cc\ubcf4\ub2e4 \uc2e4\uc81c \uc5f0\uc2b5 \uc2dc\uac04\uc774 \ucda9\ubd84\ud55c\uc9c0, \uac15\uc0ac\uac00 \ud604\uc7a5 \uacbd\ud5d8\uc744 \uac16\uace0 \uc788\ub294\uc9c0, \uc218\ub8cc \ud6c4 \ucde8\uc5c5 \uc0c1\ub2f4\uc774\ub098 \ucc44\uc6a9 \uc815\ubcf4 \uc548\ub0b4\uac00 \uc788\ub294\uc9c0\ub97c \ud655\uc778\ud558\uc138\uc694. 4050\uc740 \uc2dc\uac04\uacfc \uccb4\ub825\uc758 \ud55c\uacc4\uac00 \uc788\uc73c\ubbc0\ub85c \uc9d1\uc5d0\uc11c \ub108\ubb34 \uba3c \uacfc\uc815\uc740 \uc911\ub3c4 \ud3ec\uae30 \uac00\ub2a5\uc131\uc774 \ucee4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uacf5\ubd80 \uacc4\ud68d \uc608\uc2dc<\/h2>\n<table>\n<thead>\n<tr>\n<th>\uae30\uac04<\/th>\n<th>\ud560 \uc77c<\/th>\n<th>\uc8fc\uc758\ud560 \uc810<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>1\uc8fc\ucc28<\/td>\n<td>\uc2dc\ud5d8 \uad6c\uc870\uc640 \uacf5\uc2dd \uc548\ub0b4 \ud655\uc778<\/td>\n<td>\uc751\uc2dc\uc790\uaca9, \uc2e4\uc2b5, \uad50\uc721 \uc774\uc218 \uc5ec\ubd80\ub97c \uba3c\uc800 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>2~3\uc8fc\ucc28<\/td>\n<td>\uae30\ucd08 \uac1c\ub150\uacfc \uae30\ucd9c \uc720\ud615 \uc815\ub9ac<\/td>\n<td>\ubaa8\ub974\ub294 \uc6a9\uc5b4\ub294 \ubcc4\ub3c4 \ub178\ud2b8\uc5d0 \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>4~6\uc8fc\ucc28<\/td>\n<td>\uae30\ucd9c \ubc18\ubcf5 \ub610\ub294 \uc2e4\uae30 \uc5f0\uc2b5<\/td>\n<td>\uc2e4\uae30\ud615 \uc790\uaca9\uc740 \uc2e4\uc81c \ub3c4\uad6c\uc640 \uc7a5\ube44\ub97c \uc368\ubd10\uc57c \ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc2dc\ud5d8 \uc804<\/td>\n<td>\uc624\ub2f5, \uac10\uc810 \uc694\uc18c, \uc900\ube44\ubb3c \ud655\uc778<\/td>\n<td>\uc0c8 \uc790\ub8cc\ubcf4\ub2e4 \uae30\uc874 \uc624\ub2f5\uacfc \uc2e4\uc218 \uc904\uc774\uae30\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<div class=\"guide-core-upgrade\">\n<h2>\uc2dc\uc791 \uc804 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h2>\n<ul>\n<li>\ucd5c\uc885\ud559\ub825 \uae30\uc900\uc744 \ud655\uc778\ud588\ub294\uac00<\/li>\n<li>\uc774\uc218\ud574\uc57c \ud560 \uacfc\ubaa9 \uc218\ub97c \ud655\uc778\ud588\ub294\uac00<\/li>\n<li>\ud604\uc7a5\uc2e4\uc2b5 \uac00\ub2a5\ud55c \uae30\uad00\uacfc \uc694\uc77c\uc744 \uc54c\uc544\ubd24\ub294\uac00<\/li>\n<li>\ucde8\ub4dd \ud6c4 \uc9c0\uc6d0\ud560 \ubcf5\uc9c0\uae30\uad00 \uc720\ud615\uc744 \uc815\ud588\ub294\uac00<\/li>\n<\/ul>\n<p>\uc790\uaca9\uc99d \uc2dc\ud5d8\uc77c\uc815\uacfc \uc138\ubd80 \uae30\uc900\uc740 \ubc14\ub014 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2e4\uc81c \uc811\uc218 \uc804\uc5d0\ub294 Q-Net, \uace0\uc6a924, HRD-Net, \uad00\ub828 \ud611\ud68c \ub610\ub294 \uad50\uc721\uae30\uad00\uc758 \ucd5c\uc2e0 \uc548\ub0b4\ub97c \ub2e4\uc2dc \ud655\uc778\ud558\uc138\uc694.<\/p>\n<\/div>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<h3>4050\ub3c4 \ub3c5\ud559\uc73c\ub85c \uc900\ube44\ud560 \uc218 \uc788\ub098\uc694?<\/h3>\n<p>\ud544\uae30 \uc911\uc2ec\uc774\uac70\ub098 \uae30\ucd9c \ubc18\ubcf5\ud615 \uc2dc\ud5d8\uc740 \ub3c5\ud559\uc73c\ub85c \uc2dc\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\ub9cc \uc2e4\uae30 \uc7a5\ube44, \ud604\uc7a5\uc2e4\uc2b5, \uad50\uc721 \uc774\uc218\uac00 \ud544\uc694\ud55c \uc790\uaca9\uc740 \ud559\uc6d0\uc774\ub098 \uacf5\uc2dd \uad50\uc721\uae30\uad00\uc744 \ud568\uaed8 \uac80\ud1a0\ud558\ub294 \uac83\uc774 \ud604\uc2e4\uc801\uc785\ub2c8\ub2e4.<\/p>\n<h3>\ubb38\uc81c\uc9d1\uc740 \ucd5c\uc2e0\ud310\uc774\uba74 \ucda9\ubd84\ud55c\uac00\uc694?<\/h3>\n<p>\ucd5c\uc2e0\ud310 \uc5ec\ubd80\ub294 \uae30\ubcf8\uc774\uace0, \ud574\uc124\uc774 \ucda9\ubd84\ud55c\uc9c0, \uc2e4\uae30 \uc0ac\uc9c4\uc774\ub098 \uc791\uc5c5 \uc21c\uc11c\uac00 \uc788\ub294\uc9c0, \ucd5c\uadfc \uae30\ucd9c\uc774 \ubc18\uc601\ub418\uc5b4 \uc788\ub294\uc9c0\ub97c \ud568\uaed8 \ubd10\uc57c \ud569\ub2c8\ub2e4. \ubcf8\uc778\uc758 \uae30\ucd08\uac00 \uc57d\ud558\ub2e4\uba74 \ud574\uc124\ud615 \uad50\uc7ac\uac00 \ub354 \ub0ab\uc2b5\ub2c8\ub2e4.<\/p>\n<h3>\uc790\uaca9\uc99d\uc744 \uba3c\uc800 \ub538\uc9c0, \uad6d\ube44\uc9c0\uc6d0 \uacfc\uc815\uc744 \uba3c\uc800 \ucc3e\uc744\uc9c0 \ud5f7\uac08\ub9bd\ub2c8\ub2e4<\/h3>\n<p>\uc2e4\uae30\ub098 \uc2e4\uc2b5\uc774 \ud544\uc694\ud55c \uc790\uaca9\uc740 \uad6d\ube44\uc9c0\uc6d0 \uacfc\uc815\uc744 \uba3c\uc800 \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \ubc18\ub300\ub85c \ud544\uae30 \uc911\uc2ec \uc790\uaca9\uc740 \ub3c5\ud559\uc73c\ub85c \uae30\ucd08\ub97c \uc7a1\uc740 \ub4a4 \ud544\uc694\ud55c \uacbd\uc6b0 \uacfc\uc815\uc774\ub098 \uac15\uc758\ub97c \ubcf4\uc644\ud574\ub3c4 \ub429\ub2c8\ub2e4.<\/p>\n<div class=\"guide-related-posts\">\n<h2>\ud568\uaed8 \ubcf4\uba74 \uc88b\uc740 \uae00<\/h2>\n<p>\uac19\uc740 \uc790\uaca9\uc99d\uc774\ub098 \uc778\uc811 \ubd84\uc57c\ub97c \uc774\uc5b4\uc11c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/4050guide.co.kr\/social-worker-level-2-4050\/\">\uc0ac\ud68c\ubcf5\uc9c0\uc0ac 2\uae09 4050 \uc900\ube44\ubc29\ubc95<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/social-worker-level-2-practice-checklist\/\">\uc0ac\ud68c\ubcf5\uc9c0\uc0ac 2\uae09 \uc2e4\uc2b5 \uc804 \ud655\uc778\ud560 \uac83<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/care-work-reemployment-guide-4050\/\">\ub3cc\ubd04 \ubd84\uc57c \uc7ac\ucde8\uc5c5 \uac00\uc774\ub4dc<\/a><\/li>\n<\/ul>\n<\/div>\n","protected":false},"excerpt":{"rendered":"<p>\uc0ac\ud68c\ubcf5\uc9c0\uc0ac 2\uae09\uc740 \ud544\uae30\uc2dc\ud5d8\uc744 \ub2e8\uae30\uac04\uc5d0 \ubcf4\ub294 \uc790\uaca9\uc99d\uc774 \uc544\ub2c8\ub77c \uacfc\ubaa9 \uc774\uc218\uc640 \ud604\uc7a5\uc2e4\uc2b5\uc744 \ucc28\uadfc\ucc28\uadfc \ucc44\uc6cc\uc57c \ud558\ub294 \uc790\uaca9\uc785\ub2c8\ub2e4. 4050 \uc900\ube44\uc790\ub294 \uad11\uace0 \ubb38\uad6c\ubcf4\ub2e4 \ud559\uc810\uc740\ud589\uc81c \uacfc\ubaa9, \uc2e4\uc2b5 \uac00\ub2a5 \uc2dc\uae30, \ube44\uc6a9, \ucde8\uc5c5\ucc98\ub97c \uba3c\uc800 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n","protected":false},"author":1,"featured_media":83,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[2],"tags":[],"class_list":["post-528","post","type-post","status-publish","f