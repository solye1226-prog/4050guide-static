{"id":239,"date":"2026-05-25T11:25:30","date_gmt":"2026-05-25T02:25:30","guid":{"rendered":"https:\/\/4050guide.co.kr\/senior-tailored-care-service-parents-guide\/"},"modified":"2026-05-26T18:38:17","modified_gmt":"2026-05-26T09:38:17","slug":"senior-tailored-care-service-parents-guide","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/senior-tailored-care-service-parents-guide\/","title":{"rendered":"\ubd80\ubaa8\ub2d8 \ub178\uc778\ub9de\ucda4\ub3cc\ubd04\uc11c\ube44\uc2a4 \ud655\uc778\ubc95: \uc2e0\uccad \ub300\uc0c1\uacfc \uc0c1\ub2f4 \uc804 \uc900\ube44\uc11c\ub958"},"content":{"rendered":"<p>\ub178\uc778\ub9de\ucda4\ub3cc\ubd04\uc11c\ube44\uc2a4\ub294 \ud63c\uc790 \uc0dd\ud65c\ud558\ub294 \uc5b4\ub974\uc2e0\uc774\ub098 \ub3cc\ubd04\uc774 \ud544\uc694\ud55c \uc5b4\ub974\uc2e0\uc5d0\uac8c \uc548\uc804 \ud655\uc778, \uc0dd\ud65c \uc9c0\uc6d0, \uc0ac\ud68c \ucc38\uc5ec \ub4f1\uc744 \uc81c\uacf5\ud558\ub294 \ubcf5\uc9c0 \uc11c\ube44\uc2a4\uc785\ub2c8\ub2e4. \ubd80\ubaa8\ub2d8\uc774 \ud63c\uc790 \uc9c0\ub0b4\uac70\ub098 \uc77c\uc0c1\uc0dd\ud65c\uc5d0 \ub3c4\uc6c0\uc774 \ud544\uc694\ud558\ub2e4\uba74 4050 \uc790\ub140\uac00 \uba3c\uc800 \ud655\uc778\ud574\ubcfc \ub9cc\ud55c \uc81c\ub3c4\uc785\ub2c8\ub2e4.<\/p>\n<h2>\uba3c\uc800 \ubcfc \ud575\uc2ec<\/h2>\n<ul>\n<li>\ubd80\ubaa8\ub2d8\uc758 \uc0dd\ud65c \uc0c1\ud0dc\uc640 \ub3cc\ubd04 \ud544\uc694\ub3c4\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc8fc\ubbfc\uc13c\ud130\ub098 \uc218\ud589\uae30\uad00 \uc0c1\ub2f4\uc744 \ud1b5\ud574 \ub300\uc0c1 \uc5ec\ubd80\ub97c \ubd05\ub2c8\ub2e4.<\/li>\n<li>\uae30\ucd08\uc5f0\uae08, \uc7a5\uae30\uc694\uc591 \ub4f1 \ub2e4\ub978 \uc81c\ub3c4\uc640 \uad6c\ubd84\ud569\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>\ub178\uc778\ub9de\ucda4\ub3cc\ubd04\uc11c\ube44\uc2a4 \ud655\uc778 \ud56d\ubaa9<\/h2>\n<table>\n<tbody>\n<tr>\n<th>\uad6c\ubd84<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<th>4050 \uccb4\ud06c \ud3ec\uc778\ud2b8<\/th>\n<\/tr>\n<tr>\n<td>\uc0dd\ud65c \uc0c1\ud0dc<\/td>\n<td>\ud63c\uc790 \uac70\uc8fc\ud558\ub294\uc9c0, \uc77c\uc0c1\uc0dd\ud65c\uc5d0 \uc5b4\ub824\uc6c0\uc774 \uc788\ub294\uc9c0 \ubd05\ub2c8\ub2e4.<\/td>\n<td>\uc790\ub140\uac00 \uc790\uc8fc \ubc29\ubb38\ud558\uae30 \uc5b4\ub824\uc6b4 \uacbd\uc6b0 \uc6b0\uc120 \ud655\uc778<\/td>\n<\/tr>\n<tr>\n<td>\uc11c\ube44\uc2a4 \ub0b4\uc6a9<\/td>\n<td>\uc548\uc804 \ud655\uc778, \uc0dd\ud65c\uad50\uc721, \uc0ac\ud68c\ucc38\uc5ec, \uc5f0\uacc4 \uc11c\ube44\uc2a4 \ub4f1\uc774 \uc788\uc2b5\ub2c8\ub2e4.<\/td>\n<td>\uc694\uc591\ubcf4\ud638\uc640 \uac19\uc740 \uc2e0\uccb4 \uc218\ubc1c \uc11c\ube44\uc2a4\uc640 \uad6c\ubd84<\/td>\n<\/tr>\n<tr>\n<td>\uc2e0\uccad \ucc3d\uad6c<\/td>\n<td>\uc8fc\ubbfc\uc13c\ud130 \ub610\ub294 \uc9c0\uc5ed \uc218\ud589\uae30\uad00\uc5d0\uc11c \uc0c1\ub2f4\ud569\ub2c8\ub2e4.<\/td>\n<td>\uc9c0\uc5ed\ubcc4 \uc6b4\uc601 \ubc29\uc2dd \ud655\uc778<\/td>\n<\/tr>\n<tr>\n<td>\ub2e4\ub978 \uc81c\ub3c4<\/td>\n<td>\uc7a5\uae30\uc694\uc591\ub4f1\uae09, \uae30\ucd08\uc5f0\uae08 \ub4f1\uacfc \uad00\uacc4\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<td>\uc911\ubcf5 \uac00\ub2a5 \uc5ec\ubd80 \uc0c1\ub2f4 \ud544\uc694<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\uc2e0\uccad \uc804 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h2>\n<ul>\n<li>\ubd80\ubaa8\ub2d8\uc758 \ud604\uc7ac \uac70\uc8fc \ud615\ud0dc\uc640 \uac74\uac15 \uc0c1\ud0dc\ub97c \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/li>\n<li>\ucd5c\uadfc \ubcd1\uc6d0 \uc774\uc6a9 \ub0b4\uc5ed\uc774\ub098 \ubcf5\uc6a9 \uc57d\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\ud63c\uc790 \uc2dd\uc0ac, \uc678\ucd9c, \uccad\uc18c\uac00 \uac00\ub2a5\ud55c\uc9c0 \uc0b4\ud3b4\ubd05\ub2c8\ub2e4.<\/li>\n<li>\uc8fc\ubbfc\uc13c\ud130\uc5d0 \ub300\uc0c1 \uc5ec\ubd80\uc640 \ud544\uc694 \uc11c\ub958\ub97c \ubb38\uc758\ud569\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>4050\uc5d0\uac8c \uc911\uc694\ud55c \ud310\ub2e8 \uae30\uc900<\/h2>\n<p>\ub178\uc778\ub9de\ucda4\ub3cc\ubd04\uc11c\ube44\uc2a4\ub294 \ubd80\ubaa8\ub2d8\uc774 \uac11\uc790\uae30 \ud070 \uc9c8\ubcd1\uc774 \uc0dd\uae34 \uacbd\uc6b0\ub9cc \ubcf4\ub294 \uc81c\ub3c4\uac00 \uc544\ub2d9\ub2c8\ub2e4. \ud63c\uc790 \uc0dd\ud65c\ud558\uba74\uc11c \uc548\uc804 \ud655\uc778\uc774 \ud544\uc694\ud558\uac70\ub098 \uc0ac\ud68c\uc801 \uace0\ub9bd\uc774 \uc6b0\ub824\ub418\ub294 \uacbd\uc6b0\uc5d0\ub3c4 \ud655\uc778\ud574\ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ub2e4\ub9cc \uc7a5\uae30\uc694\uc591\ubcf4\ud5d8\uc758 \ubc29\ubb38\uc694\uc591\uacfc\ub294 \ubaa9\uc801\uacfc \uae30\uc900\uc774 \ub2e4\ub985\ub2c8\ub2e4. \uc2e0\uccb4 \uc218\ubc1c\uc774 \ud544\uc694\ud55c \uacbd\uc6b0\ub77c\uba74 \uc7a5\uae30\uc694\uc591\ub4f1\uae09 \uc2e0\uccad\ub3c4 \ud568\uaed8 \uac80\ud1a0\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<p>4050 \uc790\ub140 \uc785\uc7a5\uc5d0\uc11c\ub294 \ubd80\ubaa8\ub2d8\uc774 \uc11c\ube44\uc2a4\ub97c \uc6d0\ud558\uc9c0 \uc54a\uc744 \uc218\ub3c4 \uc788\uc73c\ubbc0\ub85c, \u201c\uac10\uc2dc\u201d\uac00 \uc544\ub2c8\ub77c \u201c\uc548\uc804 \ud655\uc778\uacfc \uc0dd\ud65c \ub3c4\uc6c0\u201d\uc774\ub77c\ub294 \uad00\uc810\uc73c\ub85c \uc124\uba85\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<p><!-- guide4050-expanded --><\/p>\n<h2>\ub178\uc778\ub9de\ucda4\ub3cc\ubd04\uc11c\ube44\uc2a4\uc640 \uc7a5\uae30\uc694\uc591\uc758 \ucc28\uc774<\/h2>\n<p>\ub178\uc778\ub9de\ucda4\ub3cc\ubd04\uc11c\ube44\uc2a4\ub294 \uc5b4\ub974\uc2e0\uc758 \uc548\uc804 \ud655\uc778, \uc0dd\ud65c\uad50\uc721, \uc0ac\ud68c\ucc38\uc5ec, \uc11c\ube44\uc2a4 \uc5f0\uacc4\ub97c \ub3d5\ub294 \uc131\uaca9\uc774 \uac15\ud569\ub2c8\ub2e4. \ubc18\uba74 \uc7a5\uae30\uc694\uc591\ubcf4\ud5d8\uc740 \uc2e0\uccb4 \uae30\ub2a5 \uc800\ud558\ub85c \uc77c\uc0c1\uc0dd\ud65c\uc5d0 \ub3c4\uc6c0\uc774 \ud544\uc694\ud55c \uacbd\uc6b0 \ub4f1\uae09 \ud310\uc815\uc744 \ubc1b\uc544 \uc774\uc6a9\ud558\ub294 \uc81c\ub3c4\uc785\ub2c8\ub2e4.<\/p>\n<p>\ubd80\ubaa8\ub2d8\uc774 \ud63c\uc790 \uc9c0\ub0b4\uba74\uc11c \uc2dd\uc0ac\ub098 \uc678\ucd9c\uc740 \uac00\ub2a5\ud558\uc9c0\ub9cc \uc548\uc804 \ud655\uc778\uc774 \ud544\uc694\ud558\ub2e4\uba74 \ub178\uc778\ub9de\ucda4\ub3cc\ubd04\uc11c\ube44\uc2a4\ub97c \uba3c\uc800 \uc54c\uc544\ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubc18\ub300\ub85c \ubaa9\uc695, \uc774\ub3d9, \uc2dd\uc0ac \ub4f1 \uc2e0\uccb4 \uc218\ubc1c\uc774 \ud544\uc694\ud558\ub2e4\uba74 \uc7a5\uae30\uc694\uc591\ub4f1\uae09 \uc2e0\uccad\uc744 \ud568\uaed8 \uac80\ud1a0\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<p>\ub450 \uc81c\ub3c4\ub294 \ubaa9\uc801\uc774 \ub2e4\ub974\ubbc0\ub85c \uc5b4\ub290 \ud558\ub098\uac00 \ubb34\uc870\uac74 \ub354 \uc88b\uc740 \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4. \ubd80\ubaa8\ub2d8\uc758 \uc0c1\ud0dc\uc5d0 \ub530\ub77c \uc801\uc808\ud55c \uc81c\ub3c4\ub97c \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h2>\ubd80\ubaa8\ub2d8 \uc0c1\ud0dc\ubcc4 \ud655\uc778 \ubc29\ud5a5<\/h2>\n<table>\n<thead>\n<tr>\n<th>\uc0c1\ud0dc<\/th>\n<th>\uba3c\uc800 \ud655\uc778\ud560 \uc81c\ub3c4<\/th>\n<th>\uc0c1\ub2f4 \ud3ec\uc778\ud2b8<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\ud63c\uc790 \uac70\uc8fc\ud558\uace0 \uc678\ub85c\uc6c0\uc774 \ud07c<\/td>\n<td>\ub178\uc778\ub9de\ucda4\ub3cc\ubd04\uc11c\ube44\uc2a4<\/td>\n<td>\uc548\uc804 \ud655\uc778\uacfc \uc0ac\ud68c\ucc38\uc5ec \uac00\ub2a5 \uc5ec\ubd80<\/td>\n<\/tr>\n<tr>\n<td>\uac70\ub3d9\uc740 \uac00\ub2a5\ud558\uc9c0\ub9cc \uc2dd\uc0ac \uad00\ub9ac\uac00 \uc5b4\ub824\uc6c0<\/td>\n<td>\ub178\uc778\ub9de\ucda4\ub3cc\ubd04 \ub610\ub294 \uc9c0\uc790\uccb4 \uc11c\ube44\uc2a4<\/td>\n<td>\uc9c0\uc5ed \uc5f0\uacc4 \uc11c\ube44\uc2a4 \uc5ec\ubd80<\/td>\n<\/tr>\n<tr>\n<td>\uc774\ub3d9, \ubaa9\uc695, \uc2dd\uc0ac\uc5d0 \ub3c4\uc6c0\uc774 \ud544\uc694\ud568<\/td>\n<td>\uc7a5\uae30\uc694\uc591\ub4f1\uae09<\/td>\n<td>\ubc29\ubb38\uc694\uc591 \ub4f1\uae09 \uc2e0\uccad \uac00\ub2a5\uc131<\/td>\n<\/tr>\n<tr>\n<td>\uce58\ub9e4 \uc758\uc2ec \uc99d\uc0c1\uc774 \uc788\uc74c<\/td>\n<td>\uce58\ub9e4\uc548\uc2ec\uc13c\ud130 \uc0c1\ub2f4<\/td>\n<td>\uac80\uc0ac\uc640 \uac00\uc871 \uc0c1\ub2f4 \uc5f0\uacc4<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\uc790\ub140\uac00 \uc0c1\ub2f4\ud560 \ub54c \uc900\ube44\ud558\uba74 \uc88b\uc740 \uc9c8\ubb38<\/h2>\n<p>\uccab\uc9f8, \ubd80\ubaa8\ub2d8\uc774 \ud604\uc7ac \ubc1b\uc744 \uc218 \uc788\ub294 \ub3cc\ubd04 \uc11c\ube44\uc2a4\uac00 \ubb34\uc5c7\uc778\uc9c0 \ubb3c\uc5b4\ubd10\uc57c \ud569\ub2c8\ub2e4. \uac19\uc740 \uc9c0\uc5ed \uc548\uc5d0\uc11c\ub3c4 \uc218\ud589\uae30\uad00\uacfc \uc9c0\uc6d0 \ub0b4\uc6a9\uc774 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ub458\uc9f8, \ub2e4\ub978 \ubcf5\uc9c0 \uc11c\ube44\uc2a4\uc640 \uc911\ubcf5 \uc774\uc6a9\uc774 \uac00\ub2a5\ud55c\uc9c0 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \uae30\ucd08\uc5f0\uae08, \uc7a5\uae30\uc694\uc591, \uc9c0\uc790\uccb4 \ub3cc\ubd04 \uc0ac\uc5c5\uacfc \uad00\uacc4\uac00 \uc788\uc744 \uc218 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4.<\/p>\n<p>\uc14b\uc9f8, \uc11c\ube44\uc2a4\uac00 \uc2dc\uc791\ub418\uae30\uae4c\uc9c0 \uac78\ub9ac\ub294 \uae30\uac04\uacfc \ub2f4\ub2f9 \uc0dd\ud65c\uc9c0\uc6d0\uc0ac\uac00 \uc5b4\ub5a4 \ubc29\uc2dd\uc73c\ub85c \ubc29\ubb38\ud558\uac70\ub098 \uc5f0\ub77d\ud558\ub294\uc9c0 \ud655\uc778\ud558\uba74 \ubd80\ubaa8\ub2d8\uaed8 \uc124\uba85\ud558\uae30 \uc27d\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uacf5\uc2dd \ud655\uc778\ucc98<\/h2>\n<p>\uc81c\ub3c4\uba85\uacfc \uc2e0\uccad \uc870\uac74\uc740 \uc218\uc2dc\ub85c \ubc14\ub014 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2e4\uc81c \uc2e0\uccad \uc804\uc5d0\ub294 \uc544\ub798 \uacf5\uc2dd \ud398\uc774\uc9c0\uc5d0\uc11c \ucd5c\uc2e0 \uc548\ub0b4\ub97c \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/www.bokjiro.go.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\ubcf5\uc9c0\ub85c<\/a><\/li>\n<li><a href=\"https:\/\/www.gov.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\uc815\ubd8024<\/a><\/li>\n<\/ul>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<h3>\uc790\ub140\uac00 \ub300\uc2e0 \uc2e0\uccad\ud560 \uc218 \uc788\ub098\uc694?<\/h3>\n<p>\uc0c1\ub2f4\uacfc \ubb38\uc758\ub294 \uac00\ub2a5\ud558\uc9c0\ub9cc \uc2e4\uc81c \uc2e0\uccad \uc808\ucc28\uc5d0\uc11c\ub294 \ubcf8\uc778 \ud655\uc778\uacfc \ub3d9\uc758\uac00 \ud544\uc694\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h3>\uc7a5\uae30\uc694\uc591\ub4f1\uae09\uacfc \uac19\uc740 \uc81c\ub3c4\uc778\uac00\uc694?<\/h3>\n<p>\ub2e4\ub985\ub2c8\ub2e4. \uc7a5\uae30\uc694\uc591\uc740 \uc2e0\uccb4 \uae30\ub2a5\uacfc \uc694\uc591 \ud544\uc694\ub3c4\ub97c \uae30\uc900\uc73c\ub85c \ud558\uace0, \ub178\uc778\ub9de\ucda4\ub3cc\ubd04\uc740 \uc548\uc804 \ud655\uc778\uacfc \uc0dd\ud65c \uc9c0\uc6d0 \uc131\uaca9\uc774 \uac15\ud569\ub2c8\ub2e4.<\/p>\n<p><strong>\uc548\ub0b4:<\/strong> \uc774 \uae00\uc740 4050 \uc138\ub300\uac00 \uc81c\ub3c4\uc640 \uc790\uaca9 \uc815\ubcf4\ub97c \ube60\ub974\uac8c \uc774\ud574\ud558\ub3c4\ub85d \ub3d5\uae30 \uc704\ud55c \uc815\ub9ac \uae00\uc785\ub2c8\ub2e4. \ucd5c\uc885 \uc2e0\uccad \uac00\ub2a5 \uc5ec\ubd80\uc640 \uae08\uc561, \uc77c\uc815\uc740 \uac1c\uc778 \uc870\uac74\uacfc \uacf5\uc2dd \uae30\uad00\uc758 \ucd5c\uc2e0 \uc548\ub0b4\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p><!-- guide4050-related-start --><\/p>\n<section class=\"guide-related-posts\">\n<h2>\ud568\uaed8 \ubcf4\uba74 \uc88b\uc740 \uae00<\/h2>\n<p>\uc774 \uae00\uacfc \uc774\uc5b4\uc11c \ud655\uc778\ud558\uba74 \uc88b\uc740 4050 \ub9de\ucda4 \uc815\ubcf4\uc785\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/4050guide.co.kr\/basic-pension-income-recognition-check\/\">\uae30\ucd08\uc5f0\uae08 \uc2e0\uccad \uc804 \ud655\uc778\ud560 \uac83: \uc18c\ub4dd\uc778\uc815\uc561\uacfc \ud0c8\ub77d \uc0ac\uc720 \uc27d\uac8c \uc815\ub9ac<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/summer-2026-energy-voucher-parent-checklist\/\">2026 \uc5ec\ub984 \uc5d0\ub108\uc9c0\ubc14\uc6b0\ucc98 \ubd80\ubaa8\ub2d8 \ub300\uc2e0 \ud655\uc778\ud560 \uac83: \ub300\uc0c1, \uc2e0\uccad\ucc98, \uc0ac\uc6a9\ucc98<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/senior-job-program-application-guide\/\">\ub178\uc778\uc77c\uc790\ub9ac \uc2e0\uccad\ubc29\ubc95: \ubd80\ubaa8\ub2d8 \uc77c\uc790\ub9ac\uc640 \uc0ac\ud68c\ud65c\ub3d9 \uc9c0\uc6d0\uc0ac\uc5c5 \ud655\uc778<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/dementia-test-cost-support-guide\/\">\uce58\ub9e4\uac80\uc0ac\ube44 \uc9c0\uc6d0 \ud655\uc778\ubc29\ubc95: \ubcf4\uac74\uc18c \uc0c1\ub2f4 \uc804 \uc900\ube44\ud560 \uac83<\/a><\/li>\n<\/ul>\n<\/section>\n<p><!-- guide4050-related-end --><\/p>\n<p><!-- 4050_SHORT_UPLIFT_START --><\/p>\n<section class=\"guide-short-uplift\">\n<h2>\ubcf5\uc9c0\uc81c\ub3c4 \ud655\uc778 \uc804 \uc900\ube44\ud560 \uac83<\/h2>\n<p>\ubcf5\uc9c0\uc81c\ub3c4\ub294 \uc774\ub984\uc774 \ube44\uc2b7\ud574\ub3c4 \ub300\uc0c1, \uc18c\ub4dd\u00b7\uc7ac\uc0b0 \uae30\uc900, \uc2e0\uccad\ucc98\uac00 \ub2e4\ub985\ub2c8\ub2e4. \ubd80\ubaa8\ub2d8 \ub300\uc2e0 \uc54c\uc544\ubcf4\ub294 \uacbd\uc6b0\ub77c\uba74 \uc0dd\ub144\uc6d4\uc77c, \uc18c\ub4dd, \uc7ac\uc0b0, \uac70\uc8fc\uc9c0, \uac74\uac15 \uc0c1\ud0dc\ub97c \uba3c\uc800 \uc815\ub9ac\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<figure class=\"wp-block-table\">\n<table>\n<tr>\n<th>\ud655\uc778 \uc21c\uc11c<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<th>\ud310\ub2e8 \uae30\uc900<\/th>\n<\/tr>\n<tr>\n<td>1\ub2e8\uacc4<\/td>\n<td>\ub300\uc0c1 \uc870\uac74<\/td>\n<td>\ub098\uc774, \uac00\uad6c \ud615\ud0dc, \uac74\uac15 \uc0c1\ud0dc\ub97c \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>2\ub2e8\uacc4<\/td>\n<td>\uc18c\ub4dd\u00b7\uc7ac\uc0b0<\/td>\n<td>\ubcf8\uc778\ubfd0 \uc544\ub2c8\ub77c \uac00\uad6c \uae30\uc900\uc778\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>3\ub2e8\uacc4<\/td>\n<td>\uc2e0\uccad\ucc98<\/td>\n<td>\ubcf5\uc9c0\ub85c, \uc8fc\ubbfc\uc13c\ud130, \ubcf4\uac74\uc18c \uc911 \uc5b4\ub514\uc778\uc9c0 \uad6c\ubd84\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>4\ub2e8\uacc4<\/td>\n<td>\uc900\ube44\uc11c\ub958<\/td>\n<td>\uc2e0\ubd84\uc99d, \ud1b5\uc7a5, \uc9c4\ub2e8\uc11c, \uac00\uc871\uad00\uacc4 \uc11c\ub958 \ud544\uc694 \uc5ec\ubd80\ub97c \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/table>\n<\/figure>\n<h3>\ube60\ub978 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h3>\n<ul>\n<li>\uc804\ud654 \uc0c1\ub2f4 \uc804 \uc8fc\ubbfc\ub4f1\ub85d\uc0c1 \uc8fc\uc18c\uc9c0\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\ub300\ub9ac \uc2e0\uccad \uac00\ub2a5 \uc5ec\ubd80\ub97c \uba3c\uc800 \ubb3c\uc5b4\ubd05\ub2c8\ub2e4.<\/li>\n<li>\ud0c8\ub77d\ud558\ub354\ub77c\ub3c4 \ub2e4\ub978 \uc720\uc0ac \uc81c\ub3c4\ub97c \ud568\uaed8 \ubb38\uc758\ud569\ub2c8\ub2e4.<\/li>\n<\/ul>\n<p>\uc704 \ub0b4\uc6a9\uc740 \uae30\ubcf8 \ud310\ub2e8 \uae30\uc900\uc774\uba70, \uc2e4\uc81c \uc2e0\uccad\uc774\ub098 \uc811\uc218 \uc804\uc5d0\ub294 \uacf5\uc2dd \uae30\uad00\uc758 \ucd5c\uc2e0 \uc548\ub0b4\ub97c \ub2e4\uc2dc \ud655\uc778\ud558\ub294 \uac83\uc774 \uc548\uc804\ud569\ub2c8\ub2e4.<\/p>\n<\/section>\n<p><!-- 4050_SHORT_UPLIFT_END --><\/p>\n","protected":false},"excerpt":{"rendered":"<p>\ub178\uc778\ub9de\ucda4\ub3cc\ubd04\uc11c\ube44\uc2a4\ub294 \ud63c\uc790 \uc0dd\ud65c\ud558\ub294 \uc5b4\ub974\uc2e0\uc774\ub098 \ub3cc\ubd04\uc774 \ud544\uc694\ud55c \uc5b4\ub974\uc2e0\uc5d0\uac8c \uc548\uc804 \ud655\uc778, \uc0dd\ud65c \uc9c0\uc6d0, \uc0ac\ud68c \ucc38\uc5ec \ub4f1\uc744 \uc81c\uacf5\ud558\ub294 \ubcf5\uc9c0 \uc11c\ube44\uc2a4\uc785\ub2c8\ub2e4. \ubd80\ubaa8\ub2d8\uc774 \ud63c\uc790 \uc9c0\ub0b4\uac70\ub098 \uc77c\uc0c1\uc0dd\ud65c\uc5d0 \ub3c4\uc6c0\uc774 \ud544\uc694\ud558\ub2e4\uba74 4050 \uc790\ub140\uac00 \uba3c\uc800 \ud655\uc778\ud574\ubcfc \ub9cc\ud55c \uc81c\ub3c4\uc785\ub2c8\ub2e4. \uba3c\uc800 \ubcfc \ud575\uc2ec \ubd80\ubaa8\ub2d8\uc758 \uc0dd\ud65c \uc0c1\ud0dc\uc640 \ub3cc\ubd04 \ud544\uc694\ub3c4\ub97c \ud655\uc778\ud569\ub2c8\ub2e4. \uc8fc\ubbfc\uc13c\ud130\ub098 \uc218\ud589\uae30\uad00 \uc0c1\ub2f4\uc744 \ud1b5\ud574 \ub300\uc0c1 \uc5ec\ubd80\ub97c \ubd05\ub2c8\ub2e4. \uae30\ucd08\uc5f0\uae08, \uc7a5\uae30\uc694\uc591 \ub4f1 \ub2e4\ub978 \uc81c\ub3c4\uc640 \uad6c\ubd84\ud569\ub2c8\ub2e4. \ub178\uc778\ub9de\ucda4\ub3cc\ubd04\uc11c\ube44\uc2a4 \ud655\uc778 \ud56d\ubaa9 \uad6c\ubd84 [&hellip;]<\/p>\n","protected":false},"author":0,"featured_media":216,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[8],"tags":[],"class_list":["post-239","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-welfare"],"_links":{"self":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts\/239","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/types\/post"}],"replies":[{"embeddable":true,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/comments?post=239"}],"version-history":[{"count":5,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts\/239\/revisions"}],"predecessor-version":[{"id":452,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts\/239\/revisions\/452"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/media\/216"}],"wp:attachment":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/media?parent=239"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/categories?post=239"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/tags?post=239"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}