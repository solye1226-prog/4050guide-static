{"id":93,"date":"2026-05-18T23:06:03","date_gmt":"2026-05-18T14:06:03","guid":{"rendered":"https:\/\/4050guide.co.kr\/housing-benefit-eligibility-2026\/"},"modified":"2026-05-26T18:38:19","modified_gmt":"2026-05-26T09:38:19","slug":"housing-benefit-eligibility-2026","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/housing-benefit-eligibility-2026\/","title":{"rendered":"\uc8fc\uac70\uae09\uc5ec \uc2e0\uccad\uc870\uac74 2026: \uc784\ucc28\uae09\uc5ec\uc640 \uc218\uc120\uc720\uc9c0\uae09\uc5ec \ucc28\uc774"},"content":{"rendered":"<figure class=\"wp-block-image size-large\"><img decoding=\"async\" src=\"\/wp-content\/uploads\/2026\/05\/government-benefit-photo.png\" alt=\"\uc8fc\uac70\uae09\uc5ec \uc2e0\uccad \uc870\uac74\uc744 \ud655\uc778\ud558\ub294 \ubaa8\uc2b5\"><\/figure>\n<p>\uc8fc\uac70\uae09\uc5ec\ub294 \uc800\uc18c\ub4dd \uac00\uad6c\uc758 \uc8fc\uac70\ube44 \ubd80\ub2f4\uc744 \uc904\uc774\uae30 \uc704\ud55c \uc81c\ub3c4\uc785\ub2c8\ub2e4. \uc784\ucc28\uac00\uad6c\ub294 \uc784\ucc28\uae09\uc5ec, \uc790\uac00\uac00\uad6c\ub294 \uc218\uc120\uc720\uc9c0\uae09\uc5ec\uc640 \uad00\ub828\ub420 \uc218 \uc788\uc5b4 \ubcf8\uc778\uc758 \uac70\uc8fc \ud615\ud0dc\uc5d0 \ub530\ub77c \ud655\uc778\ud560 \ub0b4\uc6a9\uc774 \ub2ec\ub77c\uc9d1\ub2c8\ub2e4.<\/p>\n<h2>\uc8fc\uac70\uae09\uc5ec \ud575\uc2ec \uc694\uc57d<\/h2>\n<table>\n<thead>\n<tr>\n<th>\uad6c\ubd84<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\uc784\ucc28\uac00\uad6c<\/td>\n<td>\uc804\uc6d4\uc138 \ub4f1 \uc784\ucc28\ub8cc \uc9c0\uc6d0 \uc5ec\ubd80 \ud655\uc778<\/td>\n<\/tr>\n<tr>\n<td>\uc790\uac00\uac00\uad6c<\/td>\n<td>\uc8fc\ud0dd \ub178\ud6c4\ub3c4\uc5d0 \ub530\ub978 \uc218\uc120\uc720\uc9c0\uae09\uc5ec \ud655\uc778<\/td>\n<\/tr>\n<tr>\n<td>\uc2e0\uccad\ucc98<\/td>\n<td>\uc8fc\ubbfc\uc13c\ud130, \ubcf5\uc9c0\ub85c<\/td>\n<\/tr>\n<tr>\n<td>\uc2ec\uc0ac<\/td>\n<td>\uc18c\ub4dd\uc778\uc815\uc561, \uac00\uad6c\uc6d0, \uc8fc\uac70 \ud615\ud0dc, \uc784\ub300\ucc28 \uc815\ubcf4<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\uc784\ucc28\uae09\uc5ec\uc640 \uc218\uc120\uc720\uc9c0\uae09\uc5ec \ucc28\uc774<\/h2>\n<p>\uc804\uc138\ub098 \uc6d4\uc138\ub85c \uac70\uc8fc\ud558\ub294 \uacbd\uc6b0\uc5d0\ub294 \uc784\ucc28\uae09\uc5ec\ub97c \ud655\uc778\ud569\ub2c8\ub2e4. \ubc18\uba74 \ubcf8\uc778 \uc18c\uc720 \uc8fc\ud0dd\uc5d0 \uac70\uc8fc\ud558\ub294 \uacbd\uc6b0\uc5d0\ub294 \uc9d1\uc218\ub9ac\uc640 \uad00\ub828\ub41c \uc218\uc120\uc720\uc9c0\uae09\uc5ec \ub300\uc0c1 \uc5ec\ubd80\ub97c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc2e0\uccad \uc804 \uc900\ube44\ud560 \uc790\ub8cc<\/h2>\n<ul>\n<li>\uc2e0\ubd84\uc99d<\/li>\n<li>\uc784\ub300\ucc28\uacc4\uc57d\uc11c \ub610\ub294 \uc8fc\uac70 \uad00\ub828 \uc790\ub8cc<\/li>\n<li>\uac00\uad6c\uc6d0\uacfc \uc18c\ub4dd \uad00\ub828 \uc790\ub8cc<\/li>\n<li>\ud1b5\uc7a5 \uc0ac\ubcf8 \ub4f1 \uc9c0\uae09 \uad00\ub828 \uc790\ub8cc<\/li>\n<li>\uc790\uac00\uac00\uad6c\uc758 \uacbd\uc6b0 \uc8fc\ud0dd \uc0c1\ud0dc \ud655\uc778 \uc790\ub8cc<\/li>\n<\/ul>\n<h2>4050 \uc138\ub300\uac00 \ud655\uc778\ud560 \uc810<\/h2>\n<p>\ud1f4\uc9c1, \uc18c\ub4dd \uac10\uc18c, \uac00\uc871 \ubd84\ub9ac, \ubd80\ubaa8\ub2d8 \ubd80\uc591 \ub4f1\uc73c\ub85c \uac00\uad6c \uc0c1\ud669\uc774 \ubc14\ub00c\uba74 \uc8fc\uac70\uae09\uc5ec \ub300\uc0c1 \uc5ec\ubd80\ub3c4 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\uc804\uc5d0 \ub300\uc0c1\uc774 \uc544\ub2c8\uc5c8\ub2e4\uace0 \ud574\uc11c \uacc4\uc18d \ubd88\uac00\ub2a5\ud558\ub2e4\uace0 \ub2e8\uc815\ud558\uc9c0 \ub9d0\uace0 \ud604\uc7ac \uae30\uc900\uc73c\ub85c \ub2e4\uc2dc \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc2e0\uccad \uc21c\uc11c<\/h2>\n<ol>\n<li>\ubcf5\uc9c0\ub85c \ub610\ub294 \uc8fc\ubbfc\uc13c\ud130\uc5d0\uc11c \ub300\uc0c1 \uac00\ub2a5\uc131\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uac70\uc8fc \ud615\ud0dc\uc640 \uc784\ub300\ucc28 \uc815\ubcf4\ub97c \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc18c\ub4dd\uacfc \uc7ac\uc0b0 \uad00\ub828 \uc790\ub8cc\ub97c \uc900\ube44\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc2e0\uccad \ud6c4 \uc870\uc0ac\uc640 \uc2ec\uc0ac \uacb0\uacfc\ub97c \uae30\ub2e4\ub9bd\ub2c8\ub2e4.<\/li>\n<li>\uacb0\uacfc\uc5d0 \ub530\ub77c \uc784\ucc28\uae09\uc5ec \ub610\ub294 \uc218\uc120\uc720\uc9c0\uae09\uc5ec \ub0b4\uc6a9\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<\/ol>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<h3>\uc790\uac00 \uc8fc\ud0dd\uc774 \uc788\uc73c\uba74 \uc8fc\uac70\uae09\uc5ec\ub97c \ubabb \ubc1b\ub098\uc694?<\/h3>\n<p>\uc790\uac00\uac00\uad6c\ub3c4 \uc218\uc120\uc720\uc9c0\uae09\uc5ec\uc640 \uad00\ub828\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\ub9cc \uc18c\ub4dd\uc778\uc815\uc561\uacfc \uc8fc\ud0dd \uc0c1\ud0dc \ub4f1 \uc2ec\uc0ac\uac00 \ud544\uc694\ud569\ub2c8\ub2e4.<\/p>\n<h3>\uc6d4\uc138 \uacc4\uc57d\uc11c\uac00 \uaf2d \ud544\uc694\ud55c\uac00\uc694?<\/h3>\n<p>\uc784\ucc28\ub8cc \ud655\uc778\uc744 \uc704\ud574 \uc784\ub300\ucc28\uacc4\uc57d\uc11c \ub4f1 \uc8fc\uac70 \uad00\ub828 \uc790\ub8cc\uac00 \uc911\uc694\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc0c1\ud669\uc5d0 \ub530\ub77c \uc8fc\ubbfc\uc13c\ud130 \uc548\ub0b4\ub97c \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h3>\uae30\ucd08\uc0dd\ud65c\ubcf4\uc7a5 \ub2e4\ub978 \uae09\uc5ec\uc640 \ud568\uaed8 \ubcfc \uc218 \uc788\ub098\uc694?<\/h3>\n<p>\uc8fc\uac70\uae09\uc5ec\ub294 \ubcf5\uc9c0\uc81c\ub3c4\uc640 \ud568\uaed8 \uac80\ud1a0\ub420 \uc218 \uc788\uc73c\ub098, \uac1c\uc778\ubcc4 \uc18c\ub4dd\u00b7\uc7ac\uc0b0\u00b7\uac00\uad6c \uc870\uac74\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4.<\/p>\n<h2>\uacf5\uc2dd \ucd9c\ucc98<\/h2>\n<p>\uc8fc\uac70\uae09\uc5ec \uae30\uc900\uc740 \ud574\ub9c8\ub2e4 \ubc14\ub014 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2e4\uc81c \uc2e0\uccad \uc804 \ubcf5\uc9c0\ub85c\uc640 \uac70\uc8fc\uc9c0 \uc8fc\ubbfc\uc13c\ud130\uc758 \ucd5c\uc2e0 \uc548\ub0b4\ub97c \ud655\uc778\ud558\uc138\uc694.<\/p>\n<p><a href=\"https:\/\/www.bokjiro.go.kr\" target=\"_blank\" rel=\"noopener\">\ubcf5\uc9c0\ub85c \uacf5\uc2dd \ud648\ud398\uc774\uc9c0<\/a><\/p>\n<p><!-- guide4050-depth-expand --><\/p>\n<h2>4050 \uae30\uc900\uc73c\ub85c \uba3c\uc800 \ud310\ub2e8\ud560 \ubd80\ubd84<\/h2>\n<p>\uc8fc\uac70\uae09\uc5ec \uc2e0\uccad\uc870\uac74 2026: \uc784\ucc28\uae09\uc5ec\uc640 \uc218\uc120\uc720\uc9c0\uae09\uc5ec \ucc28\uc774\ub97c \ud655\uc778\ud560 \ub54c\ub294 \ub2e8\uc21c\ud788 \uc774\ub984\ub9cc \ubcf4\uace0 \uacb0\uc815\ud558\uae30\ubcf4\ub2e4 \ub0b4 \uc0c1\ud669\uc5d0 \uc2e4\uc81c\ub85c \ub9de\ub294\uc9c0\ubd80\ud130 \ubcf4\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. 40\ub300\uc640 50\ub300\ub294 \uc774\ubbf8 \uc9c1\uc7a5 \uacbd\ud5d8, \uac00\uc871 \ubd80\uc591, \uac74\uac15\ubcf4\ud5d8\ub8cc, \ud1f4\uc9c1 \uc77c\uc815, \ubd80\ubaa8\ub2d8 \ub3cc\ubd04 \uac19\uc740 \uc870\uac74\uc774 \ud568\uaed8 \uc6c0\uc9c1\uc774\ub294 \uacbd\uc6b0\uac00 \ub9ce\uae30 \ub54c\ubb38\uc5d0 \uac19\uc740 \uc81c\ub3c4\ub77c\ub3c4 \uccb4\uac10\ub418\ub294 \uc720\ub9ac\ud568\uc774 \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ud2b9\ud788 \uc2e0\uccad\ud615 \uc81c\ub3c4\ub098 \uc790\uaca9\uc99d \uc815\ubcf4\ub294 \uad11\uace0 \ubb38\uad6c\ubcf4\ub2e4 \uacf5\uc2dd \uc870\uac74\uacfc \uc2e4\uc81c \ud65c\uc6a9\ucc98\ub97c \ud568\uaed8 \ubd10\uc57c \ud569\ub2c8\ub2e4. \uc9c0\uc6d0 \ub300\uc0c1, \uc2e0\uccad \uae30\uac04, \uc900\ube44\uc11c\ub958, \ubcf8\uc778\ubd80\ub2f4 \uc5ec\ubd80, \uc0c1\ub2f4 \ucc3d\uad6c\ub97c \uba3c\uc800 \ud655\uc778\ud558\uba74 \uc2dc\uac04\uc744 \uc904\uc77c \uc218 \uc788\uace0, \uc2e0\uccad \ud6c4 \ud0c8\ub77d\ud558\uac70\ub098 \uacfc\uc815 \uc218\ub8cc \ud6c4 \ud65c\uc6a9\ud558\uc9c0 \ubabb\ud558\ub294 \uc0c1\ud669\uc744 \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc9c0\uc6d0\uae08 \uc2e0\uccad \uc804 \ud655\uc778 \uc21c\uc11c<\/h2>\n<table>\n<thead>\n<tr>\n<th>\ud655\uc778 \uc21c\uc11c<\/th>\n<th>\ub0b4\uc6a9<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\ub300\uc0c1<\/td>\n<td>\ub098\uc774, \uc18c\ub4dd, \uc7ac\uc0b0, \uac00\uad6c \ud615\ud0dc \uae30\uc900\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uae30\uac04<\/td>\n<td>\uc0c1\uc2dc \uc2e0\uccad\uc778\uc9c0, \uc815\uae30 \uc2e0\uccad\uc778\uc9c0, \uae30\ud55c \ud6c4 \uc2e0\uccad\uc774 \uac00\ub2a5\ud55c\uc9c0 \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc11c\ub958<\/td>\n<td>\uc18c\ub4dd\uc790\ub8cc, \uac00\uc871\uad00\uacc4, \ud1b5\uc7a5, \uc784\ub300\ucc28\uacc4\uc57d\uc11c \ub4f1 \ud544\uc694\ud55c \uc11c\ub958\ub97c \ubbf8\ub9ac \uc900\ube44\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc2e0\uccad\ucc98<\/td>\n<td>\uc815\ubd8024, \ubcf5\uc9c0\ub85c, \uc8fc\ubbfc\uc13c\ud130, \uad00\ud560 \uae30\uad00 \uc911 \uc5b4\ub514\uc5d0\uc11c \uc2e0\uccad\ud558\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p>\uc9c0\uc6d0\uae08\uc740 \uc870\uac74\uc774 \ub9de\uc544\ub3c4 \uc2e0\uccad\ud558\uc9c0 \uc54a\uc73c\uba74 \ubc1b\uc744 \uc218 \uc5c6\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \ubd80\ubaa8\ub2d8 \ub300\uc2e0 \uc54c\uc544\ubcf4\ub294 \uacbd\uc6b0\uc5d0\ub294 \ubcf8\uc778 \uc778\uc99d, \uc704\uc784, \uac00\uc871\uad00\uacc4 \ud655\uc778\uc774 \ud544\uc694\ud560 \uc218 \uc788\uc73c\ubbc0\ub85c \uacf5\uc2dd \uc548\ub0b4\ub97c \uba3c\uc800 \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc0c1\ub2f4 \uc804 \uba54\ubaa8\ud574\ub450\uba74 \uc88b\uc740 \uc9c8\ubb38<\/h2>\n<ul>\n<li>\ub0b4 \ub098\uc774\uc640 \uace0\uc6a9 \uc0c1\ud0dc\uc5d0\uc11c \uc2e0\uccad \uac00\ub2a5\ud55c\uac00\uc694?<\/li>\n<li>\uc18c\ub4dd, \uc7ac\uc0b0, \uacbd\ub825 \ub54c\ubb38\uc5d0 \uc81c\uc678\ub420 \uc218 \uc788\ub294 \uc870\uac74\uc774 \uc788\ub098\uc694?<\/li>\n<li>\uc628\ub77c\uc778 \uc2e0\uccad\uacfc \ubc29\ubb38 \uc2e0\uccad \uc911 \uc5b4\ub5a4 \ubc29\uc2dd\uc774 \ube60\ub978\uac00\uc694?<\/li>\n<li>\uc2e0\uccad \ud6c4 \uacb0\uacfc \ud655\uc778\uae4c\uc9c0 \ubcf4\ud1b5 \uc5bc\ub9c8\ub098 \uac78\ub9ac\ub098\uc694?<\/li>\n<li>\ube44\uc2b7\ud55c \uc81c\ub3c4\ub098 \uacfc\uc815\uacfc \uc911\ubcf5 \uc774\uc6a9\uc774 \uac00\ub2a5\ud55c\uac00\uc694?<\/li>\n<\/ul>\n<p>\uc774 \uc9c8\ubb38\uc744 \ubbf8\ub9ac \uc815\ub9ac\ud574\ub450\uba74 \uc0c1\ub2f4 \uc2dc\uac04\uc774 \uc9e7\uc544\uc9c0\uace0, \ub2f4\ub2f9\uc790\uc5d0\uac8c \ud544\uc694\ud55c \uc815\ubcf4\ub97c \ube60\ub974\uac8c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \uac00\uc871 \ub300\uc2e0 \uc54c\uc544\ubcf4\ub294 \uacbd\uc6b0\uc5d0\ub294 \ub2f9\uc0ac\uc790\uc758 \uc0dd\ub144\uc6d4\uc77c, \uac70\uc8fc\uc9c0, \uc18c\ub4dd \uc0c1\ud0dc, \uac74\uac15 \uc0c1\ud0dc\ucc98\ub7fc \uae30\ubcf8 \uc815\ubcf4\ub97c \uc900\ube44\ud574\ub450\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<p><!-- guide4050-related-start --><\/p>\n<section class=\"guide-related-posts\">\n<h2>\ud568\uaed8 \ubcf4\uba74 \uc88b\uc740 \uae00<\/h2>\n<p>\uc774 \uae00\uacfc \uc774\uc5b4\uc11c \ud655\uc778\ud558\uba74 \uc88b\uc740 4050 \ub9de\ucda4 \uc815\ubcf4\uc785\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/4050guide.co.kr\/june-2026-4050-benefit-welfare-checklist\/\">2026\ub144 6\uc6d4 4050 \uc815\ubd80\uc9c0\uc6d0\uae08\u00b7\ubcf5\uc9c0 \uc2e0\uccad \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/earned-child-tax-credit-june-2026-check\/\">2026 \uadfc\ub85c\u00b7\uc790\ub140\uc7a5\ub824\uae08 6\uc6d4 1\uc77c \uc804\ud6c4 \ud655\uc778\ud560 \uac83: \uc2e0\uccad, \uae30\ud55c \ud6c4 \uc2e0\uccad, \uc9c0\uae09\uc77c<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/small-business-policy-fund-4050-checklist\/\">\uc18c\uc0c1\uacf5\uc778 \uc815\ucc45\uc790\uae08 4050 \uc790\uc601\uc5c5\uc790 \ud655\uc778\ubc29\ubc95: \uc2e0\uccad \uc804 \uc900\ube44\uc11c\ub958<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/national-employment-support-4050-checklist\/\">\uad6d\ubbfc\ucde8\uc5c5\uc9c0\uc6d0\uc81c\ub3c4 4050 \uc2e0\uccad \uc804 \ud655\uc778\ud560 \uac83: \uc18c\ub4dd, \ucde8\uc5c5\uacbd\ud5d8, \uad6c\uc