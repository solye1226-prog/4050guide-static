{"id":133,"date":"2026-05-22T16:39:09","date_gmt":"2026-05-22T07:39:09","guid":{"rendered":"https:\/\/4050guide.co.kr\/interview-preparation-after-40-50\/"},"modified":"2026-05-26T18:38:18","modified_gmt":"2026-05-26T09:38:18","slug":"interview-preparation-after-40-50","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/interview-preparation-after-40-50\/","title":{"rendered":"4050 \uba74\uc811 \uc900\ube44\ubc95: \uacbd\ub825\uc740 \ub9ce\uc740\ub370 \ub098\uc774\uac00 \uac71\uc815\ub420 \ub54c"},"content":{"rendered":"<p>4050 \uad6c\uc9c1\uc790\ub294 \uacbd\ub825\uc774 \uc7a5\uc810\uc774\uba74\uc11c \ub3d9\uc2dc\uc5d0 \ubd80\ub2f4\uc73c\ub85c \ubcf4\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uba74\uc811\uc5d0\uc11c\ub294 \ub098\uc774\ub97c \ubc29\uc5b4\ud558\uae30\ubcf4\ub2e4 \uc989\uc2dc \ub9e1\uc744 \uc218 \uc788\ub294 \uc5ed\ud560\uacfc \ud611\uc5c5 \ud0dc\ub3c4\ub97c \ubcf4\uc5ec\uc8fc\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4.<\/p>\n<p>\ud2b9\ud788 \uc9c1\ubb34 \uc804\ud658\uc774\ub098 \uae09\uc5ec \uc870\uc815\uc774 \ud544\uc694\ud55c \uacbd\uc6b0\uc5d0\ub294 \uae30\ub300 \uc870\uac74\uc744 \ud604\uc2e4\uc801\uc73c\ub85c \uc815\ub9ac\ud574\ub450\uc5b4\uc57c \uba74\uc811\uc5d0\uc11c \ud754\ub4e4\ub9ac\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>4050 \uba74\uc811 \uc900\ube44 \uc694\uc57d<\/h2>\n<table class=\"guide-table\">\n<tbody>\n<tr>\n<th>\ud575\uc2ec \uba54\uc2dc\uc9c0<\/th>\n<td>\uacbd\ub825\ubcf4\ub2e4 \uc9c0\uae08 \ub9e1\uc744 \uc218 \uc788\ub294 \uc5ed\ud560\uc744 \ubd84\uba85\ud788 \ub9d0\ud558\uae30<\/td>\n<\/tr>\n<tr>\n<th>\uc900\ube44 \uc790\ub8cc<\/th>\n<td>\ucd5c\uadfc \uc5c5\ubb34 \uc131\uacfc, \uc0ac\uc6a9 \uac00\ub2a5 \ub3c4\uad6c, \ud76c\ub9dd \uadfc\ubb34\uc870\uac74<\/td>\n<\/tr>\n<tr>\n<th>\uc8fc\uc758 \uc9c8\ubb38<\/th>\n<td>\ub098\uc774, \uae09\uc5ec, \uc0c1\uc0ac \uc5f0\ub839, \uccb4\ub825, \uacf5\ubc31 \uae30\uac04<\/td>\n<\/tr>\n<tr>\n<th>\ub2f5\ubcc0 \ubc29\ud5a5<\/th>\n<td>\ubc29\uc5b4\ubcf4\ub2e4 \uc801\uc751\ub825\uacfc \uc548\uc815\uc131\uc744 \uac15\uc870<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\ud655\uc778 \uc21c\uc11c<\/h2>\n<ol>\n<li>\ucd5c\uadfc \uacbd\ub825\uc744 3\uac00\uc9c0 \uc131\uacfc\ub85c \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc9c0\uc6d0 \uc9c1\ubb34\uc5d0\uc11c \ubc14\ub85c \ud560 \uc218 \uc788\ub294 \uc77c\uc744 \ubb38\uc7a5\uc73c\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.<\/li>\n<li>\uae09\uc5ec\uc640 \uadfc\ubb34\uc2dc\uac04\uc758 \ucd5c\uc18c \uae30\uc900\uc744 \uc815\ud569\ub2c8\ub2e4.<\/li>\n<li>\uacf5\ubc31 \uae30\uac04\uc774\ub098 \uc804\uc9c1 \uc774\uc720\ub97c \uc9e7\uace0 \uc194\uc9c1\ud558\uac8c \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/li>\n<li>\ub098\uc774 \uad00\ub828 \uc9c8\ubb38\uc5d0\ub294 \ud611\uc5c5\uacfc \uc548\uc815\uc131\uc73c\ub85c \ub2f5\ubcc0\ud569\ub2c8\ub2e4.<\/li>\n<\/ol>\n<h2>4050 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h2>\n<ul>\n<li>\uc608\uc804 \uc9c1\uae09\uc744 \ub0b4\ub824\ub193\uace0 \uc0c8 \uc5ed\ud560\uc744 \ubc1b\uc544\ub4e4\uc77c \uc900\ube44\uac00 \ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc80a\uc740 \uad00\ub9ac\uc790\uc640 \uc77c\ud558\ub294 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc124\uba85\ud560\uc9c0 \uc900\ube44\ud569\ub2c8\ub2e4.<\/li>\n<li>\uccb4\ub825\uc774\ub098 \uad50\ub300\uadfc\ubb34 \uc9c8\ubb38\uc5d0 \uacfc\uc7a5 \uc5c6\uc774 \ub2f5\ud569\ub2c8\ub2e4.<\/li>\n<li>\uacbd\ub825 \uc124\uba85\uc774 \uae38\uc5b4\uc9c0\uc9c0 \uc54a\uac8c 1\ubd84 \ub2f5\ubcc0\uc744 \uc5f0\uc2b5\ud569\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>\uc0c1\ud669\ubcc4 \ud310\ub2e8 \uae30\uc900<\/h2>\n<h3>\ub3d9\uc885\uc5c5\uacc4 \uc9c0\uc6d0<\/h3>\n<p>\uc804\ubb38\uc131\uacfc \uc548\uc815\uc131\uc744 \uac15\uc870\ud558\ub418 \uc774\uc804 \ud68c\uc0ac \ubc29\uc2dd\ub9cc \uace0\uc9d1\ud558\uc9c0 \uc54a\ub294 \ud0dc\ub3c4\ub97c \ubcf4\uc5ec\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h3>\uc2e0\uc785\uae09 \uc9c1\ubb34 \uc804\ud658<\/h3>\n<p>\ubc30\uc6b0\ub294 \uc790\uc138\uc640 \ucd9c\uadfc \uc548\uc815\uc131, \uae30\ubcf8 \uc5c5\ubb34 \uc2b5\ub4dd\ub825\uc744 \uac15\uc870\ud558\ub294 \ud3b8\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<h3>\uacf5\ubc31 \uae30\uac04\uc774 \uc788\ub294 \uacbd\uc6b0<\/h3>\n<p>\uac00\uc871 \ub3cc\ubd04, \uad50\uc721, \uad6c\uc9c1\ud65c\ub3d9 \ub4f1 \uc0ac\uc2e4\uc744 \uc9e7\uac8c \uc124\uba85\ud558\uace0 \ud604\uc7ac \uc900\ube44\ub41c \uc0c1\ud0dc\ub97c \ub9d0\ud569\ub2c8\ub2e4.<\/p>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<details>\n<summary>\ub098\uc774\uac00 \ub9ce\ub2e4\ub294 \uc9c8\ubb38\uc744 \ubc1b\uc73c\uba74 \uc5b4\ub5bb\uac8c \ub2f5\ud558\ub098\uc694?<\/summary>\n<p>\ub098\uc774\ub97c \ubd80\uc815\ud558\uae30\ubcf4\ub2e4 \uc5c5\ubb34 \uc548\uc815\uc131, \ucc45\uc784\uac10, \ucd9c\uadfc \uac00\ub2a5\uc131, \ud611\uc5c5 \ud0dc\ub3c4\ub97c \uc911\uc2ec\uc73c\ub85c \ub2f5\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<\/details>\n<details>\n<summary>\ud76c\ub9dd\uc5f0\ubd09\uc740 \ub0ae\uac8c \ub9d0\ud574\uc57c \ud558\ub098\uc694?<\/summary>\n<p>\ubb34\uc870\uac74 \ub0ae\ucd94\uae30\ubcf4\ub2e4 \ucd5c\uc18c \uc0dd\ud65c\ube44\uc640 \uc9c1\ubb34 \uc218\uc900\uc744 \uae30\uc900\uc73c\ub85c \ud604\uc2e4\uc801\uc778 \ubc94\uc704\ub97c \uc815\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<\/details>\n<h2>\uacf5\uc2dd \ud655\uc778\ucc98<\/h2>\n<p>\uc774 \uae00\uc740 \uc2e0\uccad \ubc29\ud5a5\uc744 \uc7a1\uae30 \uc704\ud55c \uc815\ub9ac\uc785\ub2c8\ub2e4. \uc2e4\uc81c \uae30\uc900, \uae30\uac04, \uae08\uc561, \ud544\uc694 \uc11c\ub958\ub294 \ubc14\ub014 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2e0\uccad \uc804 \uacf5\uc2dd \ud398\uc774\uc9c0\uc5d0\uc11c \ucd5c\uc2e0 \ub0b4\uc6a9\uc744 \ud655\uc778\ud558\uc138\uc694.<\/p>\n<ul>\n<li><a href=\"https:\/\/www.work24.go.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\uace0\uc6a924<\/a><\/li>\n<li><a href=\"https:\/\/www.work.go.kr\/senior\/\" target=\"_blank\" rel=\"noopener noreferrer\">\uc911\uc7a5\ub144\uc6cc\ud06c\ub137<\/a><\/li>\n<\/ul>\n<div class=\"guide-related\"><\/div>\n<p><!-- guide4050-depth-expand --><\/p>\n<h2>4050 \uae30\uc900\uc73c\ub85c \uba3c\uc800 \ud310\ub2e8\ud560 \ubd80\ubd84<\/h2>\n<p>4050 \uba74\uc811 \uc900\ube44\ubc95: \uacbd\ub825\uc740 \ub9ce\uc740\ub370 \ub098\uc774\uac00 \uac71\uc815\ub420 \ub54c\ub97c \ud655\uc778\ud560 \ub54c\ub294 \ub2e8\uc21c\ud788 \uc774\ub984\ub9cc \ubcf4\uace0 \uacb0\uc815\ud558\uae30\ubcf4\ub2e4 \ub0b4 \uc0c1\ud669\uc5d0 \uc2e4\uc81c\ub85c \ub9de\ub294\uc9c0\ubd80\ud130 \ubcf4\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. 40\ub300\uc640 50\ub300\ub294 \uc774\ubbf8 \uc9c1\uc7a5 \uacbd\ud5d8, \uac00\uc871 \ubd80\uc591, \uac74\uac15\ubcf4\ud5d8\ub8cc, \ud1f4\uc9c1 \uc77c\uc815, \ubd80\ubaa8\ub2d8 \ub3cc\ubd04 \uac19\uc740 \uc870\uac74\uc774 \ud568\uaed8 \uc6c0\uc9c1\uc774\ub294 \uacbd\uc6b0\uac00 \ub9ce\uae30 \ub54c\ubb38\uc5d0 \uac19\uc740 \uc81c\ub3c4\ub77c\ub3c4 \uccb4\uac10\ub418\ub294 \uc720\ub9ac\ud568\uc774 \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ud2b9\ud788 \uc2e0\uccad\ud615 \uc81c\ub3c4\ub098 \uc790\uaca9\uc99d \uc815\ubcf4\ub294 \uad11\uace0 \ubb38\uad6c\ubcf4\ub2e4 \uacf5\uc2dd \uc870\uac74\uacfc \uc2e4\uc81c \ud65c\uc6a9\ucc98\ub97c \ud568\uaed8 \ubd10\uc57c \ud569\ub2c8\ub2e4. \uc9c0\uc6d0 \ub300\uc0c1, \uc2e0\uccad \uae30\uac04, \uc900\ube44\uc11c\ub958, \ubcf8\uc778\ubd80\ub2f4 \uc5ec\ubd80, \uc0c1\ub2f4 \ucc3d\uad6c\ub97c \uba3c\uc800 \ud655\uc778\ud558\uba74 \uc2dc\uac04\uc744 \uc904\uc77c \uc218 \uc788\uace0, \uc2e0\uccad \ud6c4 \ud0c8\ub77d\ud558\uac70\ub098 \uacfc\uc815 \uc218\ub8cc \ud6c4 \ud65c\uc6a9\ud558\uc9c0 \ubabb\ud558\ub294 \uc0c1\ud669\uc744 \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc7ac\ucde8\uc5c5 \uc900\ube44\uc5d0\uc11c \ub193\uce58\uae30 \uc26c\uc6b4 \uc21c\uc11c<\/h2>\n<table>\n<thead>\n<tr>\n<th>\ub2e8\uacc4<\/th>\n<th>\ud560 \uc77c<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>1\ub2e8\uacc4<\/td>\n<td>\ud604\uc7ac \uacbd\ub825\uacfc \uac00\ub2a5\ud55c \uadfc\ubb34\uc2dc\uac04\uc744 \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>2\ub2e8\uacc4<\/td>\n<td>\uc911\uc7a5\ub144 \ub0b4\uc77c\uc13c\ud130, \uace0\uc6a9\uc13c\ud130, \uc9c0\uc790\uccb4 \uc77c\uc790\ub9ac\uc13c\ud130 \uc0c1\ub2f4 \uac00\ub2a5 \uc5ec\ubd80\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>3\ub2e8\uacc4<\/td>\n<td>\ud544\uc694\ud55c \uad50\uc721\uc774\ub098 \uc790\uaca9\uc99d\uc774 \uc788\ub2e4\uba74 \uad6d\ube44\uc9c0\uc6d0 \uacfc\uc815\uacfc \uc5f0\uacb0\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>4\ub2e8\uacc4<\/td>\n<td>\uc774\ub825\uc11c\uc5d0\ub294 \uacfc\uac70 \uc9c1\ucc45\ubcf4\ub2e4 \uc9c0\uae08 \ud560 \uc218 \uc788\ub294 \uc5c5\ubb34\ub97c \uc911\uc2ec\uc73c\ub85c \uc501\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p>\uc7ac\ucde8\uc5c5\uc740 \uc815\ubcf4\ub97c \ub9ce\uc774 \ubcf4\ub294 \uac83\ubcf4\ub2e4 \uc21c\uc11c\ub97c \uc815\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uba3c\uc800 \uc0c1\ub2f4 \ucc3d\uad6c\ub97c \ud1b5\ud574 \ud604\uc7ac \uad6c\uc9c1 \uc0c1\ud0dc\ub97c \uc815\ub9ac\ud558\uace0, \uc774\ud6c4 \ud544\uc694\ud55c \uad50\uc721\uc774\ub098 \uc790\uaca9\uc99d\uc744 \ubd99\uc774\ub294 \ubc29\uc2dd\uc774 \uc2dc\ud589\ucc29\uc624\ub97c \uc904\uc785\ub2c8\ub2e4.<\/p>\n<h2>\uc0c1\ub2f4 \uc804 \uba54\ubaa8\ud574\ub450\uba74 \uc88b\uc740 \uc9c8\ubb38<\/h2>\n<ul>\n<li>\ub0b4 \ub098\uc774\uc640 \uace0\uc6a9 \uc0c1\ud0dc\uc5d0\uc11c \uc2e0\uccad \uac00\ub2a5\ud55c\uac00\uc694?<\/li>\n<li>\uc18c\ub4dd, \uc7ac\uc0b0, \uacbd\ub825 \ub54c\ubb38\uc5d0 \uc81c\uc678\ub420 \uc218 \uc788\ub294 \uc870\uac74\uc774 \uc788\ub098\uc694?<\/li>\n<li>\uc628\ub77c\uc778 \uc2e0\uccad\uacfc \ubc29\ubb38 \uc2e0\uccad \uc911 \uc5b4\ub5a4 \ubc29\uc2dd\uc774 \ube60\ub978\uac00\uc694?<\/li>\n<li>\uc2e0\uccad \ud6c4 \uacb0\uacfc \ud655\uc778\uae4c\uc9c0 \ubcf4\ud1b5 \uc5bc\ub9c8\ub098 \uac78\ub9ac\ub098\uc694?<\/li>\n<li>\ube44\uc2b7\ud55c \uc81c\ub3c4\ub098 \uacfc\uc815\uacfc \uc911\ubcf5 \uc774\uc6a9\uc774 \uac00\ub2a5\ud55c\uac00\uc694?<\/li>\n<\/ul>\n<p>\uc774 \uc9c8\ubb38\uc744 \ubbf8\ub9ac \uc815\ub9ac\ud574\ub450\uba74 \uc0c1\ub2f4 \uc2dc\uac04\uc774 \uc9e7\uc544\uc9c0\uace0, \ub2f4\ub2f9\uc790\uc5d0\uac8c \ud544\uc694\ud55c \uc815\ubcf4\ub97c \ube60\ub974\uac8c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \uac00\uc871 \ub300\uc2e0 \uc54c\uc544\ubcf4\ub294 \uacbd\uc6b0\uc5d0\ub294 \ub2f9\uc0ac\uc790\uc758 \uc0dd\ub144\uc6d4\uc77c, \uac70\uc8fc\uc9c0, \uc18c\ub4dd \uc0c1\ud0dc, \uac74\uac15 \uc0c1\ud0dc\ucc98\ub7fc \uae30\ubcf8 \uc815\ubcf4\ub97c \uc900\ube44\ud574\ub450\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<p><!-- guide4050-related-start --><\/p>\n<section class=\"guide-related-posts\">\n<h2>\ud568\uaed8 \ubcf4\uba74 \uc88b\uc740 \uae00<\/h2>\n<p>\uc774 \uae00\uacfc \uc774\uc5b4\uc11c \ud655\uc778\ud558\uba74 \uc88b\uc740 4050 \ub9de\ucda4 \uc815\ubcf4\uc785\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/4050guide.co.kr\/middle-aged-tomorrow-center-counseling-prep\/\">\uc911\uc7a5\ub144 \ub0b4\uc77c\uc13c\ud130 \uc0c1\ub2f4\ubc1b\uae30 \uc804 \uc900\ube44\ud560 \uac83: 4050 \uc7ac\ucde8\uc5c5 \uc0c1\ub2f4 \ud65c\uc6a9\ubc95<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/june-2026-middle-aged-reemployment-support\/\">2026\ub144 6\uc6d4 \uc911\uc7a5\ub144 \uc7ac\ucde8\uc5c5 \uc9c0\uc6d0\uc81c\ub3c4 \ud655\uc778\ud560 \uac83: \uc0c1\ub2f4, \uad50\uc721, \uad6c\uc9c1\ub4f1\ub85d<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/security-guard-basic-training-4050\/\">\uacbd\ube44\uc6d0 \uc2e0\uc784\uad50\uc721 4050 \uc900\ube44\ubc29\ubc95: \uc77c\ubc18\uacbd\ube44\uc6d0 \ucde8\uc5c5 \uc804 \ud655\uc778\ud560 \uac83<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/reemployment-checklist-before-retirement\/\">\ud1f4\uc9c1 \uc608\uc815\uc790 \uc7ac\ucde8\uc5c5 \uc900\ube44 \uc21c\uc11c: \ud1f4\uc0ac \uc804 3\uac1c\uc6d4 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/a><\/li>\n<\/ul>\n<\/section>\n<p><!-- guide4050-related-end --><\/p>\n<p><!-- 4050_SHORT_UPLIFT_START --><\/p>\n<section class=\"guide-short-uplift\">\n<h2>\uc7ac\ucde8\uc5c5 \uc900\ube44\uc5d0\uc11c \uba3c\uc800 \uc815\ub9ac\ud560 \uac83<\/h2>\n<p>\uc7ac\ucde8\uc5c5 \uc815\ubcf4\ub294 \uc81c\ub3c4\ubcf4\ub2e4 \ubcf8\uc778\uc758 \uc870\uac74 \uc815\ub9ac\uac00 \uba3c\uc800\uc785\ub2c8\ub2e4. \uacbd\ub825, \ud76c\ub9dd \uadfc\ubb34\uc2dc\uac04, \uac74\uac15 \uc0c1\ud0dc, \uc774\ub3d9 \uac00\ub2a5 \uac70\ub9ac, \ucd5c\uc18c \uae09\uc5ec \uae30\uc900\uc744 \uc815\ub9ac\ud558\uba74 \uc0c1\ub2f4\uacfc \uc9c0\uc6d0\uc11c \uc791\uc131\uc774 \ud6e8\uc52c \uc26c\uc6cc\uc9d1\ub2c8\ub2e4.<\/p>\n<figure class=\"wp-block-table\">\n<table>\n<tr>\n<th>\ud655\uc778 \uc21c\uc11c<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<th>\ud310\ub2e8 \uae30\uc900<\/th>\n<\/tr>\n<tr>\n<td>1\ub2e8\uacc4<\/td>\n<td>\uc774\uc804 \uacbd\ub825<\/td>\n<td>\ucd5c\uadfc \uacbd\ub825 \uc911 \ub2e4\uc2dc \ud65c\uc6a9 \uac00\ub2a5\ud55c \uc5c5\ubb34\ub97c \ucc3e\uc2b5\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>2\ub2e8\uacc4<\/td>\n<td>\uadfc\ubb34 \uc870\uac74<\/td>\n<td>\uc8fc\uac04\u00b7\uc57c\uac04\u00b7\uad50\ub300\uadfc\ubb34 \uac00\ub2a5 \uc5ec\ubd80\ub97c \uad6c\ubd84\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>3\ub2e8\uacc4<\/td>\n<td>\uad50\uc721 \ud544\uc694\uc131<\/td>\n<td>\uc0c8 \uc790\uaca9\uc99d\uc774 \ud544\uc694\ud55c\uc9c0, \ub2e8\uae30 \uad50\uc721\uc73c\ub85c \ucda9\ubd84\ud55c\uc9c0 \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>4\ub2e8\uacc4<\/td>\n<td>\uc9c0\uc6d0 \uacbd\ub85c<\/td>\n<td>\uace0\uc6a924, \uc911\uc7a5\ub144 \ub0b4\uc77c\uc13c\ud130, \uc9c0\uc790\uccb4 \uacf5\uace0\ub97c \ud568\uaed8 \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/table>\n<\/figure>\n<h3>\ube60\ub978 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h3>\n<ul>\n<li>\uc774\ub825\uc11c\ub294 \ud558\ub098\ub9cc \uc4f0\uc9c0 \ub9d0\uace0 \uc9c1\ubb34\ubcc4\ub85c \ub098\ub215\ub2c8\ub2e4.<\/li>\n<li>\ub098\uc774\ubcf4\ub2e4 \uc5c5\ubb34 \uac00\ub2a5 \uc2dc\uac04\uacfc \uacbd\ub825 \uc5f0\uacb0\uc131\uc744 \uac15\uc870\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc0c1\ub2f4 \uc804 \ud76c\ub9dd \uc9c1\ubb34\ub97c 2~3\uac1c\ub85c \uc881\ud799\ub2c8\ub2e4.<\/li>\n<\/ul>\n<p>\uc704 \ub0b4\uc6a9\uc740 \uae30\ubcf8 \ud310\ub2e8 \uae30\uc900\uc774\uba70, \uc2e4\uc81c \uc2e0\uccad\uc774\ub098 \uc811\uc218 \uc804\uc5d0\ub294 \uacf5\uc2dd \uae30\uad00\uc758 \ucd5c\uc2e0 \uc548\ub0b4\ub97c \ub2e4\uc2dc \ud655\uc778\ud558\ub294 \uac83\uc774 \uc548\uc804\ud569\ub2c8\ub2e4.<\/p>\n<\/section>\n<p><!-- 4050_SHORT_UPLIFT_END --><\/p>\n","protected":false},"excerpt":{"rendered":"<p>4050 \uad6c\uc9c1\uc790\ub294 \uacbd\ub825\uc774 \uc7a5\uc810\uc774\uba74\uc11c \ub3d9\uc2dc\uc5d0 \ubd80\ub2f4\uc73c\ub85c \ubcf4\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uba74\uc811\uc5d0\uc11c\ub294 \ub098\uc774\ub97c \ubc29\uc5b4\ud558\uae30\ubcf4\ub2e4 \uc989\uc2dc \ub9e1\uc744 \uc218 \uc788\ub294 \uc5ed\ud560\uacfc \ud611\uc5c5 \ud0dc\ub3c4\ub97c \ubcf4\uc5ec\uc8fc\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4.<\/p>\n","protected":false},"author":0,"featured_media":223,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[5],"tags":[],"class_list":["post-133","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-rejob"],"_links":{"self":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts\/133","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/types\/post"}],"replies":[{"embeddable":true,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/comments?post=133"}],"version-history":[{"count":3,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts\/133\/revisions"}],"predecessor-version":[{"id":481,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts\/133\/revisions\/481"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/media\/223"}],"wp:attachment":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/media?parent=133"}],"wp:term":[{"taxono