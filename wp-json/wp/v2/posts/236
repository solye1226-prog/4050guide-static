{"id":236,"date":"2026-05-25T11:25:30","date_gmt":"2026-05-25T02:25:30","guid":{"rendered":"https:\/\/4050guide.co.kr\/middle-aged-tomorrow-center-counseling-prep\/"},"modified":"2026-05-26T18:33:29","modified_gmt":"2026-05-26T09:33:29","slug":"middle-aged-tomorrow-center-counseling-prep","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/middle-aged-tomorrow-center-counseling-prep\/","title":{"rendered":"\uc911\uc7a5\ub144 \ub0b4\uc77c\uc13c\ud130 \uc0c1\ub2f4\ubc1b\uae30 \uc804 \uc900\ube44\ud560 \uac83: 4050 \uc7ac\ucde8\uc5c5 \uc0c1\ub2f4 \ud65c\uc6a9\ubc95"},"content":{"rendered":"<p>\uc911\uc7a5\ub144 \ub0b4\uc77c\uc13c\ud130\ub294 40\ub300\uc640 50\ub300\uac00 \uc7ac\ucde8\uc5c5, \uc804\uc9c1, \uc0dd\uc560\uacbd\ub825\uc124\uacc4\ub97c \uc0c1\ub2f4\ubc1b\uc744 \uc218 \uc788\ub294 \ub300\ud45c\uc801\uc778 \uc9c0\uc6d0 \ucc3d\uad6c\uc785\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uc0c1\ub2f4\uc744 \ubc1b\uae30 \uc804\uc5d0 \ubcf8\uc778\uc758 \uacbd\ub825\uacfc \ud76c\ub9dd \uc870\uac74\uc744 \uc815\ub9ac\ud558\uc9c0 \uc54a\uc73c\uba74 \uc0c1\ub2f4 \uc2dc\uac04\uc774 \ub2e8\uc21c \uc548\ub0b4\ub85c \ub05d\ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uba3c\uc800 \ubcfc \ud575\uc2ec<\/h2>\n<ul>\n<li>\ucd5c\uadfc \uacbd\ub825\uacfc \uac00\ub2a5\ud55c \uc5c5\ubb34\ub97c \uba3c\uc800 \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/li>\n<li>\ud76c\ub9dd \uae09\uc5ec\ubcf4\ub2e4 \uac00\ub2a5\ud55c \uadfc\ubb34 \ud615\ud0dc\ub97c \uad6c\uccb4\ud654\ud569\ub2c8\ub2e4.<\/li>\n<li>\uad6d\ube44\uc9c0\uc6d0 \uad50\uc721\uacfc \uc5f0\uacb0 \uac00\ub2a5\ud55c\uc9c0 \ud568\uaed8 \ubb3c\uc5b4\ubd05\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>\uc0c1\ub2f4 \uc804 \uc900\ube44 \uc790\ub8cc<\/h2>\n<table>\n<tbody>\n<tr>\n<th>\uad6c\ubd84<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<th>4050 \uccb4\ud06c \ud3ec\uc778\ud2b8<\/th>\n<\/tr>\n<tr>\n<td>\uacbd\ub825 \uc694\uc57d<\/td>\n<td>\ucd5c\uadfc 10\ub144 \uacbd\ub825\uacfc \uc8fc\uc694 \uc5c5\ubb34\ub97c \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/td>\n<td>\uc9c1\ubb34\uba85\ubcf4\ub2e4 \uc2e4\uc81c \ud574\ubcf8 \uc77c\uc744 \uc911\uc2ec\uc73c\ub85c \uc791\uc131<\/td>\n<\/tr>\n<tr>\n<td>\ud76c\ub9dd \uc870\uac74<\/td>\n<td>\uadfc\ubb34 \uc2dc\uac04, \uc9c0\uc5ed, \uae09\uc5ec, \uace0\uc6a9 \ud615\ud0dc\ub97c \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/td>\n<td>\ubd88\uac00\ub2a5\ud55c \uc870\uac74\ub3c4 \ud568\uaed8 \uc801\uc5b4\ub450\uae30<\/td>\n<\/tr>\n<tr>\n<td>\uad50\uc721 \uc774\ub825<\/td>\n<td>\ubcf4\uc720 \uc790\uaca9\uc99d\uacfc \uc218\uac15\ud55c \uad50\uc721\uc744 \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/td>\n<td>\ucd94\uac00 \uad50\uc721 \ud544\uc694 \uc5ec\ubd80 \uc0c1\ub2f4 \uac00\ub2a5<\/td>\n<\/tr>\n<tr>\n<td>\uc804\uc9c1 \ubc29\ud5a5<\/td>\n<td>\uae30\uc874 \uc9c1\ubb34 \uc720\uc9c0 \ub610\ub294 \uc0c8 \ubd84\uc57c \uc804\ud658\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4.<\/td>\n<td>\ud604\uc2e4\uc801\uc778 \ud6c4\ubcf4 \uc9c1\ubb34 2~3\uac1c \uc900\ube44<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\uc2e0\uccad \uc804 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h2>\n<ul>\n<li>\uae30\uc874 \uc774\ub825\uc11c\ub97c \ucd5c\uc2e0 \ub0b4\uc6a9\uc73c\ub85c \uc218\uc815\ud569\ub2c8\ub2e4.<\/li>\n<li>\ud76c\ub9dd \uc9c1\ubb34\ub97c \ud558\ub098\ub9cc \uc815\ud558\uc9c0 \ub9d0\uace0 2~3\uac1c \ud6c4\ubcf4\ub85c \uc900\ube44\ud569\ub2c8\ub2e4.<\/li>\n<li>\uadfc\ubb34 \uac00\ub2a5\ud55c \uc2dc\uac04\ub300\uc640 \uc774\ub3d9 \uac00\ub2a5 \uc9c0\uc5ed\uc744 \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/li>\n<li>\uad6d\ube44\uc9c0\uc6d0 \uad50\uc721\uc774 \ud544\uc694\ud55c\uc9c0 \uc0c1\ub2f4 \ub54c \uc9c8\ubb38\ud569\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>4050\uc5d0\uac8c \uc911\uc694\ud55c \ud310\ub2e8 \uae30\uc900<\/h2>\n<p>4050 \uc7ac\ucde8\uc5c5 \uc0c1\ub2f4\uc5d0\uc11c \uac00\uc7a5 \uc911\uc694\ud55c \uac83\uc740 \u201c\ubb34\uc2a8 \uc77c\uc744 \ud558\uace0 \uc2f6\uc740\uac00\u201d\ubcf4\ub2e4 \u201c\uc5b4\ub5a4 \uc77c\uc744 \uc2e4\uc81c\ub85c \ud560 \uc218 \uc788\ub294\uac00\u201d\uc785\ub2c8\ub2e4. \uacbd\ub825, \uccb4\ub825, \uc0dd\ud65c \ud328\ud134, \uc774\ub3d9 \uac00\ub2a5 \uc9c0\uc5ed\uc744 \ud568\uaed8 \uace0\ub824\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<p>\uc911\uc7a5\ub144 \ub0b4\uc77c\uc13c\ud130\ub294 \uc77c\uc790\ub9ac \uc815\ubcf4\ub9cc \uc81c\uacf5\ud558\ub294 \uacf3\uc774 \uc544\ub2c8\ub77c \uc0dd\uc560\uacbd\ub825\uc124\uacc4, \uc804\uc9c1 \uc9c0\uc6d0, \uad50\uc721 \uc5f0\uacc4\uae4c\uc9c0 \ud568\uaed8 \ubcfc \uc218 \uc788\ub294 \ucc3d\uad6c\uc785\ub2c8\ub2e4. \uc0c1\ub2f4\uc744 \uc798 \ud65c\uc6a9\ud558\uba74 \ud63c\uc790 \uac80\uc0c9\ud560 \ub54c\ubcf4\ub2e4 \ubc29\ud5a5\uc744 \ube60\ub974\uac8c \uc7a1\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\uc0c1\ub2f4 \ud6c4\uc5d0\ub294 \ucd94\ucc9c\ubc1b\uc740 \uc9c1\ubb34\ub97c \ubc14\ub85c \uc9c0\uc6d0\ud558\uae30\ubcf4\ub2e4 \ucc44\uc6a9\uacf5\uace0\ub97c 5\uac1c \uc774\uc0c1 \ube44\uad50\ud574\ubcf4\uace0, \uc2e4\uc81c \uc694\uad6c \uacbd\ub825\uacfc \uc790\uaca9\uc99d\uc744 \ud655\uc778\ud558\ub294 \uacfc\uc815\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.<\/p>\n<p><!-- guide4050-expanded --><\/p>\n<h2>\uc0c1\ub2f4 \uc804 \uc900\ube44\uac00 \uc911\uc694\ud55c \uc774\uc720<\/h2>\n<p>\uc911\uc7a5\ub144 \ub0b4\uc77c\uc13c\ud130 \uc0c1\ub2f4\uc740 \ubc29\ud5a5\uc744 \uc7a1\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\uc9c0\ub9cc, \uc544\ubb34 \uc900\ube44 \uc5c6\uc774 \ubc29\ubb38\ud558\uba74 \uc77c\ubc18\uc801\uc778 \uc81c\ub3c4 \uc124\uba85\ub9cc \ub4e3\uace0 \ub05d\ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc0c1\ub2f4\uc0ac\uac00 \ub098\uc5d0\uac8c \ub9de\ub294 \uc9c1\ubb34\ub098 \ud6c8\ub828\uc744 \uc81c\uc548\ud558\ub824\uba74 \ud604\uc7ac \uacbd\ub825, \uac00\ub2a5\ud55c \uadfc\ubb34 \uc870\uac74, \ud76c\ub9dd\ud558\ub294 \uc77c\uc790\ub9ac \ubc94\uc704\ub97c \uc54c\uc544\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<p>4050 \uc7ac\ucde8\uc5c5\uc740 \ub2e8\uc21c\ud788 \ub098\uc774\ub9cc\uc758 \ubb38\uc81c\uac00 \uc544\ub2d9\ub2c8\ub2e4. \uc774\uc804 \uacbd\ub825\uc774 \uc5b4\ub5a4 \uc5c5\uc885\uc774\uc5c8\ub294\uc9c0, \uacbd\ub825\uc744 \uc774\uc5b4\uac08 \uc218 \uc788\ub294\uc9c0, \uc0c8\ub85c\uc6b4 \ubd84\uc57c\ub85c \uc804\ud658\ud574\uc57c \ud558\ub294\uc9c0, \uccb4\ub825\uacfc \uac00\uc871 \ub3cc\ubd04 \uc2dc\uac04\uc774 \uc5b4\ub5a4\uc9c0\uc5d0 \ub530\ub77c \uc120\ud0dd\uc9c0\uac00 \ub2ec\ub77c\uc9d1\ub2c8\ub2e4.<\/p>\n<p>\ub530\ub77c\uc11c \uc0c1\ub2f4 \uc804\uc5d0\ub294 \u201c\ubb34\uc2a8 \uc77c\uc744 \ud558\uace0 \uc2f6\ub2e4\u201d\ubcf4\ub2e4 \u201c\ubb34\uc2a8 \uc77c\uc740 \uac00\ub2a5\ud558\uace0, \uc5b4\ub5a4 \uc870\uac74\uc740 \uc5b4\ub835\ub2e4\u201d\ub97c \uc815\ub9ac\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \uc774 \uc815\ubcf4\uac00 \uc788\uc5b4\uc57c \ud604\uc2e4\uc801\uc778 \uc77c\uc790\ub9ac\uc640 \uad50\uc721 \uacfc\uc815\uc744 \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc0c1\ub2f4 \uc804 \uc815\ub9ac\ud560 \ub0b4\uc6a9<\/h2>\n<table>\n<thead>\n<tr>\n<th>\uc900\ube44 \ud56d\ubaa9<\/th>\n<th>\uc791\uc131 \uc608\uc2dc<\/th>\n<th>\ud65c\uc6a9 \ubc29\ubc95<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\ucd5c\uadfc \uacbd\ub825<\/td>\n<td>\ucd1d\ubb34 8\ub144, \uace0\uac1d\uc0c1\ub2f4 5\ub144, \ub9e4\uc7a5\uad00\ub9ac 3\ub144<\/td>\n<td>\ube44\uc2b7\ud55c \uc9c1\ubb34 \uc804\ud658 \uac00\ub2a5\uc131 \ud310\ub2e8<\/td>\n<\/tr>\n<tr>\n<td>\uac00\ub2a5 \uc2dc\uac04<\/td>\n<td>\ud3c9\uc77c \uc624\uc804 \uac00\ub2a5, \uc57c\uac04 \ubd88\uac00, \uc8fc\ub9d0 \uc77c\ubd80 \uac00\ub2a5<\/td>\n<td>\ud6c8\ub828\uacfc \uadfc\ubb34 \uc870\uac74 \uc120\ubcc4<\/td>\n<\/tr>\n<tr>\n<td>\ud76c\ub9dd \uc9c0\uc5ed<\/td>\n<td>\uc9d1\uc5d0\uc11c 40\ubd84 \uc774\ub0b4, \ub300\uc911\uad50\ud1b5 \uac00\ub2a5 \uc9c0\uc5ed<\/td>\n<td>\uc2e4\uc81c \ucd9c\uadfc \uac00\ub2a5\uc131 \ud310\ub2e8<\/td>\n<\/tr>\n<tr>\n<td>\ubcf4\uc720 \uc790\uaca9<\/td>\n<td>\uc6b4\uc804\uba74\ud5c8, \ucef4\ud4e8\ud130\ud65c\uc6a9, \uc694\uc591\ubcf4\ud638\uc0ac \ub4f1<\/td>\n<td>\ucd94\uac00 \uad50\uc721 \ud544\uc694 \uc5ec\ubd80 \ud655\uc778<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\uc0c1\ub2f4 \ud6c4 \ubc14\ub85c \ud574\uc57c \ud560 \uc77c<\/h2>\n<p>\uc0c1\ub2f4\uc744 \ubc1b\uc740 \ub4a4\uc5d0\ub294 \ucd94\ucc9c\ubc1b\uc740 \uc9c1\ubb34\ub97c \ubc14\ub85c \uacb0\uc815\ud558\uc9c0 \ub9d0\uace0 \ucc44\uc6a9\uacf5\uace0\ub97c \uc9c1\uc811 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \uac19\uc740 \uc9c1\ubb34\uba85\uc774\ub77c\ub3c4 \uc2e4\uc81c \uc5c5\ubb34 \ub0b4\uc6a9, \uae09\uc5ec, \uadfc\ubb34 \uc2dc\uac04, \uc694\uad6c \uacbd\ub825\uc774 \ub2e4\ub974\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4.<\/p>\n<p>\ucd94\ucc9c\ubc1b\uc740 \uad6d\ube44\uc9c0\uc6d0 \uacfc\uc815\uc774 \uc788\ub2e4\uba74 \uacfc\uc815\uba85\ub9cc \uc800\uc7a5\ud558\uc9c0 \ub9d0\uace0 \ud6c8\ub828\uae30\uad00, \uc790\ube44\ubd80\ub2f4\uae08, \uc218\uac15 \uae30\uac04, \uc218\ub8cc \ud6c4 \uc9c0\uc6d0 \ub0b4\uc6a9\uc744 \ud568\uaed8 \uc801\uc5b4\ub450\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\uc0c1\ub2f4 \uacb0\uacfc\ub294 \ud55c \ubc88\uc73c\ub85c \ub05d\ub0b4\uc9c0 \uc54a\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \uc774\ub825\uc11c\ub97c \uc218\uc815\ud558\uace0 \uba87 \uac1c \uacf5\uace0\uc5d0 \uc9c0\uc6d0\ud55c \ub4a4 \ub2e4\uc2dc \uc0c1\ub2f4\uc744 \ubc1b\uc73c\uba74 \ud6e8\uc52c \uad6c\uccb4\uc801\uc778 \ud53c\ub4dc\ubc31\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uacf5\uc2dd \ud655\uc778\ucc98<\/h2>\n<p>\uc81c\ub3c4\uba85\uacfc \uc2e0\uccad \uc870\uac74\uc740 \uc218\uc2dc\ub85c \ubc14\ub014 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2e4\uc81c \uc2e0\uccad \uc804\uc5d0\ub294 \uc544\ub798 \uacf5\uc2dd \ud398\uc774\uc9c0\uc5d0\uc11c \ucd5c\uc2e0 \uc548\ub0b4\ub97c \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/www.work24.go.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\uc911\uc7a5\ub144 \ub0b4\uc77c\uc13c\ud130 \uc548\ub0b4<\/a><\/li>\n<li><a href=\"https:\/\/www.work24.go.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\uace0\uc6a924<\/a><\/li>\n<\/ul>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<h3>\uc0c1\ub2f4\uc740 \ubb34\ub8cc\uc778\uac00\uc694?<\/h3>\n<p>\ub300\ubd80\ubd84\uc758 \uace0\uc6a9 \uc9c0\uc6d0 \uc0c1\ub2f4\uc740 \ubb34\ub8cc\ub85c \uc6b4\uc601\ub418\uc9c0\ub9cc, \uc138\ubd80 \ud504\ub85c\uadf8\ub7a8\uc740 \uc9c0\uc5ed\uacfc \uae30\uad00\uc5d0 \ub530\ub77c \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h3>\uc774\ub825\uc11c\uac00 \uc5c6\uc5b4\ub3c4 \uc0c1\ub2f4\ubc1b\uc744 \uc218 \uc788\ub098\uc694?<\/h3>\n<p>\uac00\ub2a5\ud558\uc9c0\ub9cc \uacbd\ub825 \uc815\ub9ac \uc790\ub8cc\uac00 \uc788\uc73c\uba74 \ud6e8\uc52c \uad6c\uccb4\uc801\uc778 \uc0c1\ub2f4\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p><strong>\uc548\ub0b4:<\/strong> \uc774 \uae00\uc740 4050 \uc138\ub300\uac00 \uc81c\ub3c4\uc640 \uc790\uaca9 \uc815\ubcf4\ub97c \ube60\ub974\uac8c \uc774\ud574\ud558\ub3c4\ub85d \ub3d5\uae30 \uc704\ud55c \uc815\ub9ac \uae00\uc785\ub2c8\ub2e4. \ucd5c\uc885 \uc2e0\uccad \uac00\ub2a5 \uc5ec\ubd80\uc640 \uae08\uc561, \uc77c\uc815\uc740 \uac1c\uc778 \uc870\uac74\uacfc \uacf5\uc2dd \uae30\uad00\uc758 \ucd5c\uc2e0 \uc548\ub0b4\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p><!-- guide4050-related-start --><\/p>\n<section class=\"guide-related-posts\">\n<h2>\ud568\uaed8 \ubcf4\uba74 \uc88b\uc740 \uae00<\/h2>\n<p>\uc774 \uae00\uacfc \uc774\uc5b4\uc11c \ud655\uc778\ud558\uba74 \uc88b\uc740 4050 \ub9de\ucda4 \uc815\ubcf4\uc785\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/4050guide.co.kr\/june-2026-middle-aged-reemployment-support\/\">2026\ub144 6\uc6d4 \uc911\uc7a5\ub144 \uc7ac\ucde8\uc5c5 \uc9c0\uc6d0\uc81c\ub3c4 \ud655\uc778\ud560 \uac83: \uc0c1\ub2f4, \uad50\uc721, \uad6c\uc9c1\ub4f1\ub85d<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/security-guard-basic-training-4050\/\">\uacbd\ube44\uc6d0 \uc2e0\uc784\uad50\uc721 4050 \uc900\ube44\ubc29\ubc95: \uc77c\ubc18\uacbd\ube44\uc6d0 \ucde8\uc5c5 \uc804 \ud655\uc778\ud560 \uac83<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/reemployment-checklist-before-retirement\/\">\ud1f4\uc9c1 \uc608\uc815\uc790 \uc7ac\ucde8\uc5c5 \uc900\ube44 \uc21c\uc11c: \ud1f4\uc0ac \uc804 3\uac1c\uc6d4 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/interview-preparation-after-40-50\/\">4050 \uba74\uc811 \uc900\ube44\ubc95: \uacbd\ub825\uc740 \ub9ce\uc740\ub370 \ub098\uc774\uac00 \uac71\uc815\ub420 \ub54c<\/a><\/li>\n<\/ul>\n<\/section>\n<p><!-- guide4050-related-end --><\/p>\n<p><!-- 4050_ADSENSE_CORE_UPGRADE_START --><\/p>\n<section class=\"guide-core-upgrade\">\n<h2>\uc911\uc7a5\ub144 \ub0b4\uc77c\uc13c\ud130 \uc0c1\ub2f4 \uc804 \uc900\ube44 \uae30\uc900<\/h2>\n<p>\uc911\uc7a5\ub144 \ub0b4\uc77c\uc13c\ud130\ub294 \ub2e8\uc21c \uc77c\uc790\ub9ac \uc18c\uac1c \ucc3d\uad6c\uac00 \uc544\ub2c8\ub77c \uacbd\ub825 \uc9c4\ub2e8, \uc7ac\ucde8\uc5c5 \uc0c1\ub2f4, \uad50\uc721 \uc5f0\uacc4, \uc774\ub825\uc11c \uc810\uac80\uc744 \ubc1b\uc744 \uc218 \uc788\ub294 \uacf3\uc785\ub2c8\ub2e4. \uc0c1\ub2f4 \uc804\uc5d0 \ubcf8\uc778\uc758 \uacbd\ub825\uacfc \ud76c\ub9dd \uc870\uac74\uc744 \uc815\ub9ac\ud558\uba74 \ud6e8\uc52c \uc2e4\uc9c8\uc801\uc778 \ub3c4\uc6c0\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<figure class=\"wp-block-table\">\n<table>\n<tr>\n<th>\uc900\ube44 \ud56d\ubaa9<\/th>\n<th>\ub0b4\uc6a9<\/th>\n<th>\uc774\uc720<\/th>\n<\/tr>\n<tr>\n<td>\uacbd\ub825 \uc694\uc57d<\/td>\n<td>\ucd5c\uadfc 10\ub144 \uc911\uc2ec\uc73c\ub85c \uc9c1\ubb34\ub97c \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/td>\n<td>\uc0c1\ub2f4\uc0ac\uac00 \uac00\ub2a5\ud55c \uc9c1\ubb34\ub97c \ube60\ub974\uac8c \ud30c\uc545\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\ud76c\ub9dd \uc870\uac74<\/td>\n<td>\uadfc\ubb34\uc2dc\uac04, \uc9c0\uc5ed, \uae09\uc5ec, \uadfc\ubb34\uac15\ub3c4\ub97c \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/td>\n<td>\ud604\uc2e4\uc801\uc778 \uc77c\uc790\ub9ac \ub9e4\uce6d\uc5d0 \ud544\uc694\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc790\uaca9\u00b7\uad50\uc721<\/td>\n<td>\ubcf4\uc720 \uc790\uaca9\uc99d\uacfc \uad50\uc721 \uc774\ub825\uc744 \uc815\ub9ac\ud569\