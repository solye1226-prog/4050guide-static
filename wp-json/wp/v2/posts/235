{"id":235,"date":"2026-05-25T11:25:30","date_gmt":"2026-05-25T02:25:30","guid":{"rendered":"https:\/\/4050guide.co.kr\/health-insurance-after-retirement-4050-checklist\/"},"modified":"2026-05-26T09:29:08","modified_gmt":"2026-05-26T00:29:08","slug":"health-insurance-after-retirement-4050-checklist","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/health-insurance-after-retirement-4050-checklist\/","title":{"rendered":"\ud1f4\uc9c1 \ud6c4 \uac74\uac15\ubcf4\ud5d8\ub8cc \uc904\uc774\ub294 \ubc29\ubc95: \uc9c0\uc5ed\uac00\uc785\uc790 \uc804\ud658 \uc804 4050 \uccb4\ud06c\ub9ac\uc2a4\ud2b8"},"content":{"rendered":"<p>\ud1f4\uc9c1 \ud6c4 \uac00\uc7a5 \uba3c\uc800 \uccb4\uac10\ub418\ub294 \uace0\uc815\ube44 \uc911 \ud558\ub098\uac00 \uac74\uac15\ubcf4\ud5d8\ub8cc\uc785\ub2c8\ub2e4. \uc9c1\uc7a5\uac00\uc785\uc790\uc77c \ub54c\ub294 \ud68c\uc0ac\uac00 \uc77c\ubd80\ub97c \ubd80\ub2f4\ud588\uc9c0\ub9cc, \uc9c0\uc5ed\uac00\uc785\uc790\ub85c \uc804\ud658\ub418\uba74 \uc18c\ub4dd\uacfc \uc7ac\uc0b0\uc744 \uae30\uc900\uc73c\ub85c \ubcf4\ud5d8\ub8cc\uac00 \uc0b0\uc815\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub798\uc11c \ud1f4\uc9c1 \uc804\ud6c4\uc5d0\ub294 \ud53c\ubd80\uc591\uc790 \uac00\ub2a5 \uc5ec\ubd80\uc640 \uc608\uc0c1 \ubcf4\ud5d8\ub8cc\ub97c \ubbf8\ub9ac \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h2>\uba3c\uc800 \ubcfc \ud575\uc2ec<\/h2>\n<ul>\n<li>\ud1f4\uc9c1 \uc9c1\ud6c4 \uc9c0\uc5ed\uac00\uc785\uc790 \uc804\ud658 \uc5ec\ubd80\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\ubc30\uc6b0\uc790\ub098 \uc790\ub140\uc758 \ud53c\ubd80\uc591\uc790 \ub4f1\ub85d \uac00\ub2a5\uc131\uc744 \ubd05\ub2c8\ub2e4.<\/li>\n<li>\uc5f0\uae08, \uc784\ub300\uc18c\ub4dd, \uc0ac\uc5c5\uc18c\ub4dd\uc774 \uc788\ub294\uc9c0 \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>\ud1f4\uc9c1 \ud6c4 \uac74\uac15\ubcf4\ud5d8\ub8cc \ud655\uc778 \ud56d\ubaa9<\/h2>\n<table>\n<tbody>\n<tr>\n<th>\uad6c\ubd84<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<th>4050 \uccb4\ud06c \ud3ec\uc778\ud2b8<\/th>\n<\/tr>\n<tr>\n<td>\uac00\uc785 \uc720\ud615<\/td>\n<td>\uc9c1\uc7a5\uac00\uc785\uc790, \uc9c0\uc5ed\uac00\uc785\uc790, \ud53c\ubd80\uc591\uc790\ub85c \uad6c\ubd84\ub429\ub2c8\ub2e4.<\/td>\n<td>\ud1f4\uc9c1 \ud6c4 \uc790\ub3d9\uc73c\ub85c \uc9c0\uc5ed\uac00\uc785\uc790\uac00 \ub420 \uc218 \uc788\uc74c<\/td>\n<\/tr>\n<tr>\n<td>\uc18c\ub4dd<\/td>\n<td>\uc5f0\uae08, \uc774\uc790, \ubc30\ub2f9, \uc784\ub300, \uc0ac\uc5c5\uc18c\ub4dd\uc774 \ubc18\uc601\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/td>\n<td>\ubd80\ubd80 \ud569\uc0b0 \uc0dd\ud65c\ube44 \uacc4\ud68d\uacfc \ud568\uaed8 \ud655\uc778<\/td>\n<\/tr>\n<tr>\n<td>\uc7ac\uc0b0<\/td>\n<td>\uc8fc\ud0dd, \ud1a0\uc9c0, \uc790\ub3d9\ucc28 \ub4f1 \uc7ac\uc0b0 \uc694\uc18c\uac00 \uc601\ud5a5\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/td>\n<td>\ubd80\ubaa8\ub2d8 \uac74\uac15\ubcf4\ud5d8\ub3c4 \ud568\uaed8 \ud655\uc778<\/td>\n<\/tr>\n<tr>\n<td>\ud53c\ubd80\uc591\uc790<\/td>\n<td>\uac00\uc871\uc758 \uc9c1\uc7a5\uac00\uc785\uc790 \ubc11\uc73c\ub85c \ub4f1\ub85d \uac00\ub2a5\ud55c\uc9c0 \ubd05\ub2c8\ub2e4.<\/td>\n<td>\uc18c\ub4dd\uacfc \uc7ac\uc0b0 \uae30\uc900 \ucda9\uc871 \uc5ec\ubd80\uac00 \uc911\uc694<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\uc2e0\uccad \uc804 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h2>\n<ul>\n<li>\ud1f4\uc9c1 \uc608\uc815\uc77c \uae30\uc900\uc73c\ub85c \uac74\uac15\ubcf4\ud5d8 \uc790\uaca9 \ubcc0\ub3d9 \uc2dc\uc810\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\ubc30\uc6b0\uc790\ub098 \uc790\ub140\uc758 \uc9c1\uc7a5\uac00\uc785\uc790 \ud53c\ubd80\uc591\uc790 \ub4f1\ub85d \uac00\ub2a5\uc131\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uad6d\ubbfc\uc5f0\uae08 \uc218\ub839 \uc608\uc815\uc561\uacfc \ub2e4\ub978 \uc18c\ub4dd\uc744 \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc608\uc0c1 \ubcf4\ud5d8\ub8cc\ub97c \ud655\uc778\ud55c \ub4a4 \uc0dd\ud65c\ube44 \uc608\uc0b0\uc5d0 \ubc18\uc601\ud569\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>4050\uc5d0\uac8c \uc911\uc694\ud55c \ud310\ub2e8 \uae30\uc900<\/h2>\n<p>4050\uc5d0\uac8c \uac74\uac15\ubcf4\ud5d8\ub8cc\ub294 \ub2e8\uc21c\ud55c \uacf5\uacfc\uae08\uc774 \uc544\ub2c8\ub77c \ud1f4\uc9c1 \ud6c4 \uc0dd\ud65c\ube44 \uacc4\ud68d\uc758 \ud575\uc2ec \ud56d\ubaa9\uc785\ub2c8\ub2e4. \ud2b9\ud788 \uc18c\ub4dd\uc774 \uc904\uc5c8\ub294\ub370 \ubcf4\ud5d8\ub8cc\uac00 \uc608\uc0c1\ubcf4\ub2e4 \ub192\uac8c \ub098\uc624\uba74 \uc0dd\ud65c\ube44 \ud750\ub984\uc774 \ud754\ub4e4\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ud53c\ubd80\uc591\uc790 \ub4f1\ub85d\uc740 \ubb34\uc870\uac74 \uac00\ub2a5\ud55c \uc81c\ub3c4\uac00 \uc544\ub2d9\ub2c8\ub2e4. \uc18c\ub4dd\uacfc \uc7ac\uc0b0 \uae30\uc900\uc774 \uc788\uc73c\uba70, \uae30\uc900\uc740 \ubc14\ub014 \uc218 \uc788\uc73c\ubbc0\ub85c \uad6d\ubbfc\uac74\uac15\ubcf4\ud5d8\uacf5\ub2e8\uc758 \ucd5c\uc2e0 \uc548\ub0b4\ub97c \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<p>\ud1f4\uc9c1 \uc9c1\ud6c4\uc5d0\ub294 \uc2e4\uc5c5\uae09\uc5ec, \uad6d\ubbfc\uc5f0\uae08, \uc784\ub300\uc18c\ub4dd, \uc0ac\uc5c5\uc18c\ub4dd\uc774 \uacb9\uce60 \uc218 \uc788\uc73c\ubbc0\ub85c \ubcf8\uc778\uc758 \uc218\uc785 \uad6c\uc870\ub97c \ud55c \ubc88\uc5d0 \uc815\ub9ac\ud574\ub450\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<p><!-- guide4050-expanded --><\/p>\n<h2>\ud1f4\uc9c1 \ud6c4 \uac74\uac15\ubcf4\ud5d8\ub8cc\uac00 \ubd80\ub2f4\ub418\ub294 \uc774\uc720<\/h2>\n<p>\uc9c1\uc7a5\uac00\uc785\uc790\uc77c \ub54c\ub294 \ubcf4\ud5d8\ub8cc \uc77c\ubd80\ub97c \ud68c\uc0ac\uac00 \ubd80\ub2f4\ud569\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \ud1f4\uc9c1 \ud6c4 \uc9c0\uc5ed\uac00\uc785\uc790\ub85c \uc804\ud658\ub418\uba74 \uc18c\ub4dd\uacfc \uc7ac\uc0b0\uc744 \uae30\uc900\uc73c\ub85c \ubcf4\ud5d8\ub8cc\uac00 \uc0b0\uc815\ub420 \uc218 \uc788\uc5b4 \uccb4\uac10 \ubd80\ub2f4\uc774 \ucee4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \uc8fc\ud0dd, \uc790\ub3d9\ucc28, \uae08\uc735\uc18c\ub4dd, \uc5f0\uae08 \uc218\ub839\uc561\uc774 \uc788\ub294 \uacbd\uc6b0 \uc608\uc0c1\ubcf4\ub2e4 \ubcf4\ud5d8\ub8cc\uac00 \ub192\uac8c \ub098\uc62c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>4050 \uc138\ub300\ub294 \ud1f4\uc9c1 \ud6c4 \ubc14\ub85c \uad6d\ubbfc\uc5f0\uae08\uc744 \ubc1b\uc9c0 \uc54a\ub294 \uacbd\uc6b0\ub3c4 \uc788\uace0, \uc7ac\ucde8\uc5c5 \uc900\ube44 \uae30\uac04\uc774 \uae38\uc5b4\uc9c8 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc2dc\uae30\uc5d0\ub294 \uc18c\ub4dd\uc740 \uc904\uc5c8\ub294\ub370 \uace0\uc815\ube44\ub294 \uadf8\ub300\ub85c \ub0a8\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc73c\ubbc0\ub85c \uac74\uac15\ubcf4\ud5d8\ub8cc\ub97c \ubbf8\ub9ac \uacc4\uc0b0\ud574\ub450\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4.<\/p>\n<p>\ubd80\ubaa8\ub2d8 \uac74\uac15\ubcf4\ud5d8\uc744 \ud568\uaed8 \ucc59\uae30\ub294 \uacbd\uc6b0\ub3c4 \ub9ce\uc2b5\ub2c8\ub2e4. \ubd80\ubaa8\ub2d8\uc774 \ud53c\ubd80\uc591\uc790\ub85c \ub4f1\ub85d\ub418\uc5b4 \uc788\ub2e4\uac00 \uc18c\ub4dd\uc774\ub098 \uc7ac\uc0b0 \uae30\uc900 \ub54c\ubb38\uc5d0 \uc9c0\uc5ed\uac00\uc785\uc790\ub85c \uc804\ud658\ub420 \uc218 \uc788\uc73c\ubbc0\ub85c, \ubcf8\uc778\ubfd0 \uc544\ub2c8\ub77c \uac00\uc871\uc758 \uc790\uaca9 \ubcc0\ub3d9\ub3c4 \uac19\uc774 \uc0b4\ud3b4\ubcf4\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\ud1f4\uc9c1 \uc804\ud6c4 \ud655\uc778\ud560 \ubcf4\ud5d8\ub8cc \ubcc0\uc218<\/h2>\n<table>\n<thead>\n<tr>\n<th>\ud56d\ubaa9<\/th>\n<th>\uc65c \uc911\uc694\ud55c\uac00<\/th>\n<th>\ud655\uc778 \ubc29\ubc95<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\uc5f0\uae08\uc18c\ub4dd<\/td>\n<td>\uad6d\ubbfc\uc5f0\uae08 \ub4f1 \uc815\uae30 \uc18c\ub4dd\uc774 \ubcf4\ud5d8\ub8cc\uc5d0 \uc601\ud5a5\uc744 \uc904 \uc218 \uc788\uc74c<\/td>\n<td>\uc608\uc0c1 \uc218\ub839\uc561 \uc815\ub9ac<\/td>\n<\/tr>\n<tr>\n<td>\uc784\ub300\uc18c\ub4dd<\/td>\n<td>\uc8fc\ud0dd \uc784\ub300\ub098 \uc0c1\uac00 \uc784\ub300 \uc18c\ub4dd\uc774 \uc788\ub294 \uacbd\uc6b0 \ud655\uc778 \ud544\uc694<\/td>\n<td>\uc18c\ub4dd \uc2e0\uace0 \ub0b4\uc5ed \ud655\uc778<\/td>\n<\/tr>\n<tr>\n<td>\ud53c\ubd80\uc591\uc790 \uac00\ub2a5\uc131<\/td>\n<td>\uac00\uc871\uc758 \uc9c1\uc7a5\uac00\uc785\uc790 \ubc11\uc73c\ub85c \ub4f1\ub85d \uac00\ub2a5\ud558\uba74 \ubd80\ub2f4 \uac10\uc18c \uac00\ub2a5<\/td>\n<td>\uac74\ubcf4\uacf5\ub2e8 \uae30\uc900 \ud655\uc778<\/td>\n<\/tr>\n<tr>\n<td>\uc7ac\ucde8\uc5c5 \uacc4\ud68d<\/td>\n<td>\uc7ac\ucde8\uc5c5 \uc2dc \ub2e4\uc2dc \uc9c1\uc7a5\uac00\uc785\uc790\ub85c \uc804\ud658\ub420 \uc218 \uc788\uc74c<\/td>\n<td>\ucde8\uc5c5 \uc608\uc0c1 \uc2dc\uc810 \ubc18\uc601<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\ubcf4\ud5d8\ub8cc\ub97c \uc904\uc774\uae30 \uc704\ud574 \ud560 \uc218 \uc788\ub294 \ud604\uc2e4\uc801 \uc900\ube44<\/h2>\n<p>\uac00\uc7a5 \uba3c\uc800 \ud560 \uc77c\uc740 \uc790\uaca9 \uc720\ud615\uc744 \ud655\uc778\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ud1f4\uc9c1 \ud6c4 \uc9c0\uc5ed\uac00\uc785\uc790\uac00 \ub418\ub294\uc9c0, \uc784\uc758\uacc4\uc18d\uac00\uc785 \uc81c\ub3c4\ub97c \uac80\ud1a0\ud560 \uc218 \uc788\ub294\uc9c0, \uac00\uc871 \ud53c\ubd80\uc591\uc790 \ub4f1\ub85d\uc774 \uac00\ub2a5\ud55c\uc9c0 \uc21c\uc11c\ub300\ub85c \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<p>\ub2e4\uc74c\uc73c\ub85c \uc18c\ub4dd \uad6c\uc870\ub97c \uc815\ub9ac\ud569\ub2c8\ub2e4. \ud1f4\uc9c1\uae08, \uc5f0\uae08, \uc784\ub300\uc18c\ub4dd, \uc0ac\uc5c5\uc18c\ub4dd\ucc98\ub7fc \uc18c\ub4dd\uc73c\ub85c \uc7a1\ud790 \uc218 \uc788\ub294 \ud56d\ubaa9\uc744 \ud55c \ubc88\uc5d0 \uc815\ub9ac\ud558\uba74 \uc0c1\ub2f4\uc744 \ubc1b\uc744 \ub54c \ud6e8\uc52c \uc815\ud655\ud558\uac8c \ubb3c\uc5b4\ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ub9c8\uc9c0\ub9c9\uc73c\ub85c \ubcf4\ud5d8\ub8cc\ub97c \uc0dd\ud65c\ube44 \uc608\uc0b0\uc5d0 \ub123\uc5b4\uc57c \ud569\ub2c8\ub2e4. \ud1f4\uc9c1 \ud6c4 \uc0dd\ud65c\ube44\ub97c \uacc4\uc0b0\ud560 \ub54c \uc2dd\ube44\uc640 \uad00\ub9ac\ube44\ub9cc \ubcf4\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc740\ub370, \uac74\uac15\ubcf4\ud5d8\ub8cc\uc640 \uad6d\ubbfc\uc5f0\uae08 \ub0a9\ubd80 \uc5ec\ubd80\uae4c\uc9c0 \ud3ec\ud568\ud574\uc57c \uc2e4\uc81c \uc6d4 \uc9c0\ucd9c\uc744 \uc54c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uacf5\uc2dd \ud655\uc778\ucc98<\/h2>\n<p>\uc81c\ub3c4\uba85\uacfc \uc2e0\uccad \uc870\uac74\uc740 \uc218\uc2dc\ub85c \ubc14\ub014 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2e4\uc81c \uc2e0\uccad \uc804\uc5d0\ub294 \uc544\ub798 \uacf5\uc2dd \ud398\uc774\uc9c0\uc5d0\uc11c \ucd5c\uc2e0 \uc548\ub0b4\ub97c \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/www.nhis.or.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\uad6d\ubbfc\uac74\uac15\ubcf4\ud5d8\uacf5\ub2e8<\/a><\/li>\n<li><a href=\"https:\/\/www.gov.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\uc815\ubd8024 \uac74\uac15\ubcf4\ud5d8 \uc790\uaca9\ub4dd\uc2e4 \ud655\uc778<\/a><\/li>\n<\/ul>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<h3>\ud1f4\uc9c1\ud558\uba74 \ubc14\ub85c \uc9c0\uc5ed\uac00\uc785\uc790\uac00 \ub418\ub098\uc694?<\/h3>\n<p>\uc0c1\ud669\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \uac00\uc871 \ud53c\ubd80\uc591\uc790 \ub4f1\ub85d\uc774 \uac00\ub2a5\ud558\uba74 \uc9c0\uc5ed\uac00\uc785\uc790\uac00 \ub418\uc9c0 \uc54a\uc744 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h3>\ubcf4\ud5d8\ub8cc\ub97c \uc904\uc774\ub824\uba74 \ubb34\uc5c7\uc744 \uba3c\uc800 \ubd10\uc57c \ud558\ub098\uc694?<\/h3>\n<p>\ud53c\ubd80\uc591\uc790 \uac00\ub2a5 \uc5ec\ubd80, \uc18c\ub4dd \uc885\ub958, \uc7ac\uc0b0 \ubc18\uc601 \ud56d\ubaa9\uc744 \uba3c\uc800 \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<p><strong>\uc548\ub0b4:<\/strong> \uc774 \uae00\uc740 4050 \uc138\ub300\uac00 \uc81c\ub3c4\uc640 \uc790\uaca9 \uc815\ubcf4\ub97c \ube60\ub974\uac8c \uc774\ud574\ud558\ub3c4\ub85d \ub3d5\uae30 \uc704\ud55c \uc815\ub9ac \uae00\uc785\ub2c8\ub2e4. \ucd5c\uc885 \uc2e0\uccad \uac00\ub2a5 \uc5ec\ubd80\uc640 \uae08\uc561, \uc77c\uc815\uc740 \uac1c\uc778 \uc870\uac74\uacfc \uacf5\uc2dd \uae30\uad00\uc758 \ucd5c\uc2e0 \uc548\ub0b4\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p><!-- guide4050-related-start --><\/p>\n<section class=\"guide-related-posts\">\n<h2>\ud568\uaed8 \ubcf4\uba74 \uc88b\uc740 \uae00<\/h2>\n<p>\uc774 \uae00\uacfc \uc774\uc5b4\uc11c \ud655\uc778\ud558\uba74 \uc88b\uc740 4050 \ub9de\ucda4 \uc815\ubcf4\uc785\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/4050guide.co.kr\/housing-pension-parent-checklist\/\">\uc8fc\ud0dd\uc5f0\uae08 4050\uc774 \ubd80\ubaa8\ub2d8 \ub300\uc2e0 \ud655\uc778\ud560 \ub54c \ubcfc \uac83: \uac00\uc785\uc870\uac74\uacfc \uc0c1\ub2f4 \uc804 \uc900\ube44<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/health-insurance-dependent-loss-4050\/\">\uac74\uac15\ubcf4\ud5d8 \ud53c\ubd80\uc591\uc790 \ud0c8\ub77d \uae30\uc900 4050 \uccb4\ud06c: \ubd80\ubaa8\ub2d8\uacfc \ud1f4\uc9c1\uc790 \ubaa8\ub450 \ud655\uc778<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/living-cost-after-retirement-calculation\/\">\ud1f4\uc9c1 \ud6c4 \uc0dd\ud65c\ube44 \uacc4\uc0b0\ubc95: \uc5f0\uae08, \ubcf4\ud5d8\ub8cc, \ub300\ucd9c\uc0c1\ud658\uc744 \ud55c \ubc88\uc5d0 \ubcf4\uae30<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/severance-pay-vs-retirement-pension-4050\/\">\ud1f4\uc9c1\uae08 \uc911\uac04\uc815\uc0b0\uacfc \ud1f4\uc9c1\uc5f0\uae08 \ucc28\uc774: 4050\uc774 \ud5f7\uac08\ub9ac\uae30 \uc26c\uc6b4 \ubd80\ubd84<\/a><\/li>\n<\/ul>\n<\/section>\n<p><!-- guide4050-related-end --><\/p>\n","protected":false},"excerpt":{"rendered":"<p>\ud1f4\uc9c1 \ud6c4 \uac00\uc7a5 \uba3c\uc800 \uccb4\uac10\ub418\ub294 \uace0\uc815\ube44 \uc911 \ud558\ub098\uac00 \uac74\uac15\ubcf4\ud5d8\ub8cc\uc785\ub2c8\ub2e4. \uc9c1\uc7a5\uac00\uc785\uc790\uc77c \ub54c\ub294 \ud68c\uc0ac\uac00 \uc77c\ubd80\ub97c \ubd80\ub2f4\ud588\uc9c0\ub9cc, \uc9c0\uc5ed\uac00\uc785\uc790\ub85c \uc804\ud658\ub418\uba74 \uc18c\ub4dd\uacfc \uc7ac\uc0b0\uc744 \uae30\uc900\uc73c\ub85c \ubcf4\ud5d8\ub8cc\uac00 \uc0b0\uc815\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub798\uc11c \ud1f4\uc9c1 \uc804\ud6c4\uc5d0\ub294 \ud53c\ubd80\uc591\uc790 \uac00\ub2