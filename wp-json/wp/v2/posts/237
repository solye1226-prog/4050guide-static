{"id":237,"date":"2026-05-25T11:25:30","date_gmt":"2026-05-25T02:25:30","guid":{"rendered":"https:\/\/4050guide.co.kr\/basic-pension-income-recognition-check\/"},"modified":"2026-05-26T18:38:17","modified_gmt":"2026-05-26T09:38:17","slug":"basic-pension-income-recognition-check","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/basic-pension-income-recognition-check\/","title":{"rendered":"\uae30\ucd08\uc5f0\uae08 \uc2e0\uccad \uc804 \ud655\uc778\ud560 \uac83: \uc18c\ub4dd\uc778\uc815\uc561\uacfc \ud0c8\ub77d \uc0ac\uc720 \uc27d\uac8c \uc815\ub9ac"},"content":{"rendered":"<p>\uae30\ucd08\uc5f0\uae08\uc740 \ub9cc 65\uc138 \uc774\ud6c4 \ub9ce\uc740 \uac00\uad6c\uac00 \ud655\uc778\ud558\ub294 \ub300\ud45c \ubcf5\uc9c0 \uc81c\ub3c4\uc785\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \ub098\uc774\uac00 \ub410\ub2e4\uace0 \ubaa8\ub450 \ubc1b\uc744 \uc218 \uc788\ub294 \uac83\uc740 \uc544\ub2c8\uba70, \uc18c\ub4dd\uacfc \uc7ac\uc0b0\uc744 \ubc18\uc601\ud55c \uc18c\ub4dd\uc778\uc815\uc561 \uae30\uc900\uc744 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \ubd80\ubaa8\ub2d8 \uc2e0\uccad\uc744 \ub3c4\uc640\uc8fc\ub294 4050 \uc790\ub140\ub77c\uba74 \uc900\ube44\uc11c\ub958\uc640 \ud0c8\ub77d \uc0ac\uc720\ub97c \uba3c\uc800 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uba3c\uc800 \ubcfc \ud575\uc2ec<\/h2>\n<ul>\n<li>\ub098\uc774 \uc694\uac74\uacfc \uc18c\ub4dd\uc778\uc815\uc561 \uae30\uc900\uc744 \ud568\uaed8 \ubd05\ub2c8\ub2e4.<\/li>\n<li>\ubd80\ubd80\uac00\uad6c\ub294 \ub2e8\ub3c5\uac00\uad6c\uc640 \uae30\uc900\uc774 \ub2e4\ub985\ub2c8\ub2e4.<\/li>\n<li>\uc2e0\uccad \uc7a5\uc18c\uc640 \uc900\ube44\uc11c\ub958\ub97c \ubbf8\ub9ac \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>\uae30\ucd08\uc5f0\uae08 \uc2e0\uccad \uc804 \ud655\uc778 \ud56d\ubaa9<\/h2>\n<table>\n<tbody>\n<tr>\n<th>\uad6c\ubd84<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<th>4050 \uccb4\ud06c \ud3ec\uc778\ud2b8<\/th>\n<\/tr>\n<tr>\n<td>\ub098\uc774<\/td>\n<td>\ub9cc 65\uc138 \uc774\uc0c1 \uc5ec\ubd80\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<td>\uc0dd\uc77c\uc774 \uc9c0\ub09c \ub4a4 \uc2e0\uccad \uac00\ub2a5\ud55c\uc9c0 \ud655\uc778<\/td>\n<\/tr>\n<tr>\n<td>\uc18c\ub4dd<\/td>\n<td>\uadfc\ub85c, \uc0ac\uc5c5, \uc5f0\uae08, \uae08\uc735\uc18c\ub4dd \ub4f1\uc774 \ubc18\uc601\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/td>\n<td>\uad6d\ubbfc\uc5f0\uae08 \uc218\ub839\uc561\ub3c4 \ud568\uaed8 \ud655\uc778<\/td>\n<\/tr>\n<tr>\n<td>\uc7ac\uc0b0<\/td>\n<td>\uc8fc\ud0dd, \ud1a0\uc9c0, \uc608\uae08 \ub4f1 \uc7ac\uc0b0\uc774 \ubc18\uc601\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/td>\n<td>\ubd80\ubaa8\ub2d8 \uba85\uc758 \uc7ac\uc0b0 \uc815\ub9ac \ud544\uc694<\/td>\n<\/tr>\n<tr>\n<td>\uac00\uad6c \uc720\ud615<\/td>\n<td>\ub2e8\ub3c5\uac00\uad6c\uc640 \ubd80\ubd80\uac00\uad6c \uae30\uc900\uc774 \ub2e4\ub985\ub2c8\ub2e4.<\/td>\n<td>\ubc30\uc6b0\uc790 \uc18c\ub4dd\uacfc \uc7ac\uc0b0\ub3c4 \ud568\uaed8 \ud655\uc778<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\uc2e0\uccad \uc804 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h2>\n<ul>\n<li>\ubd80\ubaa8\ub2d8\uc758 \uc8fc\ubbfc\ub4f1\ub85d\uc0c1 \uac00\uad6c \uad6c\uc131\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uad6d\ubbfc\uc5f0\uae08\uacfc \uae30\ud0c0 \uc5f0\uae08 \uc218\ub839\uc561\uc744 \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc8fc\ud0dd, \uc608\uae08, \uc790\ub3d9\ucc28 \ub4f1 \uc7ac\uc0b0 \ub0b4\uc5ed\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\ubcf5\uc9c0\ub85c \ub610\ub294 \uc8fc\ubbfc\uc13c\ud130\uc5d0\uc11c \ucd5c\uc2e0 \uae30\uc900\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>4050\uc5d0\uac8c \uc911\uc694\ud55c \ud310\ub2e8 \uae30\uc900<\/h2>\n<p>\uae30\ucd08\uc5f0\uae08\uc740 \ubd80\ubaa8\ub2d8 \uc0dd\ud65c\ube44\uc640 \uc9c1\uc811 \uc5f0\uacb0\ub418\ub294 \uc81c\ub3c4\uc774\uae30 \ub54c\ubb38\uc5d0 4050 \uc790\ub140\uac00 \ub300\uc2e0 \uc815\ubcf4\ub97c \ucc3e\uc544\ubcf4\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \uc774\ub54c \uc911\uc694\ud55c \uac83\uc740 \u201c\ub098\uc774\uac00 \ub410\ub294\uc9c0\u201d\ubcf4\ub2e4 \u201c\uc18c\ub4dd\uc778\uc815\uc561 \uae30\uc900\uc5d0 \ub4e4\uc5b4\uc624\ub294\uc9c0\u201d\uc785\ub2c8\ub2e4.<\/p>\n<p>\uc18c\ub4dd\uc778\uc815\uc561\uc740 \ub2e8\uc21c \uc6d4\uae09\ub9cc \ubcf4\ub294 \uac1c\ub150\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uc7ac\uc0b0\uacfc \uae08\uc735\uc790\uc0b0, \uc5f0\uae08 \uc218\ub839\uc561 \ub4f1\uc774 \ubc18\uc601\ub420 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2e0\uccad \uc804 \uc790\ub8cc\ub97c \uc815\ub9ac\ud574\ub450\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ud0c8\ub77d\ud558\ub354\ub77c\ub3c4 \uc0c1\ud669\uc774 \ubc14\ub00c\uba74 \ub2e4\uc2dc \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubc30\uc6b0\uc790 \uc0ac\ub9dd, \uc18c\ub4dd \uac10\uc18c, \uc7ac\uc0b0 \ubcc0\ub3d9\ucc98\ub7fc \uc870\uac74\uc774 \ub2ec\ub77c\uc84c\ub2e4\uba74 \uc8fc\ubbfc\uc13c\ud130\ub098 \ubcf5\uc9c0\ub85c\uc5d0\uc11c \ub2e4\uc2dc \uc0c1\ub2f4\ud574\ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p><!-- guide4050-expanded --><\/p>\n<h2>\uc18c\ub4dd\uc778\uc815\uc561\uc744 \uc774\ud574\ud574\uc57c \ud558\ub294 \uc774\uc720<\/h2>\n<p>\uae30\ucd08\uc5f0\uae08\uc740 \ub2e8\uc21c\ud788 \ub9cc 65\uc138\uac00 \ub418\uba74 \uc790\ub3d9\uc73c\ub85c \uc9c0\uae09\ub418\ub294 \uc81c\ub3c4\uac00 \uc544\ub2d9\ub2c8\ub2e4. \ubcf8\uc778\uacfc \ubc30\uc6b0\uc790\uc758 \uc18c\ub4dd\uacfc \uc7ac\uc0b0\uc744 \uc77c\uc815 \ubc29\uc2dd\uc73c\ub85c \ud658\uc0b0\ud55c \uc18c\ub4dd\uc778\uc815\uc561\uc774 \uae30\uc900\uc5d0 \ub9de\uc544\uc57c \ud569\ub2c8\ub2e4. \uadf8\ub798\uc11c \ub098\uc774\ub294 \ucda9\uc871\ud588\uc9c0\ub9cc \uc18c\ub4dd\uc774\ub098 \uc7ac\uc0b0 \ub54c\ubb38\uc5d0 \ub300\uc0c1\uc5d0\uc11c \uc81c\uc678\ub418\ub294 \uacbd\uc6b0\uac00 \uc0dd\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>4050 \uc790\ub140\uac00 \ubd80\ubaa8\ub2d8 \uc2e0\uccad\uc744 \ub3c4\uc640\uc904 \ub54c \uac00\uc7a5 \ub9ce\uc774 \ud5f7\uac08\ub9ac\ub294 \ubd80\ubd84\ub3c4 \uc774 \uc9c0\uc810\uc785\ub2c8\ub2e4. \ubd80\ubaa8\ub2d8\uc774 \uc2e4\uc81c\ub85c \uc190\uc5d0 \uc950\ub294 \ud604\uae08 \uc218\uc785\uc740 \ub9ce\uc9c0 \uc54a\uc544 \ubcf4\uc5ec\ub3c4 \uc8fc\ud0dd, \uc608\uae08, \uc5f0\uae08, \uc790\ub3d9\ucc28 \ub4f1\uc774 \ubc18\uc601\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\uc18c\ub4dd\uc778\uc815\uc561 \uacc4\uc0b0\uc740 \uac1c\uc778\uc774 \uc815\ud655\ud788 \uacc4\uc0b0\ud558\uae30 \uc5b4\ub835\uae30 \ub54c\ubb38\uc5d0 \ubcf5\uc9c0\ub85c \ubaa8\uc758\uacc4\uc0b0\uc774\ub098 \uc8fc\ubbfc\uc13c\ud130 \uc0c1\ub2f4\uc744 \ud65c\uc6a9\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \ub2e8, \ubaa8\uc758\uacc4\uc0b0\uc740 \ucc38\uace0\uc6a9\uc774\uace0 \ucd5c\uc885 \ud310\ub2e8\uc740 \uc2e0\uccad \ud6c4 \uc2ec\uc0ac\ub97c \ud1b5\ud574 \uacb0\uc815\ub429\ub2c8\ub2e4.<\/p>\n<h2>\uae30\ucd08\uc5f0\uae08 \ud0c8\ub77d \uac00\ub2a5\uc131\uc744 \ub192\uc774\ub294 \uc694\uc18c<\/h2>\n<table>\n<thead>\n<tr>\n<th>\ud56d\ubaa9<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<th>\uc8fc\uc758\ud560 \uc810<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\ubd80\ubd80\uac00\uad6c<\/td>\n<td>\ubc30\uc6b0\uc790\uc758 \uc18c\ub4dd\uacfc \uc7ac\uc0b0\ub3c4 \ud568\uaed8 \ubc18\uc601\ub420 \uc218 \uc788\uc74c<\/td>\n<td>\ub2e8\ub3c5\uac00\uad6c \uae30\uc900\uacfc \ub2e4\ub984<\/td>\n<\/tr>\n<tr>\n<td>\uad6d\ubbfc\uc5f0\uae08<\/td>\n<td>\uc218\ub839\uc561\uc774 \uc18c\ub4dd\uc5d0 \ubc18\uc601\ub420 \uc218 \uc788\uc74c<\/td>\n<td>\uc5f0\uae08\uc774 \uc788\ub2e4\uace0 \ubb34\uc870\uac74 \uc81c\uc678\ub294 \uc544\ub2d8<\/td>\n<\/tr>\n<tr>\n<td>\ubd80\ub3d9\uc0b0<\/td>\n<td>\uc8fc\ud0dd\uacfc \ud1a0\uc9c0 \ub4f1 \uc7ac\uc0b0\uc774 \ubc18\uc601\ub420 \uc218 \uc788\uc74c<\/td>\n<td>\uc2e4\uac70\uc8fc \uc8fc\ud0dd\ub3c4 \uae30\uc900 \ud655\uc778 \ud544\uc694<\/td>\n<\/tr>\n<tr>\n<td>\uae08\uc735\uc7ac\uc0b0<\/td>\n<td>\uc608\uae08, \uc801\uae08, \ubcf4\ud5d8 \ub4f1 \uae08\uc735\uc7ac\uc0b0 \ud655\uc778<\/td>\n<td>\ucd5c\uadfc \ubcc0\ub3d9 \ub0b4\uc5ed\ub3c4 \uc900\ube44<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\ubd80\ubaa8\ub2d8 \uc2e0\uccad\uc744 \ub3c4\uc6b8 \ub54c\uc758 \uc21c\uc11c<\/h2>\n<p>\uba3c\uc800 \ubd80\ubaa8\ub2d8\uc774 \uc2e4\uc81c\ub85c \uc2e0\uccad \uc758\uc0ac\uac00 \uc788\ub294\uc9c0 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \ubcf5\uc9c0 \uc81c\ub3c4 \uc2e0\uccad\uc744 \ubd80\ub2f4\uc2a4\ub7fd\uac8c \ub290\ub07c\ub294 \uacbd\uc6b0\ub3c4 \uc788\uc73c\ubbc0\ub85c \uc790\ub140\uac00 \uc77c\ubc29\uc801\uc73c\ub85c \uacb0\uc815\ud558\uae30\ubcf4\ub2e4 \uc124\uba85\uc744 \ucda9\ubd84\ud788 \ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ub2e4\uc74c\uc73c\ub85c \uc8fc\ubbfc\ub4f1\ub85d\uc0c1 \uac00\uad6c \ud615\ud0dc\uc640 \ubc30\uc6b0\uc790 \uc5ec\ubd80\ub97c \ud655\uc778\ud569\ub2c8\ub2e4. \ub2e8\ub3c5\uac00\uad6c\uc778\uc9c0 \ubd80\ubd80\uac00\uad6c\uc778\uc9c0\uc5d0 \ub530\ub77c \uae30\uc900\uc774 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4.<\/p>\n<p>\ub9c8\uc9c0\ub9c9\uc73c\ub85c \ubcf5\uc9c0\ub85c \ub610\ub294 \uc8fc\ubbfc\uc13c\ud130\uc5d0\uc11c \uc0c1\ub2f4\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \uc18c\ub4dd\uacfc \uc7ac\uc0b0 \uc790\ub8cc\ub97c \ub300\ub7b5 \uc815\ub9ac\ud574\uac00\uba74 \uc0c1\ub2f4\uc774 \ud6e8\uc52c \ube60\ub974\uac8c \uc9c4\ud589\ub429\ub2c8\ub2e4.<\/p>\n<h2>\uacf5\uc2dd \ud655\uc778\ucc98<\/h2>\n<p>\uc81c\ub3c4\uba85\uacfc \uc2e0\uccad \uc870\uac74\uc740 \uc218\uc2dc\ub85c \ubc14\ub014 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2e4\uc81c \uc2e0\uccad \uc804\uc5d0\ub294 \uc544\ub798 \uacf5\uc2dd \ud398\uc774\uc9c0\uc5d0\uc11c \ucd5c\uc2e0 \uc548\ub0b4\ub97c \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/www.bokjiro.go.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\ubcf5\uc9c0\ub85c \uae30\ucd08\uc5f0\uae08<\/a><\/li>\n<li><a href=\"https:\/\/www.gov.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\uc815\ubd8024<\/a><\/li>\n<\/ul>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<h3>\uad6d\ubbfc\uc5f0\uae08\uc744 \ubc1b\uc73c\uba74 \uae30\ucd08\uc5f0\uae08\uc744 \ubabb \ubc1b\ub098\uc694?<\/h3>\n<p>\ubb34\uc870\uac74 \ubabb \ubc1b\ub294 \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4. \uad6d\ubbfc\uc5f0\uae08 \uc218\ub839\uc561\uacfc \uc804\uccb4 \uc18c\ub4dd\uc778\uc815\uc561\uc744 \ud568\uaed8 \ubd10\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h3>\uc790\ub140 \uc18c\ub4dd\ub3c4 \ubc18\uc601\ub418\ub098\uc694?<\/h3>\n<p>\uae30\ucd08\uc5f0\uae08\uc740 \uae30\ubcf8\uc801\uc73c\ub85c \ubcf8\uc778\uacfc \ubc30\uc6b0\uc790\uc758 \uc18c\ub4dd\u00b7\uc7ac\uc0b0\uc744 \uc911\uc2ec\uc73c\ub85c \ubcf4\uc9c0\ub9cc, \uc138\ubd80 \uae30\uc900\uc740 \uacf5\uc2dd \uc548\ub0b4\ub97c \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<p><strong>\uc548\ub0b4:<\/strong> \uc774 \uae00\uc740 4050 \uc138\ub300\uac00 \uc81c\ub3c4\uc640 \uc790\uaca9 \uc815\ubcf4\ub97c \ube60\ub974\uac8c \uc774\ud574\ud558\ub3c4\ub85d \ub3d5\uae30 \uc704\ud55c \uc815\ub9ac \uae00\uc785\ub2c8\ub2e4. \ucd5c\uc885 \uc2e0\uccad \uac00\ub2a5 \uc5ec\ubd80\uc640 \uae08\uc561, \uc77c\uc815\uc740 \uac1c\uc778 \uc870\uac74\uacfc \uacf5\uc2dd \uae30\uad00\uc758 \ucd5c\uc2e0 \uc548\ub0b4\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p><!-- guide4050-related-start --><\/p>\n<section class=\"guide-related-posts\">\n<h2>\ud568\uaed8 \ubcf4\uba74 \uc88b\uc740 \uae00<\/h2>\n<p>\uc774 \uae00\uacfc \uc774\uc5b4\uc11c \ud655\uc778\ud558\uba74 \uc88b\uc740 4050 \ub9de\ucda4 \uc815\ubcf4\uc785\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/4050guide.co.kr\/senior-tailored-care-service-parents-guide\/\">\ubd80\ubaa8\ub2d8 \ub178\uc778\ub9de\ucda4\ub3cc\ubd04\uc11c\ube44\uc2a4 \ud655\uc778\ubc95: \uc2e0\uccad \ub300\uc0c1\uacfc \uc0c1\ub2f4 \uc804 \uc900\ube44\uc11c\ub958<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/summer-2026-energy-voucher-parent-checklist\/\">2026 \uc5ec\ub984 \uc5d0\ub108\uc9c0\ubc14\uc6b0\ucc98 \ubd80\ubaa8\ub2d8 \ub300\uc2e0 \ud655\uc778\ud560 \uac83: \ub300\uc0c1, \uc2e0\uccad\ucc98, \uc0ac\uc6a9\ucc98<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/senior-job-program-application-guide\/\">\ub178\uc778\uc77c\uc790\ub9ac \uc2e0\uccad\ubc29\ubc95: \ubd80\ubaa8\ub2d8 \uc77c\uc790\ub9ac\uc640 \uc0ac\ud68c\ud65c\ub3d9 \uc9c0\uc6d0\uc0ac\uc5c5 \ud655\uc778<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/dementia-test-cost-support-guide\/\">\uce58\ub9e4\uac80\uc0ac\ube44 \uc9c0\uc6d0 \ud655\uc778\ubc29\ubc95: \ubcf4\uac74\uc18c \uc0c1\ub2f4 \uc804 \uc900\ube44\ud560 \uac83<\/a><\/li>\n<\/ul>\n<\/section>\n<p><!-- guide4050-related-end --><\/p>\n<p><!-- 4050_SHORT_UPLIFT_START --><\/p>\n<section class=\"guide-short-uplift\">\n<h2>\ubcf5\uc9c0\uc81c\ub3c4 \ud655\uc778 \uc804 \uc900\ube44\ud560 \uac83<\/h2>\n<p>\ubcf5\uc9c0\uc81c\ub3c4\ub294 \uc774\ub984\uc774 \ube44\uc2b7\ud574\ub3c4 \ub300\uc0c1, \uc18c\ub4dd\u00b7\uc7ac\uc0b0 \uae30\uc900, \uc2e0\uccad\ucc98\uac00 \ub2e4\ub985\ub2c8\ub2e4. \ubd80\ubaa8\ub2d8 \ub300\uc2e0 \uc54c\uc544\ubcf4\ub294 \uacbd\uc6b0\ub77c\uba74 \uc0dd\ub144\uc6d4\uc77c, \uc18c\ub4dd, \uc7ac\uc0b0, \uac70\uc8fc\uc9c0, \uac74\uac15 \uc0c1\ud0dc\ub97c \uba3c\uc800 \uc815\ub9ac\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<figure class=\"wp-block-table\">\n<table>\n<tr>\n<th>\ud655\uc778 \uc21c\uc11c<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<th>\ud310\ub2e8 \uae30\uc900<\/th>\n<\/tr>\n<tr>\n<td>1\ub2e8\uacc4<\/td>\n<td>\ub300\uc0c1 \uc870\uac74<\/td>\n<td>\ub098\uc774, \uac00\uad6c \ud615\ud0dc, \uac74\uac15 \uc0c1\ud0dc\ub97c \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>2\ub2e8\uacc4<\/td>\n<td>\uc18c\ub4dd\u00b7\uc7ac\uc0b0<\/td>\n<td>\ubcf8\uc778\ubfd0 \uc544\ub2c8\ub77c \uac00\uad6c \uae30\uc900\uc778\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>3\ub2e8\uacc4<\/td>\n<td>\uc2e0\uccad\ucc98<\/td>\n<td>\ubcf5\uc9c0\ub85c, \uc8fc\ubbfc\uc13c\ud130, \ubcf4\uac74\uc18c \uc911 \uc5b4\ub514\uc778\uc9c0 \uad6c\ubd84\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>4\ub2e8\uacc4<\/td>\n<td>\uc900\ube44\uc11c\ub958<\/td>\n<td>\uc2e0\ubd84\uc9