{"id":139,"date":"2026-05-22T16:39:10","date_gmt":"2026-05-22T07:39:10","guid":{"rendered":"https:\/\/4050guide.co.kr\/local-middle-aged-support-program-search\/"},"modified":"2026-05-26T18:38:18","modified_gmt":"2026-05-26T09:38:18","slug":"local-middle-aged-support-program-search","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/local-middle-aged-support-program-search\/","title":{"rendered":"\uc9c0\uc790\uccb4 \uc911\uc7a5\ub144 \uc9c0\uc6d0\uc0ac\uc5c5 \ucc3e\ub294 \ubc95: \uc11c\uc6b8\u00b7\uacbd\uae30\u00b7\ubd80\uc0b0\ucc98\ub7fc \uc9c0\uc5ed\ubcc4\ub85c \ubcf4\ub294 \ubc29\ubc95"},"content":{"rendered":"<p>\uc911\uc7a5\ub144 \uc9c0\uc6d0\uc0ac\uc5c5\uc740 \uc911\uc559\uc815\ubd80 \uc81c\ub3c4\ubfd0 \uc544\ub2c8\ub77c \uc9c0\uc790\uccb4 \uc0ac\uc5c5\ub3c4 \ub9ce\uc2b5\ub2c8\ub2e4. \uac19\uc740 \uc911\uc7a5\ub144 \uc77c\uc790\ub9ac\ub77c\ub3c4 \uc11c\uc6b8, \uacbd\uae30, \ubd80\uc0b0, \ub300\uad6c \ub4f1 \uc9c0\uc5ed\ubcc4\ub85c \uc6b4\uc601 \ubc29\uc2dd\uacfc \uc2e0\uccad \uae30\uac04\uc774 \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>4050 \uc138\ub300\uac00 \uc9c0\uc6d0\uc0ac\uc5c5\uc744 \ucc3e\uc744 \ub54c\ub294 \uc804\uad6d \uacf5\ud1b5 \uc81c\ub3c4\uc640 \uc9c0\uc5ed \uc0ac\uc5c5\uc744 \ub098\ub220\uc11c \ud655\uc778\ud574\uc57c \ub193\uce58\ub294 \uc815\ubcf4\ub97c \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc9c0\uc5ed \uc9c0\uc6d0\uc0ac\uc5c5 \uac80\uc0c9\ud45c<\/h2>\n<table class=\"guide-table\">\n<tbody>\n<tr>\n<th>\uc804\uad6d \uacf5\ud1b5<\/th>\n<td>\uace0\uc6a924, \uc815\ubd8024, \uc911\uc7a5\ub144\uc6cc\ud06c\ub137<\/td>\n<\/tr>\n<tr>\n<th>\uc9c0\uc5ed \uc0ac\uc5c5<\/th>\n<td>\uc2dc\u00b7\ub3c4\uccad, \uad6c\uccad, \uc77c\uc790\ub9ac\uc13c\ud130, \ud3c9\uc0dd\ud559\uc2b5\ud3ec\ud138<\/td>\n<\/tr>\n<tr>\n<th>\uac80\uc0c9 \ud0a4\uc6cc\ub4dc<\/th>\n<td>\uc911\uc7a5\ub144, \uc2e0\uc911\ub144, 4050, \uc7ac\ucde8\uc5c5, \uc9c1\uc5c5\ud6c8\ub828<\/td>\n<\/tr>\n<tr>\n<th>\uc8fc\uc758\uc810<\/th>\n<td>\uac70\uc8fc\uc9c0 \uc81c\ud55c, \uc811\uc218 \uae30\uac04, \uc120\ucc29\uc21c \uc5ec\ubd80<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\ud655\uc778 \uc21c\uc11c<\/h2>\n<ol>\n<li>\uc815\ubd8024\uc5d0\uc11c \uc911\uc7a5\ub144 \ud0a4\uc6cc\ub4dc\ub85c \uacf5\uacf5\ud61c\ud0dd\uc744 \uac80\uc0c9\ud569\ub2c8\ub2e4.<\/li>\n<li>\uac70\uc8fc\uc9c0 \uc2dc\uccad\u00b7\uad6c\uccad \ud648\ud398\uc774\uc9c0\uc5d0\uc11c \uc911\uc7a5\ub144 \ub610\ub294 \uc77c\uc790\ub9ac \uba54\ub274\ub97c \ubd05\ub2c8\ub2e4.<\/li>\n<li>\uc9c0\uc5ed \uc77c\uc790\ub9ac\uc13c\ud130\uc640 \ud3c9\uc0dd\ud559\uc2b5\ud3ec\ud138 \uacf5\uace0\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc811\uc218 \uae30\uac04\uacfc \uac70\uc8fc\uc9c0 \uc81c\ud55c\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc628\ub77c\uc778 \uc2e0\uccad\uc774 \uc5b4\ub824\uc6b0\uba74 \uc804\ud654 \uc0c1\ub2f4\uc73c\ub85c \uc808\ucc28\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<\/ol>\n<h2>4050 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h2>\n<ul>\n<li>\uc8fc\ubbfc\ub4f1\ub85d\uc0c1 \uac70\uc8fc\uc9c0\uac00 \ud574\ub2f9 \uc9c0\uc5ed\uc778\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc5f0\ub839 \uae30\uc900\uc774 40\ub300\uc778\uc9c0 50\ub300\uc778\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uad50\uc721\ube44 \uc9c0\uc6d0\uc778\uc9c0, \uc77c\uc790\ub9ac \uc5f0\uacb0\uc778\uc9c0, \ud604\uae08\uc131 \uc9c0\uc6d0\uc778\uc9c0 \uad6c\ubd84\ud569\ub2c8\ub2e4.<\/li>\n<li>\ubaa8\uc9d1 \ub9c8\uac10 \ud6c4 \ub300\uae30 \uc2e0\uccad\uc774 \uac00\ub2a5\ud55c\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>\uc0c1\ud669\ubcc4 \ud310\ub2e8 \uae30\uc900<\/h2>\n<h3>\uc11c\uc6b8 \uac70\uc8fc\uc790<\/h3>\n<p>\uc11c\uc6b8\uc2dc\uc640 \uc790\uce58\uad6c \uc77c\uc790\ub9ac\uc13c\ud130, 50\ud50c\ub7ec\uc2a4 \uad00\ub828 \uae30\uad00\uc744 \ud568\uaed8 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h3>\uacbd\uae30 \uac70\uc8fc\uc790<\/h3>\n<p>\uacbd\uae30\ub3c4 \uc77c\uc790\ub9ac\uc7ac\ub2e8\uacfc \uc2dc\uad70 \uc77c\uc790\ub9ac\uc13c\ud130 \uacf5\uace0\ub97c \ud568\uaed8 \ubd10\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h3>\ubd80\uc0b0\u00b7\ub300\uad6c \ub4f1 \uad11\uc5ed\uc2dc<\/h3>\n<p>\uc2dc\uccad \uc77c\uc790\ub9ac \ud3ec\ud138\uacfc \uad6c\uad70\ubcc4 \ud3c9\uc0dd\ud559\uc2b5\u00b7\ucde8\uc5c5\uc9c0\uc6d0 \uacf5\uace0\ub97c \uac19\uc774 \ud655\uc778\ud569\ub2c8\ub2e4.<\/p>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<details>\n<summary>\uc9c0\uc5ed \uc9c0\uc6d0\uc0ac\uc5c5\uc740 \uc5b4\ub514\uac00 \uac00\uc7a5 \ube60\ub978\uac00\uc694?<\/summary>\n<p>\uac70\uc8fc\uc9c0 \uc2dc\uccad\u00b7\uad6c\uccad \ud648\ud398\uc774\uc9c0\uc640 \uc77c\uc790\ub9ac\uc13c\ud130 \uacf5\uc9c0\uac00 \ube60\ub978 \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4.<\/p>\n<\/details>\n<details>\n<summary>\ub2e4\ub978 \uc9c0\uc5ed \uc0ac\uc5c5\ub3c4 \uc2e0\uccad\ud560 \uc218 \uc788\ub098\uc694?<\/summary>\n<p>\ub300\ubd80\ubd84 \uac70\uc8fc\uc9c0 \uc81c\ud55c\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uacf5\uace0\uc758 \uc2e0\uccad \uc790\uaca9\uc744 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<\/details>\n<h2>\uacf5\uc2dd \ud655\uc778\ucc98<\/h2>\n<p>\uc774 \uae00\uc740 \uc2e0\uccad \ubc29\ud5a5\uc744 \uc7a1\uae30 \uc704\ud55c \uc815\ub9ac\uc785\ub2c8\ub2e4. \uc2e4\uc81c \uae30\uc900, \uae30\uac04, \uae08\uc561, \ud544\uc694 \uc11c\ub958\ub294 \ubc14\ub014 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2e0\uccad \uc804 \uacf5\uc2dd \ud398\uc774\uc9c0\uc5d0\uc11c \ucd5c\uc2e0 \ub0b4\uc6a9\uc744 \ud655\uc778\ud558\uc138\uc694.<\/p>\n<ul>\n<li><a href=\"https:\/\/www.gov.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\uc815\ubd8024<\/a><\/li>\n<li><a href=\"https:\/\/www.work24.go.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\uace0\uc6a924<\/a><\/li>\n<\/ul>\n<div class=\"guide-related\"><\/div>\n<p><!-- guide4050-depth-expand --><\/p>\n<h2>4050 \uae30\uc900\uc73c\ub85c \uba3c\uc800 \ud310\ub2e8\ud560 \ubd80\ubd84<\/h2>\n<p>\uc9c0\uc790\uccb4 \uc911\uc7a5\ub144 \uc9c0\uc6d0\uc0ac\uc5c5 \ucc3e\ub294 \ubc95: \uc11c\uc6b8\u00b7\uacbd\uae30\u00b7\ubd80\uc0b0\ucc98\ub7fc \uc9c0\uc5ed\ubcc4\ub85c \ubcf4\ub294 \ubc29\ubc95\ub97c \ud655\uc778\ud560 \ub54c\ub294 \ub2e8\uc21c\ud788 \uc774\ub984\ub9cc \ubcf4\uace0 \uacb0\uc815\ud558\uae30\ubcf4\ub2e4 \ub0b4 \uc0c1\ud669\uc5d0 \uc2e4\uc81c\ub85c \ub9de\ub294\uc9c0\ubd80\ud130 \ubcf4\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. 40\ub300\uc640 50\ub300\ub294 \uc774\ubbf8 \uc9c1\uc7a5 \uacbd\ud5d8, \uac00\uc871 \ubd80\uc591, \uac74\uac15\ubcf4\ud5d8\ub8cc, \ud1f4\uc9c1 \uc77c\uc815, \ubd80\ubaa8\ub2d8 \ub3cc\ubd04 \uac19\uc740 \uc870\uac74\uc774 \ud568\uaed8 \uc6c0\uc9c1\uc774\ub294 \uacbd\uc6b0\uac00 \ub9ce\uae30 \ub54c\ubb38\uc5d0 \uac19\uc740 \uc81c\ub3c4\ub77c\ub3c4 \uccb4\uac10\ub418\ub294 \uc720\ub9ac\ud568\uc774 \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ud2b9\ud788 \uc2e0\uccad\ud615 \uc81c\ub3c4\ub098 \uc790\uaca9\uc99d \uc815\ubcf4\ub294 \uad11\uace0 \ubb38\uad6c\ubcf4\ub2e4 \uacf5\uc2dd \uc870\uac74\uacfc \uc2e4\uc81c \ud65c\uc6a9\ucc98\ub97c \ud568\uaed8 \ubd10\uc57c \ud569\ub2c8\ub2e4. \uc9c0\uc6d0 \ub300\uc0c1, \uc2e0\uccad \uae30\uac04, \uc900\ube44\uc11c\ub958, \ubcf8\uc778\ubd80\ub2f4 \uc5ec\ubd80, \uc0c1\ub2f4 \ucc3d\uad6c\ub97c \uba3c\uc800 \ud655\uc778\ud558\uba74 \uc2dc\uac04\uc744 \uc904\uc77c \uc218 \uc788\uace0, \uc2e0\uccad \ud6c4 \ud0c8\ub77d\ud558\uac70\ub098 \uacfc\uc815 \uc218\ub8cc \ud6c4 \ud65c\uc6a9\ud558\uc9c0 \ubabb\ud558\ub294 \uc0c1\ud669\uc744 \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc9c0\uc6d0\uae08 \uc2e0\uccad \uc804 \ud655\uc778 \uc21c\uc11c<\/h2>\n<table>\n<thead>\n<tr>\n<th>\ud655\uc778 \uc21c\uc11c<\/th>\n<th>\ub0b4\uc6a9<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\ub300\uc0c1<\/td>\n<td>\ub098\uc774, \uc18c\ub4dd, \uc7ac\uc0b0, \uac00\uad6c \ud615\ud0dc \uae30\uc900\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uae30\uac04<\/td>\n<td>\uc0c1\uc2dc \uc2e0\uccad\uc778\uc9c0, \uc815\uae30 \uc2e0\uccad\uc778\uc9c0, \uae30\ud55c \ud6c4 \uc2e0\uccad\uc774 \uac00\ub2a5\ud55c\uc9c0 \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc11c\ub958<\/td>\n<td>\uc18c\ub4dd\uc790\ub8cc, \uac00\uc871\uad00\uacc4, \ud1b5\uc7a5, \uc784\ub300\ucc28\uacc4\uc57d\uc11c \ub4f1 \ud544\uc694\ud55c \uc11c\ub958\ub97c \ubbf8\ub9ac \uc900\ube44\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc2e0\uccad\ucc98<\/td>\n<td>\uc815\ubd8024, \ubcf5\uc9c0\ub85c, \uc8fc\ubbfc\uc13c\ud130, \uad00\ud560 \uae30\uad00 \uc911 \uc5b4\ub514\uc5d0\uc11c \uc2e0\uccad\ud558\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p>\uc9c0\uc6d0\uae08\uc740 \uc870\uac74\uc774 \ub9de\uc544\ub3c4 \uc2e0\uccad\ud558\uc9c0 \uc54a\uc73c\uba74 \ubc1b\uc744 \uc218 \uc5c6\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \ubd80\ubaa8\ub2d8 \ub300\uc2e0 \uc54c\uc544\ubcf4\ub294 \uacbd\uc6b0\uc5d0\ub294 \ubcf8\uc778 \uc778\uc99d, \uc704\uc784, \uac00\uc871\uad00\uacc4 \ud655\uc778\uc774 \ud544\uc694\ud560 \uc218 \uc788\uc73c\ubbc0\ub85c \uacf5\uc2dd \uc548\ub0b4\ub97c \uba3c\uc800 \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc0c1\ub2f4 \uc804 \uba54\ubaa8\ud574\ub450\uba74 \uc88b\uc740 \uc9c8\ubb38<\/h2>\n<ul>\n<li>\ub0b4 \ub098\uc774\uc640 \uace0\uc6a9 \uc0c1\ud0dc\uc5d0\uc11c \uc2e0\uccad \uac00\ub2a5\ud55c\uac00\uc694?<\/li>\n<li>\uc18c\ub4dd, \uc7ac\uc0b0, \uacbd\ub825 \ub54c\ubb38\uc5d0 \uc81c\uc678\ub420 \uc218 \uc788\ub294 \uc870\uac74\uc774 \uc788\ub098\uc694?<\/li>\n<li>\uc628\ub77c\uc778 \uc2e0\uccad\uacfc \ubc29\ubb38 \uc2e0\uccad \uc911 \uc5b4\ub5a4 \ubc29\uc2dd\uc774 \ube60\ub978\uac00\uc694?<\/li>\n<li>\uc2e0\uccad \ud6c4 \uacb0\uacfc \ud655\uc778\uae4c\uc9c0 \ubcf4\ud1b5 \uc5bc\ub9c8\ub098 \uac78\ub9ac\ub098\uc694?<\/li>\n<li>\ube44\uc2b7\ud55c \uc81c\ub3c4\ub098 \uacfc\uc815\uacfc \uc911\ubcf5 \uc774\uc6a9\uc774 \uac00\ub2a5\ud55c\uac00\uc694?<\/li>\n<\/ul>\n<p>\uc774 \uc9c8\ubb38\uc744 \ubbf8\ub9ac \uc815\ub9ac\ud574\ub450\uba74 \uc0c1\ub2f4 \uc2dc\uac04\uc774 \uc9e7\uc544\uc9c0\uace0, \ub2f4\ub2f9\uc790\uc5d0\uac8c \ud544\uc694\ud55c \uc815\ubcf4\ub97c \ube60\ub974\uac8c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \uac00\uc871 \ub300\uc2e0 \uc54c\uc544\ubcf4\ub294 \uacbd\uc6b0\uc5d0\ub294 \ub2f9\uc0ac\uc790\uc758 \uc0dd\ub144\uc6d4\uc77c, \uac70\uc8fc\uc9c0, \uc18c\ub4dd \uc0c1\ud0dc, \uac74\uac15 \uc0c1\ud0dc\ucc98\ub7fc \uae30\ubcf8 \uc815\ubcf4\ub97c \uc900\ube44\ud574\ub450\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<p><!-- guide4050-related-start --><\/p>\n<section class=\"guide-related-posts\">\n<h2>\ud568\uaed8 \ubcf4\uba74 \uc88b\uc740 \uae00<\/h2>\n<p>\uc774 \uae00\uacfc \uc774\uc5b4\uc11c \ud655\uc778\ud558\uba74 \uc88b\uc740 4050 \ub9de\ucda4 \uc815\ubcf4\uc785\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/4050guide.co.kr\/june-2026-4050-benefit-welfare-checklist\/\">2026\ub144 6\uc6d4 4050 \uc815\ubd80\uc9c0\uc6d0\uae08\u00b7\ubcf5\uc9c0 \uc2e0\uccad \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/earned-child-tax-credit-june-2026-check\/\">2026 \uadfc\ub85c\u00b7\uc790\ub140\uc7a5\ub824\uae08 6\uc6d4 1\uc77c \uc804\ud6c4 \ud655\uc778\ud560 \uac83: \uc2e0\uccad, \uae30\ud55c \ud6c4 \uc2e0\uccad, \uc9c0\uae09\uc77c<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/small-business-policy-fund-4050-checklist\/\">\uc18c\uc0c1\uacf5\uc778 \uc815\ucc45\uc790\uae08 4050 \uc790\uc601\uc5c5\uc790 \ud655\uc778\ubc29\ubc95: \uc2e0\uccad \uc804 \uc900\ube44\uc11c\ub958<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/national-employment-support-4050-checklist\/\">\uad6d\ubbfc\ucde8\uc5c5\uc9c0\uc6d0\uc81c\ub3c4 4050 \uc2e0\uccad \uc804 \ud655\uc778\ud560 \uac83: \uc18c\ub4dd, \ucde8\uc5c5\uacbd\ud5d8, \uad6c\uc9c1\ud65c\ub3d9<\/a><\/li>\n<\/ul>\n<\/section>\n<p><!-- guide4050-related-end --><\/p>\n<p><!-- 4050_SHORT_UPLIFT_START --><\/p>\n<section class=\"guide-short-uplift\">\n<h2>\uc9c0\uc6d0\uae08 \uc2e0\uccad \uc804 \ud655\uc778\ud560 \uac83<\/h2>\n<p>\uc9c0\uc6d0\uae08\uc740 \u201c\ubc1b\