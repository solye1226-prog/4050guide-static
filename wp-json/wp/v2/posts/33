{"id":33,"date":"2026-05-16T16:00:00","date_gmt":"2026-05-16T07:00:00","guid":{"rendered":"https:\/\/4050guide.co.kr\/?p=33"},"modified":"2026-05-26T18:33:29","modified_gmt":"2026-05-26T09:33:29","slug":"earned-income-tax-credit-payment-date","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/earned-income-tax-credit-payment-date\/","title":{"rendered":"\uadfc\ub85c\uc7a5\ub824\uae08 \uc9c0\uae09\uc77c \ud655\uc778\ubc29\ubc95: \uc2ec\uc0ac \uc9c4\ud589 \uc0c1\ud669 \ubcf4\ub294 \ubc95"},"content":{"rendered":"<figure class=\"wp-block-image size-large\">\n  <img decoding=\"async\" src=\"\/wp-content\/uploads\/2026\/05\/government-benefit-photo.png\" alt=\"\uadfc\ub85c\uc7a5\ub824\uae08 \uc9c0\uae09\uc77c\uc744 \uc628\ub77c\uc778\uc73c\ub85c \ud655\uc778\ud558\ub294 \uc911\uc7a5\ub144\"><br \/>\n<\/figure>\n<p>\uadfc\ub85c\uc7a5\ub824\uae08\uc744 \uc2e0\uccad\ud55c \ub4a4\uc5d0\ub294 \uc5b8\uc81c \uc9c0\uae09\ub418\ub294\uc9c0, \uc2ec\uc0ac\uac00 \uc5b4\ub514\uae4c\uc9c0 \uc9c4\ud589\ub410\ub294\uc9c0 \uad81\uae08\ud574\uc9d1\ub2c8\ub2e4. \uc9c0\uae09\uc77c\uc740 \uc2e0\uccad \uc720\ud615\uacfc \uc2ec\uc0ac \uacb0\uacfc\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc73c\ubbc0\ub85c \ud648\ud0dd\uc2a4 \ub610\ub294 \uc190\ud0dd\uc2a4\uc5d0\uc11c \uc9c1\uc811 \ud655\uc778\ud558\ub294 \uac83\uc774 \uc815\ud655\ud569\ub2c8\ub2e4.<\/p>\n<h2>\ud575\uc2ec \uc694\uc57d<\/h2>\n<table>\n<thead>\n<tr>\n<th>\uad6c\ubd84<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\ud655\uc778 \uacbd\ub85c<\/td>\n<td>\ud648\ud0dd\uc2a4, \uc190\ud0dd\uc2a4, \uad6d\uc138\uccad \uc548\ub0b4<\/td>\n<\/tr>\n<tr>\n<td>\ud655\uc778 \ub0b4\uc6a9<\/td>\n<td>\uc2e0\uccad \ub0b4\uc5ed, \uc2ec\uc0ac \uc9c4\ud589, \uc9c0\uae09 \uc608\uc815 \uc5ec\ubd80<\/td>\n<\/tr>\n<tr>\n<td>\ubcc0\ub3d9 \uac00\ub2a5\uc131<\/td>\n<td>\uc790\ub8cc \ud655\uc778\uacfc \uc2ec\uc0ac \uacb0\uacfc\uc5d0 \ub530\ub77c \uc9c0\uae09\uc561 \ubcc0\ub3d9 \uac00\ub2a5<\/td>\n<\/tr>\n<tr>\n<td>\uc8fc\uc758\uc810<\/td>\n<td>\ubb38\uc790 \uc548\ub0b4\ub9cc \ubbff\uc9c0 \ub9d0\uace0 \uacf5\uc2dd \uacbd\ub85c \ud655\uc778<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\ud655\uc778\ud574\uc57c \ud560 \uae30\ubcf8 \uc870\uac74<\/h2>\n<p>\uc774 \uc8fc\uc81c\ub97c \uc900\ube44\ud560 \ub54c\ub294 \ubcf8\uc778\uc758 \ub098\uc774, \uacbd\ub825, \uc18c\ub4dd \uc0c1\ud0dc, \uac70\uc8fc \uc9c0\uc5ed, \uac00\ub2a5\ud55c \uad50\uc721 \uc2dc\uac04\ubd80\ud130 \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \uac19\uc740 \uc81c\ub3c4\ub098 \uc790\uaca9\uc99d\uc774\ub77c\ub3c4 \uac1c\uc778 \uc870\uac74\uc5d0 \ub530\ub77c \uc2e0\uccad \uac00\ub2a5 \uc5ec\ubd80\uc640 \uc900\ube44 \ubc29\ubc95\uc774 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc900\ube44 \uc21c\uc11c<\/h2>\n<table>\n<thead>\n<tr>\n<th>\uc21c\uc11c<\/th>\n<th>\ud574\uc57c \ud560 \uc77c<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>1\ub2e8\uacc4<\/td>\n<td>\ud648\ud0dd\uc2a4 \ub610\ub294 \uc190\ud0dd\uc2a4\uc5d0 \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>2\ub2e8\uacc4<\/td>\n<td>\uadfc\ub85c\uc7a5\ub824\uae08 \uc2e0\uccad \ub0b4\uc5ed \uba54\ub274\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>3\ub2e8\uacc4<\/td>\n<td>\uc2ec\uc0ac \uc9c4\ud589 \uc0c1\ud669\uacfc \uc9c0\uae09 \uc608\uc815\uc77c\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>4\ub2e8\uacc4<\/td>\n<td>\uc9c0\uae09\uc561\uc774 \uc608\uc0c1\uacfc \ub2e4\ub974\uba74 \uc0b0\uc815 \ub0b4\uc5ed\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>4050 \uc138\ub300\uac00 \ud2b9\ud788 \uc8fc\uc758\ud560 \uc810<\/h2>\n<p>\uadfc\ub85c\uc7a5\ub824\uae08 \uc9c0\uae09\uc744 \uc0ac\uce6d\ud55c \ubb38\uc790\ub098 \ub9c1\ud06c\ub97c \uc870\uc2ec\ud574\uc57c \ud569\ub2c8\ub2e4. \uacc4\uc88c \uc815\ubcf4 \uc785\ub825\uc740 \ubc18\ub4dc\uc2dc \uacf5\uc2dd \uc0ac\uc774\ud2b8\uc5d0\uc11c\ub9cc \uc9c4\ud589\ud558\uc138\uc694.<\/p>\n<h2>\uc2e0\uccad \ub610\ub294 \uc900\ube44 \uc804 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h2>\n<ul>\n<li>\uacf5\uc2dd \uc0ac\uc774\ud2b8\uc5d0\uc11c \ucd5c\uc2e0 \uae30\uc900\uc744 \ud655\uc778\ud588\ub294\uc9c0<\/li>\n<li>\ubcf8\uc778 \uc870\uac74\uc774 \ub300\uc0c1\uc5d0 \ud574\ub2f9\ud558\ub294\uc9c0<\/li>\n<li>\uad50\uc721\ube44, \uc218\uc218\ub8cc, \ubcf8\uc778\ubd80\ub2f4\uae08\uc774 \uc788\ub294\uc9c0<\/li>\n<li>\uc2e4\uc81c \ucde8\uc5c5\uc774\ub098 \uc0dd\ud65c\uc5d0 \ub3c4\uc6c0\uc774 \ub418\ub294\uc9c0<\/li>\n<li>\uc2e0\uccad \uae30\uac04, \uc2dc\ud5d8 \uc77c\uc815, \uc0c1\ub2f4 \ud544\uc694 \uc5ec\ubd80\ub97c \ud655\uc778\ud588\ub294\uc9c0<\/li>\n<\/ul>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<h3>4050 \uc138\ub300\ub3c4 \uc900\ube44\ud558\uae30 \ub2a6\uc9c0 \uc54a\ub098\uc694?<\/h3>\n<p>\ub2a6\uc5c8\ub2e4\uace0 \ubcf4\uae30 \uc5b4\ub835\uc2b5\ub2c8\ub2e4. \ub2e4\ub9cc \ubb34\uc791\uc815 \uc2dc\uc791\ud558\uae30\ubcf4\ub2e4 \ud604\uc7ac \uacbd\ub825, \uc0dd\ud65c \ud328\ud134, \uccb4\ub825, \uac00\ub2a5\ud55c \uad50\uc721 \uc2dc\uac04\uc744 \uae30\uc900\uc73c\ub85c \ud604\uc2e4\uc801\uc778 \uc120\ud0dd\uc744 \ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4.<\/p>\n<h3>\uad6d\ube44\uc9c0\uc6d0\uc774\ub098 \uc815\ubd80\uc9c0\uc6d0\uae08\uc744 \ud568\uaed8 \ubc1b\uc744 \uc218 \uc788\ub098\uc694?<\/h3>\n<p>\uc81c\ub3c4\ub9c8\ub2e4 \uc911\ubcf5 \uac00\ub2a5 \uc5ec\ubd80\uac00 \ub2e4\ub985\ub2c8\ub2e4. \uac19\uc740 \ubaa9\uc801\uc758 \uc9c0\uc6d0\uc740 \uc81c\ud55c\ub420 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2e0\uccad \uc804 \uacf5\uc2dd \uc548\ub0b4\uc5d0\uc11c \uc911\ubcf5 \uc218\uae09 \uae30\uc900\uc744 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h3>\uc5b4\ub514\uc5d0\uc11c \ucd5c\uc2e0 \uc815\ubcf4\ub97c \ud655\uc778\ud574\uc57c \ud558\ub098\uc694?<\/h3>\n<p>\uc815\ubd80\uc9c0\uc6d0\uae08\uacfc \uc9c1\uc5c5\ud6c8\ub828\uc740 \uace0\uc6a924, \uc815\ubd8024, \ubcf5\uc9c0\ub85c \ub4f1 \uacf5\uc2dd \uc0ac\uc774\ud2b8\ub97c \uc6b0\uc120 \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \uc790\uaca9\uc99d\uc740 \ud050\ub137\uc774\ub098 \ud574\ub2f9 \uc790\uaca9 \ubc1c\uae09\uae30\uad00\uc758 \uc548\ub0b4\ub97c \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h2>\uacf5\uc2dd \ucd9c\ucc98<\/h2>\n<p>\uc774 \uae00\uc740 \uad6d\uc138\uccad \ud648\ud0dd\uc2a4\uc758 \uacf5\uac1c \uc815\ubcf4\ub97c \ucc38\uace0\ud574 \uc791\uc131\ud588\uc2b5\ub2c8\ub2e4. \uc81c\ub3c4\uc640 \uc790\uaca9 \uc694\uac74\uc740 \ubc14\ub014 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2e4\uc81c \uc2e0\uccad \ub610\ub294 \uc811\uc218 \uc804\uc5d0\ub294 \ubc18\ub4dc\uc2dc \uacf5\uc2dd \ud398\uc774\uc9c0\uc5d0\uc11c \ucd5c\uc2e0 \ub0b4\uc6a9\uc744 \ud655\uc778\ud558\uc2dc\uae30 \ubc14\ub78d\ub2c8\ub2e4.<\/p>\n<p><a href=\"https:\/\/www.hometax.go.kr\" target=\"_blank\" rel=\"noopener\">\uad6d\uc138\uccad \ud648\ud0dd\uc2a4 \uacf5\uc2dd \uc548\ub0b4 \ubc14\ub85c\uac00\uae30<\/a><\/p>\n<p><!-- guide4050-depth-expand --><\/p>\n<h2>4050 \uae30\uc900\uc73c\ub85c \uba3c\uc800 \ud310\ub2e8\ud560 \ubd80\ubd84<\/h2>\n<p>\uadfc\ub85c\uc7a5\ub824\uae08 \uc9c0\uae09\uc77c \ud655\uc778\ubc29\ubc95: \uc2ec\uc0ac \uc9c4\ud589 \uc0c1\ud669 \ubcf4\ub294 \ubc95\ub97c \ud655\uc778\ud560 \ub54c\ub294 \ub2e8\uc21c\ud788 \uc774\ub984\ub9cc \ubcf4\uace0 \uacb0\uc815\ud558\uae30\ubcf4\ub2e4 \ub0b4 \uc0c1\ud669\uc5d0 \uc2e4\uc81c\ub85c \ub9de\ub294\uc9c0\ubd80\ud130 \ubcf4\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. 40\ub300\uc640 50\ub300\ub294 \uc774\ubbf8 \uc9c1\uc7a5 \uacbd\ud5d8, \uac00\uc871 \ubd80\uc591, \uac74\uac15\ubcf4\ud5d8\ub8cc, \ud1f4\uc9c1 \uc77c\uc815, \ubd80\ubaa8\ub2d8 \ub3cc\ubd04 \uac19\uc740 \uc870\uac74\uc774 \ud568\uaed8 \uc6c0\uc9c1\uc774\ub294 \uacbd\uc6b0\uac00 \ub9ce\uae30 \ub54c\ubb38\uc5d0 \uac19\uc740 \uc81c\ub3c4\ub77c\ub3c4 \uccb4\uac10\ub418\ub294 \uc720\ub9ac\ud568\uc774 \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ud2b9\ud788 \uc2e0\uccad\ud615 \uc81c\ub3c4\ub098 \uc790\uaca9\uc99d \uc815\ubcf4\ub294 \uad11\uace0 \ubb38\uad6c\ubcf4\ub2e4 \uacf5\uc2dd \uc870\uac74\uacfc \uc2e4\uc81c \ud65c\uc6a9\ucc98\ub97c \ud568\uaed8 \ubd10\uc57c \ud569\ub2c8\ub2e4. \uc9c0\uc6d0 \ub300\uc0c1, \uc2e0\uccad \uae30\uac04, \uc900\ube44\uc11c\ub958, \ubcf8\uc778\ubd80\ub2f4 \uc5ec\ubd80, \uc0c1\ub2f4 \ucc3d\uad6c\ub97c \uba3c\uc800 \ud655\uc778\ud558\uba74 \uc2dc\uac04\uc744 \uc904\uc77c \uc218 \uc788\uace0, \uc2e0\uccad \ud6c4 \ud0c8\ub77d\ud558\uac70\ub098 \uacfc\uc815 \uc218\ub8cc \ud6c4 \ud65c\uc6a9\ud558\uc9c0 \ubabb\ud558\ub294 \uc0c1\ud669\uc744 \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc9c0\uc6d0\uae08 \uc2e0\uccad \uc804 \ud655\uc778 \uc21c\uc11c<\/h2>\n<table>\n<thead>\n<tr>\n<th>\ud655\uc778 \uc21c\uc11c<\/th>\n<th>\ub0b4\uc6a9<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\ub300\uc0c1<\/td>\n<td>\ub098\uc774, \uc18c\ub4dd, \uc7ac\uc0b0, \uac00\uad6c \ud615\ud0dc \uae30\uc900\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uae30\uac04<\/td>\n<td>\uc0c1\uc2dc \uc2e0\uccad\uc778\uc9c0, \uc815\uae30 \uc2e0\uccad\uc778\uc9c0, \uae30\ud55c \ud6c4 \uc2e0\uccad\uc774 \uac00\ub2a5\ud55c\uc9c0 \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc11c\ub958<\/td>\n<td>\uc18c\ub4dd\uc790\ub8cc, \uac00\uc871\uad00\uacc4, \ud1b5\uc7a5, \uc784\ub300\ucc28\uacc4\uc57d\uc11c \ub4f1 \ud544\uc694\ud55c \uc11c\ub958\ub97c \ubbf8\ub9ac \uc900\ube44\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc2e0\uccad\ucc98<\/td>\n<td>\uc815\ubd8024, \ubcf5\uc9c0\ub85c, \uc8fc\ubbfc\uc13c\ud130, \uad00\ud560 \uae30\uad00 \uc911 \uc5b4\ub514\uc5d0\uc11c \uc2e0\uccad\ud558\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p>\uc9c0\uc6d0\uae08\uc740 \uc870\uac74\uc774 \ub9de\uc544\ub3c4 \uc2e0\uccad\ud558\uc9c0 \uc54a\uc73c\uba74 \ubc1b\uc744 \uc218 \uc5c6\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \ubd80\ubaa8\ub2d8 \ub300\uc2e0 \uc54c\uc544\ubcf4\ub294 \uacbd\uc6b0\uc5d0\ub294 \ubcf8\uc778 \uc778\uc99d, \uc704\uc784, \uac00\uc871\uad00\uacc4 \ud655\uc778\uc774 \ud544\uc694\ud560 \uc218 \uc788\uc73c\ubbc0\ub85c \uacf5\uc2dd \uc548\ub0b4\ub97c \uba3c\uc800 \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc0c1\ub2f4 \uc804 \uba54\ubaa8\ud574\ub450\uba74 \uc88b\uc740 \uc9c8\ubb38<\/h2>\n<ul>\n<li>\ub0b4 \ub098\uc774\uc640 \uace0\uc6a9 \uc0c1\ud0dc\uc5d0\uc11c \uc2e0\uccad \uac00\ub2a5\ud55c\uac00\uc694?<\/li>\n<li>\uc18c\ub4dd, \uc7ac\uc0b0, \uacbd\ub825 \ub54c\ubb38\uc5d0 \uc81c\uc678\ub420 \uc218 \uc788\ub294 \uc870\uac74\uc774 \uc788\ub098\uc694?<\/li>\n<li>\uc628\ub77c\uc778 \uc2e0\uccad\uacfc \ubc29\ubb38 \uc2e0\uccad \uc911 \uc5b4\ub5a4 \ubc29\uc2dd\uc774 \ube60\ub978\uac00\uc694?<\/li>\n<li>\uc2e0\uccad \ud6c4 \uacb0\uacfc \ud655\uc778\uae4c\uc9c0 \ubcf4\ud1b5 \uc5bc\ub9c8\ub098 \uac78\ub9ac\ub098\uc694?<\/li>\n<li>\ube44\uc2b7\ud55c \uc81c\ub3c4\ub098 \uacfc\uc815\uacfc \uc911\ubcf5 \uc774\uc6a9\uc774 \uac00\ub2a5\ud55c\uac00\uc694?<\/li>\n<\/ul>\n<p>\uc774 \uc9c8\ubb38\uc744 \ubbf8\ub9ac \uc815\ub9ac\ud574\ub450\uba74 \uc0c1\ub2f4 \uc2dc\uac04\uc774 \uc9e7\uc544\uc9c0\uace0, \ub2f4\ub2f9\uc790\uc5d0\uac8c \ud544\uc694\ud55c \uc815\ubcf4\ub97c \ube60\ub974\uac8c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \uac00\uc871 \ub300\uc2e0 \uc54c\uc544\ubcf4\ub294 \uacbd\uc6b0\uc5d0\ub294 \ub2f9\uc0ac\uc790\uc758 \uc0dd\ub144\uc6d4\uc77c, \uac70\uc8fc\uc9c0, \uc18c\ub4dd \uc0c1\ud0dc, \uac74\uac15 \uc0c1\ud0dc\ucc98\ub7fc \uae30\ubcf8 \uc815\ubcf4\ub97c \uc900\ube44\ud574\ub450\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<p><!-- guide4050-related-start --><\/p>\n<section class=\"guide-related-posts\">\n<h2>\ud568\uaed8 \ubcf4\uba74 \uc88b\uc740 \uae00<\/h2>\n<p>\uc774 \uae00\uacfc \uc774\uc5b4\uc11c \ud655\uc778\ud558\uba74 \uc88b\uc740 4050 \ub9de\ucda4 \uc815\ubcf4\uc785\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/4050guide.co.kr\/june-2026-4050-benefit-welfare-checklist\/\">2026\ub144 6\uc6d4 4050 \uc815\ubd80\uc9c0\uc6d0\uae08\u00b7\ubcf5\uc9c0 \uc2e0\uccad \