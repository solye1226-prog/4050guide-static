d>\uc791\ub144 \uc18c\ub4dd \uae30\uc900\uc778\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc7ac\uc0b0 \uc694\uac74<\/td>\n<td>\uc8fc\ud0dd, \uc790\ub3d9\ucc28, \uc608\uae08 \ub4f1\uc774 \ubc18\uc601\ub429\ub2c8\ub2e4.<\/td>\n<td>\uac00\uad6c\uc6d0 \uc804\uccb4 \uc7ac\uc0b0\uc744 \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc2e0\uccad \uae30\uac04<\/td>\n<td>\uc815\uae30\uc2e0\uccad\uacfc \uae30\ud55c \ud6c4 \uc2e0\uccad\uc744 \uad6c\ubd84\ud569\ub2c8\ub2e4.<\/td>\n<td>\uae30\ud55c \ud6c4 \uc2e0\uccad\uc740 \uc9c0\uae09\uc561\uc774 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/table>\n<\/figure>\n<h3>\uc2e0\uccad \uc804 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h3>\n<ul>\n<li>\uad6d\uc138\uccad \ud648\ud0dd\uc2a4 \uc548\ub0b4\ubb38 \uc218\uc2e0 \uc5ec\ubd80 \ud655\uc778<\/li>\n<li>\uac00\uad6c \uc720\ud615 \ud655\uc778<\/li>\n<li>\uc804\ub144\ub3c4 \uc18c\ub4dd\uc790\ub8cc \ud655\uc778<\/li>\n<li>\uc815\uae30\uc2e0\uccad \uae30\uac04\uacfc \uc9c0\uae09 \uc608\uc815\uc77c \ud655\uc778<\/li>\n<\/ul>\n<h3>\uc790\uc8fc \ub193\uce58\ub294 \ubd80\ubd84<\/h3>\n<p>\uc548\ub0b4\ubb38\uc744 \ubc1b\uc9c0 \ubabb\ud574\ub3c4 \uc2e0\uccad \ub300\uc0c1\uc77c \uc218 \uc788\uace0, \uc548\ub0b4\ubb38\uc744 \ubc1b\uc544\ub3c4 \ucd5c\uc885 \uc2ec\uc0ac\uc5d0\uc11c \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud648\ud0dd\uc2a4\uc5d0\uc11c \uc9c1\uc811 \uc870\ud68c\ud558\ub294 \uac83\uc774 \uac00\uc7a5 \uc815\ud655\ud569\ub2c8\ub2e4.<\/p>\n<p><strong>\uacf5\uc2dd \ud655\uc778\ucc98:<\/strong> \uad6d\uc138\uccad \ud648\ud0dd\uc2a4<\/p>\n<\/section>\n<p><!-- 4050_ADSENSE_CORE_UPGRADE_END --><\/p>\n","protected":false},"excerpt":{"rendered":"<p>\uadfc\ub85c\uc7a5\ub824\uae08\uc744 \uc2e0\uccad\ud55c \ub4a4\uc5d0\ub294 \uc5b8\uc81c \uc9c0\uae09\ub418\ub294\uc9c0, \uc2ec\uc0ac\uac00 \uc5b4\ub514\uae4c\uc9c0 \uc9c4\ud589\ub410\ub294\uc9c0 \uad81\uae08\ud574\uc9d1\ub2c8\ub2e4. \uc9c0\uae09\uc77c\uc740 \uc2e0\uccad \uc720\ud615\uacfc \uc2ec\uc0ac \uacb0\uacfc\uc5