{"id":121,"date":"2026-05-22T16:19:22","date_gmt":"2026-05-22T07:19:22","guid":{"rendered":"https:\/\/4050guide.co.kr\/national-pension-early-claim-checklist\/"},"modified":"2026-05-26T18:38:18","modified_gmt":"2026-05-26T09:38:18","slug":"national-pension-early-claim-checklist","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/national-pension-early-claim-checklist\/","title":{"rendered":"\uad6d\ubbfc\uc5f0\uae08 \uc870\uae30\uc218\ub839 \uc804 \ud655\uc778\ud560 \uac83: \uac10\uc561\uacfc \uac74\uac15\ubcf4\ud5d8 \uc601\ud5a5\uae4c\uc9c0"},"content":{"rendered":"<p>\uad6d\ubbfc\uc5f0\uae08 \uc870\uae30\uc218\ub839\uc740 \ub2f9\uc7a5 \ud604\uae08\ud750\ub984\uc774 \ud544\uc694\ud560 \ub54c \uac80\ud1a0\ud560 \uc218 \uc788\uc9c0\ub9cc, \ud3c9\uc0dd \ubc1b\uc744 \uc5f0\uae08\uc561\uc774 \uc904\uc5b4\ub4e4 \uc218 \uc788\uc5b4 \uc2e0\uc911\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<p>4050 \ud6c4\ubc18\uc774\ub098 60\ub300 \ucd08\ubc18\uc5d0 \ud1f4\uc9c1\uc744 \uc55e\ub454 \uacbd\uc6b0\uc5d0\ub294 \uc5f0\uae08 \uc218\ub839 \uc2dc\uc810, \uc7ac\ucde8\uc5c5 \uac00\ub2a5\uc131, \uac74\uac15\ubcf4\ud5d8\ub8cc, \ubc30\uc6b0\uc790 \uc18c\ub4dd\uae4c\uc9c0 \ud568\uaed8 \ubd10\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h2>\uc870\uae30\uc218\ub839 \ud310\ub2e8\ud45c<\/h2>\n<table class=\"guide-table\">\n<tbody>\n<tr>\n<th>\ud575\uc2ec \uae30\uc900<\/th>\n<td>\uc218\uae09 \uac00\ub2a5 \ub098\uc774, \uac00\uc785 \uae30\uac04, \uc18c\ub4dd \ud65c\ub3d9 \uc5ec\ubd80<\/td>\n<\/tr>\n<tr>\n<th>\uac00\uc7a5 \ud070 \uc601\ud5a5<\/th>\n<td>\uc870\uae30\uc218\ub839 \uc2dc \uc5f0\uae08\uc561 \uac10\uc561 \uac00\ub2a5<\/td>\n<\/tr>\n<tr>\n<th>\ud568\uaed8 \ubcfc \ud56d\ubaa9<\/th>\n<td>\uac74\uac15\ubcf4\ud5d8\ub8cc, \ub2e4\ub978 \uc18c\ub4dd, \uc7ac\ucde8\uc5c5 \uacc4\ud68d<\/td>\n<\/tr>\n<tr>\n<th>\ud655\uc778 \uae30\uad00<\/th>\n<td>\uad6d\ubbfc\uc5f0\uae08\uacf5\ub2e8<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>4050 \uae30\uc900 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h2>\n<ul>\n<li>\uc815\uc0c1 \uc218\ub839 \uc2dc\uc810\uacfc \uc870\uae30\uc218\ub839 \uc2dc\uc810\uc744 \ube44\uad50\ud569\ub2c8\ub2e4.<\/li>\n<li>\uac10\uc561\ub41c \uae08\uc561\uc774 \ud3c9\uc0dd \uc801\uc6a9\ub418\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc7ac\ucde8\uc5c5\uc774\ub098 \uc0ac\uc5c5\uc18c\ub4dd \uacc4\ud68d\uc774 \uc788\ub294\uc9c0 \uc810\uac80\ud569\ub2c8\ub2e4.<\/li>\n<li>\ubc30\uc6b0\uc790 \uc5f0\uae08\uacfc \uac00\uad6c \uc804\uccb4 \uc0dd\ud65c\ube44\ub97c \ud568\uaed8 \uacc4\uc0b0\ud569\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>\uc790\uc8fc \ub193\uce58\ub294 \ubd80\ubd84<\/h2>\n<ul>\n<li>\ub2f9\uc7a5 \ubc1b\uc744 \uc218 \uc788\ub2e4\ub294 \uc774\uc720\ub9cc\uc73c\ub85c \uc2e0\uccad\ud558\ub294 \uacbd\uc6b0<\/li>\n<li>\uac10\uc561\ub960\uacfc \uc7a5\uae30 \uc218\ub839\uc561 \ucc28\uc774\ub97c \uacc4\uc0b0\ud558\uc9c0 \uc54a\ub294 \uacbd\uc6b0<\/li>\n<li>\uac74\uac15\ubcf4\ud5d8\ub8cc\ub098 \ub2e4\ub978 \ubcf5\uc9c0 \uae30\uc900\uc5d0 \ubbf8\uce60 \uc601\ud5a5\uc744 \ub193\uce58\ub294 \uacbd\uc6b0<\/li>\n<li>\uc815\ud655\ud55c \uc608\uc0c1\uc5f0\uae08\uc561\uc744 \ud655\uc778\ud558\uc9c0 \uc54a\ub294 \uacbd\uc6b0<\/li>\n<\/ul>\n<h2>\ud604\uc2e4\uc801\uc73c\ub85c \uc774\ub807\uac8c \ud310\ub2e8\ud558\uc138\uc694<\/h2>\n<p>\uc870\uae30\uc218\ub839\uc740 \ub2e8\uae30 \ud604\uae08\ud750\ub984\uc5d0\ub294 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc9c0\ub9cc \uc7a5\uae30 \ub178\ud6c4\uc18c\ub4dd\uc5d0\ub294 \ubd88\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\uc2e0\uccad \uc804\uc5d0\ub294 \uad6d\ubbfc\uc5f0\uae08\uacf5\ub2e8\uc758 \uc608\uc0c1\uc5f0\uae08 \uc870\ud68c\ub97c \ud1b5\ud574 \uc815\uc0c1\uc218\ub839, \uc870\uae30\uc218\ub839, \uc5f0\uae30\uc218\ub839\uc744 \ubaa8\ub450 \ube44\uad50\ud574\ubcf4\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<details>\n<summary>\uc870\uae30\uc218\ub839\ud558\uba74 \ub098\uc911\uc5d0 \uc815\uc0c1 \uae08\uc561\uc73c\ub85c \ub3cc\uc544\uc624\ub098\uc694?<\/summary>\n<p>\uc77c\ubc18\uc801\uc73c\ub85c \uac10\uc561\ub41c \uae08\uc561\uc774 \uacc4\uc18d \uc801\uc6a9\ub420 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2e0\uccad \uc804 \uacf5\uc2dd \uc0c1\ub2f4\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.<\/p>\n<\/details>\n<details>\n<summary>\ud1f4\uc9c1\ud558\uba74 \ubb34\uc870\uac74 \uc870\uae30\uc218\ub839\uc774 \uc720\ub9ac\ud55c\uac00\uc694?<\/summary>\n<p>\uc544\ub2d9\ub2c8\ub2e4. \uc0dd\ud65c\ube44, \uac74\uac15 \uc0c1\ud0dc, \uc7ac\ucde8\uc5c5 \uac00\ub2a5\uc131, \ub2e4\ub978 \uc18c\ub4dd\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4.<\/p>\n<\/details>\n<h2>\uacf5\uc2dd \ud655\uc778\ucc98<\/h2>\n<p>\uc9c0\uc6d0 \uae30\uc900\uacfc \uc2e0\uccad \uae30\uac04\uc740 \ubc14\ub014 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2e4\uc81c \uc2e0\uccad \uc804\uc5d0\ub294 \uc544\ub798 \uacf5\uc2dd \ud398\uc774\uc9c0\uc5d0\uc11c \ucd5c\uc2e0 \uc548\ub0b4\ub97c \ub2e4\uc2dc \ud655\uc778\ud558\uc138\uc694.<\/p>\n<ul>\n<li><a href=\"https:\/\/www.nps.or.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\uad6d\ubbfc\uc5f0\uae08\uacf5\ub2e8<\/a><\/li>\n<li><a href=\"https:\/\/www.gov.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\uc815\ubd8024<\/a><\/li>\n<\/ul>\n<div class=\"guide-related\"><\/div>\n<p><!-- guide4050-depth-expand --><\/p>\n<h2>4050 \uae30\uc900\uc73c\ub85c \uba3c\uc800 \ud310\ub2e8\ud560 \ubd80\ubd84<\/h2>\n<p>\uad6d\ubbfc\uc5f0\uae08 \uc870\uae30\uc218\ub839 \uc804 \ud655\uc778\ud560 \uac83: \uac10\uc561\uacfc \uac74\uac15\ubcf4\ud5d8 \uc601\ud5a5\uae4c\uc9c0\ub97c \ud655\uc778\ud560 \ub54c\ub294 \ub2e8\uc21c\ud788 \uc774\ub984\ub9cc \ubcf4\uace0 \uacb0\uc815\ud558\uae30\ubcf4\ub2e4 \ub0b4 \uc0c1\ud669\uc5d0 \uc2e4\uc81c\ub85c \ub9de\ub294\uc9c0\ubd80\ud130 \ubcf4\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. 40\ub300\uc640 50\ub300\ub294 \uc774\ubbf8 \uc9c1\uc7a5 \uacbd\ud5d8, \uac00\uc871 \ubd80\uc591, \uac74\uac15\ubcf4\ud5d8\ub8cc, \ud1f4\uc9c1 \uc77c\uc815, \ubd80\ubaa8\ub2d8 \ub3cc\ubd04 \uac19\uc740 \uc870\uac74\uc774 \ud568\uaed8 \uc6c0\uc9c1\uc774\ub294 \uacbd\uc6b0\uac00 \ub9ce\uae30 \ub54c\ubb38\uc5d0 \uac19\uc740 \uc81c\ub3c4\ub77c\ub3c4 \uccb4\uac10\ub418\ub294 \uc720\ub9ac\ud568\uc774 \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ud2b9\ud788 \uc2e0\uccad\ud615 \uc81c\ub3c4\ub098 \uc790\uaca9\uc99d \uc815\ubcf4\ub294 \uad11\uace0 \ubb38\uad6c\ubcf4\ub2e4 \uacf5\uc2dd \uc870\uac74\uacfc \uc2e4\uc81c \ud65c\uc6a9\ucc98\ub97c \ud568\uaed8 \ubd10\uc57c \ud569\ub2c8\ub2e4. \uc9c0\uc6d0 \ub300\uc0c1, \uc2e0\uccad \uae30\uac04, \uc900\ube44\uc11c\ub958, \ubcf8\uc778\ubd80\ub2f4 \uc5ec\ubd80, \uc0c1\ub2f4 \ucc3d\uad6c\ub97c \uba3c\uc800 \ud655\uc778\ud558\uba74 \uc2dc\uac04\uc744 \uc904\uc77c \uc218 \uc788\uace0, \uc2e0\uccad \ud6c4 \ud0c8\ub77d\ud558\uac70\ub098 \uacfc\uc815 \uc218\ub8cc \ud6c4 \ud65c\uc6a9\ud558\uc9c0 \ubabb\ud558\ub294 \uc0c1\ud669\uc744 \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc0dd\ud65c\uacbd\uc81c \uc815\ubcf4\ub294 \uc22b\uc790\ub85c \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4<\/h2>\n<table>\n<thead>\n<tr>\n<th>\ud56d\ubaa9<\/th>\n<th>\ud655\uc778\ud560 \uc810<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\uc6d4 \uace0\uc815\ube44<\/td>\n<td>\ubcf4\ud5d8\ub8cc, \ub300\ucd9c\uc0c1\ud658, \uac74\uac15\ubcf4\ud5d8\ub8cc, \ud1b5\uc2e0\ube44\ucc98\ub7fc \ub9e4\ub2ec \ub098\uac00\ub294 \ube44\uc6a9\uc744 \uba3c\uc800 \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc18c\ub4dd \ubcc0\ud654<\/td>\n<td>\ud1f4\uc9c1, \uc7ac\ucde8\uc5c5, \uc5f0\uae08 \uc218\ub839 \uc2dc\uc810\uc5d0 \ub530\ub77c \ub0a9\ubd80 \uae30\uc900\uc774 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uac00\uc871 \uc601\ud5a5<\/td>\n<td>\ubd80\uc591\uac00\uc871, \ud53c\ubd80\uc591\uc790, \ubd80\ubaa8\ub2d8 \uc9c0\uc6d0 \uc5ec\ubd80\uac00 \ud568\uaed8 \uc601\ud5a5\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc0c1\ub2f4 \ucc3d\uad6c<\/td>\n<td>\uad6d\ubbfc\uac74\uac15\ubcf4\ud5d8\uacf5\ub2e8, \uad6d\ubbfc\uc5f0\uae08\uacf5\ub2e8, \uae08\uc735\uae30\uad00 \ub4f1 \uacf5\uc2dd \ucc3d\uad6c\uc5d0\uc11c \ucd5c\uc885 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p>4050 \uc774\ud6c4\uc758 \uc0dd\ud65c\uacbd\uc81c\ub294 \uc791\uc740 \ucc28\uc774\uac00 \ub9e4\ub2ec \ubc18\ubcf5\ub418\uae30 \ub54c\ubb38\uc5d0 \ub204\uc801 \uae08\uc561\uc774 \ucee4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc81c\ub3c4 \uc124\uba85\ub9cc \uc77d\uace0 \ub05d\ub0b4\uae30\ubcf4\ub2e4 \ub0b4 \uc6d4 \uc9c0\ucd9c\ud45c\uc5d0 \uc9c1\uc811 \ub300\uc785\ud574\ubcf4\ub294 \uac83\uc774 \uac00\uc7a5 \ud604\uc2e4\uc801\uc778 \ud310\ub2e8 \ubc29\ubc95\uc785\ub2c8\ub2e4.<\/p>\n<h2>\uc0c1\ub2f4 \uc804 \uba54\ubaa8\ud574\ub450\uba74 \uc88b\uc740 \uc9c8\ubb38<\/h2>\n<ul>\n<li>\ub0b4 \ub098\uc774\uc640 \uace0\uc6a9 \uc0c1\ud0dc\uc5d0\uc11c \uc2e0\uccad \uac00\ub2a5\ud55c\uac00\uc694?<\/li>\n<li>\uc18c\ub4dd, \uc7ac\uc0b0, \uacbd\ub825 \ub54c\ubb38\uc5d0 \uc81c\uc678\ub420 \uc218 \uc788\ub294 \uc870\uac74\uc774 \uc788\ub098\uc694?<\/li>\n<li>\uc628\ub77c\uc778 \uc2e0\uccad\uacfc \ubc29\ubb38 \uc2e0\uccad \uc911 \uc5b4\ub5a4 \ubc29\uc2dd\uc774 \ube60\ub978\uac00\uc694?<\/li>\n<li>\uc2e0\uccad \ud6c4 \uacb0\uacfc \ud655\uc778\uae4c\uc9c0 \ubcf4\ud1b5 \uc5bc\ub9c8\ub098 \uac78\ub9ac\ub098\uc694?<\/li>\n<li>\ube44\uc2b7\ud55c \uc81c\ub3c4\ub098 \uacfc\uc815\uacfc \uc911\ubcf5 \uc774\uc6a9\uc774 \uac00\ub2a5\ud55c\uac00\uc694?<\/li>\n<\/ul>\n<p>\uc774 \uc9c8\ubb38\uc744 \ubbf8\ub9ac \uc815\ub9ac\ud574\ub450\uba74 \uc0c1\ub2f4 \uc2dc\uac04\uc774 \uc9e7\uc544\uc9c0\uace0, \ub2f4\ub2f9\uc790\uc5d0\uac8c \ud544\uc694\ud55c \uc815\ubcf4\ub97c \ube60\ub974\uac8c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \uac00\uc871 \ub300\uc2e0 \uc54c\uc544\ubcf4\ub294 \uacbd\uc6b0\uc5d0\ub294 \ub2f9\uc0ac\uc790\uc758 \uc0dd\ub144\uc6d4\uc77c, \uac70\uc8fc\uc9c0, \uc18c\ub4dd \uc0c1\ud0dc, \uac74\uac15 \uc0c1\ud0dc\ucc98\ub7fc \uae30\ubcf8 \uc815\ubcf4\ub97c \uc900\ube44\ud574\ub450\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<p><!-- guide4050-related-start --><\/p>\n<section class=\"guide-related-posts\">\n<h2>\ud568\uaed8 \ubcf4\uba74 \uc88b\uc740 \uae00<\/h2>\n<p>\uc774 \uae00\uacfc \uc774\uc5b4\uc11c \ud655\uc778\ud558\uba74 \uc88b\uc740 4050 \ub9de\ucda4 \uc815\ubcf4\uc785\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/4050guide.co.kr\/health-insurance-after-retirement-4050-checklist\/\">\ud1f4\uc9c1 \ud6c4 \uac74\uac15\ubcf4\ud5d8\ub8cc \uc904\uc774\ub294 \ubc29\ubc95: \uc9c0\uc5ed\uac00\uc785\uc790 \uc804\ud658 \uc804 4050 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/housing-pension-parent-checklist\/\">\uc8fc\ud0dd\uc5f0\uae08 4050\uc774 \ubd80\ubaa8\ub2d8 \ub300\uc2e0 \ud655\uc778\ud560 \ub54c \ubcfc \uac83: \uac00\uc785\uc870\uac74\uacfc \uc0c1\ub2f4 \uc804 \uc900\ube44<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/health-insurance-dependent-loss-4050\/\">\uac74\uac15\ubcf4\ud5d8 \ud53c\ubd80\uc591\uc790 \ud0c8\ub77d \uae30\uc900 4050 \uccb4\ud06c: \ubd80\ubaa8\ub2d8\uacfc \ud1f4\uc9c1\uc790 \ubaa8\ub450 \ud655\uc778<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/living-cost-after-retirement-calculation\/\">\ud1f4\uc9c1 \ud6c4 \uc0dd\ud65c\ube44 \uacc4\uc0b0\ubc95: \uc5f0\uae08, \ubcf4\ud5d8\ub8cc, \ub300\ucd9c\uc0c1\ud658\uc744 \ud55c \ubc88\uc5d0 \ubcf4\uae30<\/a><\/li>\n<\/ul>\n<\/section>\n<p><!-- guide4050-related-end --><\/p>\n<p><!-- 4050_SHORT_UPLIFT_START --><\/p>\n<section class=\"guide-short-uplift\">\n<h2>\uc0dd\ud65c\uacbd\uc81c \uc815\ubcf4 \ud655\uc778 \uae30\uc900<\/h2>\n<p>\uc0dd\ud65c\uacbd\uc81c \uc815\ubcf4\ub294 \uae08\uc561\ub9cc \ubcf4\uace0 \uacb0\uc815\ud558\uba74 \uc704\ud5d8\ud569\ub2c8\ub2e4. \uc9c0\uc6d0\uae08, \ubcf4\ud5d8\ub8cc, \uc5f0\uae08, \ub300\ucd9c\uc740 \uc2e0\uccad \uc2dc\uc810\uacfc \uac1c\uc778 \uc870\uac74\uc5d0 \ub530\ub77c \uacb0\uacfc\uac00 \ub2ec\ub77c\uc9c0\ubbc0\ub85c \uacf5\uc2dd \uacc4\uc0b0 \uae30\uc900\uacfc \uc0c1\ub2f4 \ucc3d\uad6c\ub97c \ud568\uaed8 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<figure class=\"wp-block-table\">\n<table>\n<tr>\n<th>\ud655\uc778 \uc21c\uc11c<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<th>\ud310\ub2e8 \uae30\uc900<\/th>\n<\/tr>\n<tr>\n<td>1\ub2e8\uacc4<\/td>\n<td>\uc801\uc6a9 \ub300\uc0c1<\/td>\n<td>\ubcf8\uc778, \ubc30\uc6b0\uc790, \ubd80\ubaa8\ub2d8 \uc911 \ub204\uad6c \uae30\uc900\uc778\uc9c0 \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>2\ub2e8\uacc4<\/td>\n<td>\uae08\uc561 \uc0b0\uc815<\/td>\n<td>\uc18c\ub4dd, \uc7ac\uc0b0, \ubcf4\ud5d8\ub8cc, \uae30\uc874 \ucc44\ubb34\uac00 \ubc18\uc601\ub418\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>3\ub2e8\uacc4<\/td>\n<td>\uc2e0\uccad \uc2dc\uae30<\/td>\n<td>\uc815\uae30 \uc2e0\uccad\uc778\uc9c0 \uc218\uc2dc \uc2e0\uccad\uc778\uc9c0 \uad6c\ubd84\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>4\ub2e8\uacc4<\/td>\n<td>\ubd88\uc774\uc775 \uc5ec\ubd80<\/td>\n<td>\uac10\uc561, \ud658\uc218, \ubcf4\ud5d8\ub8cc \uc99d\uac00 \uac00\ub2a5\uc131\uc744 \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/table>\n<\/figure>\n<h3>\ube60\ub978 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h3>\n<ul>\n<li>\ud64d\ubcf4\uc131 \uae08\uc561\ubcf4\ub2e4 \uacf5\uc2dd \uacc4\uc0b0 \uae30\uc900\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\ucd5c\uadfc \uc18c\ub4dd \ubcc0\ub3d9\uc774 \uc788\uc73c\uba74 \uc0c1\ub2f4 \ub54c \uc124\uba85\ud569\ub2c8\ub2e4.<\/li>\n<li>\uacb0\uc815 \uc804 \uac00\uc871\uc5d0\uac8c \uc601\ud5a5\uc744 \uc8fc\ub294 \ud56d\ubaa9\uc774 \uc788\ub294\uc9c0 \ubd05\ub2c8\ub2e4.<\/li>\n<\/ul>\n<p>\uc704 \ub0b4\uc6a9\uc740 \uae30\ubcf8 \ud310\ub2e8 \uae30\uc900\uc774\uba70, \uc2e4\uc81c \uc2e0\uccad\uc774\ub098 \uc811\uc218 \uc804\uc5d0\ub294 \uacf5\uc2dd \uae30\uad00\uc758 \ucd5c\uc2e0 \uc548\ub0b4\ub97c \ub2e4\uc2dc \ud655\uc778\ud558\ub294 \uac83\uc774 \uc548\uc804\ud569\ub2c8\ub2e4.<\/p>\n<\/section>\n<p><!-- 4050_SHORT_UPLIFT_END --><\/p>\n","protected":false},"excerpt":{"rendered":"<p>\uad6d\ubbfc\uc5f0\uae08 \uc870\uae30\uc218\ub839\uc74