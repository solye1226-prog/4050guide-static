{"id":131,"date":"2026-05-22T16:39:09","date_gmt":"2026-05-22T07:39:09","guid":{"rendered":"https:\/\/4050guide.co.kr\/tomorrow-card-for-workers-after-work\/"},"modified":"2026-05-26T18:38:18","modified_gmt":"2026-05-26T09:38:18","slug":"tomorrow-card-for-workers-after-work","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/tomorrow-card-for-workers-after-work\/","title":{"rendered":"\uc7ac\uc9c1\uc790 \ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc \uc0ac\uc6a9\ubc95: \ud1f4\uadfc \ud6c4 \ud6c8\ub828\uacfc\uc815 \uc120\ud0dd \uae30\uc900"},"content":{"rendered":"<p>\uc7ac\uc9c1 \uc911\uc5d0\ub3c4 \uc9c1\ubb34 \uc804\ud658\uc774\ub098 \uc774\uc9c1 \uc900\ube44\ub97c \uc704\ud574 \uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc\ub97c \uac80\ud1a0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\ub9cc \uadfc\ubb34\uc2dc\uac04\uacfc \ud6c8\ub828\uc2dc\uac04\uc774 \uacb9\uce58\uba74 \uc218\ub8cc\uac00 \uc5b4\ub824\uc6cc\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>4050 \uc7ac\uc9c1\uc790\ub294 \ud1f4\uadfc \ud6c4 \uccb4\ub825, \uac00\uc871 \ub3cc\ubd04, \uc8fc\ub9d0 \uc77c\uc815\uae4c\uc9c0 \uace0\ub824\ud574 \ubb34\ub9ac \uc5c6\ub294 \uacfc\uc815\uc744 \uace0\ub974\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4.<\/p>\n<h2>\uc7ac\uc9c1\uc790 \uacfc\uc815 \uc120\ud0dd \uc694\uc57d<\/h2>\n<table class=\"guide-table\">\n<tbody>\n<tr>\n<th>\ud575\uc2ec \uc870\uac74<\/th>\n<td>\uadfc\ubb34\uc2dc\uac04\uacfc \ud6c8\ub828\uc2dc\uac04 \ucda9\ub3cc \uc5ec\ubd80<\/td>\n<\/tr>\n<tr>\n<th>\ud655\uc778 \ud56d\ubaa9<\/th>\n<td>\uc57c\uac04\ubc18, \uc8fc\ub9d0\ubc18, \uc628\ub77c\uc778 \uacfc\uc815, \ucd9c\uc11d \uae30\uc900<\/td>\n<\/tr>\n<tr>\n<th>\uc8fc\uc758\uc810<\/th>\n<td>\ud68c\uc0ac \uc77c\uc815, \uc57c\uadfc, \ucd9c\uc7a5 \uac00\ub2a5\uc131<\/td>\n<\/tr>\n<tr>\n<th>\ucd94\ucc9c \ubc29\uc2dd<\/th>\n<td>\ub2e8\uae30 \uacfc\uc815\ubd80\ud130 \uc2dc\uc791\ud574 \uc218\ub8cc \uacbd\ud5d8\uc744 \ub9cc\ub4e0 \ub4a4 \ud655\uc7a5<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\ud655\uc778 \uc21c\uc11c<\/h2>\n<ol>\n<li>\ud604\uc7ac \uadfc\ubb34\ud45c\uc640 \ud6c8\ub828 \uc2dc\uac04\ud45c\ub97c \uba3c\uc800 \ube44\uad50\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc57c\uac04\ubc18\u00b7\uc8fc\ub9d0\ubc18\uc774 \uc2e4\uc81c \uac1c\uc124\ub418\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc628\ub77c\uc778 \uacfc\uc815\uc774\ub77c\ub3c4 \ucd9c\uc11d \uc778\uc815 \ubc29\uc2dd\uacfc \ud3c9\uac00 \ubc29\uc2dd\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc774\uc9c1 \ubaa9\uc801\uc774\ub77c\uba74 \uad00\ub828 \ucc44\uc6a9\uacf5\uace0\ub97c \ud568\uaed8 \ubd05\ub2c8\ub2e4.<\/li>\n<li>\ubb34\ub9ac\ud55c \uc7a5\uae30 \uacfc\uc815\uc740 \ud53c\ud558\uace0 \uc218\ub8cc \uac00\ub2a5\ud55c \uacfc\uc815\ubd80\ud130 \uc120\ud0dd\ud569\ub2c8\ub2e4.<\/li>\n<\/ol>\n<h2>4050 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h2>\n<ul>\n<li>\ud1f4\uadfc \ud6c4 \uc774\ub3d9 \uc2dc\uac04\uc774 \uacfc\ub3c4\ud558\uc9c0 \uc54a\uc740\uc9c0 \ubd05\ub2c8\ub2e4.<\/li>\n<li>\uc8fc\ub9d0 \uac00\uc871 \uc77c\uc815\uacfc \uacb9\uce58\uc9c0 \uc54a\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uacfc\uc81c\uc640 \uc2dc\ud5d8 \uc900\ube44 \uc2dc\uac04\uc774 \ubcc4\ub3c4\ub85c \ud544\uc694\ud55c\uc9c0 \ubb38\uc758\ud569\ub2c8\ub2e4.<\/li>\n<li>\ud6c8\ub828 \uc2dc\uc791 \uc804 \ud68c\uc0ac \uc77c\uc815 \ubcc0\ub3d9 \uac00\ub2a5\uc131\uc744 \uace0\ub824\ud569\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>\uc0c1\ud669\ubcc4 \ud310\ub2e8 \uae30\uc900<\/h2>\n<h3>\uc9c1\ubb34\ub2a5\ub825 \ubcf4\uac15 \ubaa9\uc801<\/h3>\n<p>\ud604\uc7ac \uc5c5\ubb34\uc640 \uc5f0\uacb0\ub418\ub294 \uc5d1\uc140, \uc804\uc0b0, \uc548\uc804, \ud68c\uacc4 \ub4f1 \uc2e4\ubb34 \uacfc\uc815\uc744 \uc6b0\uc120 \uac80\ud1a0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h3>\uc774\uc9c1 \uc900\ube44 \ubaa9\uc801<\/h3>\n<p>\ud76c\ub9dd \uc9c1\uc885 \uacf5\uace0\uc5d0\uc11c \ubc18\ubcf5\ub418\ub294 \uc790\uaca9\uc774\ub098 \ud504\ub85c\uadf8\ub7a8\uc744 \uae30\uc900\uc73c\ub85c \uacfc\uc815\uc744 \uace0\ub974\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<h3>\ud1f4\uc9c1 \uc608\uc815\uc790<\/h3>\n<p>\ud1f4\uc9c1 \uc804\uc5d0\ub294 \uc7ac\uc9c1\uc790 \uacfc\uc815, \ud1f4\uc9c1 \ud6c4\uc5d0\ub294 \uad6c\uc9c1\uc790 \uacfc\uc815\uc73c\ub85c \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc5b4 \uc2e0\uccad \uc2dc\uc810\uc744 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<details>\n<summary>\uc7ac\uc9c1 \uc911\uc774\uba74 \ud68c\uc0ac\uc5d0 \uc54c\ub824\uc57c \ud558\ub098\uc694?<\/summary>\n<p>\uc81c\ub3c4 \uc774\uc6a9 \uc790\uccb4\ub294 \uac1c\uc778 \uc0c1\ud669\uc5d0 \ub530\ub77c \ub2e4\ub974\uc9c0\ub9cc, \ud6c8\ub828 \uc2dc\uac04\uc774 \uadfc\ubb34\uc640 \uacb9\uce5c\ub2e4\uba74 \ud68c\uc0ac \uc77c\uc815\uacfc \ucda9\ub3cc\ud558\uc9c0 \uc54a\uac8c \uc870\uc728\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<\/details>\n<details>\n<summary>\uc628\ub77c\uc778 \uacfc\uc815\uc774 \ub354 \uc26c\uc6b4\uac00\uc694?<\/summary>\n<p>\uc774\ub3d9 \ubd80\ub2f4\uc740 \uc801\uc9c0\ub9cc \ucd9c\uc11d, \uacfc\uc81c, \ud3c9\uac00 \uae30\uc900\uc740 \uacfc\uc815\ubcc4\ub85c \ub2e4\ub985\ub2c8\ub2e4. \uc0c1\uc138 \uae30\uc900\uc744 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<\/details>\n<h2>\uacf5\uc2dd \ud655\uc778\ucc98<\/h2>\n<p>\uc774 \uae00\uc740 \uc2e0\uccad \ubc29\ud5a5\uc744 \uc7a1\uae30 \uc704\ud55c \uc815\ub9ac\uc785\ub2c8\ub2e4. \uc2e4\uc81c \uae30\uc900, \uae30\uac04, \uae08\uc561, \ud544\uc694 \uc11c\ub958\ub294 \ubc14\ub014 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2e0\uccad \uc804 \uacf5\uc2dd \ud398\uc774\uc9c0\uc5d0\uc11c \ucd5c\uc2e0 \ub0b4\uc6a9\uc744 \ud655\uc778\ud558\uc138\uc694.<\/p>\n<ul>\n<li><a href=\"https:\/\/www.hrd.go.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\uc9c1\uc5c5\ud6c8\ub828\ud3ec\ud138 HRD-Net<\/a><\/li>\n<li><a href=\"https:\/\/www.work24.go.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\uace0\uc6a924<\/a><\/li>\n<\/ul>\n<div class=\"guide-related\"><\/div>\n<p><!-- guide4050-depth-expand --><\/p>\n<h2>4050 \uae30\uc900\uc73c\ub85c \uba3c\uc800 \ud310\ub2e8\ud560 \ubd80\ubd84<\/h2>\n<p>\uc7ac\uc9c1\uc790 \ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc \uc0ac\uc6a9\ubc95: \ud1f4\uadfc \ud6c4 \ud6c8\ub828\uacfc\uc815 \uc120\ud0dd \uae30\uc900\ub97c \ud655\uc778\ud560 \ub54c\ub294 \ub2e8\uc21c\ud788 \uc774\ub984\ub9cc \ubcf4\uace0 \uacb0\uc815\ud558\uae30\ubcf4\ub2e4 \ub0b4 \uc0c1\ud669\uc5d0 \uc2e4\uc81c\ub85c \ub9de\ub294\uc9c0\ubd80\ud130 \ubcf4\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. 40\ub300\uc640 50\ub300\ub294 \uc774\ubbf8 \uc9c1\uc7a5 \uacbd\ud5d8, \uac00\uc871 \ubd80\uc591, \uac74\uac15\ubcf4\ud5d8\ub8cc, \ud1f4\uc9c1 \uc77c\uc815, \ubd80\ubaa8\ub2d8 \ub3cc\ubd04 \uac19\uc740 \uc870\uac74\uc774 \ud568\uaed8 \uc6c0\uc9c1\uc774\ub294 \uacbd\uc6b0\uac00 \ub9ce\uae30 \ub54c\ubb38\uc5d0 \uac19\uc740 \uc81c\ub3c4\ub77c\ub3c4 \uccb4\uac10\ub418\ub294 \uc720\ub9ac\ud568\uc774 \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ud2b9\ud788 \uc2e0\uccad\ud615 \uc81c\ub3c4\ub098 \uc790\uaca9\uc99d \uc815\ubcf4\ub294 \uad11\uace0 \ubb38\uad6c\ubcf4\ub2e4 \uacf5\uc2dd \uc870\uac74\uacfc \uc2e4\uc81c \ud65c\uc6a9\ucc98\ub97c \ud568\uaed8 \ubd10\uc57c \ud569\ub2c8\ub2e4. \uc9c0\uc6d0 \ub300\uc0c1, \uc2e0\uccad \uae30\uac04, \uc900\ube44\uc11c\ub958, \ubcf8\uc778\ubd80\ub2f4 \uc5ec\ubd80, \uc0c1\ub2f4 \ucc3d\uad6c\ub97c \uba3c\uc800 \ud655\uc778\ud558\uba74 \uc2dc\uac04\uc744 \uc904\uc77c \uc218 \uc788\uace0, \uc2e0\uccad \ud6c4 \ud0c8\ub77d\ud558\uac70\ub098 \uacfc\uc815 \uc218\ub8cc \ud6c4 \ud65c\uc6a9\ud558\uc9c0 \ubabb\ud558\ub294 \uc0c1\ud669\uc744 \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uad6d\ube44\uc9c0\uc6d0 \uae00\uc5d0\uc11c \uaf2d \ube44\uad50\ud560 \ud56d\ubaa9<\/h2>\n<table>\n<thead>\n<tr>\n<th>\ud655\uc778 \ud56d\ubaa9<\/th>\n<th>\uc65c \uc911\uc694\ud55c\uac00<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\uc790\ube44\ubd80\ub2f4\uae08<\/td>\n<td>\uac19\uc740 \uacfc\uc815\uc774\ub77c\ub3c4 \ud6c8\ub828\uae30\uad00\uacfc \uc9c1\uc885\uc5d0 \ub530\ub77c \uc2e4\uc81c \ubd80\ub2f4\uc561\uc774 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\ud6c8\ub828\uc2dc\uac04<\/td>\n<td>\uc7ac\uc9c1\uc790\uc640 \uad6c\uc9c1\uc790\ub294 \uac00\ub2a5\ud55c \uc2dc\uac04\ub300\uac00 \ub2e4\ub974\ubbc0\ub85c \uc218\ub8cc \uac00\ub2a5\uc131\uc744 \uba3c\uc800 \ubd10\uc57c \ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\ucde8\uc5c5 \uc5f0\uacc4<\/td>\n<td>\uc218\ub8cc \ud6c4 \ucc44\uc6a9 \uc0c1\ub2f4, \uc774\ub825\uc11c \uc9c0\uc6d0, \ud604\uc7a5 \uc2e4\uc2b5 \uc5ec\ubd80\uac00 \uc2e4\uc81c \ud65c\uc6a9\ub3c4\ub97c \uc88c\uc6b0\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uacf5\uc2dd \ub4f1\ub85d \uc5ec\ubd80<\/td>\n<td>\uace0\uc6a924\ub098 HRD-Net\uc5d0\uc11c \ud655\uc778\ub418\ub294 \uacfc\uc815\uc778\uc9c0 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p>4050 \uc138\ub300\ub294 \ub2e8\uae30\uac04\uc5d0 \uacb0\uacfc\ub97c \ub0b4\uc57c \ud558\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \uadf8\ub798\uc11c \ub2e8\uc21c\ud788 \uc778\uae30 \uacfc\uc815\uc778\uc9c0\ubcf4\ub2e4 \uc218\ub8cc \ud6c4 \uc5b4\ub514\uc5d0 \uc9c0\uc6d0\ud560 \uc218 \uc788\ub294\uc9c0, \ub0b4 \uacbd\ub825\uacfc \uc5f0\uacb0\ub418\ub294\uc9c0, \ud604\uc7ac \uac70\uc8fc \uc9c0\uc5ed\uc5d0\uc11c \uc2e4\uc2b5\uc774\ub098 \ucd9c\uc11d\uc774 \uac00\ub2a5\ud55c\uc9c0\ub97c \ud568\uaed8 \ud310\ub2e8\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc0c1\ub2f4 \uc804 \uba54\ubaa8\ud574\ub450\uba74 \uc88b\uc740 \uc9c8\ubb38<\/h2>\n<ul>\n<li>\ub0b4 \ub098\uc774\uc640 \uace0\uc6a9 \uc0c1\ud0dc\uc5d0\uc11c \uc2e0\uccad \uac00\ub2a5\ud55c\uac00\uc694?<\/li>\n<li>\uc18c\ub4dd, \uc7ac\uc0b0, \uacbd\ub825 \ub54c\ubb38\uc5d0 \uc81c\uc678\ub420 \uc218 \uc788\ub294 \uc870\uac74\uc774 \uc788\ub098\uc694?<\/li>\n<li>\uc628\ub77c\uc778 \uc2e0\uccad\uacfc \ubc29\ubb38 \uc2e0\uccad \uc911 \uc5b4\ub5a4 \ubc29\uc2dd\uc774 \ube60\ub978\uac00\uc694?<\/li>\n<li>\uc2e0\uccad \ud6c4 \uacb0\uacfc \ud655\uc778\uae4c\uc9c0 \ubcf4\ud1b5 \uc5bc\ub9c8\ub098 \uac78\ub9ac\ub098\uc694?<\/li>\n<li>\ube44\uc2b7\ud55c \uc81c\ub3c4\ub098 \uacfc\uc815\uacfc \uc911\ubcf5 \uc774\uc6a9\uc774 \uac00\ub2a5\ud55c\uac00\uc694?<\/li>\n<\/ul>\n<p>\uc774 \uc9c8\ubb38\uc744 \ubbf8\ub9ac \uc815\ub9ac\ud574\ub450\uba74 \uc0c1\ub2f4 \uc2dc\uac04\uc774 \uc9e7\uc544\uc9c0\uace0, \ub2f4\ub2f9\uc790\uc5d0\uac8c \ud544\uc694\ud55c \uc815\ubcf4\ub97c \ube60\ub974\uac8c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \uac00\uc871 \ub300\uc2e0 \uc54c\uc544\ubcf4\ub294 \uacbd\uc6b0\uc5d0\ub294 \ub2f9\uc0ac\uc790\uc758 \uc0dd\ub144\uc6d4\uc77c, \uac70\uc8fc\uc9c0, \uc18c\ub4dd \uc0c1\ud0dc, \uac74\uac15 \uc0c1\ud0dc\ucc98\ub7fc \uae30\ubcf8 \uc815\ubcf4\ub97c \uc900\ube44\ud574\ub450\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<p><!-- guide4050-related-start --><\/p>\n<section class=\"guide-related-posts\">\n<h2>\ud568\uaed8 \ubcf4\uba74 \uc88b\uc740 \uae00<\/h2>\n<p>\uc774 \uae00\uacfc \uc774\uc5b4\uc11c \ud655\uc778\ud558\uba74 \uc88b\uc740 4050 \ub9de\ucda4 \uc815\ubcf4\uc785\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/4050guide.co.kr\/2026-qnet-constant-exam-14-license-guide-4050\/\">2026\ub144 \uc0c1\uc2dc\uac80\uc815 \uc790\uaca9\uc99d 14\uc885\ubaa9: \uc9c0\uac8c\ucc28\u00b7\ud55c\uc2dd\uc870\ub9ac\ucc98\ub7fc \uc77c\uc815 \uc120\ud0dd\uc774 \uc26c\uc6b4 \uc885\ubaa9<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/4050-tomorrow-card-self-payment-guide\/\">4050 \uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc \uc790\ube44\ubd80\ub2f4\uae08 \ud655\uc778\ubc95: \uac19\uc740 \uacfc\uc815\ub3c4 \ube44\uc6a9\uc774 \ub2e4\ub978 \uc774\uc720<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/second-half-2026-hrd-training-course-guide\/\">2026\ub144 \ud558\ubc18\uae30 \uad6d\ube44\uc9c0\uc6d0 \ud6c8\ub828\uacfc\uc815 \ucc3e\ub294 \ubc95: 6\uc6d4\ubd80\ud130 \ube44\uad50\ud560 \ud56d\ubaa9<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/polytech-middle-aged-training-course-guide\/\">\ud3f4\ub9ac\ud14d \uc2e0\uc911\ub144 \ud2b9\ud654\uacfc\uc815 \ud655\uc778\ubc29\ubc95: 4050 \uae30\uc220\uad50\uc721 \ucc3e\ub294 \uae30\uc900<\/a><\/li>\n<\/ul>\n<\/section>\n<p><!-- guide4050-related-end --><\/p>\n<p><!-- 4050_SHORT_UPLIFT_START --><\/p>\n<section class=\"guide-short-uplift\">\n<h2>\uad6d\ube44\uc9c0\uc6d0 \uc815\ubcf4\ub97c \ubcfc \ub54c \ud568\uaed8 \ud655\uc778\ud560 \uac83<\/h2>\n<p>\uad6d\ube44\uc9c0\uc6d0 \uacfc\uc815\uc740 \uc2e0\uccad \uac00\ub2a5 \uc5ec\ubd80, \uc790\ube44\ubd80\ub2f4\uae08, \uc218\ub8cc \uac00\ub2a5\uc131, \ucde8\uc5c5 \uc5f0\uacb0\uc131\uc744 \ud568\uaed8 \ubd10\uc57c \ud569\ub2c8\ub2e4. \ud2b9\ud788 4050 \uc138\ub300\ub294 \uc2dc\uac04\uacfc \ube44\uc6a9\uc744 \ub2e4\uc2dc \uc4f0\uae30 \uc5b4\ub835\uae30 \ub54c\ubb38\uc5d0 \uc811\uc218 \uc804 \uae30\uc900\uc744 \ubd84\uba85\ud788 \uc7a1\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<figure class=\"wp-block-table\">\n<table>\n<tr>\n<th>\ud655\uc778 \uc21c\uc11c<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<th>\ud310\ub2e8 \uae30\uc900<\/th>\n<\/tr>\n<tr>\n<td>1\ub2e8\uacc4<\/td>\n<td>\uc2e0\uccad \uac00\ub2a5 \uc5ec\ubd80<\/td>\n<td>\uace0\uc6a9 \uc0c1\ud0dc\uc640 \ub098\uc774\ubcf4\ub2e4 \uc2e4\uc81c \uc9c0\uc6d0 \uc81c\uc678 \uc870\uac74\uc744 \uba3c\uc800 \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>2\ub2e8\uacc4<\/td>\n<td>\ud6c8\ub828\ube44\uc640 \uc790\ube44\ubd80\ub2f4\uae08<\/td>\n<td>\ucd1d\uc561, \uc815\ubd80\uc9c0\uc6d0\uae08, \ubcf8\uc778\ubd80\ub2f4\uae08\uc744 \ub098\ub220 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>3\ub2e8\uacc4<\/td>\n<td>\uc218\ub8cc \uac00\ub2a5\uc131<\/td>\n<td>\ucd9c\uc11d \uc2dc\uac04, \uac70\ub9ac, \uc2e4\uc2b5 \uc77c\uc815\uc744 \ud604\uc2e4\uc801\uc73c\ub85c \uacc4\uc0b0\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>4\ub2e8\uacc4<\/td>\n<td>\ucde8\uc5c5 \uc5f0\uacb0\uc131<\/td>\n<td>\uc218\ub8cc \ud6c4 \uc9c0\uc6d0 \uac00\ub2a5\ud55c \ucc44\uc6a9\uacf5\uace0\uac00 \uc788\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/table>\n<\/figure>\n<h3>\ube60\ub978 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h3>\n<ul>\n<li>\ud6c8\ub828\uae30\uad00 \uc0c1\ub2f4 \uc804 \uc9c8\ubb38\uc744 \uba54\ubaa8\ud569\ub2c8\ub2e4.<\/li>\n<li>\uac19\uc740 \uacfc\uc815\uc774\ub77c\ub3c4 \uc9c0\uc5ed\uacfc \uae30\uad00\ubcc4 \ube44\uc6a9\uc744 \ube44\uad50\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc218\ub8cc \ud6c4 \ubc14\ub85c \uc4f8 \uc218 \uc788\ub294 \uc790\uaca9\uc774\ub098 \uae30\uc220\uc778\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<\/ul>\n<p>\uc704 \ub0b4\uc6a9\uc740 \uae30\ubcf8 \ud310\ub2e8 \uae30\uc900\uc774\uba70, \uc2e4\uc81c \uc2e0\uccad\uc774\ub098 \uc811\uc218 \uc804\uc5d0\ub294 \uacf5\uc2dd \uae30\uad00\uc758 \ucd5c\uc2e0 \uc548\ub0b4\ub97c \ub2e4\uc2dc \ud655\uc778\ud558\ub294 \uac83\uc774 \uc548\uc804\ud569\ub2c8\ub2e4.<\/p>\n<\/section>\n<p><!-- 4050_SHORT_UPLIFT_END --><\/p>\n","protected":false},"excerpt":{"rendered":"<p>\uc7ac\uc9c1 \uc911\uc5d0\ub3c4 \uc9c1\ubb34 \uc804\ud658\uc774\ub098 \uc774\uc9c1 \uc900\ube44\ub97c \uc704\ud574 \uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc\ub97c \uac80\ud1a0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\ub9cc \uadfc\ubb34\uc2dc\uac04\uacfc \ud6c8\ub828\uc2dc\uac04\uc774 \uacb9\uce58\uba74 \uc218\ub8cc\uac00 \uc5b4\ub824\uc6cc\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n","protected":false},"author":0,"featured_media":232,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[3],"tags":[],"class_list":["post-131","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-support"],"_links":{"self":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts\/131","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/types\/post"}],"replies":[{"embeddable":true,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/com