{"id":115,"date":"2026-05-22T14:45:33","date_gmt":"2026-05-22T05:45:33","guid":{"rendered":"https:\/\/4050guide.co.kr\/caregiver-jobs-after-certificate\/"},"modified":"2026-05-26T09:29:09","modified_gmt":"2026-05-26T00:29:09","slug":"caregiver-jobs-after-certificate","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/caregiver-jobs-after-certificate\/","title":{"rendered":"\uc694\uc591\ubcf4\ud638\uc0ac \ucde8\ub4dd \ud6c4 \ucde8\uc5c5\ucc98: \ubc29\ubb38\uc694\uc591, \uc2dc\uc124, \uc8fc\uac04\ubcf4\ud638\uc13c\ud130 \ucc28\uc774"},"content":{"rendered":"<p>\uc694\uc591\ubcf4\ud638\uc0ac \uc790\uaca9\uc99d\uc740 4050 \uc774\ud6c4 \uc7ac\ucde8\uc5c5\uc5d0\uc11c \ub9ce\uc774 \uac80\ud1a0\ud558\ub294 \uc790\uaca9\uc785\ub2c8\ub2e4. \ub2e4\ub9cc \ucde8\ub4dd \ud6c4 \uc77c\ud558\ub294 \uacf3\uc5d0 \ub530\ub77c \uc5c5\ubb34 \uac15\ub3c4\uc640 \uadfc\ubb34 \uc2dc\uac04\uc774 \ud06c\uac8c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4.<\/p>\n<p>\ubc29\ubb38\uc694\uc591, \uc694\uc591\uc2dc\uc124, \uc8fc\uac04\ubcf4\ud638\uc13c\ud130\ub294 \ubaa8\ub450 \ub3cc\ubd04 \uc5c5\ubb34\ub77c\ub294 \uacf5\ud1b5\uc810\uc774 \uc788\uc9c0\ub9cc \uc774\ub3d9 \ubc29\uc2dd, \uc2e0\uccb4 \ubd80\ub2f4, \uadfc\ubb34 \ud328\ud134\uc774 \ub2e4\ub974\ubbc0\ub85c \ubcf8\uc778\uc758 \uc0dd\ud65c \uc870\uac74\uacfc \ub9de\ucdb0\ubd10\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h2>\ucde8\uc5c5\ucc98\ubcc4 \ucc28\uc774<\/h2>\n<table class=\"guide-table\">\n<tbody>\n<tr>\n<th>\ubc29\ubb38\uc694\uc591<\/th>\n<td>\uc5b4\ub974\uc2e0 \uac00\uc815\uc744 \ubc29\ubb38\ud574 \ub3cc\ubd04 \uc81c\uacf5. \uc774\ub3d9 \uc2dc\uac04\uacfc \ubc30\uc815 \uc9c0\uc5ed \ud655\uc778 \ud544\uc694<\/td>\n<\/tr>\n<tr>\n<th>\uc694\uc591\uc2dc\uc124<\/th>\n<td>\uc2dc\uc124 \ub0b4 \uad50\ub300\uadfc\ubb34 \uac00\ub2a5. \uc2e0\uccb4 \ubd80\ub2f4\uacfc \uc57c\uac04\uadfc\ubb34 \uc5ec\ubd80 \ud655\uc778<\/td>\n<\/tr>\n<tr>\n<th>\uc8fc\uac04\ubcf4\ud638\uc13c\ud130<\/th>\n<td>\ub0ae \uc2dc\uac04 \ub3cc\ubd04 \uc911\uc2ec. \ud504\ub85c\uadf8\ub7a8 \ubcf4\uc870\uc640 \uc1a1\uc601 \uc5c5\ubb34\uac00 \ud3ec\ud568\ub420 \uc218 \uc788\uc74c<\/td>\n<\/tr>\n<tr>\n<th>\uacf5\ud1b5 \ud655\uc778<\/th>\n<td>\uadfc\ubb34\uc2dc\uac04, \uc774\ub3d9\uac70\ub9ac, \uae09\uc5ec \ubc29\uc2dd, 4\ub300\ubcf4\ud5d8 \uc5ec\ubd80<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>4050 \uae30\uc900\uc73c\ub85c \uba3c\uc800 \ud655\uc778\ud560 \uac83<\/h2>\n<ul>\n<li>\ud5c8\ub9ac, \ubb34\ub98e \ub4f1 \uc2e0\uccb4 \ubd80\ub2f4\uc744 \uac10\ub2f9\ud560 \uc218 \uc788\ub294\uc9c0 \ubd05\ub2c8\ub2e4.<\/li>\n<li>\ubc29\ubb38\uc694\uc591\uc740 \uc774\ub3d9\uac70\ub9ac\uc640 \uad50\ud1b5\ud3b8\uc744 \ubc18\ub4dc\uc2dc \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc2dc\uc124 \uadfc\ubb34\ub294 \uad50\ub300\uc640 \uc57c\uac04\uadfc\ubb34 \uc870\uac74\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\ucd08\ubcf4\uc790\ub294 \uad50\uc721\uae30\uad00\uc758 \ucde8\uc5c5 \uc5f0\uacc4 \ubc29\uc2dd\ub3c4 \ud568\uaed8 \ubd05\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>\uc2e0\uccad\ud558\uac70\ub098 \uc900\ube44\ud560 \ub54c \uc790\uc8fc \ub193\uce58\ub294 \ubd80\ubd84<\/h2>\n<ul>\n<li>\uc790\uaca9\uc99d\ub9cc \ucde8\ub4dd\ud558\uba74 \uc6d0\ud558\ub294 \uc2dc\uac04\uc5d0 \ubc14\ub85c \uc77c\ud560 \uc218 \uc788\ub2e4\uace0 \uc0dd\uac01\ud558\ub294 \uacbd\uc6b0<\/li>\n<li>\ubc29\ubb38\uc694\uc591\uacfc \uc2dc\uc124 \uadfc\ubb34\uc758 \uc5c5\ubb34 \uac15\ub3c4\ub97c \ub3d9\uc77c\ud558\uac8c \ubcf4\ub294 \uacbd\uc6b0<\/li>\n<li>\uc1a1\uc601 \uc5c5\ubb34, \uc2dd\uc0ac \ubcf4\uc870, \ud504\ub85c\uadf8\ub7a8 \ubcf4\uc870 \ub4f1 \ubd80\uac00 \uc5c5\ubb34\ub97c \ub193\uce58\ub294 \uacbd\uc6b0<\/li>\n<li>\uae09\uc5ec\ub9cc \ubcf4\uace0 \uc774\ub3d9 \uc2dc\uac04\uacfc \ud734\uac8c \uc2dc\uac04\uc744 \uacc4\uc0b0\ud558\uc9c0 \uc54a\ub294 \uacbd\uc6b0<\/li>\n<\/ul>\n<h2>\ud604\uc2e4\uc801\uc73c\ub85c \uc774\ub807\uac8c \ud310\ub2e8\ud558\uc138\uc694<\/h2>\n<p>\uc694\uc591\ubcf4\ud638\uc0ac\ub294 \uc218\uc694\uac00 \uafb8\uc900\ud558\uc9c0\ub9cc \uc26c\uc6b4 \uc77c\uc740 \uc544\ub2d9\ub2c8\ub2e4. \ud2b9\ud788 4050 \ucd08\ubcf4\uc790\ub294 \ucc98\uc74c\ubd80\ud130 \uc7a5\uc2dc\uac04 \uadfc\ubb34\ubcf4\ub2e4 \ubcf8\uc778\uc758 \uccb4\ub825\uacfc \ub3cc\ubd04 \uacbd\ud5d8\uc744 \uace0\ub824\ud574 \uc2dc\uc791\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ucde8\uc5c5\ucc98\ub97c \uace0\ub97c \ub54c\ub294 \uae30\uad00\uba85\ubcf4\ub2e4 \uc2e4\uc81c \uadfc\ubb34\ud45c, \ub2f4\ub2f9 \uc5b4\ub974\uc2e0 \uc218, \uc774\ub3d9\uac70\ub9ac, \uad50\uc721 \uc9c0\uc6d0 \uc5ec\ubd80\ub97c \ud655\uc778\ud558\uc138\uc694.<\/p>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<details>\n<summary>\uc694\uc591\ubcf4\ud638\uc0ac \ucde8\ub4dd \ud6c4 \ubc14\ub85c \ucde8\uc5c5\ud560 \uc218 \uc788\ub098\uc694?<\/summary>\n<p>\uc9c0\uc5ed\uacfc \uae30\uad00 \uc0c1\ud669\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \uc790\uaca9 \ucde8\ub4dd \ud6c4 \uad50\uc721\uae30\uad00, \uc6cc\ud06c\ub137, \uc9c0\uc5ed\uc13c\ud130 \ucc44\uc6a9\uacf5\uace0\ub97c \ud568\uaed8 \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<\/details>\n<details>\n<summary>\ub0a8\uc131\ub3c4 \uc694\uc591\ubcf4\ud638\uc0ac\ub85c \uc77c\ud560 \uc218 \uc788\ub098\uc694?<\/summary>\n<p>\uac00\ub2a5\ud569\ub2c8\ub2e4. \uc2dc\uc124, \ubcd1\uc6d0, \ubc29\ubb38\uc694\uc591 \ub4f1\uc5d0\uc11c \ub0a8\uc131 \uc778\ub825\uc744 \ucc3e\ub294 \uacbd\uc6b0\ub3c4 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<\/details>\n<h2>\uacf5\uc2dd \ud655\uc778\ucc98<\/h2>\n<p>\uc81c\ub3c4\uc640 \uc2dc\ud5d8 \uc815\ubcf4\ub294 \uc218\uc2dc\ub85c \ubc14\ub014 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2e4\uc81c \uc2e0\uccad \uc804\uc5d0\ub294 \uc544\ub798 \uacf5\uc2dd \ud398\uc774\uc9c0\uc5d0\uc11c \ucd5c\uc2e0 \uacf5\uace0, \uc2e0\uccad \uc790\uaca9, \uc811\uc218 \uae30\uac04\uc744 \ub2e4\uc2dc \ud655\uc778\ud558\uc138\uc694.<\/p>\n<ul>\n<li><a href=\"https:\/\/www.kuksiwon.or.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\ud55c\uad6d\ubcf4\uac74\uc758\ub8cc\uc778\uad6d\uac00\uc2dc\ud5d8\uc6d0<\/a><\/li>\n<li><a href=\"https:\/\/www.longtermcare.or.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\ub178\uc778\uc7a5\uae30\uc694\uc591\ubcf4\ud5d8<\/a><\/li>\n<\/ul>\n<div class=\"guide-related\"><\/div>\n<p><!-- guide4050-depth-expand --><\/p>\n<h2>4050 \uae30\uc900\uc73c\ub85c \uba3c\uc800 \ud310\ub2e8\ud560 \ubd80\ubd84<\/h2>\n<p>\uc694\uc591\ubcf4\ud638\uc0ac \ucde8\ub4dd \ud6c4 \ucde8\uc5c5\ucc98: \ubc29\ubb38\uc694\uc591, \uc2dc\uc124, \uc8fc\uac04\ubcf4\ud638\uc13c\ud130 \ucc28\uc774\ub97c \ud655\uc778\ud560 \ub54c\ub294 \ub2e8\uc21c\ud788 \uc774\ub984\ub9cc \ubcf4\uace0 \uacb0\uc815\ud558\uae30\ubcf4\ub2e4 \ub0b4 \uc0c1\ud669\uc5d0 \uc2e4\uc81c\ub85c \ub9de\ub294\uc9c0\ubd80\ud130 \ubcf4\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. 40\ub300\uc640 50\ub300\ub294 \uc774\ubbf8 \uc9c1\uc7a5 \uacbd\ud5d8, \uac00\uc871 \ubd80\uc591, \uac74\uac15\ubcf4\ud5d8\ub8cc, \ud1f4\uc9c1 \uc77c\uc815, \ubd80\ubaa8\ub2d8 \ub3cc\ubd04 \uac19\uc740 \uc870\uac74\uc774 \ud568\uaed8 \uc6c0\uc9c1\uc774\ub294 \uacbd\uc6b0\uac00 \ub9ce\uae30 \ub54c\ubb38\uc5d0 \uac19\uc740 \uc81c\ub3c4\ub77c\ub3c4 \uccb4\uac10\ub418\ub294 \uc720\ub9ac\ud568\uc774 \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ud2b9\ud788 \uc2e0\uccad\ud615 \uc81c\ub3c4\ub098 \uc790\uaca9\uc99d \uc815\ubcf4\ub294 \uad11\uace0 \ubb38\uad6c\ubcf4\ub2e4 \uacf5\uc2dd \uc870\uac74\uacfc \uc2e4\uc81c \ud65c\uc6a9\ucc98\ub97c \ud568\uaed8 \ubd10\uc57c \ud569\ub2c8\ub2e4. \uc9c0\uc6d0 \ub300\uc0c1, \uc2e0\uccad \uae30\uac04, \uc900\ube44\uc11c\ub958, \ubcf8\uc778\ubd80\ub2f4 \uc5ec\ubd80, \uc0c1\ub2f4 \ucc3d\uad6c\ub97c \uba3c\uc800 \ud655\uc778\ud558\uba74 \uc2dc\uac04\uc744 \uc904\uc77c \uc218 \uc788\uace0, \uc2e0\uccad \ud6c4 \ud0c8\ub77d\ud558\uac70\ub098 \uacfc\uc815 \uc218\ub8cc \ud6c4 \ud65c\uc6a9\ud558\uc9c0 \ubabb\ud558\ub294 \uc0c1\ud669\uc744 \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc790\uaca9\uc99d \uc120\ud0dd \uc804 \ud604\uc2e4 \uccb4\ud06c<\/h2>\n<table>\n<thead>\n<tr>\n<th>\uad6c\ubd84<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\uc751\uc2dc\uc870\uac74<\/td>\n<td>\ud559\ub825, \uacbd\ub825, \uc2e4\uc2b5, \uad50\uc721 \uc774\uc218 \uc870\uac74\uc774 \uc788\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\ucde8\uc5c5\ucc98<\/td>\n<td>\uc790\uaca9\uc99d\uc744 \uc694\uad6c\ud558\ub294 \uc2e4\uc81c \ucc44\uc6a9\uacf5\uace0\uac00 \uc788\ub294\uc9c0 \ud568\uaed8 \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc900\ube44\uae30\uac04<\/td>\n<td>\ud544\uae30\uc640 \uc2e4\uae30 \uc900\ube44\uac00 \uc0dd\ud65c \ud328\ud134 \uc548\uc5d0\uc11c \uac00\ub2a5\ud55c\uc9c0 \uacc4\uc0b0\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc720\uc9c0\ube44\uc6a9<\/td>\n<td>\ubcf4\uc218\uad50\uc721, \uac31\uc2e0, \uc2e4\uc2b5\ube44, \uad50\uc7ac\ube44\ucc98\ub7fc \ucd94\uac00 \ube44\uc6a9\uc774 \uc788\ub294\uc9c0 \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p>4050\uc5d0\uac8c \uc88b\uc740 \uc790\uaca9\uc99d\uc740 \u201c\ucde8\ub4dd\uc774 \uc26c\uc6b4 \uc790\uaca9\uc99d\u201d\uc774 \uc544\ub2c8\ub77c \uacbd\ub825, \uccb4\ub825, \uc9c0\uc5ed \uc77c\uc790\ub9ac\uc640 \uc5f0\uacb0\ub418\ub294 \uc790\uaca9\uc99d\uc785\ub2c8\ub2e4. \uc2dc\ud5d8 \ud569\uaca9\ub9cc \ubaa9\ud45c\ub85c \uc7a1\uae30\ubcf4\ub2e4, \ucde8\ub4dd \ud6c4 \uc9c0\uc6d0\ud560 \uc218 \uc788\ub294 \uae30\uad00\uacfc \uadfc\ubb34 \ud615\ud0dc\uae4c\uc9c0 \uac19\uc774 \ud655\uc778\ud574\uc57c \ub9cc\uc871\ub3c4\uac00 \ub192\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc0c1\ub2f4 \uc804 \uba54\ubaa8\ud574\ub450\uba74 \uc88b\uc740 \uc9c8\ubb38<\/h2>\n<ul>\n<li>\ub0b4 \ub098\uc774\uc640 \uace0\uc6a9 \uc0c1\ud0dc\uc5d0\uc11c \uc2e0\uccad \uac00\ub2a5\ud55c\uac00\uc694?<\/li>\n<li>\uc18c\ub4dd, \uc7ac\uc0b0, \uacbd\ub825 \ub54c\ubb38\uc5d0 \uc81c\uc678\ub420 \uc218 \uc788\ub294 \uc870\uac74\uc774 \uc788\ub098\uc694?<\/li>\n<li>\uc628\ub77c\uc778 \uc2e0\uccad\uacfc \ubc29\ubb38 \uc2e0\uccad \uc911 \uc5b4\ub5a4 \ubc29\uc2dd\uc774 \ube60\ub978\uac00\uc694?<\/li>\n<li>\uc2e0\uccad \ud6c4 \uacb0\uacfc \ud655\uc778\uae4c\uc9c0 \ubcf4\ud1b5 \uc5bc\ub9c8\ub098 \uac78\ub9ac\ub098\uc694?<\/li>\n<li>\ube44\uc2b7\ud55c \uc81c\ub3c4\ub098 \uacfc\uc815\uacfc \uc911\ubcf5 \uc774\uc6a9\uc774 \uac00\ub2a5\ud55c\uac00\uc694?<\/li>\n<\/ul>\n<p>\uc774 \uc9c8\ubb38\uc744 \ubbf8\ub9ac \uc815\ub9ac\ud574\ub450\uba74 \uc0c1\ub2f4 \uc2dc\uac04\uc774 \uc9e7\uc544\uc9c0\uace0, \ub2f4\ub2f9\uc790\uc5d0\uac8c \ud544\uc694\ud55c \uc815\ubcf4\ub97c \ube60\ub974\uac8c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \uac00\uc871 \ub300\uc2e0 \uc54c\uc544\ubcf4\ub294 \uacbd\uc6b0\uc5d0\ub294 \ub2f9\uc0ac\uc790\uc758 \uc0dd\ub144\uc6d4\uc77c, \uac70\uc8fc\uc9c0, \uc18c\ub4dd \uc0c1\ud0dc, \uac74\uac15 \uc0c1\ud0dc\ucc98\ub7fc \uae30\ubcf8 \uc815\ubcf4\ub97c \uc900\ube44\ud574\ub450\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<p><!-- guide4050-related-start --><\/p>\n<section class=\"guide-related-posts\">\n<h2>\ud568\uaed8 \ubcf4\uba74 \uc88b\uc740 \uae00<\/h2>\n<p>\uc774 \uae00\uacfc \uc774\uc5b4\uc11c \ud655\uc778\ud558\uba74 \uc88b\uc740 4050 \ub9de\ucda4 \uc815\ubcf4\uc785\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/4050guide.co.kr\/2026-qnet-constant-exam-14-license-guide-4050\/\">2026\ub144 \uc0c1\uc2dc\uac80\uc815 \uc790\uaca9\uc99d 14\uc885\ubaa9: \uc9c0\uac8c\ucc28\u00b7\ud55c\uc2dd\uc870\ub9ac\ucc98\ub7fc \uc77c\uc815 \uc120\ud0dd\uc774 \uc26c\uc6b4 \uc885\ubaa9<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/2026-national-technical-exam-remaining-schedule-4050\/\">2026\ub144 \ub0a8\uc740 \uad6d\uac00\uae30\uc220\uc790\uaca9 \uc2dc\ud5d8\uc77c\uc815: 4050\uc774 \uc9c0\uae08 \uc900\ube44\ud560 \uc218 \uc788\ub294 \ud68c\ucc28 \uc815\ub9ac<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/2026-craftsman-remaining-exam-schedule-4050\/\">2026\ub144 \uae30\ub2a5\uc0ac \ub0a8\uc740 \uc2dc\ud5d8\uc77c\uc815: \uc804\uae30\u00b7\uc870\ub9ac\u00b7\uc2dc\uc124\uad00\ub9ac \uc900\ube44\uc790\uc6a9 4050 \uac00\uc774\ub4dc<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/2026-engineer-industrial-engineer-remaining-schedule-4050\/\">2026\ub144 \uae30\uc0ac\u00b7\uc0b0\uc5c5\uae30\uc0ac \ub0a8\uc740 \uc2dc\ud5d8\uc77c\uc815: \uc81c2\ud68c\u00b7\uc81c3\ud68c \uc900\ube44 \uac00\ub2a5\uc131 \ube44\uad50<\/a><\/li>\n<\/ul>\n<\/section>\n<p><!-- guide4050-related-end --><\/p>\n","protected":false},"excerpt":{"rendered":"<p>\uc694\uc591\ubcf4\ud638\uc0ac \uc790\uaca9\uc99d\uc740 4050 \uc774\ud6c4 \uc7ac\ucde8\uc5c5\uc5d0\uc11c \ub9ce\uc774 \uac80\ud1a0\ud558\ub294 \uc790\uaca9\uc785\ub2c8\ub2e4. \ub2e4\ub9cc \ucde8\ub4dd \ud6c4 \uc77c\ud558\ub294 \uacf3\uc5d0 \ub530\ub77c \uc5c5\ubb34 \uac15\ub3c4\uc640 \uadfc\ubb34 \uc2dc\uac04\uc774 \ud06c\uac8c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4.<\/p>\n","protected":false},"author":0,"featured_media":217,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[2],"tags":[],"class_list":["post-115","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-license"],"_links":{"self":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts\/115","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/types\/post"}],"replies":[{"embeddable":true,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/comments?post=115"}],"version-history":[{"count":3,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts\/115\/revisions"}],"predecessor-version":[{"id":417,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts\/115\/revisions\/417"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/media\/217"}],"wp:attachment":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/media?parent=115"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/ca