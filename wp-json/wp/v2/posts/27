{"id":27,"date":"2026-05-14T16:30:00","date_gmt":"2026-05-14T07:30:00","guid":{"rendered":"https:\/\/4050guide.co.kr\/?p=27"},"modified":"2026-05-26T18:33:29","modified_gmt":"2026-05-26T09:33:29","slug":"national-tomorrow-learning-card-apply","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/national-tomorrow-learning-card-apply\/","title":{"rendered":"\uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc \uc2e0\uccad\ubc29\ubc95 2026: \ub300\uc0c1, \uc0ac\uc6a9\ucc98, \uc2e0\uccad \uc804 \ud655\uc778\ud560 \uac83"},"content":{"rendered":"<figure class=\"wp-block-image size-large\"><img decoding=\"async\" src=\"\/wp-content\/uploads\/2026\/05\/national-tomorrow-learning-card-photo.png\" alt=\"\uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc \uc2e0\uccad\ubc29\ubc95 2026: \ub300\uc0c1, \uc0ac\uc6a9\ucc98, \uc2e0\uccad \uc804 \ud655\uc778\ud560 \uac83\"><\/figure>\n<p>\uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc\ub294 \uc9c1\uc5c5\ud6c8\ub828\uc774 \ud544\uc694\ud55c \uc0ac\ub78c\uc774 \uad50\uc721\ube44 \ubd80\ub2f4\uc744 \uc904\uc774\uace0 \uc0c8\ub85c\uc6b4 \uae30\uc220\uc744 \ubc30\uc6b8 \uc218 \uc788\ub3c4\ub85d \ub3d5\ub294 \uc81c\ub3c4\uc785\ub2c8\ub2e4. 40\ub300\uc640 50\ub300\ub294 \uc7ac\ucde8\uc5c5, \uc804\uc9c1, \uc790\uaca9\uc99d \uc900\ube44, \uc9c1\ubb34 \uc804\ud658\uc744 \uc704\ud574 \uad6d\ube44\uc9c0\uc6d0 \uad50\uc721\uc744 \ucc3e\ub294 \uacbd\uc6b0\uac00 \ub9ce\uae30 \ub54c\ubb38\uc5d0 \uc2e0\uccad\ubc29\ubc95\ub9cc\ud07c\uc774\ub098 \u201c\uc5b4\ub5a4 \uacfc\uc815\uc744 \uace8\ub77c\uc57c \ud558\ub294\uc9c0\u201d\ub97c \ud568\uaed8 \ubd10\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h2>\uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc \ud575\uc2ec \uc694\uc57d<\/h2>\n<table>\n<thead>\n<tr>\n<th>\uad6c\ubd84<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\uc2e0\uccad \ubaa9\uc801<\/td>\n<td>\uc9c1\uc5c5\ud6c8\ub828, \uc790\uaca9\uc99d \uc900\ube44, \uc7ac\ucde8\uc5c5\u00b7\uc804\uc9c1 \uc900\ube44\ub97c \uc704\ud55c \ud6c8\ub828\ube44 \uc9c0\uc6d0<\/td>\n<\/tr>\n<tr>\n<td>\uc2e0\uccad \uacbd\ub85c<\/td>\n<td>\uace0\uc6a924\uc5d0\uc11c \uc628\ub77c\uc778 \uc2e0\uccad, \uace0\uc6a9\uc13c\ud130 \ubc29\ubb38 \uc2e0\uccad \uac00\ub2a5<\/td>\n<\/tr>\n<tr>\n<td>\ud655\uc778\ud560 \uac83<\/td>\n<td>\ubcf8\uc778\ubd80\ub2f4\uae08, \ud6c8\ub828\uc2dc\uac04, \ucd9c\uc11d \uae30\uc900, \uc218\ub8cc \uc870\uac74, \ucde8\uc5c5 \uc5f0\uacc4 \uc5ec\ubd80<\/td>\n<\/tr>\n<tr>\n<td>\uc8fc\uc758\uc810<\/td>\n<td>\uce74\ub4dc \ubc1c\uae09\uacfc \ud6c8\ub828\uacfc\uc815 \uc2e0\uccad\uc740 \ubcc4\ub3c4 \uc808\ucc28\ub85c \uc9c4\ud589\ub420 \uc218 \uc788\uc74c<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>4050\uc774 \uc2e0\uccad \uc804\uc5d0 \ubd10\uc57c \ud560 \uae30\uc900<\/h2>\n<p>\uce74\ub4dc\ub97c \ubc1c\uae09\ubc1b\ub294 \uac83\ubcf4\ub2e4 \uc911\uc694\ud55c \uac83\uc740 \ub0b4 \uc0c1\ud669\uc5d0 \ub9de\ub294 \uacfc\uc815\uc744 \uace0\ub974\ub294 \uc77c\uc785\ub2c8\ub2e4. \uad11\uace0\uc5d0\uc11c \u201c\ubb34\ub8cc\u201d\ub77c\uace0 \ubcf4\uc5ec\ub3c4 \uc2e4\uc81c\ub85c\ub294 \ubcf8\uc778\ubd80\ub2f4\uae08\uc774 \uc788\uac70\ub098 \ucd9c\uc11d\ub960 \uae30\uc900\uc744 \ucc44\uc6b0\uc9c0 \ubabb\ud558\uba74 \uc9c0\uc6d0\uc774 \uc81c\ud55c\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<ul>\n<li>\ud3c9\uc77c \uc8fc\uac04 \uc218\uc5c5\uc778\uc9c0, \uc57c\uac04\u00b7\uc8fc\ub9d0 \uacfc\uc815\uc778\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc9d1\uc774\ub098 \uc9c1\uc7a5\uc5d0\uc11c \uc774\ub3d9 \uac00\ub2a5\ud55c \uac70\ub9ac\uc778\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc218\ub8cc \ud6c4 \uc2e4\uc81c \uc9c0\uc6d0 \uac00\ub2a5\ud55c \uc77c\uc790\ub9ac\uc640 \uc5f0\uacb0\ub418\ub294\uc9c0 \ubd05\ub2c8\ub2e4.<\/li>\n<li>\uc790\uaca9\uc99d \ucde8\ub4dd \uacfc\uc815\uc774\ub77c\uba74 \uc2dc\ud5d8 \uc77c\uc815\uacfc \uc2e4\uc2b5 \uc5ec\ubd80\ub97c \ud568\uaed8 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\ubcf8\uc778\ubd80\ub2f4\uae08\uc774 \uc5bc\ub9c8\uc778\uc9c0, \uad50\uc7ac\ube44\ub098 \uc7ac\ub8cc\ube44\uac00 \ubcc4\ub3c4\uc778\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>\ud6c8\ub828\uacfc\uc815 \uc120\ud0dd \uc608\uc2dc<\/h2>\n<table>\n<thead>\n<tr>\n<th>\ubaa9\ud45c<\/th>\n<th>\uc0b4\ud3b4\ubcfc \uacfc\uc815<\/th>\n<th>\ud655\uc778 \ud3ec\uc778\ud2b8<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\uc2dc\uc124\uad00\ub9ac \uc804\uc9c1<\/td>\n<td>\uc804\uae30, \uc18c\ubc29, \uc5d0\ub108\uc9c0\uad00\ub9ac, \uacf5\uc870 \uad00\ub828 \uacfc\uc815<\/td>\n<td>\uc2e4\uae30 \uc5f0\uc2b5 \ud658\uacbd\uacfc \uc2dc\ud5d8 \ub300\ube44 \uc5ec\ubd80<\/td>\n<\/tr>\n<tr>\n<td>\ub3cc\ubd04 \ubd84\uc57c \ucde8\uc5c5<\/td>\n<td>\uc694\uc591\ubcf4\ud638\uc0ac, \uc0ac\ud68c\ubcf5\uc9c0 \uc2e4\ubb34, \ubcd1\uc6d0 \ub3d9\ud589 \uad00\ub828 \uacfc\uc815<\/td>\n<td>\uc2e4\uc2b5 \uc77c\uc815\uacfc \ucde8\uc5c5\ucc98 \uc5f0\uacb0<\/td>\n<\/tr>\n<tr>\n<td>\ubb3c\ub958\u00b7\ud604\uc7a5\uc9c1<\/td>\n<td>\uc9c0\uac8c\ucc28, \uad74\ucc29\uae30, \ubb3c\ub958\uad00\ub9ac \uacfc\uc815<\/td>\n<td>\uc7a5\ube44 \uc2e4\uc2b5 \uc2dc\uac04\uacfc \uc548\uc804\uad50\uc721<\/td>\n<\/tr>\n<tr>\n<td>\uc0ac\ubb34\uc9c1 \uc7ac\uc9c4\uc785<\/td>\n<td>\ucef4\ud4e8\ud130\ud65c\uc6a9, \ud68c\uacc4, \uc5d1\uc140 \uc2e4\ubb34 \uacfc\uc815<\/td>\n<td>\uae30\ucd08\ubc18\uc778\uc9c0 \uc2e4\ubb34\ubc18\uc778\uc9c0 \uad6c\ubd84<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\uc2e0\uccad \uc808\ucc28<\/h2>\n<ol>\n<li>\uace0\uc6a924\uc5d0\uc11c \uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc \uc548\ub0b4 \ud398\uc774\uc9c0\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\ubcf8\uc778 \uc778\uc99d \ud6c4 \uc2e0\uccad\uc11c\ub97c \uc791\uc131\ud569\ub2c8\ub2e4.<\/li>\n<li>\ud6c8\ub828 \ubaa9\uc801\uacfc \uad6c\uc9c1\u00b7\uc7ac\uc9c1 \uc0c1\ud0dc\ub97c \uc785\ub825\ud569\ub2c8\ub2e4.<\/li>\n<li>\uce74\ub4dc \ubc1c\uae09 \ud6c4 HRD-Net \ub610\ub294 \uace0\uc6a924\uc5d0\uc11c \ud6c8\ub828\uacfc\uc815\uc744 \uac80\uc0c9\ud569\ub2c8\ub2e4.<\/li>\n<li>\ud6c8\ub828\uae30\uad00\uc758 \uc77c\uc815, \ubcf8\uc778\ubd80\ub2f4\uae08, \uc218\ub8cc \uae30\uc900\uc744 \ud655\uc778\ud55c \ub4a4 \uc218\uac15 \uc2e0\uccad\ud569\ub2c8\ub2e4.<\/li>\n<\/ol>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<h3>\uce74\ub4dc\ub9cc \ubc1c\uae09\ubc1b\uc73c\uba74 \ubc14\ub85c \uc218\uc5c5\uc744 \ub4e4\uc744 \uc218 \uc788\ub098\uc694?<\/h3>\n<p>\uce74\ub4dc \ubc1c\uae09\uacfc \ud6c8\ub828\uacfc\uc815 \uc2e0\uccad\uc740 \uad6c\ubd84\ud574\uc11c \ubd10\uc57c \ud569\ub2c8\ub2e4. \uce74\ub4dc\uac00 \uc788\uc5b4\ub3c4 \uc6d0\ud558\ub294 \uacfc\uc815\uc758 \ubaa8\uc9d1 \uae30\uac04, \uc815\uc6d0, \uc790\ube44\ubd80\ub2f4\uae08 \uc870\uac74\uc744 \ub530\ub85c \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h3>50\ub300\ub3c4 \uc2e0\uccad\ud560 \uc218 \uc788\ub098\uc694?<\/h3>\n<p>\uc5f0\ub839\ub9cc\uc73c\ub85c \uc81c\ud55c\ub418\ub294 \uc81c\ub3c4\ub294 \uc544\ub2c8\uc9c0\ub9cc \uace0\uc6a9 \uc0c1\ud0dc, \uc9c0\uc6d0 \uc81c\uc678 \ub300\uc0c1, \ud6c8\ub828 \ubaa9\uc801\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2e4\uc81c \uc2e0\uccad \uc804 \uace0\uc6a924\uc640 \uace0\uc6a9\uc13c\ud130 \uc548\ub0b4\ub97c \ud655\uc778\ud558\ub294 \uac83\uc774 \uc548\uc804\ud569\ub2c8\ub2e4.<\/p>\n<h3>\uc5b4\ub5a4 \uacfc\uc815\uc774 \uac00\uc7a5 \uc88b\ub098\uc694?<\/h3>\n<p>\ubb34\uc870\uac74 \uc778\uae30 \uacfc\uc815\uc774 \uc88b\uc740 \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4. \ucd9c\uc11d \uac00\ub2a5\uc131, \ucde8\uc5c5\ucc98, \uccb4\ub825 \ubd80\ub2f4, \uc2e4\uc2b5 \uc870\uac74, \uc2dc\ud5d8 \ub09c\uc774\ub3c4\ub97c \ud568\uaed8 \ubd10\uc57c 4050\uc5d0\uac8c \ud604\uc2e4\uc801\uc778 \uc120\ud0dd\uc774 \ub429\ub2c8\ub2e4.<\/p>\n<h2>\uacfc\uc815 \uc120\ud0dd \uc804\uc5d0 \uc2e4\uc81c\ub85c \ube44\uad50\ud560 \uc9c8\ubb38<\/h2>\n<p>4050 \uc138\ub300\ub294 \ud6c8\ub828\uc744 \ubc1b\ub294 \ub3d9\uc548 \uc0dd\uacc4\uc640 \uc2dc\uac04\uc744 \ud568\uaed8 \uace0\ub824\ud574\uc57c \ud569\ub2c8\ub2e4. \uadf8\ub798\uc11c \uacfc\uc815\uba85\ubcf4\ub2e4 \uc218\uc5c5 \uc6b4\uc601 \ubc29\uc2dd\uc774 \ub354 \uc911\uc694\ud560 \ub54c\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \uac19\uc740 \uc804\uae30\uae30\ub2a5\uc0ac \uacfc\uc815\uc774\ub77c\ub3c4 \uc5b4\ub5a4 \uacf3\uc740 \ud544\uae30 \uc911\uc2ec\uc774\uace0, \uc5b4\ub5a4 \uacf3\uc740 \uc2e4\uae30 \uc2e4\uc2b5 \uc2dc\uac04\uc774 \ucda9\ubd84\ud569\ub2c8\ub2e4. \uac19\uc740 \ucef4\ud4e8\ud130 \uacfc\uc815\uc774\ub77c\ub3c4 \uae30\ucd08\ubc18\uc778\uc9c0 \uc2e4\ubb34 \uc5d1\uc140 \ubb38\uc11c \uc791\uc131\ubc18\uc778\uc9c0\uc5d0 \ub530\ub77c \uccb4\uac10 \ub09c\uc774\ub3c4\uac00 \ub2e4\ub985\ub2c8\ub2e4.<\/p>\n<ul>\n<li>\uc218\ub8cc \ud6c4 \ubc14\ub85c \uc9c0\uc6d0\ud560 \uc218 \uc788\ub294 \ucc44\uc6a9\uacf5\uace0\uac00 \uc788\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\ud6c8\ub828\uae30\uad00\uc774 \ucde8\uc5c5 \uc0c1\ub2f4\uc774\ub098 \uc774\ub825\uc11c \ucca8\uc0ad\uc744 \uc81c\uacf5\ud558\ub294\uc9c0 \ubd05\ub2c8\ub2e4.<\/li>\n<li>\uacb0\uc11d \uc2dc \ubcf4\uac15\uc774 \uac00\ub2a5\ud55c\uc9c0, \ucd9c\uc11d\ub960 \uae30\uc900\uc740 \uc5b4\ub5bb\uac8c \ub418\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc790\uaca9\uc99d \uacfc\uc815\uc774\ub77c\uba74 \uc2dc\ud5d8 \uc811\uc218 \uc2dc\uc810\uacfc \uc218\uc5c5 \uc885\ub8cc \uc2dc\uc810\uc774 \ub9de\ub294\uc9c0 \ubd05\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>\uc774\ub7f0 \uc120\ud0dd\uc740 \ud53c\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4<\/h2>\n<p>\u201c\ubb34\ub8cc\ub77c\uc11c\u201d, \u201c\uc9d1\uc5d0\uc11c \uac00\uae4c\uc6cc\uc11c\u201d, \u201c\uc778\uae30\uac00 \ub9ce\uc544\uc11c\u201d\ub77c\ub294 \uc774\uc720\ub9cc\uc73c\ub85c \uace0\ub974\uba74 \uc218\ub8cc \ud6c4 \ud65c\uc6a9\ub3c4\uac00 \ub0ae\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \ud1f4\uc9c1 \ud6c4 \uc7ac\ucde8\uc5c5\uc744 \ubaa9\ud45c\ub85c \ud55c\ub2e4\uba74 \ud6c8\ub828\uacfc\uc815 \uc0c1\uc138 \ud398\uc774\uc9c0\uc5d0\uc11c \ud6c8\ub828 \ubaa9\ud45c, \ucde8\uc5c5\ub960, \uc218\uac15\ud3c9, \ubcf8\uc778\ubd80\ub2f4\uae08, \ud6c8\ub828\uc2dc\uac04\ud45c\ub97c \ud568\uaed8 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \uad50\uc721\uc744 \ubc1b\ub294 \ub3d9\uc548 \ub2e4\ub978 \uad6c\uc9c1\ud65c\ub3d9\uc744 \ubcd1\ud589\ud560 \uc218 \uc788\ub294\uc9c0\ub3c4 \ud604\uc2e4\uc801\uc73c\ub85c \ub530\uc838\ubcf4\uc138\uc694.<\/p>\n<h2>\uacf5\uc2dd \ucd9c\ucc98<\/h2>\n<p>\uc81c\ub3c4\uc640 \uc2e0\uccad \uc808\ucc28\ub294 \ubcc0\uacbd\ub420 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2e4\uc81c \uc2e0\uccad \uc804\uc5d0\ub294 \uace0\uc6a924\uc758 \ucd5c\uc2e0 \uc548\ub0b4\ub97c \ud655\uc778\ud558\uc138\uc694.<\/p>\n<p><a href=\"https:\/\/www.work24.go.kr\/hr\/h\/a\/1100\/selectIssuGudn.do\" target=\"_blank\" rel=\"noopener\">\uace0\uc6a924 \uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc \uc548\ub0b4<\/a><\/p>\n<p><!-- guide4050-related-start --><\/p>\n<section class=\"guide-related-posts\">\n<h2>\ud568\uaed8 \ubcf4\uba74 \uc88b\uc740 \uae00<\/h2>\n<p>\uc774 \uae00\uacfc \uc774\uc5b4\uc11c \ud655\uc778\ud558\uba74 \uc88b\uc740 4050 \ub9de\ucda4 \uc815\ubcf4\uc785\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/4050guide.co.kr\/2026-qnet-constant-exam-14-license-guide-4050\/\">2026\ub144 \uc0c1\uc2dc\uac80\uc815 \uc790\uaca9\uc99d 14\uc885\ubaa9: \uc9c0\uac8c\ucc28\u00b7\ud55c\uc2dd\uc870\ub9ac\ucc98\ub7fc \uc77c\uc815 \uc120\ud0dd\uc774 \uc26c\uc6b4 \uc885\ubaa9<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/4050-tomorrow-card-self-payment-guide\/\">4050 \uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc \uc790\ube44\ubd80\ub2f4\uae08 \ud655\uc778\ubc95: \uac19\uc740 \uacfc\uc815\ub3c4 \ube44\uc6a9\uc774 \ub2e4\ub978 \uc774\uc720<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/second-half-2026-hrd-training-course-guide\/\">2026\ub144 \ud558\ubc18\uae30 \uad6d\ube44\uc9c0\uc6d0 \ud6c8\ub828\uacfc\uc815 \ucc3e\ub294 \ubc95: 6\uc6d4\ubd80\ud130 \ube44\uad50\ud560 \ud56d\ubaa9<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/polytech-middle-aged-training-course-guide\/\">\ud3f4\ub9ac\ud14d \uc2e0\uc911\ub144 \ud2b9\ud654\uacfc\uc815 \ud655\uc778\ubc29\ubc95: 4050 \uae30\uc220\uad50\uc721 \ucc3e\ub294 \uae30\uc900<\/a><\/li>\n<\/ul>\n<\/section>\n<p><!-- guide4050-related-end --><\/p>\n<p><!-- 4050_ADSENSE_CORE_UPGRADE_START --><\/p>\n<section class=\"guide-core-upgrade\">\n<h2>\uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc \uc2e0\uccad \uc804 4050 \uccb4\ud06c\ud3ec\uc778\ud2b8<\/h2>\n<p>\uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc\ub294 \ub2e8\uc21c\ud788 \uce74\ub4dc \ubc1c\uae09 \uc5ec\ubd80\ubcf4\ub2e4 \uc5b4\ub5a4 \ud6c8\ub828\uc744 \uc120\ud0dd\ud558\uace0 \uc790\ube44\ubd80\ub2f4\uae08\uc744 \uc5bc\ub9c8\ub098 \ub0b4\ub294\uc9c0\uac00 \uc911\uc694\ud569\ub2c8\ub2e4. 4050 \uc138\ub300\ub294 \uc7ac\ucde8\uc5c5, \uc804\uc9c1, \uc790\uaca9\uc99d \ucde8\ub4dd \ubaa9\uc801\uc774 \ubd84\uba85\ud55c \uacbd\uc6b0\uac00 \ub9ce\uae30 \ub54c\ubb38\uc5d0 \uc2e0\uccad \uc804 \uc544\ub798 \uae30\uc900\uc744 \uba3c\uc800 \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<figure class=\"wp-block-table\">\n<table>\n<tr>\n<th>\ud655\uc778 \ud56d\ubaa9<\/th>\n<th>\uc65c \uc911\uc694\ud55c\uac00<\/th>\n<th>4050 \uae30\uc900<\/th>\n<\/tr>\n<tr>\n<td>\uace0\uc6a9 \uc0c1\ud0dc<\/td>\n<td>\uc7ac\uc9c1\uc790, \uad6c\uc9c1\uc790, \uc790\uc601\uc5c5\uc790 \uc5ec\ubd80\uc5d0 \ub530\ub77c \uc774\uc6a9 \ubaa9\uc801\uc774 \ub2ec\ub77c\uc9d1\ub2c8\ub2e4.<\/td>\n<td>\ud604\uc7ac \uc18c\ub4dd\uacfc \uace0\uc6a9\ubcf4\ud5d8 \uac00\uc785 \uc5ec\ubd80\ub97c \uba3c\uc800 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\ud6c8\ub828 \uacfc\uc815<\/td>\n<td>\uac19\uc740 \uc790\uaca9\uc99d\uc774\ub77c\ub3c4 \ud6c8\ub828\uae30\uad00\uacfc \uc2dc\uac04\ud45c\uc5d0 \ub530\ub77c \uc218\ub8cc \uac00\ub2a5\uc131\uc774 \ub2e4\ub985\ub2c8\ub2e4.<\/td>\n<td>\ucd9c\uc11d \uac00\ub2a5 \uc2dc\uac04, \uac70\ub9ac, \uc2e4\uc2b5 \ube44\uc911\uc744 \ud568\uaed8 \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc790\ube44\ubd80\ub2f4\uae08<\/td>\n<td>\uc9c0\uc6d0 \uacfc\uc815\uc774\uc5b4\ub3c4 0\uc6d0\uc774 \uc544\ub2d0 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/td>\n<td>\uacb0\uc81c \uc804 HRD-Net\uc5d0\uc11c \uc2e4\uc81c \ubcf8\uc778\ubd80\ub2f4\uae08\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\ucde8\uc5c5 \uc5f0\uacb0\uc131<\/td>\n<td>\uc218\ub8cc\uc99d\ub9cc\uc73c\ub85c \ubc14\ub85c \ucde8\uc5c5\ub418\ub294 \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4.<\/td>\n<td>\uad6c\uc778\uacf5\uace0\uc5d0\uc11c \uc2e4\uc81c \uc694\uad6c\ud558\ub294 \uc790\uaca9\uc778\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/table>\n<\/figure>\n<h3>\uc2e0\uccad \uc804 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h3>\n<ul>\n<li>\uace0\uc6a924 \ub610\ub294 HRD-Net\uc5d0\uc11c \ubcf8\uc778 \uc2e0\uccad \uac00\ub2a5 \uc5ec\ubd80 \ud655\uc778<\/li>\n<li>\uad00\uc2ec \uacfc\uc815\uc758 \ud6c8\ub828\uc2dc\uac04\uacfc \ucd9c\uc11d \uc870\uac74 \ud655\uc778<\/li>\n<li>\uc790\ube44\ubd80\ub2f4\uae08\uacfc \uad50\uc7ac\ube44 \ubcc4\ub3c4 \uc5ec\ubd80 \ud655\uc778<\/li>\n<li>\uc218\ub8cc \ud6c4 \uc9c0\uc6d0 \uac00\ub2a5\ud55c \uc9c1\ubb34\uc640 \ucc44\uc6a9\uacf5\uace0 \ud655\uc778<\/li>\n<\/ul>\n<h3>\uc790\uc8fc \ub193\uce58\ub294 \ubd80\ubd84<\/h3>\n<p>\uac00\uc7a5 \ud754\ud55c \uc2e4\uc218\ub294 \u201c\uad6d\ube44\uc9c0\uc6d0\u201d\uc774\ub77c\ub294 \ub9d0\ub9cc \ubcf4\uace0 \uacfc\uc815\uc744 \uc120\ud0dd\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc2e4\uc81c\ub85c\ub294 \uc790\ube44\ubd80\ub2f4\uae08, \ud6c8\ub828 \ub09c\uc774\ub3c4, \uc218\ub8cc \ud6c4 \ucde8\uc5c5 \uc5f0\uacb0\uc131\uc774 \ubaa8\ub450 \ub2e4\ub974\ubbc0\ub85c \uacfc\uc815\uba85\ubcf4\ub2e4 \ud6c8\ub828\uae30\uad00 \ud3c9\uac00\uc640 \ucde8\uc5c5\ucc98\ub97c \ud568\uaed8 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<p><strong>\uacf5\uc2dd \ud655\uc778\ucc98:<\/strong> \uace0\uc6a924, HRD-Net<\/p>\n<\/section>\n<p><!-- 4050_ADSENSE_CORE_UPGRADE_END --><\/p>\n","protected":false},"excerpt":{"rendered":"<p>\uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc \uc2e0\uccad\ubc29\ubc95, \uc9c0\uc6d0 \ub300\uc0c1, \uc0ac\uc6a9\ucc98, \uc2e0\uccad \uc804 \ud655\uc778\ud560 \uc900\ube44\uc0ac\ud56d\uc744 4050 \uc138\ub300 \uae30\uc900\uc73c\ub85c \uc815\ub9ac\ud588\uc2b5\ub2c8\ub2e4.<\/p>\n","protected":false},"author":0,"featured_media":232,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[3],"tags":[],"class_list":["post-27","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-support"],"_links":{"self":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts\/27","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/types\/post"}],"replies":[{"embeddable":true,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/comments?post=27"}],"version-history":[{"count":8,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts\/27\/revisions"}],"predecessor-version":[{"id":437,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts\/27\/revisions\/437"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/media\/232"}],"wp:attachment":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/media?parent=27"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/categories?post=27"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/tags?post=27"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}