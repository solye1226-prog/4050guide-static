{"id":92,"date":"2026-05-18T23:06:03","date_gmt":"2026-05-18T14:06:03","guid":{"rendered":"https:\/\/4050guide.co.kr\/unemployment-benefit-apply-checklist\/"},"modified":"2026-05-26T18:38:19","modified_gmt":"2026-05-26T09:38:19","slug":"unemployment-benefit-apply-checklist","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/unemployment-benefit-apply-checklist\/","title":{"rendered":"\uc2e4\uc5c5\uae09\uc5ec \uc2e0\uccad \uc804 \ud655\uc778\ud560 \uac83: \uc774\uc9c1\ud655\uc778\uc11c\uc640 \uad6c\uc9c1\ud65c\ub3d9 \uae30\uc900"},"content":{"rendered":"<figure class=\"wp-block-image size-large\"><img decoding=\"async\" src=\"\/wp-content\/uploads\/2026\/05\/middle-aged-career-center-card.png\" alt=\"\uc2e4\uc5c5\uae09\uc5ec\uc640 \uad6c\uc9c1\ud65c\ub3d9 \uae30\uc900\uc744 \ud655\uc778\ud558\ub294 \uc911\uc7a5\ub144\"><\/figure>\n<p>\uc2e4\uc5c5\uae09\uc5ec\ub294 \ud1f4\uc9c1\ud588\ub2e4\uace0 \uc790\ub3d9\uc73c\ub85c \ubc1b\ub294 \ub3c8\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uace0\uc6a9\ubcf4\ud5d8 \uac00\uc785 \uc774\ub825, \ud1f4\uc9c1 \uc0ac\uc720, \uc774\uc9c1\ud655\uc778\uc11c, \uc218\uae09\uc790\uaca9 \uc2e0\uccad, \uad6c\uc9c1\ud65c\ub3d9 \ub4f1 \uc5ec\ub7ec \uc870\uac74\uc744 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. 4050 \uc138\ub300\ub294 \ud1f4\uc9c1 \uc774\ud6c4 \uc7ac\ucde8\uc5c5 \uc900\ube44 \uae30\uac04\uc774 \uae38\uc5b4\uc9c8 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2e0\uccad \uc804 \ud750\ub984\uc744 \ubbf8\ub9ac \uc54c\uc544\ub450\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4.<\/p>\n<h2>\uc2e4\uc5c5\uae09\uc5ec \uc2e0\uccad \uc804 \ud575\uc2ec \uc694\uc57d<\/h2>\n<table>\n<thead>\n<tr>\n<th>\ud56d\ubaa9<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\uace0\uc6a9\ubcf4\ud5d8 \uc774\ub825<\/td>\n<td>\ud53c\ubcf4\ud5d8 \ub2e8\uc704\uae30\uac04\uacfc \uac00\uc785 \uc774\ub825<\/td>\n<\/tr>\n<tr>\n<td>\ud1f4\uc9c1 \uc0ac\uc720<\/td>\n<td>\ube44\uc790\ubc1c\uc801 \uc774\uc9c1 \uc5ec\ubd80 \ub4f1 \uc218\uae09\uc790\uaca9\uacfc \uad00\ub828<\/td>\n<\/tr>\n<tr>\n<td>\uc774\uc9c1\ud655\uc778\uc11c<\/td>\n<td>\ud68c\uc0ac \uc81c\ucd9c \uc5ec\ubd80\uc640 \ub0b4\uc6a9 \ud655\uc778<\/td>\n<\/tr>\n<tr>\n<td>\uad6c\uc9c1\ub4f1\ub85d<\/td>\n<td>\uace0\uc6a924\ub97c \ud1b5\ud55c \uad6c\uc9c1 \uc758\uc0ac \ub4f1\ub85d<\/td>\n<\/tr>\n<tr>\n<td>\uad6c\uc9c1\ud65c\ub3d9<\/td>\n<td>\uc218\uae09 \uc911 \uc7ac\ucde8\uc5c5 \ud65c\ub3d9 \uc778\uc815 \uae30\uc900 \ud655\uc778<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\uc774\uc9c1\ud655\uc778\uc11c\uac00 \uc911\uc694\ud55c \uc774\uc720<\/h2>\n<p>\uc774\uc9c1\ud655\uc778\uc11c\ub294 \ud1f4\uc9c1 \uc0ac\uc720\uc640 \uadfc\ubb34 \uc774\ub825\uc744 \ud655\uc778\ud558\ub294 \uc911\uc694\ud55c \uc790\ub8cc\uc785\ub2c8\ub2e4. \ud68c\uc0ac\uac00 \uc81c\ucd9c\ud55c \ub0b4\uc6a9\uc5d0 \uc624\ub958\uac00 \uc788\uc73c\uba74 \uc218\uae09\uc790\uaca9 \ud655\uc778\uc774 \uc9c0\uc5f0\ub420 \uc218 \uc788\uc73c\ubbc0\ub85c, \ud1f4\uc9c1 \ud6c4 \uc9c4\ud589 \uc0c1\ud0dc\ub97c \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc2e0\uccad \ud750\ub984<\/h2>\n<ol>\n<li>\uace0\uc6a9\ubcf4\ud5d8 \uac00\uc785 \uc774\ub825\uacfc \ud1f4\uc9c1 \uc0ac\uc720\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uace0\uc6a924\uc5d0\uc11c \uad6c\uc9c1\ub4f1\ub85d\uc744 \uc9c4\ud589\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc774\uc9c1\ud655\uc778\uc11c \ucc98\ub9ac \uc5ec\ubd80\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc218\uae09\uc790\uaca9 \uc2e0\uccad \uad50\uc721\uacfc \uc2e0\uccad \uc808\ucc28\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc778\uc815\uc77c\uacfc \uad6c\uc9c1\ud65c\ub3d9 \uae30\uc900\uc744 \uc9c0\ud0a4\uba70 \uc7ac\ucde8\uc5c5 \ud65c\ub3d9\uc744 \uc9c4\ud589\ud569\ub2c8\ub2e4.<\/li>\n<\/ol>\n<h2>4050 \uc138\ub300\uac00 \ub193\uce58\uae30 \uc26c\uc6b4 \uc810<\/h2>\n<ul>\n<li>\uad8c\uace0\uc0ac\uc9c1, \uacc4\uc57d\ub9cc\ub8cc, \uc790\ubc1c\uc801 \ud1f4\uc0ac \ub4f1 \uc0ac\uc720\ubcc4 \ud310\ub2e8\uc774 \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/li>\n<li>\ud1f4\uc9c1 \ud6c4 \ubc14\ub85c \uc2e0\uccad\ud558\uc9c0 \uc54a\uc73c\uba74 \uc77c\uc815 \uad00\ub9ac\uac00 \uaf2c\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/li>\n<li>\uad6c\uc9c1\ud65c\ub3d9\uc740 \ub2e8\uc21c \uac80\uc0c9\uc774 \uc544\ub2c8\ub77c \uc778\uc815 \uae30\uc900\uc5d0 \ub9de\uc544\uc57c \ud569\ub2c8\ub2e4.<\/li>\n<li>\uc9c1\uc5c5\ud6c8\ub828 \ucc38\uc5ec\uac00 \uad6c\uc9c1\ud65c\ub3d9\uc73c\ub85c \uc778\uc815\ub418\ub294\uc9c0 \ud655\uc778\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<h3>\uc790\ubc1c\uc801\uc73c\ub85c \ud1f4\uc0ac\ud558\uba74 \ubb34\uc870\uac74 \ubabb \ubc1b\ub098\uc694?<\/h3>\n<p>\uc77c\ubc18\uc801\uc73c\ub85c \uc790\ubc1c\uc801 \ud1f4\uc0ac\ub294 \uc81c\ud55c\ub420 \uc218 \uc788\uc9c0\ub9cc, \uad6c\uccb4\uc801\uc778 \uc0ac\uc720\uc5d0 \ub530\ub77c \ud310\ub2e8\uc774 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uace0\uc6a9\uc13c\ud130\uc5d0\uc11c \uac1c\uc778 \uc0c1\ud669\uc744 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h3>\uad6c\uc9c1\ud65c\ub3d9\uc740 \uba87 \ubc88 \ud574\uc57c \ud558\ub098\uc694?<\/h3>\n<p>\uc218\uae09 \uae30\uac04\uacfc \ud68c\ucc28\uc5d0 \ub530\ub77c \uae30\uc900\uc774 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uace0\uc6a9\uc13c\ud130\uc5d0\uc11c \uc548\ub0b4\ubc1b\uc740 \uc778\uc815 \uae30\uc900\uc744 \ub530\ub974\ub294 \uac83\uc774 \uac00\uc7a5 \uc548\uc804\ud569\ub2c8\ub2e4.<\/p>\n<h3>\uc9c1\uc5c5\ud6c8\ub828\uc744 \ubc1b\uc73c\uba74 \ub3c4\uc6c0\uc774 \ub418\ub098\uc694?<\/h3>\n<p>\uc7ac\ucde8\uc5c5 \ubc29\ud5a5\uc774 \uba85\ud655\ud558\ub2e4\uba74 \uc9c1\uc5c5\ud6c8\ub828\uc774 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\ub9cc \uc2e4\uc5c5\uae09\uc5ec\uc640 \ud6c8\ub828 \ucc38\uc5ec \uae30\uc900\uc740 \uace0\uc6a9\uc13c\ud130 \uc548\ub0b4\ub97c \ud568\uaed8 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h2>\uacf5\uc2dd \ucd9c\ucc98<\/h2>\n<p>\uc2e4\uc5c5\uae09\uc5ec \uae30\uc900\uacfc \uc808\ucc28\ub294 \uac1c\uc778\ubcc4 \uc774\ub825\uacfc \ud1f4\uc9c1 \uc0ac\uc720\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc73c\ubbc0\ub85c \uace0\uc6a924\uc640 \uace0\uc6a9\uc13c\ud130\uc758 \ucd5c\uc2e0 \uc548\ub0b4\ub97c \ud655\uc778\ud558\uc138\uc694.<\/p>\n<p><a href=\"https:\/\/www.work24.go.kr\" target=\"_blank\" rel=\"noopener\">\uace0\uc6a924 \uacf5\uc2dd \ud648\ud398\uc774\uc9c0<\/a><\/p>\n<p><!-- guide4050-depth-expand --><\/p>\n<h2>4050 \uae30\uc900\uc73c\ub85c \uba3c\uc800 \ud310\ub2e8\ud560 \ubd80\ubd84<\/h2>\n<p>\uc2e4\uc5c5\uae09\uc5ec \uc2e0\uccad \uc804 \ud655\uc778\ud560 \uac83: \uc774\uc9c1\ud655\uc778\uc11c\uc640 \uad6c\uc9c1\ud65c\ub3d9 \uae30\uc900\ub97c \ud655\uc778\ud560 \ub54c\ub294 \ub2e8\uc21c\ud788 \uc774\ub984\ub9cc \ubcf4\uace0 \uacb0\uc815\ud558\uae30\ubcf4\ub2e4 \ub0b4 \uc0c1\ud669\uc5d0 \uc2e4\uc81c\ub85c \ub9de\ub294\uc9c0\ubd80\ud130 \ubcf4\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. 40\ub300\uc640 50\ub300\ub294 \uc774\ubbf8 \uc9c1\uc7a5 \uacbd\ud5d8, \uac00\uc871 \ubd80\uc591, \uac74\uac15\ubcf4\ud5d8\ub8cc, \ud1f4\uc9c1 \uc77c\uc815, \ubd80\ubaa8\ub2d8 \ub3cc\ubd04 \uac19\uc740 \uc870\uac74\uc774 \ud568\uaed8 \uc6c0\uc9c1\uc774\ub294 \uacbd\uc6b0\uac00 \ub9ce\uae30 \ub54c\ubb38\uc5d0 \uac19\uc740 \uc81c\ub3c4\ub77c\ub3c4 \uccb4\uac10\ub418\ub294 \uc720\ub9ac\ud568\uc774 \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ud2b9\ud788 \uc2e0\uccad\ud615 \uc81c\ub3c4\ub098 \uc790\uaca9\uc99d \uc815\ubcf4\ub294 \uad11\uace0 \ubb38\uad6c\ubcf4\ub2e4 \uacf5\uc2dd \uc870\uac74\uacfc \uc2e4\uc81c \ud65c\uc6a9\ucc98\ub97c \ud568\uaed8 \ubd10\uc57c \ud569\ub2c8\ub2e4. \uc9c0\uc6d0 \ub300\uc0c1, \uc2e0\uccad \uae30\uac04, \uc900\ube44\uc11c\ub958, \ubcf8\uc778\ubd80\ub2f4 \uc5ec\ubd80, \uc0c1\ub2f4 \ucc3d\uad6c\ub97c \uba3c\uc800 \ud655\uc778\ud558\uba74 \uc2dc\uac04\uc744 \uc904\uc77c \uc218 \uc788\uace0, \uc2e0\uccad \ud6c4 \ud0c8\ub77d\ud558\uac70\ub098 \uacfc\uc815 \uc218\ub8cc \ud6c4 \ud65c\uc6a9\ud558\uc9c0 \ubabb\ud558\ub294 \uc0c1\ud669\uc744 \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc7ac\ucde8\uc5c5 \uc900\ube44\uc5d0\uc11c \ub193\uce58\uae30 \uc26c\uc6b4 \uc21c\uc11c<\/h2>\n<table>\n<thead>\n<tr>\n<th>\ub2e8\uacc4<\/th>\n<th>\ud560 \uc77c<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>1\ub2e8\uacc4<\/td>\n<td>\ud604\uc7ac \uacbd\ub825\uacfc \uac00\ub2a5\ud55c \uadfc\ubb34\uc2dc\uac04\uc744 \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>2\ub2e8\uacc4<\/td>\n<td>\uc911\uc7a5\ub144 \ub0b4\uc77c\uc13c\ud130, \uace0\uc6a9\uc13c\ud130, \uc9c0\uc790\uccb4 \uc77c\uc790\ub9ac\uc13c\ud130 \uc0c1\ub2f4 \uac00\ub2a5 \uc5ec\ubd80\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>3\ub2e8\uacc4<\/td>\n<td>\ud544\uc694\ud55c \uad50\uc721\uc774\ub098 \uc790\uaca9\uc99d\uc774 \uc788\ub2e4\uba74 \uad6d\ube44\uc9c0\uc6d0 \uacfc\uc815\uacfc \uc5f0\uacb0\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>4\ub2e8\uacc4<\/td>\n<td>\uc774\ub825\uc11c\uc5d0\ub294 \uacfc\uac70 \uc9c1\ucc45\ubcf4\ub2e4 \uc9c0\uae08 \ud560 \uc218 \uc788\ub294 \uc5c5\ubb34\ub97c \uc911\uc2ec\uc73c\ub85c \uc501\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p>\uc7ac\ucde8\uc5c5\uc740 \uc815\ubcf4\ub97c \ub9ce\uc774 \ubcf4\ub294 \uac83\ubcf4\ub2e4 \uc21c\uc11c\ub97c \uc815\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uba3c\uc800 \uc0c1\ub2f4 \ucc3d\uad6c\ub97c \ud1b5\ud574 \ud604\uc7ac \uad6c\uc9c1 \uc0c1\ud0dc\ub97c \uc815\ub9ac\ud558\uace0, \uc774\ud6c4 \ud544\uc694\ud55c \uad50\uc721\uc774\ub098 \uc790\uaca9\uc99d\uc744 \ubd99\uc774\ub294 \ubc29\uc2dd\uc774 \uc2dc\ud589\ucc29\uc624\ub97c \uc904\uc785\ub2c8\ub2e4.<\/p>\n<h2>\uc0c1\ub2f4 \uc804 \uba54\ubaa8\ud574\ub450\uba74 \uc88b\uc740 \uc9c8\ubb38<\/h2>\n<ul>\n<li>\ub0b4 \ub098\uc774\uc640 \uace0\uc6a9 \uc0c1\ud0dc\uc5d0\uc11c \uc2e0\uccad \uac00\ub2a5\ud55c\uac00\uc694?<\/li>\n<li>\uc18c\ub4dd, \uc7ac\uc0b0, \uacbd\ub825 \ub54c\ubb38\uc5d0 \uc81c\uc678\ub420 \uc218 \uc788\ub294 \uc870\uac74\uc774 \uc788\ub098\uc694?<\/li>\n<li>\uc628\ub77c\uc778 \uc2e0\uccad\uacfc \ubc29\ubb38 \uc2e0\uccad \uc911 \uc5b4\ub5a4 \ubc29\uc2dd\uc774 \ube60\ub978\uac00\uc694?<\/li>\n<li>\uc2e0\uccad \ud6c4 \uacb0\uacfc \ud655\uc778\uae4c\uc9c0 \ubcf4\ud1b5 \uc5bc\ub9c8\ub098 \uac78\ub9ac\ub098\uc694?<\/li>\n<li>\ube44\uc2b7\ud55c \uc81c\ub3c4\ub098 \uacfc\uc815\uacfc \uc911\ubcf5 \uc774\uc6a9\uc774 \uac00\ub2a5\ud55c\uac00\uc694?<\/li>\n<\/ul>\n<p>\uc774 \uc9c8\ubb38\uc744 \ubbf8\ub9ac \uc815\ub9ac\ud574\ub450\uba74 \uc0c1\ub2f4 \uc2dc\uac04\uc774 \uc9e7\uc544\uc9c0\uace0, \ub2f4\ub2f9\uc790\uc5d0\uac8c \ud544\uc694\ud55c \uc815\ubcf4\ub97c \ube60\ub974\uac8c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \uac00\uc871 \ub300\uc2e0 \uc54c\uc544\ubcf4\ub294 \uacbd\uc6b0\uc5d0\ub294 \ub2f9\uc0ac\uc790\uc758 \uc0dd\ub144\uc6d4\uc77c, \uac70\uc8fc\uc9c0, \uc18c\ub4dd \uc0c1\ud0dc, \uac74\uac15 \uc0c1\ud0dc\ucc98\ub7fc \uae30\ubcf8 \uc815\ubcf4\ub97c \uc900\ube44\ud574\ub450\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<p><!-- guide4050-related-start --><\/p>\n<section class=\"guide-related-posts\">\n<h2>\ud568\uaed8 \ubcf4\uba74 \uc88b\uc740 \uae00<\/h2>\n<p>\uc774 \uae00\uacfc \uc774\uc5b4\uc11c \ud655\uc778\ud558\uba74 \uc88b\uc740 4050 \ub9de\ucda4 \uc815\ubcf4\uc785\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/4050guide.co.kr\/middle-aged-tomorrow-center-counseling-prep\/\">\uc911\uc7a5\ub144 \ub0b4\uc77c\uc13c\ud130 \uc0c1\ub2f4\ubc1b\uae30 \uc804 \uc900\ube44\ud560 \uac83: 4050 \uc7ac\ucde8\uc5c5 \uc0c1\ub2f4 \ud65c\uc6a9\ubc95<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/june-2026-middle-aged-reemployment-support\/\">2026\ub144 6\uc6d4 \uc911\uc7a5\ub144 \uc7ac\ucde8\uc5c5 \uc9c0\uc6d0\uc81c\ub3c4 \ud655\uc778\ud560 \uac83: \uc0c1\ub2f4, \uad50\uc721, \uad6c\uc9c1\ub4f1\ub85d<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/security-guard-basic-training-4050\/\">\uacbd\ube44\uc6d0 \uc2e0\uc784\uad50\uc721 4050 \uc900\ube44\ubc29\ubc95: \uc77c\ubc18\uacbd\ube44\uc6d0 \ucde8\uc5c5 \uc804 \ud655\uc778\ud560 \uac83<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/reemployment-checklist-before-retirement\/\">\ud1f4\uc9c1 \uc608\uc815\uc790 \uc7ac\ucde8\uc5c5 \uc900\ube44 \uc21c\uc11c: \ud1f4\uc0ac \uc804 3\uac1c\uc6d4 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/a><\/li>\n<\/ul>\n<\/section>\n<p><!-- guide4050-related-end --><\/p>\n<p><!-- 4050_SHORT_UPLIFT_START --><\/p>\n<section class=\"guide-short-uplift\">\n<h2>\uc7ac\ucde8\uc5c5 \uc900\ube44\uc5d0\uc11c \uba3c\uc800 \uc815\ub9ac\ud560 \uac83<\/h2>\n<p>\uc7ac\ucde8\uc5c5 \uc815\ubcf4\ub294 \uc81c\ub3c4\ubcf4\ub2e4 \ubcf8\uc778\uc758 \uc870\uac74 \uc815\ub9ac\uac00 \uba3c\uc800\uc785\ub2c8\ub2e4. \uacbd\ub825, \ud76c\ub9dd \uadfc\ubb34\uc2dc\uac04, \uac74\uac15 \uc0c1\ud0dc, \uc774\ub3d9 \uac00\ub2a5 \uac70\ub9ac, \ucd5c\uc18c \uae09\uc5ec \uae30\uc900\uc744 \uc815\ub9ac\ud558\uba74 \uc0c1\ub2f4\uacfc \uc9c0\uc6d0\uc11c \uc791\uc131\uc774 \ud6e8\uc52c \uc26c\uc6cc\uc9d1\ub2c8\ub2e4.<\/p>\n<figure class=\"wp-block-table\">\n<table>\n<tr>\n<th>\ud655\uc778 \uc21c\uc11c<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<th>\ud310\ub2e8 \uae30\uc900<\/th>\n<\/tr>\n<tr>\n<td>1\ub2e8\uacc4<\/td>\n<td>\uc774\uc804 \uacbd\ub825<\/td>\n<td>\ucd5c\uadfc \uacbd\ub825 \uc911 \ub2e4\uc2dc \ud65c\uc6a9 \uac00\ub2a5\ud55c \uc5c5\ubb34\ub97c \ucc3e\uc2b5\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>2\ub2e8\uacc4<\/td>\n<td>\uadfc\ubb34 \uc870\uac74<\/td>\n<td>\uc8fc\uac04\u00b7\uc57c\uac04\u00b7\uad50\ub300\uadfc\ubb34 \uac00\ub2a5 \uc5ec\ubd80\ub97c \uad6c\ubd84\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>3\ub2e8\uacc4<\/td>\n<td>\uad50\uc721 \ud544\uc694\uc131<\/td>\n<td>\uc0c8 \uc790\uaca9\uc99d\uc774 \ud544\uc694\ud55c\uc9c0, \ub2e8\uae30 \uad50\uc721\uc73c\ub85c \ucda9\ubd84\ud55c\uc9c0 \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>4\ub2e8\uacc4<\/td>\n<td>\uc9c0\uc6d0 \uacbd\ub85c<\/td>\n<td>\uace0\uc6a924, \uc911\uc7a5\ub144 \ub0b4\uc77c\uc13c\ud130, \uc9c0\uc790\uccb4 \uacf5\uace0\ub97c \ud568\uaed8 \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/table>\n<\/figure>\n<h3>\ube60\ub978 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h3>\n<ul>\n<li>\uc774\ub825\uc11c\ub294 \ud558\ub098\ub9cc \uc4f0\uc9c0 \ub9d0\uace0 \uc9c1\ubb34\ubcc4\ub85c \ub098\ub215\ub2c8\ub2e4.<\/li>\n<li>\ub098\uc774\ubcf4\ub2e4 \uc5c5\ubb34 \uac00\ub2a5 \uc2dc\uac04\uacfc \uacbd\ub825 \uc5f0\uacb0\uc131\uc744 \uac15\uc870\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc0c1\ub2f4 \uc804 \ud76c\ub9dd \uc9c1\ubb34\ub97c 2~3\uac1c\ub85c \uc881\ud799\ub2c8\ub2e4.<\/li>\n<\/ul>\n<p>\uc704 \ub0b4\uc6a9\uc740 \uae30\ubcf8 \ud310\ub2e8 \uae30\uc900\uc774\uba70, \uc2e4\uc81c \uc2e0\uccad\uc774\ub098 \uc811\uc218 \uc804\uc5d0\ub294 \uacf5\uc2dd \uae30\uad00\uc758 \ucd5c\uc2e0 \uc548\ub0b4\ub97c \ub2e4\uc2dc \ud655\uc778\ud558\ub294 \uac83\uc774 \uc548\uc804\ud569\ub2c8\ub2e4.<\/p>\n<\/section>\n<p><!-- 4050_SHORT_UPLIFT_END --><\/p>\n","protected":false},"excerpt":{"rendered":"<p>\uc2e4\uc5c5\uae09\uc5ec\ub97c \uc54c\uc544\ubcfc \ub54c \uc774\uc9c1\ud655\uc778\uc11c, \uc218\uae09\uc790\uaca9, \uad6c\uc9c1\ud65c\ub3d9, \uace0\uc6a924 \uc808\ucc28\ub97c \uba3c\uc800 \ud655\uc778\ud574\uc57c \ud558\ub294 \uc774\uc720\ub97c \uc815\ub9ac\ud588\uc2b5\ub2c8\ub2e4.<\/p>\n","protected":false},"author":0,"featured_media":224,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[5],"tags":[],"class_list":["post-92","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-rejob"],"_links":{"self":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts\/92","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/types\/post"}],"replies":[{"embeddable":true,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/comments?post=92"}],"version-history":[{"count":2,"href":"https:\/\/4050guide.co.kr\/wp-json\/