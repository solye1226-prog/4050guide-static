{"id":34,"date":"2026-05-15T13:20:00","date_gmt":"2026-05-15T04:20:00","guid":{"rendered":"https:\/\/4050guide.co.kr\/?p=34"},"modified":"2026-05-26T18:33:29","modified_gmt":"2026-05-26T09:33:29","slug":"basic-pension-eligibility-check","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/basic-pension-eligibility-check\/","title":{"rendered":"\uae30\ucd08\uc5f0\uae08 \uc218\uae09\uc790\uaca9 \ud655\uc778\ubc29\ubc95: \ub098\uc774\uc640 \uc18c\ub4dd\uc778\uc815\uc561 \uccb4\ud06c"},"content":{"rendered":"<figure class=\"wp-block-image size-large\"><img decoding=\"async\" src=\"\/wp-content\/uploads\/2026\/05\/basic-pension-card.png\" alt=\"\uae30\ucd08\uc5f0\uae08 \uc218\uae09\uc790\uaca9 \ud655\uc778\ubc29\ubc95: \ub098\uc774\uc640 \uc18c\ub4dd\uc778\uc815\uc561 \uccb4\ud06c\"><\/figure>\n<p>\uae30\ucd08\uc5f0\uae08\uc740 \ub9cc 65\uc138 \uc774\uc0c1 \uc5b4\ub974\uc2e0 \uc911 \uc18c\ub4dd\uacfc \uc7ac\uc0b0 \uae30\uc900\uc744 \ucda9\uc871\ud558\ub294 \ubd84\uc5d0\uac8c \uc9c0\uae09\ub418\ub294 \uc81c\ub3c4\uc785\ub2c8\ub2e4. 4050 \uc138\ub300\ub294 \ubcf8\uc778\ubcf4\ub2e4 \ubd80\ubaa8\ub2d8\uc758 \uae30\ucd08\uc5f0\uae08 \uc2e0\uccad\uc744 \ub300\uc2e0 \uc54c\uc544\ubcf4\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \uc774\ub54c \u201c\ub098\uc774\uac00 \ub410\uc73c\ub2c8 \uc790\ub3d9 \uc9c0\uae09\ub41c\ub2e4\u201d\uace0 \uc0dd\uac01\ud558\uae30 \uc27d\uc9c0\ub9cc \uc2e4\uc81c\ub85c\ub294 \uc2e0\uccad\uacfc \uc18c\ub4dd\uc778\uc815\uc561 \ud655\uc778\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.<\/p>\n<h2>\uae30\ucd08\uc5f0\uae08 \ud575\uc2ec \uc694\uc57d<\/h2>\n<table>\n<thead>\n<tr>\n<th>\uad6c\ubd84<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\ub300\uc0c1 \uc5f0\ub839<\/td>\n<td>\ub9cc 65\uc138 \uc774\uc0c1<\/td>\n<\/tr>\n<tr>\n<td>\ud575\uc2ec \uae30\uc900<\/td>\n<td>\uc18c\ub4dd\uc778\uc815\uc561\uc774 \uc120\uc815\uae30\uc900\uc561 \uc774\ud558\uc778\uc9c0<\/td>\n<\/tr>\n<tr>\n<td>\uc2e0\uccad \uc7a5\uc18c<\/td>\n<td>\uc8fc\uc18c\uc9c0 \uc8fc\ubbfc\uc13c\ud130, \uad6d\ubbfc\uc5f0\uae08\uacf5\ub2e8 \uc9c0\uc0ac, \ubcf5\uc9c0\ub85c<\/td>\n<\/tr>\n<tr>\n<td>\uc900\ube44\ud560 \uac83<\/td>\n<td>\uc2e0\ubd84\uc99d, \ud1b5\uc7a5, \uae08\uc735\uc815\ubcf4 \uc81c\uacf5 \ub3d9\uc758 \ub4f1<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\uc18c\ub4dd\uc778\uc815\uc561\uc774 \uc911\uc694\ud55c \uc774\uc720<\/h2>\n<p>\uae30\ucd08\uc5f0\uae08\uc740 \ub2e8\uc21c\ud788 \uc6d4\uc18c\ub4dd\ub9cc \ubcf4\ub294 \uc81c\ub3c4\uac00 \uc544\ub2d9\ub2c8\ub2e4. \uadfc\ub85c\uc18c\ub4dd, \uc5f0\uae08\uc18c\ub4dd, \uae08\uc735\uc7ac\uc0b0, \ubd80\ub3d9\uc0b0, \uc790\ub3d9\ucc28 \ub4f1 \uc5ec\ub7ec \uc694\uc18c\ub97c \ubc18\uc601\ud574 \uc18c\ub4dd\uc778\uc815\uc561\uc744 \uacc4\uc0b0\ud569\ub2c8\ub2e4. \uadf8\ub798\uc11c \u201c\ud604\uae08 \uc18c\ub4dd\uc740 \uac70\uc758 \uc5c6\ub294\ub370 \uc65c \uc81c\uc678\ub420\uae4c?\u201d\ub77c\ub294 \uc758\ubb38\uc774 \uc0dd\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>4050 \ubcf4\ud638\uc790\uac00 \ud655\uc778\ud560 \ubd80\ubd84<\/h2>\n<ul>\n<li>\ubd80\ubaa8\ub2d8\uc758 \uc8fc\ubbfc\ub4f1\ub85d \uc8fc\uc18c\uc640 \uc2e4\uc81c \uac70\uc8fc\uc9c0\uac00 \uc77c\uce58\ud558\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\ubd80\ubd80 \uc911 \ud55c \uba85\ub9cc \uc2e0\uccad\ud558\ub294 \uacbd\uc6b0\uc5d0\ub3c4 \ubc30\uc6b0\uc790 \uc18c\ub4dd\u00b7\uc7ac\uc0b0\uc774 \ud568\uaed8 \ubc18\uc601\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/li>\n<li>\uad6d\ubbfc\uc5f0\uae08\uc744 \ubc1b\ub294\ub2e4\uace0 \ud574\uc11c \ubb34\uc870\uac74 \uc81c\uc678\ub418\ub294 \uac83\uc740 \uc544\ub2c8\uc9c0\ub9cc \uae08\uc561\uc5d0 \uc601\ud5a5\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/li>\n<li>\uc790\ub3d9\ucc28, \uc804\uc138\ubcf4\uc99d\uae08, \uae08\uc735\uc7ac\uc0b0\ub3c4 \uc2ec\uc0ac\uc5d0 \ud3ec\ud568\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/li>\n<li>\ub300\ub9ac \uc2e0\uccad \uc2dc \ud544\uc694\ud55c \uc704\uc784\uc11c\ub958\ub97c \ubbf8\ub9ac \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>\uc2e0\uccad \ud750\ub984<\/h2>\n<ol>\n<li>\ub9cc 65\uc138 \uc0dd\uc77c\uc774 \uc18d\ud55c \ub2ec \uc804\ud6c4 \uc2e0\uccad \uac00\ub2a5 \uc2dc\uc810\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\ubcf5\uc9c0\ub85c \ub610\ub294 \uc8fc\ubbfc\uc13c\ud130\uc5d0\uc11c \uc2e0\uccad \uac00\ub2a5 \uc5ec\ubd80\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uae08\uc735\uc815\ubcf4 \uc81c\uacf5 \ub3d9\uc758 \ub4f1 \ud544\uc694\ud55c \uc11c\ub958\ub97c \uc900\ube44\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc18c\ub4dd\u00b7\uc7ac\uc0b0 \uc870\uc0ac\uac00 \uc9c4\ud589\ub429\ub2c8\ub2e4.<\/li>\n<li>\uacb0\uacfc \ud1b5\ubcf4 \ud6c4 \uc9c0\uae09 \uc5ec\ubd80\uc640 \uae08\uc561\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<\/ol>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<h3>\ub9cc 65\uc138\uac00 \ub418\uba74 \uc790\ub3d9\uc73c\ub85c \uc9c0\uae09\ub418\ub098\uc694?<\/h3>\n<p>\uc790\ub3d9 \uc9c0\uae09\uc774 \uc544\ub2c8\ub77c \uc2e0\uccad\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc548\ub0b4\ubb38\uc744 \ubc1b\uc558\ub354\ub77c\ub3c4 \uc2e4\uc81c \uc2e0\uccad\uacfc \uc2ec\uc0ac \uc808\ucc28\ub97c \uac70\uccd0\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h3>\uad6d\ubbfc\uc5f0\uae08\uc744 \ubc1b\uc73c\uba74 \uae30\ucd08\uc5f0\uae08\uc744 \ubabb \ubc1b\ub098\uc694?<\/h3>\n<p>\ubb34\uc870\uac74 \uc81c\uc678\ub418\ub294 \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4. \ub2e4\ub9cc \uad6d\ubbfc\uc5f0\uae08 \uc218\ub839\uc561\uacfc \uc18c\ub4dd\uc778\uc815\uc561\uc5d0 \ub530\ub77c \uae30\ucd08\uc5f0\uae08\uc561\uc774 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h3>\uc790\ub140 \uc18c\ub4dd\ub3c4 \ubc18\uc601\ub418\ub098\uc694?<\/h3>\n<p>\uc77c\ubc18\uc801\uc73c\ub85c \ubcf8\uc778\uacfc \ubc30\uc6b0\uc790\uc758 \uc18c\ub4dd\u00b7\uc7ac\uc0b0\uc744 \uc911\uc2ec\uc73c\ub85c \ubd05\ub2c8\ub2e4. \ub2e4\ub9cc \uac70\uc8fc \ud615\ud0dc\ub098 \ubd80\uc591 \uad00\ub828 \uc138\ubd80 \uc0c1\ud669\uc740 \uc2e0\uccad\uae30\uad00\uc5d0\uc11c \ud655\uc778\ud558\ub294 \uac83\uc774 \uc548\uc804\ud569\ub2c8\ub2e4.<\/p>\n<h2>\ubd80\ubaa8\ub2d8 \ub300\uc2e0 \uc54c\uc544\ubcfc \ub54c \uc8fc\uc758\ud560 \uc810<\/h2>\n<p>4050 \uc790\ub140\uac00 \ubd80\ubaa8\ub2d8\uc758 \uae30\ucd08\uc5f0\uae08\uc744 \ub300\uc2e0 \uc54c\uc544\ubcf4\ub294 \uacbd\uc6b0\uc5d0\ub294 \ubd80\ubaa8\ub2d8\uc774 \ubcf4\uc720\ud55c \uc608\uae08, \ubcf4\ud5d8, \ubd80\ub3d9\uc0b0, \uc790\ub3d9\ucc28 \uc815\ubcf4\ub97c \uc815\ud655\ud788 \uc54c\uae30 \uc5b4\ub824\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub300\ub7b5\uc801\uc778 \uae30\uc5b5\ub9cc\uc73c\ub85c \ud310\ub2e8\ud558\uba74 \uc2e4\uc81c \uc2ec\uc0ac \uacb0\uacfc\uc640 \ucc28\uc774\uac00 \ub0a0 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2e0\uccad\uae30\uad00\uc5d0\uc11c \uc548\ub0b4\ud558\ub294 \uc790\ub8cc\ub97c \uae30\uc900\uc73c\ub85c \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<ul>\n<li>\ubd80\ubd80 \uc911 \ud55c \ubd84\ub9cc \uc2e0\uccad\ud574\ub3c4 \ubc30\uc6b0\uc790 \uc815\ubcf4\uac00 \ud568\uaed8 \ud655\uc778\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/li>\n<li>\uc804\uc138\ubcf4\uc99d\uae08, \uae08\uc735\uc7ac\uc0b0, \ucc28\ub7c9\uac00\uc561\ub3c4 \ud310\ub2e8\uc5d0 \uc601\ud5a5\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/li>\n<li>\uc774\uc804\uc5d0\ub294 \ud0c8\ub77d\ud588\ub354\ub77c\ub3c4 \uc18c\ub4dd\uc774\ub098 \uc7ac\uc0b0\uc774 \ubc14\ub00c\uba74 \ub2e4\uc2dc \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/li>\n<li>\ub9cc 65\uc138\uac00 \ub418\ub294 \uc2dc\uc810\uc5d0 \ub9de\ucdb0 \ubbf8\ub9ac \ubb38\uc758\ud558\uba74 \uc900\ube44\uac00 \uc218\uc6d4\ud569\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>\uae30\ucd08\uc5f0\uae08\uacfc \ub2e4\ub978 \ubcf5\uc9c0\uc81c\ub3c4 \ud568\uaed8 \ubcf4\uae30<\/h2>\n<p>\uae30\ucd08\uc5f0\uae08\ub9cc \ud655\uc778\ud558\uace0 \ub05d\ub0b4\uae30\ubcf4\ub2e4 \uc8fc\uac70\uae09\uc5ec, \uc5d0\ub108\uc9c0\ubc14\uc6b0\ucc98, \ub178\uc778\ub9de\ucda4\ub3cc\ubd04\uc11c\ube44\uc2a4, \uc758\ub8cc\ube44 \uc9c0\uc6d0 \uac19\uc740 \uc81c\ub3c4\ub3c4 \ud568\uaed8 \uc0b4\ud3b4\ubcf4\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \ud55c \uac00\uc9c0 \uc81c\ub3c4\ub294 \ub300\uc0c1\uc774 \uc544\ub2c8\uc5b4\ub3c4 \ub2e4\ub978 \uc81c\ub3c4\ub294 \uac00\ub2a5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubcf5\uc9c0\ub85c\uc5d0\uc11c \ubaa8\uc758\uacc4\uc0b0\uacfc \ubcf5\uc9c0\uc11c\ube44\uc2a4 \uac80\uc0c9\uc744 \ud568\uaed8 \ud65c\uc6a9\ud558\uba74 \ub193\uce58\ub294 \uc81c\ub3c4\ub97c \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uacf5\uc2dd \ucd9c\ucc98<\/h2>\n<p>\uae30\ucd08\uc5f0\uae08 \uc120\uc815\uae30\uc900\uc561\uacfc \uc2e0\uccad \uc808\ucc28\ub294 \ubcc0\ub3d9\ub420 \uc218 \uc788\uc73c\ubbc0\ub85c \ubcf5\uc9c0\ub85c\uc640 \uc8fc\ubbfc\uc13c\ud130\uc758 \ucd5c\uc2e0 \uc548\ub0b4\ub97c \ud655\uc778\ud558\uc138\uc694.<\/p>\n<p><a href=\"https:\/\/www.bokjiro.go.kr\" target=\"_blank\" rel=\"noopener\">\ubcf5\uc9c0\ub85c \uacf5\uc2dd \ud648\ud398\uc774\uc9c0<\/a><\/p>\n<p><!-- guide4050-related-start --><\/p>\n<section class=\"guide-related-posts\">\n<h2>\ud568\uaed8 \ubcf4\uba74 \uc88b\uc740 \uae00<\/h2>\n<p>\uc774 \uae00\uacfc \uc774\uc5b4\uc11c \ud655\uc778\ud558\uba74 \uc88b\uc740 4050 \ub9de\ucda4 \uc815\ubcf4\uc785\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/4050guide.co.kr\/june-2026-4050-benefit-welfare-checklist\/\">2026\ub144 6\uc6d4 4050 \uc815\ubd80\uc9c0\uc6d0\uae08\u00b7\ubcf5\uc9c0 \uc2e0\uccad \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/earned-child-tax-credit-june-2026-check\/\">2026 \uadfc\ub85c\u00b7\uc790\ub140\uc7a5\ub824\uae08 6\uc6d4 1\uc77c \uc804\ud6c4 \ud655\uc778\ud560 \uac83: \uc2e0\uccad, \uae30\ud55c \ud6c4 \uc2e0\uccad, \uc9c0\uae09\uc77c<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/small-business-policy-fund-4050-checklist\/\">\uc18c\uc0c1\uacf5\uc778 \uc815\ucc45\uc790\uae08 4050 \uc790\uc601\uc5c5\uc790 \ud655\uc778\ubc29\ubc95: \uc2e0\uccad \uc804 \uc900\ube44\uc11c\ub958<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/national-employment-support-4050-checklist\/\">\uad6d\ubbfc\ucde8\uc5c5\uc9c0\uc6d0\uc81c\ub3c4 4050 \uc2e0\uccad \uc804 \ud655\uc778\ud560 \uac83: \uc18c\ub4dd, \ucde8\uc5c5\uacbd\ud5d8, \uad6c\uc9c1\ud65c\ub3d9<\/a><\/li>\n<\/ul>\n<\/section>\n<p><!-- guide4050-related-end --><\/p>\n<p><!-- 4050_ADSENSE_CORE_UPGRADE_START --><\/p>\n<section class=\"guide-core-upgrade\">\n<h2>\uae30\ucd08\uc5f0\uae08 \ud655\uc778 \uc804 \uc54c\uc544\uc57c \ud560 \uac83<\/h2>\n<p>\uae30\ucd08\uc5f0\uae08\uc740 \ub098\uc774\ub9cc \ucda9\uc871\ud55c\ub2e4\uace0 \uc790\ub3d9\uc73c\ub85c \uc9c0\uae09\ub418\ub294 \uc81c\ub3c4\uac00 \uc544\ub2d9\ub2c8\ub2e4. \uc18c\ub4dd\uacfc \uc7ac\uc0b0\uc744 \ubc18\uc601\ud55c \uc18c\ub4dd\uc778\uc815\uc561 \uae30\uc900\uc744 \ubcf4\uae30 \ub54c\ubb38\uc5d0 \ubd80\ubaa8\ub2d8 \ub300\uc2e0 \ud655\uc778\ud560 \ub54c\ub294 \uc790\ub8cc \uc900\ube44\uac00 \uc911\uc694\ud569\ub2c8\ub2e4.<\/p>\n<figure class=\"wp-block-table\">\n<table>\n<tr>\n<th>\ud56d\ubaa9<\/th>\n<th>\ud655\uc778 \ub0b4\uc6a9<\/th>\n<th>\uc900\ube44 \ud301<\/th>\n<\/tr>\n<tr>\n<td>\ub098\uc774<\/td>\n<td>\ub9cc 65\uc138 \uc774\uc0c1 \uc5ec\ubd80\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<td>\uc0dd\uc77c\uc774 \uc9c0\ub09c \ub4a4 \uc2e0\uccad \uac00\ub2a5\uc131\uc744 \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc18c\ub4dd<\/td>\n<td>\uadfc\ub85c\uc18c\ub4dd, \uc0ac\uc5c5\uc18c\ub4dd, \uc5f0\uae08\uc18c\ub4dd \ub4f1\uc744 \ubd05\ub2c8\ub2e4.<\/td>\n<td>\ucd5c\uadfc \uc18c\ub4dd \ubcc0\ub3d9\uc774 \uc788\ub2e4\uba74 \uc0c1\ub2f4 \ub54c \uc124\uba85\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc7ac\uc0b0<\/td>\n<td>\uc8fc\ud0dd, \uc790\ub3d9\ucc28, \uae08\uc735\uc7ac\uc0b0 \ub4f1\uc774 \ubc18\uc601\ub429\ub2c8\ub2e4.<\/td>\n<td>\ub300\ub7b5\uc801\uc778 \uc7ac\uc0b0 \ub0b4\uc5ed\uc744 \ubbf8\ub9ac \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc2e0\uccad\ucc98<\/td>\n<td>\uc8fc\ubbfc\uc13c\ud130 \ub610\ub294 \ubcf5\uc9c0\ub85c\uc5d0\uc11c \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<td>\ub300\ub9ac \uc0c1\ub2f4 \uc2dc \uac0