{"id":395,"date":"2026-05-26T09:28:13","date_gmt":"2026-05-26T00:28:13","guid":{"rendered":"https:\/\/4050guide.co.kr\/2026-engineer-industrial-engineer-remaining-schedule-4050\/"},"modified":"2026-05-26T09:29:07","modified_gmt":"2026-05-26T00:29:07","slug":"2026-engineer-industrial-engineer-remaining-schedule-4050","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/2026-engineer-industrial-engineer-remaining-schedule-4050\/","title":{"rendered":"2026\ub144 \uae30\uc0ac\u00b7\uc0b0\uc5c5\uae30\uc0ac \ub0a8\uc740 \uc2dc\ud5d8\uc77c\uc815: \uc81c2\ud68c\u00b7\uc81c3\ud68c \uc900\ube44 \uac00\ub2a5\uc131 \ube44\uad50"},"content":{"rendered":"<p><strong>\uae30\uc900\uc77c:<\/strong> \uc774 \uae00\uc740 2026\ub144 5\uc6d4 26\uc77c \uae30\uc900 Q-Net\uc758 \u300c2026\ub144\ub3c4 \uad6d\uac00\uae30\uc220\uc790\uaca9 \uac80\uc815 \uc2dc\ud589\uacc4\ud68d\u300d\uc744 \ubc14\ud0d5\uc73c\ub85c \uc815\ub9ac\ud588\uc2b5\ub2c8\ub2e4. \uc885\ubaa9\ubcc4 \uc2dc\ud589 \uc5ec\ubd80, \uc9c0\uc5ed\ubcc4 \uc2dc\ud5d8\uc7a5, \uc0c1\uc2dc\uac80\uc815 \uc138\ubd80 \uc811\uc218\uc77c\uc740 \ubcc0\uacbd\ub420 \uc218 \uc788\uc73c\ubbc0\ub85c \uc6d0\uc11c\uc811\uc218 \uc804\uc5d0\ub294 \ubc18\ub4dc\uc2dc Q-Net \uacf5\uc2dd \ud398\uc774\uc9c0\uc5d0\uc11c \ub2e4\uc2dc \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<p>\uae30\uc0ac\uc640 \uc0b0\uc5c5\uae30\uc0ac\ub294 \uae30\ub2a5\uc0ac\ubcf4\ub2e4 \uc751\uc2dc\uc790\uaca9 \ud655\uc778\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. 4050 \uc138\ub300\uac00 \uc804\uae30, \uc0b0\uc5c5\uc548\uc804, \uc18c\ubc29\uc124\ube44, \uacf5\uc870\ub0c9\ub3d9, \uc815\ubcf4\ucc98\ub9ac, \uc9c1\uc5c5\uc0c1\ub2f4\uc0ac \uac19\uc740 \uc885\ubaa9\uc744 \uc900\ube44\ud560 \ub54c\ub294 \uc2dc\ud5d8\uc77c\uc815\ubfd0 \uc544\ub2c8\ub77c \ud559\ub825, \uacbd\ub825, \uad00\ub828\ud559\uacfc, \uc2e4\ubb34\uacbd\ub825 \uc778\uc815 \uc5ec\ubd80\ub97c \uba3c\uc800 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<p>2026\ub144 5\uc6d4 26\uc77c \uae30\uc900\uc73c\ub85c \uae30\uc0ac\u00b7\uc0b0\uc5c5\uae30\uc0ac \uc815\uae30\uac80\uc815\uc740 \uc81c2\ud68c \ud544\uae30\uc2dc\ud5d8 \uae30\uac04\uc774 \uc9c4\ud589 \uc911\uc774\uace0, \uc81c3\ud68c\uac00 \ud558\ubc18\uae30 \ud575\uc2ec \ud68c\ucc28\ub85c \ub0a8\uc544 \uc788\uc2b5\ub2c8\ub2e4. \uc0c8\ub86d\uac8c \uc2dc\uc791\ud558\ub294 \uc0ac\ub78c\uc774\ub77c\uba74 \uc81c3\ud68c\ub97c \uc911\uc2ec\uc73c\ub85c \ubcf4\ub294 \uac83\uc774 \ud604\uc2e4\uc801\uc785\ub2c8\ub2e4.<\/p>\n<h2>2026\ub144 \uae30\uc0ac\u00b7\uc0b0\uc5c5\uae30\uc0ac \ub0a8\uc740 \uc77c\uc815<\/h2>\n<table>\n<thead>\n<tr>\n<th>\ud68c\ucc28<\/th>\n<th>\ud544\uae30 \uc6d0\uc11c\uc811\uc218<\/th>\n<th>\ud544\uae30\uc2dc\ud5d8<\/th>\n<th>\ud544\uae30 \ubc1c\ud45c<\/th>\n<th>\uc2e4\uae30 \uc6d0\uc11c\uc811\uc218<\/th>\n<th>\uc2e4\uae30\uc2dc\ud5d8<\/th>\n<th>\ucd5c\uc885 \ubc1c\ud45c<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\uc81c2\ud68c<\/td>\n<td>\uc885\ub8cc<\/td>\n<td>5\uc6d4 9\uc77c~5\uc6d4 29\uc77c<\/td>\n<td>6\uc6d4 10\uc77c<\/td>\n<td>6\uc6d4 22\uc77c~6\uc6d4 25\uc77c<\/td>\n<td>7\uc6d4 18\uc77c~8\uc6d4 5\uc77c<\/td>\n<td>1\ucc28 9\uc6d4 4\uc77c, 2\ucc28 9\uc6d4 11\uc77c<\/td>\n<\/tr>\n<tr>\n<td>\uc81c3\ud68c<\/td>\n<td>7\uc6d4 20\uc77c~7\uc6d4 23\uc77c<\/td>\n<td>8\uc6d4 7\uc77c~9\uc6d4 1\uc77c<\/td>\n<td>9\uc6d4 9\uc77c<\/td>\n<td>9\uc6d4 21\uc77c~9\uc6d4 23\uc77c, 9\uc6d4 28\uc77c<\/td>\n<td>10\uc6d4 24\uc77c~11\uc6d4 13\uc77c<\/td>\n<td>1\ucc28 12\uc6d4 11\uc77c, 2\ucc28 12\uc6d4 18\uc77c<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\uc81c2\ud68c\uc640 \uc81c3\ud68c \uc911 \uc5b4\ub514\ub97c \ubd10\uc57c \ud560\uae4c?<\/h2>\n<p>\uc81c2\ud68c\ub294 \uc774\ubbf8 \ud544\uae30 \uae30\uac04\uc5d0 \ub4e4\uc5b4\uac00 \uc788\uc73c\ubbc0\ub85c, \uc9c0\uae08\ubd80\ud130 \uc0c8\ub85c \uc2dc\uc791\ud558\ub294 \uc0ac\ub78c\uc5d0\uac8c\ub294 \ucd09\ubc15\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubc18\uba74 \uc81c3\ud68c\ub294 7\uc6d4 \uc6d0\uc11c\uc811\uc218, 8\uc6d4~9\uc6d4 \ud544\uae30, 10\uc6d4~11\uc6d4 \uc2e4\uae30 \ud750\ub984\uc774\uae30 \ub54c\ubb38\uc5d0 \uc9c0\uae08\ubd80\ud130 \ud559\uc2b5\uacc4\ud68d\uc744 \uc7a1\uae30 \uc88b\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \uc9c1\uc7a5\uacfc \ubcd1\ud589\ud558\uac70\ub098 \uc7ac\ucde8\uc5c5 \uc900\ube44\ub97c \ud568\uaed8 \ud558\ub294 4050\uc774\ub77c\uba74 \uc81c3\ud68c\uac00 \ud604\uc2e4\uc801\uc778 \uc120\ud0dd\uc785\ub2c8\ub2e4.<\/p>\n<table>\n<thead>\n<tr>\n<th>\uc0c1\ud669<\/th>\n<th>\ucd94\ucc9c \ud68c\ucc28<\/th>\n<th>\uc774\uc720<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\uc774\ubbf8 \ud544\uae30 \uacf5\ubd80\ub97c \uc0c1\ub2f9\ud788 \uc9c4\ud589\ud568<\/td>\n<td>\uc81c2\ud68c \uc2e4\uae30\uae4c\uc9c0 \uace0\ub824<\/td>\n<td>\ud544\uae30 \uc751\uc2dc \ud6c4 6\uc6d4 \ubc1c\ud45c, 7\uc6d4 \uc2e4\uae30\ub85c \uc774\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc9c0\uae08 \ucc98\uc74c \uc2dc\uc791\ud568<\/td>\n<td>\uc81c3\ud68c<\/td>\n<td>\ud544\uae30 \uc900\ube44\uc640 \uc751\uc2dc\uc790\uaca9 \ud655\uc778 \uc2dc\uac04\uc744 \ud655\ubcf4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc2e4\ubb34\uacbd\ub825 \uc99d\ube59\uc774 \uc560\ub9e4\ud568<\/td>\n<td>\uc81c3\ud68c \ub610\ub294 \ub2e4\uc74c \uc5f0\ub3c4<\/td>\n<td>\uc751\uc2dc\uc790\uaca9 \uc11c\ub958 \uc81c\ucd9c \uc900\ube44\uac00 \ud544\uc694\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc9c1\uc7a5 \ubcd1\ud589<\/td>\n<td>\uc81c3\ud68c<\/td>\n<td>\ud559\uc2b5\uc2dc\uac04\uc744 \ub098\ub204\uc5b4 \uacc4\ud68d\ud558\uae30 \uc88b\uc2b5\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>4050\uc774 \ub9ce\uc774 \uac80\ud1a0\ud558\ub294 \uae30\uc0ac\u00b7\uc0b0\uc5c5\uae30\uc0ac \ubd84\uc57c<\/h2>\n<p>\uae30\uc0ac\u00b7\uc0b0\uc5c5\uae30\uc0ac\ub294 \ucde8\ub4dd \ub09c\uc774\ub3c4\uac00 \uc788\ub294 \ub9cc\ud07c \ub2e8\uc21c \uad00\uc2ec\ubcf4\ub2e4 \uc2e4\uc81c \uacbd\ub825\uacfc \uc5f0\uacb0\ub418\ub294 \ubd84\uc57c\ub97c \uace8\ub77c\uc57c \ud569\ub2c8\ub2e4. \uc804\uae30 \ubd84\uc57c \uacbd\ub825\uc774 \uc788\uac70\ub098 \uc2dc\uc124\uad00\ub9ac\ub85c \uc804\ud658\ud558\uace0 \uc2f6\ub2e4\uba74 \uc804\uae30\uae30\uc0ac\u00b7\uc804\uae30\uc0b0\uc5c5\uae30\uc0ac\ub97c \uac80\ud1a0\ud560 \uc218 \uc788\uace0, \uc548\uc804\uad00\ub9ac \ubd84\uc57c\ub85c \uac00\ub824\uba74 \uc0b0\uc5c5\uc548\uc804\uae30\uc0ac\u00b7\uc0b0\uc5c5\uc548\uc804\uc0b0\uc5c5\uae30\uc0ac\ub97c \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<ul>\n<li>\uc804\uae30 \ubd84\uc57c: \uc804\uae30\uae30\uc0ac, \uc804\uae30\uc0b0\uc5c5\uae30\uc0ac, \uc804\uae30\uacf5\uc0ac\uae30\uc0ac<\/li>\n<li>\uc548\uc804 \ubd84\uc57c: \uc0b0\uc5c5\uc548\uc804\uae30\uc0ac, \uac74\uc124\uc548\uc804\uae30\uc0ac, \uc18c\ubc29\uc124\ube44\uae30\uc0ac<\/li>\n<li>\uc124\ube44 \ubd84\uc57c: \uacf5\uc870\ub0c9\ub3d9\uae30\uacc4\uae30\uc0ac, \uc5d0\ub108\uc9c0\uad00\ub9ac\uae30\uc0ac<\/li>\n<li>\uc0c1\ub2f4\u00b7\uc0ac\ubb34 \ubd84\uc57c: \uc9c1\uc5c5\uc0c1\ub2f4\uc0ac2\uae09, \uc0ac\ud68c\uc870\uc0ac\ubd84\uc11d\uc0ac2\uae09<\/li>\n<li>IT \ubd84\uc57c: \uc815\ubcf4\ucc98\ub9ac\uae30\uc0ac, \uc815\ubcf4\ucc98\ub9ac\uc0b0\uc5c5\uae30\uc0ac<\/li>\n<\/ul>\n<h2>\uc751\uc2dc\uc790\uaca9 \uc11c\ub958 \uc81c\ucd9c\uc744 \uba3c\uc800 \ud655\uc778\ud574\uc57c \ud558\ub294 \uc774\uc720<\/h2>\n<p>\uae30\uc0ac\u00b7\uc0b0\uc5c5\uae30\uc0ac \uc2dc\ud5d8\uc740 \ud544\uae30\uc5d0 \ud569\uaca9\ud574\ub3c4 \uc751\uc2dc\uc790\uaca9\uc774 \uc778\uc815\ub418\uc9c0 \uc54a\uc73c\uba74 \ud569\uaca9\uc608\uc815\uc774 \ubb34\ud6a8 \ucc98\ub9ac\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. Q-Net \uacf5\uace0\uc5d0\uc11c\ub3c4 \uae30\uc220\uc0ac, \uae30\ub2a5\uc7a5, \uae30\uc0ac, \uc0b0\uc5c5\uae30\uc0ac \ub4f1\uc740 \uc751\uc2dc\uc790\uaca9 \uc2ec\uc0ac\uae30\uc900\uc77c\uae4c\uc9c0 \ud574\ub2f9 \uc885\ubaa9\uc5d0\uc11c \uc694\uad6c\ud558\ub294 \uc751\uc2dc\uc790\uaca9\uc744 \ucda9\uc871\ud574\uc57c \ud55c\ub2e4\uace0 \uc548\ub0b4\ud569\ub2c8\ub2e4. \uacbd\ub825\uc99d\uba85\uc11c, 4\ub300\ubcf4\ud5d8 \uac00\uc785 \uc774\ub825, \uad00\ub828\ud559\uacfc \uc5ec\ubd80 \ub4f1\uc740 \ubbf8\ub9ac \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<p>4050 \uc138\ub300\ub294 \uc2e4\ubb34\uacbd\ub825\uc774 \uc788\uc9c0\ub9cc \uc11c\ub958\ub85c \uc815\ub9ac\ub418\uc9c0 \uc54a\uc740 \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \uc624\ub798\ub41c \uc9c1\uc7a5 \uacbd\ub825, \uc9c1\ubb34 \ub0b4\uc6a9\uc774 \ubaa8\ud638\ud55c \uacbd\ub825\uc99d\uba85\uc11c, \uc0ac\uc5c5\uc790 \uacbd\ub825, \uad70 \uacbd\ub825 \ub4f1\uc740 \uc778\uc815 \uc5ec\ubd80\uac00 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc73c\ubbc0\ub85c \uc811\uc218 \uc804\uc5d0 Q-Net \ub610\ub294 \uacf5\ub2e8 \uace0\uac1d\uc13c\ud130\ub97c \ud1b5\ud574 \ud655\uc778\ud558\ub294 \uac83\uc774 \uc548\uc804\ud569\ub2c8\ub2e4.<\/p>\n<h2>\uacf5\uc2dd \ud655\uc778\ucc98<\/h2>\n<ul>\n<li><a href=\"https:\/\/www.q-net.or.kr\/man004.do?ARTL_SEQ=5249930&amp;BOARD_ID=Q001&amp;gSite=Q&amp;id=man00402&amp;notiType=10\" target=\"_blank\" rel=\"noopener noreferrer\">Q-Net 2026\ub144\ub3c4 \uad6d\uac00\uae30\uc220\uc790\uaca9 \uac80\uc815 \uc2dc\ud589\uacc4\ud68d \uacf5\uace0<\/a><\/li>\n<li><a href=\"https:\/\/www.q-net.or.kr\/crf021.do?id=crf02103\" target=\"_blank\" rel=\"noopener noreferrer\">Q-Net \uc2dc\ud5d8\uc77c\uc815 \uc548\ub0b4<\/a><\/li>\n<\/ul>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<h3>\uae30\uc0ac \uc81c3\ud68c \uc2e4\uae30 \uc6d0\uc11c\uc811\uc218\ub294 \uc65c \ub0a0\uc9dc\uac00 \ub098\ub258\uc5b4 \uc788\ub098\uc694?<\/h3>\n<p>Q-Net \uacf5\uace0\uc5d0 \ub530\ub974\uba74 \uae30\uc0ac \uc81c3\ud68c \uc2e4\uae30 \uc6d0\uc11c\uc811\uc218\ub294 9\uc6d4 21\uc77c~9\uc6d4 23\uc77c, 9\uc6d4 28\uc77c\uc5d0 \uac00\ub2a5\ud558\uba70 \ucd94\uc11d \uc5f0\ud734 \ub4f1\uc5d0\ub294 \uc811\uc218\uac00 \ubd88\uac00\ud569\ub2c8\ub2e4. \uccab\ub0a0\uc5d0\ub294 \ub4f1\uae09\ubcc4 \uc811\uc218 \uac1c\uc2dc \uc2dc\uac04\uc774 \ub2e4\ub97c \uc218 \uc788\uc73c\ubbc0\ub85c \uc138\ubd80 \uacf5\uc9c0\ub97c \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h3>\uc0b0\uc5c5\uae30\uc0ac\uc640 \uae30\uc0ac \uc911 \ubb34\uc5c7\uc744 \uba3c\uc800 \ubd10\uc57c \ud558\ub098\uc694?<\/h3>\n<p>\uc751\uc2dc\uc790\uaca9\uacfc \ud604\uc7ac \uacbd\ub825\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \ub2f9\uc7a5 \uae30\uc0ac \uc751\uc2dc\uc790\uaca9\uc774 \ubd80\uc871\ud558\ub2e4\uba74 \uc0b0\uc5c5\uae30\uc0ac\ubd80\ud130 \uc900\ube44\ud558\ub294 \ubc29\uc2dd\ub3c4 \uac00\ub2a5\ud569\ub2c8\ub2e4. \ub2e4\ub9cc \ucd5c\uc885 \ubaa9\ud45c \uc9c1\ubb34\uc5d0\uc11c \uc5b4\ub5a4 \uc790\uaca9\uc744 \uc694\uad6c\ud558\ub294\uc9c0 \ucc44\uc6a9\uacf5\uace0\ub97c \ud568\uaed8 \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<p><!-- guide4050-related-start --><\/p>\n<section class=\"guide-related-posts\">\n<h2>\ud568\uaed8 \ubcf4\uba74 \uc88b\uc740 \uae00<\/h2>\n<p>\uc774 \uae00\uacfc \uc774\uc5b4\uc11c \ud655\uc778\ud558\uba74 \uc88b\uc740 4050 \ub9de\ucda4 \uc815\ubcf4\uc785\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/4050guide.co.kr\/2026-qnet-constant-exam-14-license-guide-4050\/\">2026\ub144 \uc0c1\uc2dc\uac80\uc815 \uc790\uaca9\uc99d 14\uc885\ubaa9: \uc9c0\uac8c\ucc28\u00b7\ud55c\uc2dd\uc870\ub9ac\ucc98\ub7fc \uc77c\uc815 \uc120\ud0dd\uc774 \uc26c\uc6b4 \uc885\ubaa9<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/2026-national-technical-exam-remaining-schedule-4050\/\">2026\ub144 \ub0a8\uc740 \uad6d\uac00\uae30\uc220\uc790\uaca9 \uc2dc\ud5d8\uc77c\uc815: 4050\uc774 \uc9c0\uae08 \uc900\ube44\ud560 \uc218 \uc788\ub294 \ud68c\ucc28 \uc815\ub9ac<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/2026-craftsman-remaining-exam-schedule-4050\/\">2026\ub144 \uae30\ub2a5\uc0ac \ub0a8\uc740 \uc2dc\ud5d8\uc77c\uc815: \uc804\uae30\u00b7\uc870\ub9ac\u00b7\uc2dc\uc124\uad00\ub9ac \uc900\ube44\uc790\uc6a9 4050 \uac00\uc774\ub4dc<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/forklift-license-hrd-course-4050\/\">\uc9c0\uac8c\ucc28\uc6b4\uc804\uae30\ub2a5\uc0ac \uad6d\ube44\uc9c0\uc6d0 \uacfc\uc815 \uace0\ub974\ub294 \ubc95: 4050 \ubb3c\ub958 \ucde8\uc5c5 \uae30\uc900<\/a><\/li>\n<\/ul>\n<\/section>\n<p><!-- guide4050-related-end --><\/p>\n","protected":false},"excerpt":{"rendered":"<p>2026\ub144 \uae30\uc0ac\u00b7\uc0b0\uc5c5\uae30\uc0ac \uc81c2\ud68c\uc640 \uc81c3\ud68c \ub0a8\uc740 \uc77c\uc815\uc744 4050 \uc7ac\ucde8\uc5c5\u00b7\uc9c1\ubb34\uc804\ud658 \uae30\uc900\uc73c\ub85c \ube44\uad50\ud588\uc2b5\ub2c8\ub2e4.<\/p>\n","protected":false},"author":0,"featured_media":434,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[23,2],"tags":[16,17,19,18],"class_list":["post-395","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-license-schedule","category-license","tag-16","tag-17","tag-19","tag-18"],"_links":{"self":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts\/395","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/types\/post"}],"replies":[{"embeddable":true,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/comments?post=395"}],"version-history":[{"count":1,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts\/395\/revisions"}],"predecessor-version":[{"id":398,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/posts\/395\/revisions\/398"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/media\/434"}],"wp:attachment":[{"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/media?parent=395"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/categories?post=395"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/4050guide.co.kr\/wp-json\/wp\/v2\/tags?post=395"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}