{"id":181,"date":"2026-05-25T09:26:38","date_gmt":"2026-05-25T00:26:38","guid":{"rendered":"https:\/\/4050guide.co.kr\/home-visit-care-service-longterm-care-guide\/"},"modified":"2026-05-26T18:38:18","modified_gmt":"2026-05-26T09:38:18","slug":"home-visit-care-service-longterm-care-guide","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/home-visit-care-service-longterm-care-guide\/","title":{"rendered":"\ubc29\ubb38\uc694\uc591 \uc11c\ube44\uc2a4 \uc2e0\uccad \uc804 \ud655\uc778\ud560 \uac83: \uc7a5\uae30\uc694\uc591\ub4f1\uae09\uacfc \uc774\uc6a9 \uc808\ucc28"},"content":{"rendered":"<p>\ubd80\ubaa8\ub2d8 \ub3cc\ubd04\uc774 \ud544\uc694\ud574\uc9c8 \ub54c \ubc29\ubb38\uc694\uc591 \uc11c\ube44\uc2a4\ub97c \uc54c\uc544\ubcf4\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \ubc29\ubb38\uc694\uc591\uc740 \uc7a5\uae30\uc694\uc591\ub4f1\uae09, \ubcf8\uc778\ubd80\ub2f4\uae08, \uc81c\uacf5\uae30\uad00 \uc120\ud0dd\uc744 \ud568\uaed8 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h2>\ubc29\ubb38\uc694\uc591 \uc11c\ube44\uc2a4 \uc2e0\uccad \uc804 \ud655\uc778\ud560 \uac83: \uc7a5\uae30\uc694\uc591\ub4f1\uae09\uacfc \uc774\uc6a9 \uc808\ucc28 \ud575\uc2ec \uc694\uc57d<\/h2>\n<table>\n<tbody>\n<tr>\n<th>\uad6c\ubd84<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<\/tr>\n<tr>\n<td>\ub300\uc0c1<\/td>\n<td>\uc7a5\uae30\uc694\uc591\ub4f1\uae09 \uc778\uc815 \uc5ec\ubd80 \ud655\uc778<\/td>\n<\/tr>\n<tr>\n<td>\uc808\ucc28<\/td>\n<td>\uc2e0\uccad, \uc778\uc815\uc870\uc0ac, \ub4f1\uae09\ud310\uc815, \uae30\uad00 \uc120\ud0dd<\/td>\n<\/tr>\n<tr>\n<td>\ube44\uc6a9<\/td>\n<td>\uae09\uc5ec \ubc94\uc704\uc640 \ubcf8\uc778\ubd80\ub2f4\uae08 \ud655\uc778<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\uc2e0\uccad \uc804 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h2>\n<ul>\n<li>\uad6d\ubbfc\uac74\uac15\ubcf4\ud5d8\uacf5\ub2e8 \uc7a5\uae30\uc694\uc591 \uc2e0\uccad \uc808\ucc28\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\ubd80\ubaa8\ub2d8\uc758 \uc77c\uc0c1\uc0dd\ud65c \ub3c4\uc6c0 \ud544\uc694 \uc815\ub3c4\ub97c \uc815\ub9ac\ud569\ub2c8\ub2e4.<\/li>\n<li>\ubc29\ubb38\uc694\uc591 \uc81c\uacf5\uae30\uad00\uc758 \ud3c9\uac00\uc640 \uac70\ub9ac\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uac00\uc871\uc774 \ubd80\ub2f4\ud574\uc57c \ud560 \ube44\uc6a9\uc744 \ubbf8\ub9ac \uacc4\uc0b0\ud569\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>4050 \uae30\uc900\uc73c\ub85c \ubcf4\ub294 \ud65c\uc6a9 \ud3ec\uc778\ud2b8<\/h2>\n<p>40\ub300\uc640 50\ub300\ub294 \ub2e8\uc21c\ud788 \uc81c\ub3c4 \uc774\ub984\uc744 \uc544\ub294 \uac83\ubcf4\ub2e4 \ubcf8\uc778\uc758 \uace0\uc6a9 \uc0c1\ud0dc, \uc18c\ub4dd, \uac00\uc871 \uc0c1\ud669, \ud5a5\ud6c4 \uc77c\uc790\ub9ac \ubc29\ud5a5\uc5d0 \ub9de\ub294\uc9c0 \ud655\uc778\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uac19\uc740 \uc81c\ub3c4\ub77c\ub3c4 \uc7ac\uc9c1\uc790, \uc2e4\uc5c5\uc790, \ud1f4\uc9c1 \uc608\uc815\uc790, \uc790\uc601\uc5c5\uc790\uc5d0 \ub530\ub77c \ud544\uc694\ud55c \uc11c\ub958\uc640 \uc808\ucc28\uac00 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ud2b9\ud788 \uad6d\ube44\uc9c0\uc6d0 \uad50\uc721\uc774\ub098 \ubcf5\uc9c0\uc11c\ube44\uc2a4\ub294 \uc2e0\uccad \uac00\ub2a5 \uc5ec\ubd80\uc640 \uc2e4\uc81c \ud65c\uc6a9 \uac00\ub2a5\uc131\uc774 \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uad50\uc721\uc740 \uc218\ub8cc \ud6c4 \uc5b4\ub5a4 \uc9c1\ubb34\uc640 \uc5f0\uacb0\ub418\ub294\uc9c0, \ubcf5\uc9c0\ub294 \ubcf8\uc778 \ub610\ub294 \ubd80\ubaa8\ub2d8\uc758 \uc18c\ub4dd\u00b7\uc7ac\uc0b0 \uae30\uc900\uc5d0 \ub9de\ub294\uc9c0 \uba3c\uc800 \ud655\uc778\ud558\ub294 \ud3b8\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uacf5\uc2dd \ud655\uc778\ucc98<\/h2>\n<p>\ucd5c\uc885 \uc2e0\uccad \uc804\uc5d0\ub294 \uc544\ub798 \uacf5\uc2dd \uc0ac\uc774\ud2b8\uc5d0\uc11c \ucd5c\uc2e0 \uc548\ub0b4\ub97c \ud655\uc778\ud558\uc138\uc694.<\/p>\n<ul>\n<li><a href=\"https:\/\/www.longtermcare.or.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\ub178\uc778\uc7a5\uae30\uc694\uc591\ubcf4\ud5d8<\/a><\/li>\n<li><a href=\"https:\/\/www.nhis.or.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\uad6d\ubbfc\uac74\uac15\ubcf4\ud5d8\uacf5\ub2e8<\/a><\/li>\n<\/ul>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<h3>\ub4f1\uae09\uc774 \uc5c6\uc73c\uba74 \uc774\uc6a9\ud560 \uc218 \uc5c6\ub098\uc694?<\/h3>\n<p>\uc7a5\uae30\uc694\uc591\uae09\uc5ec\ub85c \uc774\uc6a9\ud558\ub824\uba74 \ub4f1\uae09 \uc778\uc815\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc77c\ubc18 \uc720\ub8cc \ub3cc\ubd04\uacfc \uad6c\ubd84\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h3>\uae30\uad00\uc740 \uc5b4\ub5bb\uac8c \uace0\ub974\ub098\uc694?<\/h3>\n<p>\uac70\ub9ac, \ud3c9\uac00, \uc694\uc591\ubcf4\ud638\uc0ac \ubc30\uc815, \uc0c1\ub2f4 \uc751\ub300 \ub4f1\uc744 \ube44\uad50\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<p><strong>\uc548\ub0b4:<\/strong> \ubcf8 \uae00\uc740 \uc815\ubcf4 \ud655\uc778\uc744 \ub3d5\uae30 \uc704\ud55c \uc815\ub9ac\uc774\uba70, \uc2e4\uc81c \uc2e0\uccad \uac00\ub2a5 \uc5ec\ubd80\ub294 \uacf5\uc2dd \uae30\uad00\uc758 \ucd5c\uc2e0 \uc548\ub0b4\uc640 \uac1c\uc778 \uc870\uac74\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p><!-- guide4050-depth-expand --><\/p>\n<h2>4050 \uae30\uc900\uc73c\ub85c \uba3c\uc800 \ud310\ub2e8\ud560 \ubd80\ubd84<\/h2>\n<p>\ubc29\ubb38\uc694\uc591 \uc11c\ube44\uc2a4 \uc2e0\uccad \uc804 \ud655\uc778\ud560 \uac83: \uc7a5\uae30\uc694\uc591\ub4f1\uae09\uacfc \uc774\uc6a9 \uc808\ucc28\ub97c \ud655\uc778\ud560 \ub54c\ub294 \ub2e8\uc21c\ud788 \uc774\ub984\ub9cc \ubcf4\uace0 \uacb0\uc815\ud558\uae30\ubcf4\ub2e4 \ub0b4 \uc0c1\ud669\uc5d0 \uc2e4\uc81c\ub85c \ub9de\ub294\uc9c0\ubd80\ud130 \ubcf4\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. 40\ub300\uc640 50\ub300\ub294 \uc774\ubbf8 \uc9c1\uc7a5 \uacbd\ud5d8, \uac00\uc871 \ubd80\uc591, \uac74\uac15\ubcf4\ud5d8\ub8cc, \ud1f4\uc9c1 \uc77c\uc815, \ubd80\ubaa8\ub2d8 \ub3cc\ubd04 \uac19\uc740 \uc870\uac74\uc774 \ud568\uaed8 \uc6c0\uc9c1\uc774\ub294 \uacbd\uc6b0\uac00 \ub9ce\uae30 \ub54c\ubb38\uc5d0 \uac19\uc740 \uc81c\ub3c4\ub77c\ub3c4 \uccb4\uac10\ub418\ub294 \uc720\ub9ac\ud568\uc774 \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ud2b9\ud788 \uc2e0\uccad\ud615 \uc81c\ub3c4\ub098 \uc790\uaca9\uc99d \uc815\ubcf4\ub294 \uad11\uace0 \ubb38\uad6c\ubcf4\ub2e4 \uacf5\uc2dd \uc870\uac74\uacfc \uc2e4\uc81c \ud65c\uc6a9\ucc98\ub97c \ud568\uaed8 \ubd10\uc57c \ud569\ub2c8\ub2e4. \uc9c0\uc6d0 \ub300\uc0c1, \uc2e0\uccad \uae30\uac04, \uc900\ube44\uc11c\ub958, \ubcf8\uc778\ubd80\ub2f4 \uc5ec\ubd80, \uc0c1\ub2f4 \ucc3d\uad6c\ub97c \uba3c\uc800 \ud655\uc778\ud558\uba74 \uc2dc\uac04\uc744 \uc904\uc77c \uc218 \uc788\uace0, \uc2e0\uccad \ud6c4 \ud0c8\ub77d\ud558\uac70\ub098 \uacfc\uc815 \uc218\ub8cc \ud6c4 \ud65c\uc6a9\ud558\uc9c0 \ubabb\ud558\ub294 \uc0c1\ud669\uc744 \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\ubcf5\uc9c0\uc11c\ube44\uc2a4\ub97c \ud655\uc778\ud560 \ub54c \ud544\uc694\ud55c \uc815\ubcf4<\/h2>\n<table>\n<thead>\n<tr>\n<th>\uc900\ube44 \ud56d\ubaa9<\/th>\n<th>\ud655\uc778 \uc774\uc720<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\uac00\uad6c \uad6c\uc131<\/td>\n<td>\ud63c\uc790 \uac70\uc8fc\ud558\ub294\uc9c0, \ubd80\ubd80\uc778\uc9c0, \uc790\ub140\uc640 \ud568\uaed8 \uc0ac\ub294\uc9c0\uc5d0 \ub530\ub77c \ub300\uc0c1\uc774 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc18c\ub4dd\uacfc \uc7ac\uc0b0<\/td>\n<td>\ubcf5\uc9c0\uc11c\ube44\uc2a4\ub294 \uc18c\ub4dd\uc778\uc815\uc561\uc774\ub098 \uc7ac\uc0b0 \uae30\uc900\uc774 \uc801\uc6a9\ub418\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uac74\uac15 \uc0c1\ud0dc<\/td>\n<td>\ub3cc\ubd04, \uc758\ub8cc\ube44, \uc7a5\uae30\uc694\uc591 \uad00\ub828 \uc11c\ube44\uc2a4\ub294 \uac74\uac15 \uc0c1\ud0dc \ud655\uc778\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uac70\uc8fc \uc9c0\uc5ed<\/td>\n<td>\uc911\uc559\ubd80\ucc98 \uc81c\ub3c4\uc640 \uc9c0\uc790\uccb4 \uc790\uccb4 \uc81c\ub3c4\uac00 \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p>\ubcf5\uc9c0\uc11c\ube44\uc2a4\ub294 \uc774\ub984\uc774 \ube44\uc2b7\ud574\ub3c4 \ub2f4\ub2f9 \uae30\uad00\uacfc \uc2e0\uccad \uae30\uc900\uc774 \ub2e4\ub985\ub2c8\ub2e4. \ubcf5\uc9c0\ub85c\uc5d0\uc11c \uc81c\ub3c4\ub97c \uba3c\uc800 \ud655\uc778\ud558\uace0, \uc2e4\uc81c \uc2e0\uccad\uc740 \uc8fc\ubbfc\uc13c\ud130\ub098 \ub2f4\ub2f9 \uae30\uad00 \uc0c1\ub2f4\uc744 \ud1b5\ud574 \ucd5c\uc2e0 \uae30\uc900\uc744 \ud655\uc778\ud558\ub294 \ud750\ub984\uc774 \uc548\uc804\ud569\ub2c8\ub2e4.<\/p>\n<h2>\uc0c1\ub2f4 \uc804 \uba54\ubaa8\ud574\ub450\uba74 \uc88b\uc740 \uc9c8\ubb38<\/h2>\n<ul>\n<li>\ub0b4 \ub098\uc774\uc640 \uace0\uc6a9 \uc0c1\ud0dc\uc5d0\uc11c \uc2e0\uccad \uac00\ub2a5\ud55c\uac00\uc694?<\/li>\n<li>\uc18c\ub4dd, \uc7ac\uc0b0, \uacbd\ub825 \ub54c\ubb38\uc5d0 \uc81c\uc678\ub420 \uc218 \uc788\ub294 \uc870\uac74\uc774 \uc788\ub098\uc694?<\/li>\n<li>\uc628\ub77c\uc778 \uc2e0\uccad\uacfc \ubc29\ubb38 \uc2e0\uccad \uc911 \uc5b4\ub5a4 \ubc29\uc2dd\uc774 \ube60\ub978\uac00\uc694?<\/li>\n<li>\uc2e0\uccad \ud6c4 \uacb0\uacfc \ud655\uc778\uae4c\uc9c0 \ubcf4\ud1b5 \uc5bc\ub9c8\ub098 \uac78\ub9ac\ub098\uc694?<\/li>\n<li>\ube44\uc2b7\ud55c \uc81c\ub3c4\ub098 \uacfc\uc815\uacfc \uc911\ubcf5 \uc774\uc6a9\uc774 \uac00\ub2a5\ud55c\uac00\uc694?<\/li>\n<\/ul>\n<p>\uc774 \uc9c8\ubb38\uc744 \ubbf8\ub9ac \uc815\ub9ac\ud574\ub450\uba74 \uc0c1\ub2f4 \uc2dc\uac04\uc774 \uc9e7\uc544\uc9c0\uace0, \ub2f4\ub2f9\uc790\uc5d0\uac8c \ud544\uc694\ud55c \uc815\ubcf4\ub97c \ube60\ub974\uac8c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \uac00\uc871 \ub300\uc2e0 \uc54c\uc544\ubcf4\ub294 \uacbd\uc6b0\uc5d0\ub294 \ub2f9\uc0ac\uc790\uc758 \uc0dd\ub144\uc6d4\uc77c, \uac70\uc8fc\uc9c0, \uc18c\ub4dd \uc0c1\ud0dc, \uac74\uac15 \uc0c1\ud0dc\ucc98\ub7fc \uae30\ubcf8 \uc815\ubcf4\ub97c \uc900\ube44\ud574\ub450\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<p><!-- guide4050-related-start --><\/p>\n<section class=\"guide-related-posts\">\n<h2>\ud568\uaed8 \ubcf4\uba74 \uc88b\uc740 \uae00<\/h2>\n<p>\uc774 \uae00\uacfc \uc774\uc5b4\uc11c \ud655\uc778\ud558\uba74 \uc88b\uc740 4050 \ub9de\ucda4 \uc815\ubcf4\uc785\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/4050guide.co.kr\/basic-pension-income-recognition-check\/\">\uae30\ucd08\uc5f0\uae08 \uc2e0\uccad \uc804 \ud655\uc778\ud560 \uac83: \uc18c\ub4dd\uc778\uc815\uc561\uacfc \ud0c8\ub77d \uc0ac\uc720 \uc27d\uac8c \uc815\ub9ac<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/senior-tailored-care-service-parents-guide\/\">\ubd80\ubaa8\ub2d8 \ub178\uc778\ub9de\ucda4\ub3cc\ubd04\uc11c\ube44\uc2a4 \ud655\uc778\ubc95: \uc2e0\uccad \ub300\uc0c1\uacfc \uc0c1\ub2f4 \uc804 \uc900\ube44\uc11c\ub958<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/summer-2026-energy-voucher-parent-checklist\/\">2026 \uc5ec\ub984 \uc5d0\ub108\uc9c0\ubc14\uc6b0\ucc98 \ubd80\ubaa8\ub2d8 \ub300\uc2e0 \ud655\uc778\ud560 \uac83: \ub300\uc0c1, \uc2e0\uccad\ucc98, \uc0ac\uc6a9\ucc98<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/senior-job-program-application-guide\/\">\ub178\uc778\uc77c\uc790\ub9ac \uc2e0\uccad\ubc29\ubc95: \ubd80\ubaa8\ub2d8 \uc77c\uc790\ub9ac\uc640 \uc0ac\ud68c\ud65c\ub3d9 \uc9c0\uc6d0\uc0ac\uc5c5 \ud655\uc778<\/a><\/li>\n<\/ul>\n<\/section>\n<p><!-- guide4050-related-end --><\/p>\n<p><!-- 4050_SHORT_UPLIFT_START --><\/p>\n<section class=\"guide-short-uplift\">\n<h2>\ubcf5\uc9c0\uc81c\ub3c4 \ud655\uc778 \uc804 \uc900\ube44\ud560 \uac83<\/h2>\n<p>\ubcf5\uc9c0\uc81c\ub3c4\ub294 \uc774\ub984\uc774 \ube44\uc2b7\ud574\ub3c4 \ub300\uc0c1, \uc18c\ub4dd\u00b7\uc7ac\uc0b0 \uae30\uc900, \uc2e0\uccad\ucc98\uac00 \ub2e4\ub985\ub2c8\ub2e4. \ubd80\ubaa8\ub2d8 \ub300\uc2e0 \uc54c\uc544\ubcf4\ub294 \uacbd\uc6b0\ub77c\uba74 \uc0dd\ub144\uc6d4\uc77c, \uc18c\ub4dd, \uc7ac\uc0b0, \uac70\uc8fc\uc9c0, \uac74\uac15 \uc0c1\ud0dc\ub97c \uba3c\uc800 \uc815\ub9ac\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<figure class=\"wp-block-table\">\n<table>\n<tr>\n<th>\ud655\uc778 