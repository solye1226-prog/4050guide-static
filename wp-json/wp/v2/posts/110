{"id":110,"date":"2026-05-22T14:45:32","date_gmt":"2026-05-22T05:45:32","guid":{"rendered":"https:\/\/4050guide.co.kr\/tomorrow-card-self-payment-check\/"},"modified":"2026-05-26T18:33:29","modified_gmt":"2026-05-26T09:33:29","slug":"tomorrow-card-self-payment-check","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/tomorrow-card-self-payment-check\/","title":{"rendered":"\uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc \uc790\ube44\ubd80\ub2f4\uae08 \ud655\uc778\ubc29\ubc95: 4050\uc774 \ub193\uce58\uae30 \uc26c\uc6b4 \ube44\uc6a9"},"content":{"rendered":"<p>\uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc\ub97c \uc0ac\uc6a9\ud574\ub3c4 \ubaa8\ub4e0 \ud6c8\ub828\ube44\uac00 0\uc6d0\uc774 \ub418\ub294 \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4. \uac19\uc740 \uacfc\uc815\uc774\ub77c\ub3c4 \uc9c1\uc885, \ud6c8\ub828\uae30\uad00, \uac1c\uc778\uc758 \uace0\uc6a9 \uc0c1\ud0dc\uc5d0 \ub530\ub77c \uc790\ube44\ubd80\ub2f4\uae08\uc774 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>4050 \uc138\ub300\ub294 \uc7ac\ucde8\uc5c5\uc744 \ubaa9\ud45c\ub85c \ud6c8\ub828\uc744 \uace0\ub974\ub294 \uacbd\uc6b0\uac00 \ub9ce\uae30 \ub54c\ubb38\uc5d0 \uc218\uac15\ub8cc\ubcf4\ub2e4 \uc2e4\uc81c \ubd80\ub2f4\uc561, \ucd9c\uc11d \uae30\uc900, \uc218\ub8cc \ud6c4 \ud65c\uc6a9 \uac00\ub2a5\uc131\uc744 \ud568\uaed8 \ubd10\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<h2>\uc790\ube44\ubd80\ub2f4\uae08 \ud575\uc2ec \uc694\uc57d<\/h2>\n<table class=\"guide-table\">\n<tbody>\n<tr>\n<th>\ud655\uc778 \uc704\uce58<\/th>\n<td>\uc9c1\uc5c5\ud6c8\ub828\ud3ec\ud138 HRD-Net \uacfc\uc815 \uc0c1\uc138 \ud654\uba74<\/td>\n<\/tr>\n<tr>\n<th>\ub2ec\ub77c\uc9c0\ub294 \uae30\uc900<\/th>\n<td>\ud6c8\ub828 \uc9c1\uc885, \uacfc\uc815 \uc720\ud615, \ubcf8\uc778 \uace0\uc6a9 \uc0c1\ud0dc, \uc9c0\uc6d0 \uc6b0\ub300 \uc5ec\ubd80<\/td>\n<\/tr>\n<tr>\n<th>\uc8fc\uc758\ud560 \uc810<\/th>\n<td>\uad50\uc7ac\ube44, \uc7ac\ub8cc\ube44, \uc2dc\ud5d8 \uc751\uc2dc\ub8cc\ub294 \ubcc4\ub3c4\uc77c \uc218 \uc788\uc74c<\/td>\n<\/tr>\n<tr>\n<th>4050 \uccb4\ud06c\ud3ec\uc778\ud2b8<\/th>\n<td>\ucde8\uc5c5 \uc5f0\uacb0 \uac00\ub2a5\uc131\uacfc \uc218\ub8cc \uac00\ub2a5 \uc2dc\uac04\uc744 \uba3c\uc800 \ud655\uc778<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>4050 \uae30\uc900\uc73c\ub85c \uba3c\uc800 \ud655\uc778\ud560 \uac83<\/h2>\n<ul>\n<li>\ucd1d \ud6c8\ub828\ube44\uc640 \uc2e4\uc81c \uc790\ube44\ubd80\ub2f4\uc561\uc744 \ub530\ub85c \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\ud6c8\ub828 \uc2dc\uac04\uc774 \ud604\uc7ac \uadfc\ubb34, \ub3cc\ubd04, \uad6c\uc9c1\ud65c\ub3d9 \uc77c\uc815\uacfc \ucda9\ub3cc\ud558\uc9c0 \uc54a\ub294\uc9c0 \ubd05\ub2c8\ub2e4.<\/li>\n<li>\ud6c8\ub828\uae30\uad00 \ud6c4\uae30\ub294 \uc88b\uc9c0\ub9cc \ucde8\uc5c5\ucc98\uac00 \ubd84\uba85\ud558\uc9c0 \uc54a\uc740 \uacfc\uc815\uc740 \ud55c \ubc88 \ub354 \uac80\ud1a0\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc218\ub8cc \uae30\uc900\uacfc \uacb0\uc11d \uac00\ub2a5 \ud69f\uc218\ub97c \ud655\uc778\ud574 \uc911\ub3c4 \ud0c8\ub77d \uc704\ud5d8\uc744 \uc904\uc785\ub2c8\ub2e4.<\/li>\n<\/ul>\n<h2>\uc2e0\uccad\ud558\uac70\ub098 \uc900\ube44\ud560 \ub54c \uc790\uc8fc \ub193\uce58\ub294 \ubd80\ubd84<\/h2>\n<ul>\n<li>\uce74\ub4dc\uac00 \uc788\uc73c\uba74 \ubaa8\ub4e0 \uacfc\uc815\uc774 \ubb34\ub8cc\ub77c\uace0 \uc0dd\uac01\ud558\ub294 \uacbd\uc6b0<\/li>\n<li>\uc778\uae30 \uacfc\uc815\ub9cc \ubcf4\uace0 \uc2e4\uc81c \ucde8\uc5c5 \ubd84\uc57c\ub97c \ud655\uc778\ud558\uc9c0 \uc54a\ub294 \uacbd\uc6b0<\/li>\n<li>\uc218\uac15\ub8cc \uc678 \uad50\uc7ac\ube44\uc640 \uc2e4\uc2b5\ube44\ub97c \ub193\uce58\ub294 \uacbd\uc6b0<\/li>\n<li>\uc9d1\uacfc \ud6c8\ub828\uae30\uad00 \uac70\ub9ac, \uc57c\uac04 \uc218\uc5c5 \uc5ec\ubd80\ub97c \ub4a4\ub2a6\uac8c \ud655\uc778\ud558\ub294 \uacbd\uc6b0<\/li>\n<\/ul>\n<h2>\ud604\uc2e4\uc801\uc73c\ub85c \uc774\ub807\uac8c \ud310\ub2e8\ud558\uc138\uc694<\/h2>\n<p>\uc790\ube44\ubd80\ub2f4\uae08\uc774 \ub0ae\uc740 \uacfc\uc815\uc774 \ud56d\uc0c1 \uc88b\uc740 \uc120\ud0dd\uc740 \uc544\ub2d9\ub2c8\ub2e4. 4050 \uc7ac\ucde8\uc5c5\uc5d0\uc11c\ub294 \uc218\ub8cc \ud6c4 \ubc14\ub85c \ud65c\uc6a9\ud560 \uc218 \uc788\ub294 \uc9c1\ubb34\uc778\uc9c0, \uc9c0\uc5ed \ub0b4 \ucc44\uc6a9 \uc218\uc694\uac00 \uc788\ub294\uc9c0\uac00 \ub354 \uc911\uc694\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\uacfc\uc815 \uc120\ud0dd \uc804\uc5d0\ub294 HRD-Net\uc5d0\uc11c \uac19\uc740 \ud0a4\uc6cc\ub4dc\ub85c \uc5ec\ub7ec \uae30\uad00\uc744 \ube44\uad50\ud558\uace0, \uace0\uc6a9\uc13c\ud130 \uc0c1\ub2f4\uc744 \ud1b5\ud574 \ubcf8\uc778\uc758 \uad6c\uc9c1 \ubc29\ud5a5\uacfc \ub9de\ub294\uc9c0 \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<details>\n<summary>\uc790\ube44\ubd80\ub2f4\uae08\uc740 \uc5b8\uc81c \uacb0\uc81c\ud558\ub098\uc694?<\/summary>\n<p>\ub300\ubd80\ubd84 \ud6c8\ub828 \uc2e0\uccad\uacfc \ub4f1\ub85d \uacfc\uc815\uc5d0\uc11c \ubcf8\uc778 \ubd80\ub2f4\ubd84\uc744 \uacb0\uc81c\ud569\ub2c8\ub2e4. \uae30\uad00\ubcc4 \uc808\ucc28\uac00 \ub2e4\ub97c \uc218 \uc788\uc73c\ubbc0\ub85c \uacfc\uc815 \uc0c1\uc138 \uc548\ub0b4\ub97c \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<\/details>\n<details>\n<summary>\uc790\ube44\ubd80\ub2f4\uae08\uc774 0\uc6d0\uc778 \uacfc\uc815\ub9cc \uace8\ub77c\ub3c4 \ub418\ub098\uc694?<\/summary>\n<p>\uac00\ub2a5\ud558\uc9c0\ub9cc \uc120\ud0dd\uc9c0\uac00 \uc881\uc544\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ube44\uc6a9\ubcf4\ub2e4 \ucde8\uc5c5 \uc5f0\uacb0\uc131\uacfc \uc218\ub8cc \uac00\ub2a5\uc131\uc744 \ud568\uaed8 \ud310\ub2e8\ud558\ub294 \ud3b8\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<\/details>\n<h2>\uacf5\uc2dd \ud655\uc778\ucc98<\/h2>\n<p>\uc81c\ub3c4\uc640 \uc2dc\ud5d8 \uc815\ubcf4\ub294 \uc218\uc2dc\ub85c \ubc14\ub014 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2e4\uc81c \uc2e0\uccad \uc804\uc5d0\ub294 \uc544\ub798 \uacf5\uc2dd \ud398\uc774\uc9c0\uc5d0\uc11c \ucd5c\uc2e0 \uacf5\uace0, \uc2e0\uccad \uc790\uaca9, \uc811\uc218 \uae30\uac04\uc744 \ub2e4\uc2dc \ud655\uc778\ud558\uc138\uc694.<\/p>\n<ul>\n<li><a href=\"https:\/\/www.hrd.go.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\uc9c1\uc5c5\ud6c8\ub828\ud3ec\ud138 HRD-Net<\/a><\/li>\n<li><a href=\"https:\/\/www.work24.go.kr\/\" target=\"_blank\" rel=\"noopener noreferrer\">\uace0\uc6a924<\/a><\/li>\n<\/ul>\n<div class=\"guide-related\"><\/div>\n<p><!-- guide4050-depth-expand --><\/p>\n<h2>4050 \uae30\uc900\uc73c\ub85c \uba3c\uc800 \ud310\ub2e8\ud560 \ubd80\ubd84<\/h2>\n<p>\uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc \uc790\ube44\ubd80\ub2f4\uae08 \ud655\uc778\ubc29\ubc95: 4050\uc774 \ub193\uce58\uae30 \uc26c\uc6b4 \ube44\uc6a9\ub97c \ud655\uc778\ud560 \ub54c\ub294 \ub2e8\uc21c\ud788 \uc774\ub984\ub9cc \ubcf4\uace0 \uacb0\uc815\ud558\uae30\ubcf4\ub2e4 \ub0b4 \uc0c1\ud669\uc5d0 \uc2e4\uc81c\ub85c \ub9de\ub294\uc9c0\ubd80\ud130 \ubcf4\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. 40\ub300\uc640 50\ub300\ub294 \uc774\ubbf8 \uc9c1\uc7a5 \uacbd\ud5d8, \uac00\uc871 \ubd80\uc591, \uac74\uac15\ubcf4\ud5d8\ub8cc, \ud1f4\uc9c1 \uc77c\uc815, \ubd80\ubaa8\ub2d8 \ub3cc\ubd04 \uac19\uc740 \uc870\uac74\uc774 \ud568\uaed8 \uc6c0\uc9c1\uc774\ub294 \uacbd\uc6b0\uac00 \ub9ce\uae30 \ub54c\ubb38\uc5d0 \uac19\uc740 \uc81c\ub3c4\ub77c\ub3c4 \uccb4\uac10\ub418\ub294 \uc720\ub9ac\ud568\uc774 \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ud2b9\ud788 \uc2e0\uccad\ud615 \uc81c\ub3c4\ub098 \uc790\uaca9\uc99d \uc815\ubcf4\ub294 \uad11\uace0 \ubb38\uad6c\ubcf4\ub2e4 \uacf5\uc2dd \uc870\uac74\uacfc \uc2e4\uc81c \ud65c\uc6a9\ucc98\ub97c \ud568\uaed8 \ubd10\uc57c \ud569\ub2c8\ub2e4. \uc9c0\uc6d0 \ub300\uc0c1, \uc2e0\uccad \uae30\uac04, \uc900\ube44\uc11c\ub958, \ubcf8\uc778\ubd80\ub2f4 \uc5ec\ubd80, \uc0c1\ub2f4 \ucc3d\uad6c\ub97c \uba3c\uc800 \ud655\uc778\ud558\uba74 \uc2dc\uac04\uc744 \uc904\uc77c \uc218 \uc788\uace0, \uc2e0\uccad \ud6c4 \ud0c8\ub77d\ud558\uac70\ub098 \uacfc\uc815 \uc218\ub8cc \ud6c4 \ud65c\uc6a9\ud558\uc9c0 \ubabb\ud558\ub294 \uc0c1\ud669\uc744 \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uad6d\ube44\uc9c0\uc6d0 \uae00\uc5d0\uc11c \uaf2d \ube44\uad50\ud560 \ud56d\ubaa9<\/h2>\n<table>\n<thead>\n<tr>\n<th>\ud655\uc778 \ud56d\ubaa9<\/th>\n<th>\uc65c \uc911\uc694\ud55c\uac00<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\uc790\ube44\ubd80\ub2f4\uae08<\/td>\n<td>\uac19\uc740 \uacfc\uc815\uc774\ub77c\ub3c4 \ud6c8\ub828\uae30\uad00\uacfc \uc9c1\uc885\uc5d0 \ub530\ub77c \uc2e4\uc81c \ubd80\ub2f4\uc561\uc774 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\ud6c8\ub828\uc2dc\uac04<\/td>\n<td>\uc7ac\uc9c1\uc790\uc640 \uad6c\uc9c1\uc790\ub294 \uac00\ub2a5\ud55c \uc2dc\uac04\ub300\uac00 \ub2e4\ub974\ubbc0\ub85c \uc218\ub8cc \uac00\ub2a5\uc131\uc744 \uba3c\uc800 \ubd10\uc57c \ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\ucde8\uc5c5 \uc5f0\uacc4<\/td>\n<td>\uc218\ub8cc \ud6c4 \ucc44\uc6a9 \uc0c1\ub2f4, \uc774\ub825\uc11c \uc9c0\uc6d0, \ud604\uc7a5 \uc2e4\uc2b5 \uc5ec\ubd80\uac00 \uc2e4\uc81c \ud65c\uc6a9\ub3c4\ub97c \uc88c\uc6b0\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uacf5\uc2dd \ub4f1\ub85d \uc5ec\ubd80<\/td>\n<td>\uace0\uc6a924\ub098 HRD-Net\uc5d0\uc11c \ud655\uc778\ub418\ub294 \uacfc\uc815\uc778\uc9c0 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p>4050 \uc138\ub300\ub294 \ub2e8\uae30\uac04\uc5d0 \uacb0\uacfc\ub97c \ub0b4\uc57c \ud558\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \uadf8\ub798\uc11c \ub2e8\uc21c\ud788 \uc778\uae30 \uacfc\uc815\uc778\uc9c0\ubcf4\ub2e4 \uc218\ub8cc \ud6c4 \uc5b4\ub514\uc5d0 \uc9c0\uc6d0\ud560 \uc218 \uc788\ub294\uc9c0, \ub0b4 \uacbd\ub825\uacfc \uc5f0\uacb0\ub418\ub294\uc9c0, \ud604\uc7ac \uac70\uc8fc \uc9c0\uc5ed\uc5d0\uc11c \uc2e4\uc2b5\uc774\ub098 \ucd9c\uc11d\uc774 \uac00\ub2a5\ud55c\uc9c0\ub97c \ud568\uaed8 \ud310\ub2e8\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<h2>\uc0c1\ub2f4 \uc804 \uba54\ubaa8\ud574\ub450\uba74 \uc88b\uc740 \uc9c8\ubb38<\/h2>\n<ul>\n<li>\ub0b4 \ub098\uc774\uc640 \uace0\uc6a9 \uc0c1\ud0dc\uc5d0\uc11c \uc2e0\uccad \uac00\ub2a5\ud55c\uac00\uc694?<\/li>\n<li>\uc18c\ub4dd, \uc7ac\uc0b0, \uacbd\ub825 \ub54c\ubb38\uc5d0 \uc81c\uc678\ub420 \uc218 \uc788\ub294 \uc870\uac74\uc774 \uc788\ub098\uc694?<\/li>\n<li>\uc628\ub77c\uc778 \uc2e0\uccad\uacfc \ubc29\ubb38 \uc2e0\uccad \uc911 \uc5b4\ub5a4 \ubc29\uc2dd\uc774 \ube60\ub978\uac00\uc694?<\/li>\n<li>\uc2e0\uccad \ud6c4 \uacb0\uacfc \ud655\uc778\uae4c\uc9c0 \ubcf4\ud1b5 \uc5bc\ub9c8\ub098 \uac78\ub9ac\ub098\uc694?<\/li>\n<li>\ube44\uc2b7\ud55c \uc81c\ub3c4\ub098 \uacfc\uc815\uacfc \uc911\ubcf5 \uc774\uc6a9\uc774 \uac00\ub2a5\ud55c\uac00\uc694?<\/li>\n<\/ul>\n<p>\uc774 \uc9c8\ubb38\uc744 \ubbf8\ub9ac \uc815\ub9ac\ud574\ub450\uba74 \uc0c1\ub2f4 \uc2dc\uac04\uc774 \uc9e7\uc544\uc9c0\uace0, \ub2f4\ub2f9\uc790\uc5d0\uac8c \ud544\uc694\ud55c \uc815\ubcf4\ub97c \ube60\ub974\uac8c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \uac00\uc871 \ub300\uc2e0 \uc54c\uc544\ubcf4\ub294 \uacbd\uc6b0\uc5d0\ub294 \ub2f9\uc0ac\uc790\uc758 \uc0dd\ub144\uc6d4\uc77c, \uac70\uc8fc\uc9c0, \uc18c\ub4dd \uc0c1\ud0dc, \uac74\uac15 \uc0c1\ud0dc\ucc98\ub7fc \uae30\ubcf8 \uc815\ubcf4\ub97c \uc900\ube44\ud574\ub450\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<p><!-- guide4050-related-start --><\/p>\n<section class=\"guide-related-posts\">\n<h2>\ud568\uaed8 \ubcf4\uba74 \uc88b\uc740 \uae00<\/h2>\n<p>\uc774 \uae00\uacfc \uc774\uc5b4\uc11c \ud655\uc778\ud558\uba74 \uc88b\uc740 4050 \ub9de\ucda4 \uc815\ubcf4\uc785\ub2c8\ub2e4.<\/p>\n<ul>\n<li><a href=\"https:\/\/4050guide.co.kr\/2026-qnet-constant-exam-14-license-guide-4050\/\">2026\ub144 \uc0c1\uc2dc\uac80\uc815 \uc790\uaca9\uc99d 14\uc885\ubaa9: \uc9c0\uac8c\ucc28\u00b7\ud55c\uc2dd\uc870\ub9ac\ucc98\ub7fc \uc77c\uc815 \uc120\ud0dd\uc774 \uc26c\uc6b4 \uc885\ubaa9<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/4050-tomorrow-card-self-payment-guide\/\">4050 \uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc \uc790\ube44\ubd80\ub2f4\uae08 \ud655\uc778\ubc95: \uac19\uc740 \uacfc\uc815\ub3c4 \ube44\uc6a9\uc774 \ub2e4\ub978 \uc774\uc720<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/second-half-2026-hrd-training-course-guide\/\">2026\ub144 \ud558\ubc18\uae30 \uad6d\ube44\uc9c0\uc6d0 \ud6c8\ub828\uacfc\uc815 \ucc3e\ub294 \ubc95: 6\uc6d4\ubd80\ud130 \ube44\uad50\ud560 \ud56d\ubaa9<\/a><\/li>\n<li><a href=\"https:\/\/4050guide.co.kr\/polytech-middle-aged-training-course-guide\/\">\ud3f4\ub9ac\ud14d \uc2e0\uc911\ub144 \ud2b9\ud654\uacfc\uc815 \ud655\uc778\ubc29\ubc95: 4050 \uae30\uc220\uad50\uc721 \ucc3e\ub294 \uae30\uc900<\/a><\/li>\n<\/ul>\n<\/section>\n<p><!-- guide4050-related-end --><\/p>\n<p><!-- 4050_ADSENSE_CORE_UPGRADE_START --><\/p>\n<section class=\"guide-core-upgrade\">\n<h2>\uc790\ube44\ubd80\ub2f4\uae08\uc744 \ubcfc \ub54c \ub193\uce58\uae30 \uc26c\uc6b4 \uae30\uc900<\/h2>\n<p>\uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc \uacfc\uc815\uc740 \ubaa8\ub450 \ubb34\ub8cc\uac00 \uc544\ub2d9\ub2c8\ub2e4. \uac19\uc740 \uc790\uaca9\uc99d \uacfc\uc815\uc774\ub77c\ub3c4 \uc9c1\uc885, \ud6c8\ub828\uae30\uad00, \uac1c\uc778\uc758 \uace0\uc6a9 \uc0c1\ud0dc\uc5d0 \ub530\ub77c \uc790\ube44\ubd80\ub2f4\uae08\uc774 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<figure class=\"wp-block-table\">\n<table>\n<tr>\n<th>\uad6c\ubd84<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<th>\uc8fc\uc758\ud560 \uc810<\/th>\n<\/tr>\n<tr>\n<td>\ud6c8\ub828\ube44<\/td>\n<td>\ucd1d \ud6c8\ub828\ube44\uc640 \uc815\ubd80\uc9c0\uc6d0\uae08\uc744 \ub098\ub220 \ubd05\ub2c8\ub2e4.<\/td>\n<td>\ud64d\ubcf4 \ubb38\uad6c\uc758 \ubb34\ub8cc \uc5ec\ubd80\ub9cc \ubbff\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uad50\uc7ac\u00b7\uc7ac\ub8cc\ube44<\/td>\n<td>\ubcc4\ub3c4 \ub0a9\ubd80 \ube44\uc6a9\uc774 \uc788\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<td>\uc2e4\uc2b5 \uacfc\uc815\uc740 \uc7ac\ub8cc\ube44\uac00 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\ucd9c\uc11d \uc870\uac74<\/td>\n<td>\uc911\ub3c4 \ud3ec\uae30 \uc2dc \ubd88\uc774\uc775\uc774 \uc788\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<td>\uadfc\ubb34\uc2dc\uac04\uacfc \ubcd1\ud589 \uac00\ub2a5\uc131\uc744 \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\ud658\uae09 \uc5ec\ubd80<\/td>\n<td>\uc218\ub8cc \ud6c4 \ud658\uae09 \uc870\uac74\uc774 \uc788\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/td>\n<td>\uc218\ub8cc\ub9cc\uc73c\ub85c \ud658\uae09\ub418\ub294\uc9c0, \ucde8\uc5c5 \uc870\uac74\uc774 \uc788\ub294\uc9c0 \ubd05\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/table>\n<\/figure>\n<h3>\uc2e0\uccad \uc804 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h3>\n<ul>\n<li>HRD-Net \uacfc\uc815 \uc0c1\uc138 \ud398\uc774\uc9c0\uc5d0\uc11c \ubcf8\uc778\ubd80\ub2f4\uae08 \ud655\uc778<\/li>\n<li>\ud6c8\ub828\uae30\uad00\uc5d0 \uad50\uc7ac\ube44\uc640 \uc7ac\ub8cc\ube44 \ubcc4\ub3c4 \uc5ec\ubd80 \ubb38\uc758<\/li>\n<li>\ucd9c\uc11d\ub960 \uae30\uc900 \ud655\uc778<\/li>\n<li>\uc911\ub3c4 \ud3ec\uae30 \uc2dc \uc81c\ud55c \uc0ac\ud56d \ud655\uc778<\/li>\n<\/ul>\n<h3>\uc790\uc8fc \ub193\uce58\ub294 \ubd80\ubd84<\/h3>\n<p>\uc790\ube44\ubd80\ub2f4\uae08\uc740 \uacfc\uc815 \uac80\uc0c9 \ud654\uba74\uacfc \uc2e4\uc81c \uc2e0\uccad \ub2e8\uacc4\uc5d0\uc11c \ub2e4\ub974\uac8c \ub290\uaef4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubc18\ub4dc\uc2dc \uc0c1\uc138 \ud654\uba74\uacfc \uc2e0\uccad \uc9c1\uc804 \uae08\uc561\uc744 \ub2e4\uc2dc \ud655\uc778\ud558\ub294 \uac83\uc774 \uc548\uc804\ud569\ub2c8\ub2e4.<\/p>\n<p><strong>\uacf5\uc2dd \ud655\uc778\ucc98:<\/strong> HRD-Net \ud6c8\ub828\uacfc\uc815 \uc0c1\uc138 \uc548\ub0b4<\/p>\n<\/section>\n<p><!-- 4050_ADSENSE_CORE_UPGRADE_END --><\/p>\n","protected":false},"excerpt":{"rendered":"<p>\uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc\ub97c \uc0ac\uc6a9\ud574\ub3c4 \ubaa8\ub4e0 \ud6c8\ub828\ube44\uac00 0\uc6d0\uc774 \ub418\ub294 \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4. \uac19\uc740 \uacfc\uc815\uc774\ub77c\ub3c4 \uc9c1\uc885, \ud6c8\ub828\uae30\uad00, \uac1c\uc778\uc758 \uace0\uc6a9 \uc0c1\ud0dc\uc5d0 \ub530\ub77c \uc790\ube44\ubd80\u