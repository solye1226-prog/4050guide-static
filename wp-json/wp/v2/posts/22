{"id":22,"date":"2026-05-14T20:30:00","date_gmt":"2026-05-14T11:30:00","guid":{"rendered":"https:\/\/4050guide.co.kr\/?p=22"},"modified":"2026-05-26T09:29:10","modified_gmt":"2026-05-26T00:29:10","slug":"50s-women-reemployment-certificates","status":"publish","type":"post","link":"https:\/\/4050guide.co.kr\/50s-women-reemployment-certificates\/","title":{"rendered":"50\ub300 \uc5ec\uc131 \uc7ac\ucde8\uc5c5 \uc790\uaca9\uc99d \ucd94\ucc9c: \ud604\uc2e4\uc801\uc73c\ub85c \uc900\ube44\ud560 \ub9cc\ud55c \ubd84\uc57c"},"content":{"rendered":"<p>50\ub300 \uc5ec\uc131 \uc7ac\ucde8\uc5c5 \uc790\uaca9\uc99d\uc740 \u201c\ucde8\ub4dd\uc774 \uc26c\uc6b4\uac00\u201d\ubcf4\ub2e4 \u201c\uc2e4\uc81c\ub85c \uc77c\uc790\ub9ac\uc640 \uc5f0\uacb0\ub418\ub294\uac00\u201d\ub97c \uba3c\uc800 \ubd10\uc57c \ud569\ub2c8\ub2e4. \ud2b9\ud788 \uc694\uc591, \ub3cc\ubd04, \uc870\ub9ac, \uc0ac\ud68c\ubcf5\uc9c0, \uc0ac\ubb34 \ubcf4\uc870\ucc98\ub7fc \uc9c0\uc5ed \uad6c\uc778\uacf5\uace0\uc5d0\uc11c \uafb8\uc900\ud788 \ubcf4\uc774\ub294 \ubd84\uc57c\ub97c \uc911\uc2ec\uc73c\ub85c \ube44\uad50\ud558\ub294 \uac83\uc774 \ud604\uc2e4\uc801\uc785\ub2c8\ub2e4.<\/p>\n<h2>\uba3c\uc800 \uacb0\ub860\ubd80\ud130 \ubcf4\uba74<\/h2>\n<table>\n<thead>\n<tr>\n<th>\uc0c1\ud669<\/th>\n<th>\uba3c\uc800 \ubcfc \ub9cc\ud55c \uc790\uaca9<\/th>\n<th>\ud655\uc778 \ud3ec\uc778\ud2b8<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\ub3cc\ubd04\u00b7\uc694\uc591 \ubd84\uc57c \ucde8\uc5c5\uc744 \uc6d0\ud560 \ub54c<\/td>\n<td>\uc694\uc591\ubcf4\ud638\uc0ac<\/td>\n<td>\uad50\uc721 \uc774\uc218, \uc2e4\uc2b5, \uad6d\uac00\uc2dc\ud5d8 \uc77c\uc815<\/td>\n<\/tr>\n<tr>\n<td>\ubcf5\uc9c0\uae30\uad00\u00b7\uc8fc\uac04\ubcf4\ud638\uc13c\ud130 \ucabd\uc73c\ub85c \ub113\ud788\uace0 \uc2f6\uc744 \ub54c<\/td>\n<td>\uc0ac\ud68c\ubcf5\uc9c0\uc0ac 2\uae09<\/td>\n<td>\ud559\uc810\uc740\ud589\uc81c, \uc2e4\uc2b5 \uac00\ub2a5 \uc5ec\ubd80, \ucde8\ub4dd \uae30\uac04<\/td>\n<\/tr>\n<tr>\n<td>\uae09\uc2dd\u00b7\uc870\ub9ac \ubcf4\uc870\u00b7\uc18c\uaddc\ubaa8 \ucc3d\uc5c5\uc744 \uc0dd\uac01\ud560 \ub54c<\/td>\n<td>\ud55c\uc2dd\uc870\ub9ac\uae30\ub2a5\uc0ac<\/td>\n<td>\ud544\uae30\u00b7\uc2e4\uae30 \uc900\ube44, \uc2e4\uc2b5 \ud658\uacbd, \uccb4\ub825 \ubd80\ub2f4<\/td>\n<\/tr>\n<tr>\n<td>\uac00\uc0ac\u00b7\uc815\ub9ac\u00b7\ub3cc\ubd04 \ubcf4\uc870 \uc5c5\ubb34\ub97c \uc6d0\ud560 \ub54c<\/td>\n<td>\uc815\ub9ac\uc218\ub0a9, \uc0dd\ud65c\uc9c0\uc6d0 \uad00\ub828 \uacfc\uc815<\/td>\n<td>\ubbfc\uac04\uc790\uaca9 \uc5ec\ubd80, \uc2e4\uc81c \uad6c\uc778\uacf5\uace0 \uc694\uad6c \uc5ec\ubd80<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\uc790\uaca9\uc99d\ubcc4\ub85c \uc774\ub807\uac8c \ube44\uad50\ud558\uc138\uc694<\/h2>\n<h3>1. \uc694\uc591\ubcf4\ud638\uc0ac<\/h3>\n<p>\uc694\uc591\ubcf4\ud638\uc0ac\ub294 50\ub300 \uc774\ud6c4 \uc7ac\ucde8\uc5c5\uc5d0\uc11c \uac00\uc7a5 \ub9ce\uc774 \uac70\ub860\ub418\ub294 \uc790\uaca9 \uc911 \ud558\ub098\uc785\ub2c8\ub2e4. \ubc29\ubb38\uc694\uc591, \uc8fc\uc57c\uac04\ubcf4\ud638\uc13c\ud130, \uc694\uc591\uc2dc\uc124 \ub4f1\uc73c\ub85c \uc5f0\uacb0\ub420 \uc218 \uc788\uc5b4 \uc9c0\uc5ed \uad6c\uc778\uacf5\uace0\ub97c \ud655\uc778\ud558\uae30 \uc27d\uc2b5\ub2c8\ub2e4. \ub2e4\ub9cc \ub3cc\ubd04 \uc5c5\ubb34 \ud2b9\uc131\uc0c1 \uccb4\ub825 \ubd80\ub2f4\uacfc \uadfc\ubb34 \ud615\ud0dc\ub97c \ubbf8\ub9ac \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<ul>\n<li>\uc801\ud569\ud55c \uacbd\uc6b0: \ub3cc\ubd04 \uc5c5\ubb34\uc5d0 \uac70\ubd80\uac10\uc774 \uc5c6\uace0 \uc548\uc815\uc801\uc778 \ud604\uc7a5 \uc77c\uc790\ub9ac\ub97c \ucc3e\ub294 \uacbd\uc6b0<\/li>\n<li>\ud655\uc778\ud560 \uac83: \uad50\uc721\uae30\uad00, \uc2e4\uc2b5 \uac00\ub2a5 \uc5ec\ubd80, \uc2dc\ud5d8 \uc77c\uc815, \uadfc\ubb34 \uc2dc\uac04\ub300<\/li>\n<li>\uc8fc\uc758\ud560 \uac83: \u201c\ucde8\ub4dd \uc989\uc2dc \uace0\uc18c\ub4dd\u201d \uac19\uc740 \uad11\uace0 \ubb38\uad6c\ubcf4\ub2e4 \uc2e4\uc81c \uc9c0\uc5ed \ucc44\uc6a9\uacf5\uace0\ub97c \uba3c\uc800 \ud655\uc778<\/li>\n<\/ul>\n<h3>2. \uc0ac\ud68c\ubcf5\uc9c0\uc0ac 2\uae09<\/h3>\n<p>\uc0ac\ud68c\ubcf5\uc9c0\uc0ac 2\uae09\uc740 \ub2e8\uae30\uac04 \uc2dc\ud5d8\ud615 \uc790\uaca9\uc774\ub77c\uae30\ubcf4\ub2e4 \uacfc\ubaa9 \uc774\uc218\uc640 \uc2e4\uc2b5\uc744 \uac70\uccd0 \uc900\ube44\ud558\ub294 \uc790\uaca9\uc785\ub2c8\ub2e4. \ubcf5\uc9c0\uae30\uad00, \ub370\uc774\ucf00\uc5b4\uc13c\ud130, \uc9c0\uc5ed\uc544\ub3d9\uc13c\ud130, \ud589\uc815 \ubcf4\uc870 \ub4f1\uc73c\ub85c \uad00\uc2ec \ubd84\uc57c\ub97c \ub113\ud790 \uc218 \uc788\uc9c0\ub9cc \uc900\ube44 \uae30\uac04\uacfc \ube44\uc6a9\uc744 \uba3c\uc800 \uacc4\uc0b0\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<ul>\n<li>\uc801\ud569\ud55c \uacbd\uc6b0: \ubc14\ub85c \ud604\uc7a5\uc9c1\ubcf4\ub2e4 \ubcf5\uc9c0 \ud589\uc815\u00b7\uc0c1\ub2f4\u00b7\uae30\uad00 \uc5c5\ubb34\uae4c\uc9c0 \uace0\ub824\ud558\ub294 \uacbd\uc6b0<\/li>\n<li>\ud655\uc778\ud560 \uac83: \uc774\uc218 \uacfc\ubaa9, \uc2e4\uc2b5 \uac00\ub2a5 \uae30\uad00, \uc628\ub77c\uc778 \uc218\uc5c5 \uc778\uc815 \uc5ec\ubd80<\/li>\n<li>\uc8fc\uc758\ud560 \uac83: \uad50\uc721\uae30\uad00 \uad11\uace0\ub9cc \ubcf4\uace0 \uacb0\uc815\ud558\uc9c0 \ub9d0\uace0 \uc790\uaca9\uad00\ub9ac \uae30\uc900\uc744 \uba3c\uc800 \ud655\uc778<\/li>\n<\/ul>\n<h3>3. \ud55c\uc2dd\uc870\ub9ac\uae30\ub2a5\uc0ac<\/h3>\n<p>\ud55c\uc2dd\uc870\ub9ac\uae30\ub2a5\uc0ac\ub294 \uae09\uc2dd, \uc870\ub9ac \ubcf4\uc870, \uc2dd\ub2f9 \uc6b4\uc601 \uc900\ube44\uc640 \uc5f0\uacb0\ud574\uc11c \uc0dd\uac01\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2e4\uae30 \uc900\ube44\uac00 \ud544\uc694\ud558\uae30 \ub54c\ubb38\uc5d0 \uc190\uc774 \ub9ce\uc774 \uac00\uc9c0\ub9cc, \uc74c\uc2dd \uad00\ub828 \uacbd\ub825\uc774 \uc788\uac70\ub098 \uc870\ub9ac \uc5c5\ubb34\uc5d0 \uc775\uc219\ud558\ub2e4\uba74 \ud604\uc2e4\uc801\uc778 \uc120\ud0dd\uc9c0\uac00 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<ul>\n<li>\uc801\ud569\ud55c \uacbd\uc6b0: \uc870\ub9ac \uacbd\ud5d8\uc774 \uc788\uac70\ub098 \uae09\uc2dd\u00b7\uc8fc\ubc29 \ubcf4\uc870 \uc77c\uc790\ub9ac\ub97c \uace0\ub824\ud558\ub294 \uacbd\uc6b0<\/li>\n<li>\ud655\uc778\ud560 \uac83: \ud544\uae30\u00b7\uc2e4\uae30 \uc77c\uc815, \uc2e4\uc2b5 \uc7a5\uc18c, \uc7ac\ub8cc\ube44\uc640 \uc5f0\uc2b5 \ube44\uc6a9<\/li>\n<li>\uc8fc\uc758\ud560 \uac83: \uc11c\uc11c \uc77c\ud558\ub294 \uc2dc\uac04\uc774 \uae38 \uc218 \uc788\uc73c\ubbc0\ub85c \uccb4\ub825 \ubd80\ub2f4 \ud655\uc778<\/li>\n<\/ul>\n<h3>4. \uc815\ub9ac\uc218\ub0a9\u00b7\uc0dd\ud65c\uc9c0\uc6d0 \uad00\ub828 \uacfc\uc815<\/h3>\n<p>\uc815\ub9ac\uc218\ub0a9, \uc0dd\ud65c\uc9c0\uc6d0, \ub3cc\ubd04 \ubcf4\uc870 \ubd84\uc57c\ub294 \ubbfc\uac04\uc790\uaca9\uc774 \uc11e\uc5ec \uc788\uae30 \ub54c\ubb38\uc5d0 \ucde8\uc5c5 \ubcf4\uc7a5\ucc98\ub7fc \ubcf4\uc774\ub294 \ud45c\ud604\uc744 \uc870\uc2ec\ud574\uc57c \ud569\ub2c8\ub2e4. \uc790\uaca9\uc99d \uc774\ub984\ubcf4\ub2e4 \uc2e4\uc81c\ub85c \uc9c0\uc5ed \uc77c\uc790\ub9ac\uc5d0\uc11c \uc694\uad6c\ud558\ub294 \uc5ed\ub7c9\uc778\uc9c0 \ud655\uc778\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4.<\/p>\n<ul>\n<li>\uc801\ud569\ud55c \uacbd\uc6b0: \uc9e7\uc740 \uad50\uc721\uc73c\ub85c \uc0dd\ud65c \ubc00\ucc29\ud615 \uc77c\uc744 \uc2dc\uc791\ud574\ubcf4\uace0 \uc2f6\uc740 \uacbd\uc6b0<\/li>\n<li>\ud655\uc778\ud560 \uac83: \ubc1c\uae09\uae30\uad00, \ubbfc\uac04\uc790\uaca9 \ub4f1\ub85d \uc5ec\ubd80, \uc2e4\uc81c \ucc44\uc6a9\uacf5\uace0 \uc694\uad6c \uc5ec\ubd80<\/li>\n<li>\uc8fc\uc758\ud560 \uac83: \uc218\uac15\ub8cc\uc640 \uc790\uaca9\uc99d \ubc1c\uae09\ube44\ub97c \ubd84\ub9ac\ud574\uc11c \ud655\uc778<\/li>\n<\/ul>\n<h2>\ube44\uad50 \uccb4\ud06c\ub9ac\uc2a4\ud2b8<\/h2>\n<table>\n<thead>\n<tr>\n<th>\uccb4\ud06c \ud56d\ubaa9<\/th>\n<th>\uc65c \uc911\uc694\ud55c\uac00<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\uc9c0\uc5ed \uad6c\uc778\uacf5\uace0\uc5d0 \uc2e4\uc81c\ub85c \ubcf4\uc774\ub294\uac00<\/td>\n<td>\uc790\uaca9\uc99d \uc790\uccb4\ubcf4\ub2e4 \ucc44\uc6a9 \uc218\uc694\uac00 \ub354 \uc911\uc694\ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uad6d\uac00\uc790\uaca9\uc778\uc9c0 \ubbfc\uac04\uc790\uaca9\uc778\uc9c0<\/td>\n<td>\ubc1c\uae09\uae30\uad00\uacfc \ud65c\uc6a9 \ubc94\uc704\uac00 \ub2ec\ub77c\uc9d1\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uc2e4\uc2b5\uc774 \ud544\uc694\ud55c\uac00<\/td>\n<td>\uc2dc\uac04\ud45c, \uac70\ub9ac, \uccb4\ub825 \ubd80\ub2f4\uc744 \ubbf8\ub9ac \uacc4\uc0b0\ud574\uc57c \ud569\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\uad6d\ube44\uc9c0\uc6d0 \uacfc\uc815\uc774 \uc788\ub294\uac00<\/td>\n<td>\uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc\ub85c \uad50\uc721\ube44 \ubd80\ub2f4\uc744 \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/td>\n<\/tr>\n<tr>\n<td>\ucde8\ub4dd \ud6c4 \ubc14\ub85c \uc77c\ud560 \uc218 \uc788\ub294\uac00<\/td>\n<td>\ucd94\uac00 \uad50\uc721, \uacbd\ub825, \uac74\uac15\uac80\uc9c4 \ub4f1\uc774 \ud544\uc694\ud55c \ubd84\uc57c\uac00 \uc788\uc2b5\ub2c8\ub2e4.<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\ucd94\ucc9c \uc21c\uc11c<\/h2>\n<p>\ucc98\uc74c\ubd80\ud130 \uc5ec\ub7ec \uc790\uaca9\uc99d\uc744 \ub3d9\uc2dc\uc5d0 \uc900\ube44\ud558\uae30\ubcf4\ub2e4, \uc544\ub798 \uc21c\uc11c\ub85c \ud558\ub098\uc529 \uc881\ud600\ubcf4\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4.<\/p>\n<ol>\n<li>\uc9d1 \uadfc\ucc98 \uad6c\uc778\uacf5\uace0\uc5d0\uc11c \ubc18\ubcf5\ud574\uc11c \ubcf4\uc774\ub294 \uc9c1\ubb34\ub97c \ucc3e\uc2b5\ub2c8\ub2e4.<\/li>\n<li>\uadf8 \uc9c1\ubb34\uac00 \uc694\uad6c\ud558\ub294 \uc790\uaca9\uc99d\uc774 \uad6d\uac00\uc790\uaca9\uc778\uc9c0 \ubbfc\uac04\uc790\uaca9\uc778\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uad50\uc721 \uae30\uac04, \uc2e4\uc2b5 \uc7a5\uc18c, \ube44\uc6a9, \uc2dc\ud5d8 \uc77c\uc815\uc744 \ube44\uad50\ud569\ub2c8\ub2e4.<\/li>\n<li>\uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc\ub098 \uc9c0\uc790\uccb4 \uad50\uc721\ube44 \uc9c0\uc6d0\uc774 \uac00\ub2a5\ud55c\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<li>\uc218\uac15 \uc804 \ud574\ub2f9 \ubd84\uc57c \uadfc\ubb34\uc790\uc758 \ud6c4\uae30\uc640 \uc2e4\uc81c \uadfc\ubb34\uc2dc\uac04\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.<\/li>\n<\/ol>\n<h2 id=\"official-links\">\uacf5\uc2dd \ud655\uc778\ucc98<\/h2>\n<table>\n<thead>\n<tr>\n<th>\ubd84\uc57c<\/th>\n<th>\uacf5\uc2dd \ud655\uc778\ucc98<\/th>\n<th>\ud655\uc778\ud560 \ub0b4\uc6a9<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\uc694\uc591\ubcf4\ud638\uc0ac<\/td>\n<td><a href=\"https:\/\/www.kuksiwon.or.kr\/ss\/index.do\" target=\"_blank\" rel=\"noopener\">\uad6d\uc2dc\uc6d0 \uc790\uaca9\uc2dc\ud5d8 \uc548\ub0b4<\/a><\/td>\n<td>\uc2dc\ud5d8 \uc77c\uc815, \uc751\uc2dc\uc790\uaca9, \ud569\uaca9\uc790 \ubc1c\ud45c<\/td>\n<\/tr>\n<tr>\n<td>\uad6d\uac00\uc790\uaca9\u00b7\uae30\ub2a5\uc0ac<\/td>\n<td><a href=\"https:\/\/www.q-net.or.kr\/\" target=\"_blank\" rel=\"noopener\">Q-Net \uad6d\uac00\uc790\uaca9 \uc548\ub0b4<\/a><\/td>\n<td>\uc885\ubaa9\ubcc4 \uc2dc\ud5d8\uc77c\uc815, \ud544\uae30\u00b7\uc2e4\uae30 \uc815\ubcf4<\/td>\n<\/tr>\n<tr>\n<td>\uad6d\ube44\uc9c0\uc6d0 \ud6c8\ub828<\/td>\n<td><a href=\"https:\/\/www.work24.go.kr\/hr\/h\/a\/1100\/selectIssuGudn.do\" target=\"_blank\" rel=\"noopener\">\uace0\uc6a924 \uad6d\ubbfc\ub0b4\uc77c\ubc30\uc6c0\uce74\ub4dc \uc548\ub0b4<\/a><\/td>\n<td>\uce74\ub4dc \uc2e0\uccad, \ud6c8\ub828\uacfc\uc815 \uac80\uc0c9, \ubcf8\uc778\ubd80\ub2f4\uae08<\/td>\n<\/tr>\n<tr>\n<td>\uc0ac\ud68c\ubcf5\uc9c0\uc0ac 2\uae09<\/td>\n<td><a href=\"https:\/\/www.welfare.net\/lic\/main.do\" target=\"_blank\" rel=\"noopener\">\ud55c\uad6d\uc0ac\ud68c\ubcf5\uc9c0\uc0ac\ud611\ud68c \uc790\uaca9\uad00\ub9ac\uc13c\ud130<\/a><\/td>\n<td>\uc790\uaca9 \uae30\uc900, \uc774\uc218 \uacfc\ubaa9, \uc2e4\uc2b5 \uae30\uc900<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h2>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38<\/h2>\n<h3>50\ub300\uc5d0 \uc0c8 \uc790\uaca9\uc99d\uc744 \uc900\ube44\ud574\ub3c4 \ub2a6\uc9c0 \uc54a\ub098\uc694?<\/h3>\n<p>\ub2a6\uc5c8\ub2e4\uace0 \ubcf4\uae30 \uc5b4\ub835\uc2b5\ub2c8\ub2e4. \ub2e4\ub9cc \ub2e8\uc21c \ucde8\ub4dd\ubcf4\ub2e4 \uc77c\uc790\ub9ac\uc640 \uc5f0\uacb0\ub418\ub294\uc9c0\ub97c \uba3c\uc800 \ubd10\uc57c \ud569\ub2c8\ub2e4. \uc9c0\uc5ed \ua